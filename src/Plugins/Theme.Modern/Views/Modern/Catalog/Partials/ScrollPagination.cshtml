<div id="ajax-preloader-container" class="d-flex justify-content-center align-items-center">
    <div class="alert-info alert">
        <template v-if="catalog.Model.PagingFilteringContext.PageNumber !== catalog.Model.PagingFilteringContext.TotalPages">
            <div class="d-inline-flex align-items-center w-100">
                <div class="spinner-border text-info me-3" role="status"></div>
                <div>@Loc["View.ScrollDown"]</div>
            </div>
        </template>
        <template v-else>
            @Loc["View.Nomore"]
        </template>
    </div>
</div>
@*Behaviour lives in vueapp/src/views/scroll-pagination.js; it works together
    with catalog-modern.js, which appends each page it fetches.*@
<script type="application/json" data-grand-vm="scrollPagination">{}</script>