@model object
@*
    Data island for the Modern catalog listing view-model. The behaviour lives in
    vueapp/src/views/catalog-modern.js, which publishes the global `catalog`.
*@
<script type="application/json" data-grand-vm="catalogModern">@Json.Serialize(new {
                                                                  model = Model,
                                                                  res = new {
                                                                      warning = Loc["common.warning"].ToString(),
                                                                      loadFailed = Loc["catalog.loadfailed"].ToString()
                                                                  }
                                                              })</script>
