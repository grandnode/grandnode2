@model IList<ProductOverviewModel>
@inject IPageHeadBuilder pagebuilder
@{
    Layout = "_SingleColumn";

    //title
    pagebuilder.AddTitleParts(Loc["Title.NewProducts"]);
}
<div class="page recently-added-products-page col-12 px-0" vue-island>
    <h1 class="h2 generalTitle text-center">
        <div>@Loc["Products.NewProducts"]</div>
    </h1>
    @if (Model.Any())
    {
        <div class="item-row">
            @foreach (var product in Model)
            {
                <div class="col-6 col-sm-6 col-lg-3 col-xl-3 product-container mb-2">
                    <partial name="Partials/CatalogProductView" model="product"/>
                </div>
            }
        </div>
    }
</div>