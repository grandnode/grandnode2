@model IList<ProductTagModel>
<div class="col-12 product-tags-box px-0">
    <div class="product-tags-list">
        @for (var i = 0; i < Model.Count; i++)
        {
            <a class="btn btn-outline-secondary btn-sm producttag" href="@Url.RouteUrl("ProductsByTagName", new { Model[i].SeName })" role="button">
                @Model[i].Name <span>@Loc["Products.Tags.Count", Model[i].ProductCount]</span>
            </a>
        }
    </div>
</div>