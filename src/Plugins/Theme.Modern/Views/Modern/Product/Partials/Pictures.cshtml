@model ProductDetailsModel

@{
    <script asp-location="Footer" asp-order="300" asp-src="/Plugins/Theme.Modern/Content/script/medium-zoom.min.js"></script>
}
<div class="col-12 col-md-5 col-lg-6 col-xl-7 px-0">
    @if (!string.IsNullOrEmpty(Model.Flag))
    {
        <div class="product-label">
            @Html.Raw(Model.Flag)
        </div>
    }
    <div class="gallery">
        <div id="ppslider" class="gallery-slider">
            <!-- swiper1 Thumbs -->
            <swiper class="swiper gallery-thumbs" :options="swiperOptionThumbs" ref="swiperThumbs">
                @for (var i = 0; i < Model.PictureModels.Count; i++)
                {
                    var picture = Model.PictureModels[i];
                    <swiper-slide @@click="slideToThumb(@i)">
                        <img src="@picture.ThumbImageUrl" alt="@picture.AlternateText" title="@picture.Title"/>
                    </swiper-slide>
                }
            </swiper>
            <!-- swiper2 Main -->
            <swiper class="swiper gallery-top" :options="swiperOptionTop" ref="swiperTop">
                @foreach (var picture in Model.PictureModels)
                {
                    <swiper-slide>
                        <img src="@picture.ImageUrl" data-srcs="@picture.ImageUrl" data-zoom-src="@picture.FullSizeImageUrl" alt="@picture.AlternateText" title="@picture.Title"/>
                        @if (Model.DefaultPictureZoomEnabled)
                        {
                            <div class="zoom-button" data-zoom-image>
                                <span class="icons icon-frame"></span>
                            </div>
                        }
                    </swiper-slide>
                }
                <div class="swiper-button-next swiper-button-white" slot="button-next"></div>
                <div class="swiper-button-prev swiper-button-white" slot="button-prev"></div>
            </swiper>
        </div>
    </div>
</div>
@*
    Staged for Theme.Modern's app.js, which reads window.productGallery when the
    root vm is created: Swiper's loop mode needs more real slides than
    loopedSlides, or its loop math breaks and navigation silently does nothing.

    This cannot be a Vue instance of its own - the gallery markup above is part
    of #app's template, so app.js replaces the whole subtree when it mounts.
*@
<script type="application/json" data-grand-vm="globals">@Json.Serialize(new {
                                                            name = "productGallery",
                                                            data = new { pictureCount = Model.PictureModels.Count }
                                                        })</script>
<script type="application/json" data-grand-vm="imageZoom">{}</script>
