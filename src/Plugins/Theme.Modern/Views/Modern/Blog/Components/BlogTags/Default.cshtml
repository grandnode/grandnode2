@model BlogPostTagListModel
@if (Model.Tags.Any())
{
    <div id="block-popular-blogtags" class="block block-popular-blogtags">
        <h2 class="h5">
            <strong>@Loc["Blog.TagCloud"]</strong>
        </h2>
        <div class="viewBox">
            <div class="product-tags-list">
                @foreach (var item in Model.Tags)
                {
                    <a class="btn btn-light btn-sm mb-2 me-2" href="@Url.RouteUrl("BlogByTag", new { tag = item.Name })" role="button" style="font-size:@(Model.GetFontSize(item))%;">
                        @item.Name
                    </a>
                }
            </div>
        </div>
    </div>
}