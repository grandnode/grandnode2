@{
    var customerVmData = new Dictionary<string, object> {
        ["FirstName"] = Model.FirstName,
        ["LastName"] = Model.LastName,
        ["Company"] = Model.Company,
        ["StreetAddress"] = Model.StreetAddress,
        ["StreetAddress2"] = Model.StreetAddress2,
        ["ZipPostalCode"] = Model.ZipPostalCode,
        ["City"] = Model.City,
        //empty string, never null: these drive v-model on a <select>, and Vue
        //matches the option by value - null matches nothing and clears the
        //selection, where "" selects the "Select country" placeholder. The old
        //inline script always produced a string because it interpolated into a
        //JS literal.
        ["CountryId"] = Model.CountryId ?? "",
        ["StateProvinceId"] = Model.StateProvinceId ?? "",
        ["AvailableStates"] = Model.AvailableStates.Select(s => new { id = s.Value, name = s.Text }),
        ["Phone"] = Model.Phone,
        ["Fax"] = Model.Fax,
        ["Username"] = Model.Username,
        ["Email"] = Model.Email,
        ["Password"] = "",
        ["ConfirmPassword"] = "",
        ["AcceptPrivacyPolicy"] = false
    };
    foreach (var item in Model.CustomerAttributes)
    {
        var key = $"customer_attribute_{item.Id}";
        switch (item.AttributeControlType)
        {
            case AttributeControlType.DropdownList:
                customerVmData[key] = item.Values.FirstOrDefault(v => v.IsPreSelected)?.Id ?? "";
                break;
            //A checkbox group binds to an array and a radio group to a scalar, and
            //the required rule checks the bound value. The empty-string filler the
            //view used to emit for every unselected option made both look answered:
            //["", ""] is neither empty nor shorter than one item, so client-side
            //validation passed with nothing selected and only the server refused
            //the form - with no message on the field.
            case AttributeControlType.Checkboxes:
            case AttributeControlType.ReadonlyCheckboxes:
                customerVmData[key] = item.Values.Where(v => v.IsPreSelected).Select(v => v.Id).ToList();
                break;
            case AttributeControlType.RadioList:
                customerVmData[key] = item.Values.FirstOrDefault(v => v.IsPreSelected)?.Id ?? "";
                break;
            case AttributeControlType.TextBox:
            case AttributeControlType.MultilineTextbox:
                customerVmData[key] = item.DefaultValue ?? "";
                break;
        }
    }
}
@*Behaviour lives in vueapp/src/views/country-state-form.js, shared with the address forms.*@
<script type="application/json" data-grand-vm="countryStateForm">@Json.Serialize(new {
                                                                    name = "customer",
                                                                    data = customerVmData,
                                                                    routes = new { getStates = Url.RouteUrl("GetStatesByCountryId") },
                                                                    elements = new {
                                                                        countrySelectId = Html.IdFor(m => m.CountryId),
                                                                        stateSelectId = Html.IdFor(m => m.StateProvinceId)
                                                                    },
                                                                    newsletterToggle = new {
                                                                        checkboxId = Html.IdFor(m => m.Newsletter),
                                                                        targetSelector = ".register-category-newsletter"
                                                                    },
                                                                    res = new { warning = Loc["common.warning"].ToString() }
                                                                })</script>
