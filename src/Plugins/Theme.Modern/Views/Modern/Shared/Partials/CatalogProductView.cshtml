@using System.Globalization
@model ProductOverviewModel

@await Component.InvokeAsync("Widget", new { widgetZone = "productbox_before_content", additionalData = Model })
<article v-bind:class="{mobile: isMobile()}" class="card product-box show product-provider mb-2" @@mouseover="hover = true" @@mouseleave="hover = false">
    @if (!string.IsNullOrEmpty(Model.Flag))
    {
        <div class="flag-label">
            @Html.Raw(Model.Flag)
        </div>
    }
    <div class="picture-container">
        <a class="img-container" href="@Url.RouteUrl("Product", new { Model.SeName })" title="@Model.DefaultPictureModel.Title">
            <img class="card-img main-product-img" src="@Model.DefaultPictureModel.ImageUrl" alt="@Model.DefaultPictureModel.AlternateText" loading="lazy" title="@Model.DefaultPictureModel.Title">
            @if (!string.IsNullOrEmpty(Model.SecondPictureModel.ImageUrl))
            {
                <img class="card-img hover-img" src="@Model.SecondPictureModel.ImageUrl" alt="@Model.SecondPictureModel.AlternateText" loading="lazy">
            }
        </a>
        @if (Model.ProductAttributeModels.Any())
        {
            <div class="attr-container">
                <table>
                    <tbody>
                    @foreach (var item in Model.ProductAttributeModels)
                    {
                        <tr class="attr">
                            <td>
                                @*<div class="attr-name">
                                            @item.Name
                                        </div>*@
                            </td>
                            <td>
                                <div class="attr-value">
                                    @foreach (var spec in item.Values)
                                    {
                                        switch (item.AttributeControlType)
                                        {
                                            case AttributeControlType.DropdownList:
                                            case AttributeControlType.RadioList:
                                            case AttributeControlType.Checkboxes:
                                            case AttributeControlType.ReadonlyCheckboxes:
                                                <a class="btn btn-light btn-sm name" href="@Url.RouteUrl("Product", new { Model.SeName })?@item.Name=@Html.Raw(spec.Name)" role="button">
                                                    @Html.Raw(spec.Name)
                                                </a>
                                                break;
                                            case AttributeControlType.ColorSquares:
                                                if (spec.PictureModel.FullSizeImageUrl != null)
                                                {
                                                    <button class="btn btn-light btn-sm name color-container" type="button" title="@spec.Name" v-on:click='productImage' data-href="@spec.PictureModel.FullSizeImageUrl">
                                                        <span class="color" style="background-color:@spec.ColorSquaresRgb;">&nbsp;</span>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <a class="btn btn-light btn-sm name color-container" href="@Url.RouteUrl("Product", new { Model.SeName })?@item.Name=@Html.Raw(spec.Name)" role="button" title="@spec.Name">
                                                        <span class="color" style="background-color:@spec.ColorSquaresRgb;">&nbsp;</span>
                                                    </a>
                                                }

                                                break;
                                            case AttributeControlType.ImageSquares:
                                                if (spec.PictureModel.FullSizeImageUrl != null)
                                                {
                                                    <button class="btn btn-light btn-sm p-1 name image-container" type="button" v-on:click='productImage' data-href="@spec.PictureModel.FullSizeImageUrl">
                                                        <img src="@spec.ImageSquaresPictureModel?.ImageUrl" alt="@spec.Name"/>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <a class="btn btn-light btn-sm p-1 name image-container" href="@Url.RouteUrl("Product", new { Model.SeName })?@item.Name=@Html.Raw(spec.Name)" role="button">
                                                        <img src="@spec.ImageSquaresPictureModel?.ImageUrl" alt="@spec.Name"/>
                                                    </a>
                                                }

                                                break;
                                        }
                                    }
                                </div>
                            </td>

                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        <div class="other-buttons">
            @if (!Model.ProductPrice.DisableBuyButton)
            {
                var addToCartText = Loc["ShoppingCart.AddToCart"];
                if (Model.ProductType == ProductType.Reservation)
                {
                    addToCartText = Loc["ShoppingCart.Reservation"];
                }

                if (Model.ProductPrice.AvailableForPreOrder)
                {
                    addToCartText = Loc["ShoppingCart.PreOrder"];
                }

                <button class="btn btn-outline-secondary" type="button" data-bs-toggle="tooltip" data-bs-placement="bottom" title="@(addToCartText)" data-cart-action="add" data-url="@Model.AddToCartUrl" data-show-qty="@Model.ShowQty" data-product-id="@Model.Id">
                    <span class="icons icon-handbag"></span>
                    <span class="sr-only">AddToCart</span>
                </button>
            }
            else
            {
                if (Model.ProductType == ProductType.Auction)
                {
                    var addToCartText = Loc["ShoppingCart.Bids"];
                    <button class="btn btn-outline-secondary add-to-cart-button" type="button" data-bs-toggle="tooltip" data-bs-placement="bottom" title="@(addToCartText)" data-cart-action="add" data-url="@Model.AddToCartUrl" data-show-qty="false" data-product-id="@Model.Id">
                        <span class="icons icon-bell"></span>
                        <span class="sr-only">AddToCart</span>
                    </button>
                }
            }
            @if (!Model.ProductPrice.DisableWishlistButton && Model.ProductType == ProductType.SimpleProduct)
            {
                <a data-bs-toggle="tooltip" data-bs-placement="bottom" title="@Loc["ShoppingCart.AddToWishlist"]" class="btn btn-outline-secondary" data-cart-action="add" data-url="@Model.AddToWishlistUrl" data-show-qty="@Model.ShowQty" data-product-id="@Model.Id">
                    <span class="icons icon-heart"></span>
                    <span class="sr-only">AddToWishlist</span>
                </a>
            }
            @if (!Model.ProductPrice.DisableAddToCompareListButton && Model.ProductType == ProductType.SimpleProduct)
            {
                <a data-bs-toggle="tooltip" data-bs-placement="bottom" title="@Loc["ShoppingCart.AddToCompareList"]" class="btn btn-outline-secondary" data-cart-action="compare" data-product-id="@Model.Id">
                    <span class="sr-only">AddToCompareList</span>
                    <span class="icons icon-shuffle"></span>
                </a>
            }
        </div>
        <div class="qvb-container">
            <a class="quick-view-button w-100 btn btn-secondary" data-target="ModalQuickView" data-cart-action="quickview" data-url="@Model.QuickViewUrl">
                <span class="icons icon-magnifier"></span>
                <span>@Loc["Products.QuickView"]</span>
            </a>
        </div>
    </div>
    <div class="card-body">
        <h5 class="card-title mb-0">
            <a href="@Url.RouteUrl("Product", new { Model.SeName })">
                @Model.Name
            </a>
        </h5>
        @if (Model.ShowSku && !string.IsNullOrEmpty(Model.Sku))
        {
            <span class="sku">@Model.Sku</span>
        }
        <div class="prices-rating">
            @if (Model.ReviewOverviewModel.AllowCustomerReviews)
            {
                decimal ratingValue = 0;
                if (Model.ReviewOverviewModel.TotalReviews != 0)
                {
                    ratingValue = Convert.ToDecimal(Model.ReviewOverviewModel.RatingSum * (double)100 / Model.ReviewOverviewModel.TotalReviews / 100);
                }

                <div class="rating">
                    <partial name="Partials/Rating" model="(double)ratingValue" />
                    <a href="@Url.RouteUrl("Product", new { Model.SeName })">@Model.ReviewOverviewModel.TotalReviews @Loc["Reviews.Overview.Reviews"]</a>
                </div>
            }
            @if (Model.ProductType == ProductType.Auction)
            {
                @if (Model.EndTime.HasValue)
                {
                    <div class="countdown-box alert alert-info w-100 mb-1">
                        @if (Model.EndTime > DateTime.UtcNow)
                        {
                            <countdown :end-time="@Model.EndTime.Value.ToUniversalTime().Subtract(new DateTime(1970, 1, 1, 0, 0, 0, DateTimeKind.Utc)).TotalMilliseconds">
                                <template v-slot:process="{ timeObj }">
                                    <span class="col-form-label">@Loc["AddToCart.Timeleft"]:</span>
                                    <span>{{ `${timeObj.d}` }} : </span>
                                    <span>{{ `${timeObj.h}` }} : </span>
                                    <span>{{ `${timeObj.m}` }} : </span>
                                    <span>{{ `${timeObj.s}` }}</span>
                                </template>
                                <template v-slot:finish>
                                    <span>@Loc["ShoppingCart.Auctionends"]</span>
                                </template>
                            </countdown>
                        }
                        else
                        {
                            <div class="d-inline-flex flex-wrap justify-content-center">
                                <label class="ended-label">@Loc["ShoppingCart.Auctionends"]:</label>
                                <div class="count-date">@Model.EndTimeLocalTime.Value.ToString(CultureInfo.InvariantCulture)</div>
                            </div>
                        }
                    </div>
                }
            }
            <div class="prices @if (Model.ProductType == ProductType.Reservation) { <text>reservation-price</text> } ">
                @if (Model.ProductType != ProductType.Auction)
                {
                    <div class="actual-price price">
                        @Model.ProductPrice.Price
                    </div>
                }
                else
                {
                    <div class="actual-price price">
                        @(Model.ProductPrice.HighestBidValue > 0 ? Model.ProductPrice.HighestBid : Model.ProductPrice.StartPrice)
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.ProductPrice.OldPrice))
                {
                    <div class="old-price price">
                        @Model.ProductPrice.OldPrice
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="card-footer">
        <div class="desc" v-pre>
            @Html.Raw(Model.ShortDescription)
        </div>
        <div class="mt-auto">
            <div class="list-button-container">
                @if (Model.ShowQty)
                {
                    var qtyId = "addtocart_" + Model.Id + "_EnteredQuantity";
                    <input class="form-control input-group-addon catalog-quantity" type="number" id="@qtyId" name="@qtyId" value="1">
                }
                @if (!Model.ProductPrice.DisableBuyButton)
                {
                    var addToCartText = Loc["ShoppingCart.AddToCart"];
                    if (Model.ProductType == ProductType.Reservation)
                    {
                        addToCartText = Loc["ShoppingCart.Reservation"];
                    }

                    if (Model.ProductPrice.AvailableForPreOrder)
                    {
                        addToCartText = Loc["ShoppingCart.PreOrder"];
                    }

                    <button class="btn btn-outline-secondary add-to-cart-button" type="button" data-cart-action="add" data-url="@Model.AddToCartUrl" data-show-qty="@Model.ShowQty" data-product-id="@Model.Id">
                        <span class="add-cart-text">@(addToCartText)</span>
                        <span class="sr-only">AddToCart</span>
                    </button>
                }
                else
                {
                    if (Model.ProductType == ProductType.Auction)
                    {
                        var addToCartText = Loc["ShoppingCart.Bids"];
                        <button class="btn btn-outline-secondary add-to-cart-button" type="button" data-cart-action="add" data-url="@Model.AddToCartUrl" data-show-qty="false" data-product-id="@Model.Id">
                            <span class="add-cart-text">@Loc["ShoppingCart.Bids"]</span>
                            <span class="sr-only">AddToCart</span>
                        </button>
                    }
                }
            </div>
        </div>
    </div>
</article>