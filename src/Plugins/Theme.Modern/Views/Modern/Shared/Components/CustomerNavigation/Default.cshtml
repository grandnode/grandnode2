@model CustomerNavigationModel
@{
    <link rel="stylesheet" type="text/css" asp-src="/Plugins/Theme.Modern/Content/css/customer/customer.css">
}
<div id="block-account-navigation" class="block block-account-navigation mt-2">
    <h2 class="h5">
        <strong>@Loc["Account.Navigation"]</strong>
    </h2>
    <ul class="list viewBox">
        @await Component.InvokeAsync("Widget", new { widgetZone = "account_navigation_before" })
        @if (!Model.HideInfo)
        {
            <li class="customer-info">
                <a href="@Url.RouteUrl("CustomerInfo")" class="@if (Model.SelectedTab == AccountNavigationEnum.Info) { <text>active</text> }else { <text>inactive</text> }">
                    <i class="b-icon bi bi-person" aria-hidden="true"></i> <span>@Loc["Account.CustomerInfo"]</span>
                </a>
            </li>
        }
        @if (!Model.HideAddresses)
        {
            <li class="customer-addresses">
                <a href="@Url.RouteUrl("CustomerAddresses")" class="@if (Model.SelectedTab == AccountNavigationEnum.Addresses) { <text>active</text> }else { <text>inactive</text> }">
                    <i class="b-icon bi bi-file-earmark-richtext" aria-hidden="true"></i> <span>@Loc["Account.CustomerAddresses"]</span>
                </a>
            </li>
        }
        @if (!Model.HideOrders)
        {
            <li class="customer-orders">
                <a href="@Url.RouteUrl("CustomerOrders")" class="@if (Model.SelectedTab == AccountNavigationEnum.Orders) { <text>active</text> }else { <text>inactive</text> }">
                    <i class="b-icon bi bi-cart-check" aria-hidden="true"></i> <span>@Loc["Account.CustomerOrders"]</span>
                </a>
            </li>
        }
        @if (!Model.HideCourses)
        {
            <li class="customer-auctions">
                <a href="@Url.RouteUrl("CustomerCourses")" class="@if (Model.SelectedTab == AccountNavigationEnum.Courses) { <text>active</text> }else { <text>inactive</text> }">
                    <i class="b-icon bi bi-file-earmark-easel" aria-hidden="true"></i> <span>@Loc["Account.CustomerCourses"]</span>
                </a>
            </li>
        }
        @if (!Model.HideAuctions)
        {
            <li class="customer-auctions">
                <a href="@Url.RouteUrl("CustomerAuctions")" class="@if (Model.SelectedTab == AccountNavigationEnum.Auctions) { <text>active</text> }else { <text>inactive</text> }">
                    <i class="b-icon bi bi-hammer" aria-hidden="true"></i> <span>@Loc["Account.CustomerAuctions"]</span>
                </a>
            </li>
        }
        @if (!Model.HideNotes)
        {
            <li class="customer-notes">
                <a href="@Url.RouteUrl("CustomerNotes")" class="@if (Model.SelectedTab == AccountNavigationEnum.Notes) { <text>active</text> }else { <text>inactive</text> }">
                    <i class="b-icon bi bi-file-earmark-font" aria-hidden="true"></i> <span>@Loc["Account.CustomerNotes"]</span>
                </a>
            </li>
        }
        @if (!Model.HideDocuments)
        {
            <li class="customer-notes">
                <a href="@Url.RouteUrl("CustomerDocuments")" class="@if (Model.SelectedTab == AccountNavigationEnum.Documents) { <text>active</text> }else { <text>inactive</text> }">
                    <i class="b-icon bi bi-file-earmark-check" aria-hidden="true"></i> <span>@Loc["Account.CustomerDocuments"]</span>
                </a>
            </li>
        }
        @if (!Model.HideMerchandiseReturns)
        {
            <li class="customer-returns">
                <a href="@Url.RouteUrl("CustomerMerchandiseReturns")" class="@if (Model.SelectedTab == AccountNavigationEnum.MerchandiseReturns) { <text>active</text> }else { <text>inactive</text> }">
                    <i class="b-icon bi bi-arrow-return-left" aria-hidden="true"></i> <span>@Loc["Account.CustomerMerchandiseReturns"]</span>
                </a>
            </li>
        }
        @if (!Model.HideDownloadableProducts)
        {
            <li class="customer-downloadable">
                <a href="@Url.RouteUrl("CustomerDownloadableProducts")" class="@if (Model.SelectedTab == AccountNavigationEnum.DownloadableProducts) { <text>active</text> }else { <text>inactive</text> }">
                    <i class="b-icon bi bi-cloud-download" aria-hidden="true"></i> <span>@Loc["Account.DownloadableProducts"]</span>
                </a>
            </li>
        }
        @if (!Model.HideOutOfStockSubscriptions)
        {
            <li class="customer-back">
                <a href="@Url.RouteUrl("CustomerOutOfStockSubscriptions")" class="@if (Model.SelectedTab == AccountNavigationEnum.OutOfStockSubscriptions) { <text>active</text> }else { <text>inactive</text> }">
                    <i class="b-icon bi bi-skip-backward" aria-hidden="true"></i> <span>@Loc["Account.OutOfStockSubscriptions"]</span>
                </a>
            </li>
        }
        @if (!Model.HideLoyaltyPoints)
        {
            <li class="loyalty-points">
                <a href="@Url.RouteUrl("CustomerLoyaltyPoints")" class="@if (Model.SelectedTab == AccountNavigationEnum.LoyaltyPoints) { <text>active</text> }else { <text>inactive</text> }">
                    <i class="b-icon bi bi-trophy" aria-hidden="true"></i> <span>@Loc["Account.LoyaltyPoints"]</span>
                </a>
            </li>
        }
        @if (!Model.HideChangePassword)
        {
            <li class="change-password">
                <a href="@Url.RouteUrl("CustomerChangePassword")" class="@if (Model.SelectedTab == AccountNavigationEnum.ChangePassword) { <text>active</text> }else { <text>inactive</text> }">
                    <i class="b-icon bi bi-file-earmark-lock2" aria-hidden="true"></i> <span>@Loc["Account.ChangePassword"]</span>
                </a>
            </li>
        }
        @if (!Model.HideDeleteAccount)
        {
            <li class="customer-delete">
                <a href="@Url.RouteUrl("CustomerDeleteAccount")" class="@if (Model.SelectedTab == AccountNavigationEnum.DeleteAccount) { <text>active</text> }else { <text>inactive</text> }">
                    <i class="b-icon bi bi-trash" aria-hidden="true"></i> <span>@Loc["Account.DeleteAccount"]</span>
                </a>
            </li>
        }
        @if (!Model.HideReviews)
        {
            <li class="customer-notes">
                <a href="@Url.RouteUrl("CustomerReviews")" class="@if (Model.SelectedTab == AccountNavigationEnum.Reviews) { <text>active</text> }else { <text>inactive</text> }">
                    <i class="b-icon bi bi-star" aria-hidden="true"></i> <span>@Loc["Account.Reviews"]</span>
                </a>
            </li>
        }
        @if (!Model.HideSubAccounts)
        {
            <li class="customer-subaccounts">
                <a href="@Url.RouteUrl("CustomerSubAccounts")" class="@if (Model.SelectedTab == AccountNavigationEnum.SubAccounts) { <text>active</text> }else { <text>inactive</text> }">
                    <i class="b-icon bi bi-person-plus" aria-hidden="true"></i> <span>@Loc["Account.SubAccounts"]</span>
                </a>
            </li>
        }
        @await Component.InvokeAsync("Widget", new { widgetZone = "account_navigation_after", additionalData = Model })
    </ul>
</div>