@model IList<ProductOverviewModel>
@if (Model.Any())
{
    <div class="col-12 recommended-products-grid product-grid px-0">
        <h2 class="h3 generalTitle text-center">@Loc["Products.RecommendedProducts"]</h2>
        <div class="form-row">
            @foreach (var item in Model)
            {
                <div class="col-sm-6 col-md-4 col-lg-4 col-xl-3 product-container mb-2">
                    <partial name="Partials/CatalogProductView" model="item"/>
                </div>
            }
        </div>
    </div>
}