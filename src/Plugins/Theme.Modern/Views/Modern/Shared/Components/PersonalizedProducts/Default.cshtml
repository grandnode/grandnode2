@model IList<ProductOverviewModel>
<div class="home-page-section">
    <div id="PersonalizedProducts" class="section">
        <div class="product-grid">
            <h2 class="generalTitle text-center">
                <span>@Loc["HomePage.Personalized.Products"]</span>
            </h2>
            <div class="col-12 px-0">
                <div class="item-row">
                    <div :key="Model.Id" v-for="Model in homePPersonalized.Model" class="col-xl-3 col-lg-4 col-md-4 col-sm-6 col-6 col-for-5-xl product-container mb-2">
                        <product-box v-bind="{ Model: Model }"></product-box>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="application/json" data-grand-vm="state">@Json.Serialize(new { name = "homePPersonalized", data = new { Model } })</script>