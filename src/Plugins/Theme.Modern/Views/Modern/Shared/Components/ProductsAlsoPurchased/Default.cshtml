@model IList<ProductOverviewModel>
@if (Model.Any())
{
    <div class="col-12 also-purchased-products-grid product-grid my-3 px-0">
        <h2 class="h3 generalTitle mb-3">
            <span>@Loc["Products.AlsoPurchased"]</span>
        </h2>
        <div class="form-row">
            @foreach (var item in Model)
            {
                <div class="col-6 col-sm-6 col-md-4 col-lg-4 col-xl-3 product-container col-for-5-xl px-0 mb-2">
                    <partial name="Partials/CatalogProductView" model="item"/>
                </div>
            }
        </div>
    </div>
}