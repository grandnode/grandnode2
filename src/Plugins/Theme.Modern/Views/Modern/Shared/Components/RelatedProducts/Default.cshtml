@model IList<ProductOverviewModel>
@if (Model.Any())
{
    <div class="col-12 related-products-grid  product-grid my-3 px-0">
        <h2 class="h3 generalTitle mb-3">
            <span>@Loc["Products.RelatedProducts"]</span>
        </h2>
        <div class="form-row">
            @foreach (var item in Model)
            {
                <div class="col-6 col-sm-3 col-md-4 col-lg-4 col-xl-3 product-container px-0 mb-2">
                    <partial name="Partials/CatalogProductView" model="item"/>
                </div>
            }
        </div>
    </div>
}