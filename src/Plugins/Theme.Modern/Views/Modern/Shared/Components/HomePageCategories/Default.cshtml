@model IList<CategoryModel>
<div class="home-page-section" vue-island="homePCategories">
    <div id="HomePageCategories">
        <div class="section">
            <div class="col-12 px-0">
                <div class="row">
                    <template :key="Model.Id" v-for="Model in homePCategories.Model">
                        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-12">
                            <a class="category-item" :href="'/' + Model.SeName">
                                <img class="img-fluid gallery-img" :src="Model.PictureModel.ImageUrl" :alt="Model.PictureModel.Title" loading="lazy">
                                <div class="content">
                                    <h6 class="title mb-0">{{Model.Name}}</h6>
                                </div>
                            </a>
                        </div>
                    </template>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="application/json" data-grand-vm="state">@Json.Serialize(new { name = "homePCategories", data = new { Model } })</script>