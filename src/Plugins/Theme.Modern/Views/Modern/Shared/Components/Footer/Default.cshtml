@model FooterModel
<footer class="footer" vue-island>
    <div class="footer-top section">
        <div class="container">
            <div class="item-row">
                <div class="col-12 col-md-12 col-lg-4 col-xl-6">
                    <div class="about-us block">
                        <ul class="social-icons">
                            @if (!string.IsNullOrEmpty(Model.FacebookLink))
                            {
                                <li>
                                    <a title="facebook" href="@Model.FacebookLink" rel="noopener" target="_blank">
                                        <img src="/theme/images/facebook.svg" alt="facebook" loading="lazy" height="24" width="24">
                                        <span class="sr-only">Facebook</span>

                                    </a>
                                </li>
                            }
                            @if (!string.IsNullOrEmpty(Model.TwitterLink))
                            {
                                <li>
                                    <a title="twitter" href="@Model.TwitterLink" rel="noopener" target="_blank">
                                        <img src="/theme/images/twitter.svg" alt="twitter" loading="lazy" height="24" width="24">
                                        <span class="sr-only">twitter</span>
                                    </a>
                                </li>
                            }
                            @if (!string.IsNullOrEmpty(Model.YoutubeLink))
                            {
                                <li>
                                    <a title="youtube" href="@Model.YoutubeLink" rel="noopener" target="_blank">
                                        <img src="/theme/images/youtube.svg" alt="youtube" loading="lazy" height="24" width="24">
                                        <span class="sr-only">youtube</span>
                                    </a>
                                </li>
                            }
                            @if (!string.IsNullOrEmpty(Model.InstagramLink))
                            {
                                <li>
                                    <a href="@Model.InstagramLink" rel="noopener" target="_blank">
                                        <img src="/theme/images/instagram.svg" alt="instagram" loading="lazy" height="24" width="24">
                                        <span class="sr-only">instagram</span>
                                    </a>
                                </li>
                            }
                            @if (!string.IsNullOrEmpty(Model.LinkedInLink))
                            {
                                <li>
                                    <a href="@Model.LinkedInLink" rel="noopener" target="_blank">
                                        <img src="/theme/images/linkedin.svg" alt="linkedin" loading="lazy" height="24" width="24">
                                        <span class="sr-only">linkedin</span>
                                    </a>
                                </li>
                            }
                            @if (!string.IsNullOrEmpty(Model.PinterestLink))
                            {
                                <li>
                                    <a href="@Model.PinterestLink" rel="noopener" target="_blank">
                                        <img src="/theme/images/pinterest.svg" alt="pinterest" loading="lazy" height="24" width="24">
                                        <span class="sr-only">pinterest</span>
                                    </a>
                                </li>
                            }
                        </ul>
                        <partial name="Partials/NewsletterBox"/>
                        <h6 class="title">@Loc["Footer.AboutUs"]</h6>
                        <ul class="info">
                            <li>
                                <span class="icons icon-location-pin"></span>
                                <span class="text">
                                    @Loc["Footer.CompanyName.Title"] @Model.CompanyName @Model.CompanyAddress
                                </span>
                            </li>
                            <li>
                                <span class="icons icon-phone"></span>
                                <span class="text">
                                    @Loc["Footer.Phone.Title"] @Model.CompanyPhone
                                </span>
                            </li>
                            <li>
                                <span class="icons icon-clock"></span>
                                <span class="text">
                                    @Loc["Footer.Hour.Title"] @Model.CompanyHours
                                </span>
                            </li>
                            <li>
                                <span class="icons icon-envelope-letter"></span>
                                <span class="text">
                                    @Loc["Footer.Email.Title"] @Model.CompanyEmail
                                </span>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-lg-4 col-xl-3">
                    <h6 class="title">@Loc["Footer.Information"]</h6>
                    <ul>
                        <li>
                            <a href="@Url.RouteUrl("Sitemap")">@Loc["Sitemap"]</a>
                        </li>
                        @if (Model.PrivacyPreference)
                        {
                            <li>
                                <a href="#" id="btnPrivacyPreference" @@click="getPrivacyPreference('@Url.RouteUrl("PrivacyPreference")'); return false;">@Loc["PrivacyPreference"]</a>
                            </li>
                        }
                        @foreach (var topic in Model.Pages.Where(x => x.IncludeInFooterRow1).ToList())
                        {
                            <li>
                                <a href="@Url.RouteUrl("Page", new { topic.SeName })">@topic.Name</a>
                            </li>
                        }
                        @if (Model.NewsEnabled)
                        {
                            <li>
                                <a href="@Url.RouteUrl("NewsArchive")">@Loc["News"]</a>
                            </li>
                        }
                        @if (Model.BlogEnabled)
                        {
                            <li>
                                <a href="@Url.RouteUrl("Blog")">@Loc["Blog"]</a>
                            </li>
                        }
                        @if (Model.KnowledgebaseEnabled)
                        {
                            <li>
                                <a href="@Url.RouteUrl("Knowledgebase")">@Loc["Knowledgebase"]</a>
                            </li>
                        }
                        @if (Model.NewProductsEnabled)
                        {
                            <li>
                                <a href="@Url.RouteUrl("NewProducts")">@Loc["Products.NewProducts"]</a>
                            </li>
                        }
                    </ul>
                </div>
                <div class="col-12 col-md-6 col-lg-4 col-xl-3">
                    <h6 class="title">@Loc["Footer.MyAccount"]</h6>
                    <ul>
                        <li>
                            <a href="@Url.RouteUrl("CustomerInfo")">@Loc["Account.MyAccount"]</a>
                        </li>
                        <li>
                            <a href="@Url.RouteUrl("CustomerOrders")">@Loc["Account.CustomerOrders"]</a>
                        </li>
                        <li>
                            <a href="@Url.RouteUrl("CustomerAddresses")">@Loc["Account.CustomerAddresses"]</a>
                        </li>
                        @if (Model.ShoppingCartEnabled)
                        {
                            <li>
                                <a href="@Url.RouteUrl("ShoppingCart")">@Loc["ShoppingCart"]</a>
                            </li>
                        }
                        @if (Model.WishlistEnabled)
                        {
                            <li>
                                <a href="@Url.RouteUrl("Wishlist")">@Loc["Wishlist"]</a>
                            </li>
                        }
                        @if (Model.RecentlyViewedProductsEnabled)
                        {
                            <li>
                                <a href="@Url.RouteUrl("RecentlyViewedProducts")">@Loc["Products.RecentlyViewedProducts"]</a>
                            </li>
                        }
                        @if (Model.AllowCustomersToApplyForVendorAccount)
                        {
                            <li>
                                <a href="@Url.RouteUrl("ApplyVendorAccount")">@Loc["Vendors.ApplyAccount"]</a>
                            </li>
                        }
                        @foreach (var topic in Model.Pages.Where(x => x.IncludeInFooterRow2).ToList())
                        {
                            <a href="@Url.RouteUrl("Page", new { topic.SeName })" target="_blank">@topic.Name</a>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <div class="footer-bottom">
        <div class="container">
            <div class="item-row section">
                <div class="col-12 col-md-6 pb-1 pt-1 flex-column text-lg-left text-center copyright">
                    <span class="footer-disclaimer">@Html.Raw(Loc["Content.CopyrightNotice", DateTime.Now.Year, Model.StoreName])</span>
                </div>
                <div class="col-12 col-md-6 pb-1 pt-1 text-center text-lg-right">
                    <span>Shopping cart software by </span><a class="pe-1 text-success" href="https://grandnode.com/">GrandNode</a>™
                </div>
            </div>
        </div>
    </div>
    @await Component.InvokeAsync("Widget", new { widgetZone = "footer" })
</footer>