@model IList<ProductOverviewModel>
@if (Model.Any())
{
    <div class="col-12 similar-products-grid product-grid px-0">
        <h2 class="h3 generalTitle text-center">@Loc["Products.SimilarProducts"]</h2>
        <div class="form-row">
            @foreach (var item in Model)
            {
                <div class="col-6 col-sm-6 col-md-4 col-lg-4 col-xl-3 product-container col-for-5-xl px-0 mb-2">
                    <partial name="Partials/CatalogProductView" model="item"/>
                </div>
            }
        </div>
    </div>
}