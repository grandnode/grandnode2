@model IList<CategoryModel>
<div class="home-page-section" vue-island="homePCategoryProducts">
    <div id="CategoryFeaturedProducts" class="section">
        <div class="featured-product-grid">
            @*v-cloak sits on the block itself now that the root no longer carries it -
                everything in here is rendered by Vue from homePCategoryProducts*@
            <div class="tabs products-tabs" v-cloak>
                <ul class="nav nav-tabs" role="tablist">
                    <li class="nav-item" role="presentation" v-for="(Category, index) in homePCategoryProducts.Model" :key="'nav-' + index">
                        <button type="button" class="nav-link" :class="{ active: index === 0 }" role="tab"
                                data-bs-toggle="tab" :data-bs-target="'#featured-category-' + index"
                                :aria-controls="'featured-category-' + index" :aria-selected="index === 0">{{Category.Name}}</button>
                    </li>
                </ul>
                <div class="tab-content products-tabs-content">
                    <div class="tab-pane fade" :class="{ 'show active': index === 0 }" role="tabpanel"
                         v-for="(Category, index) in homePCategoryProducts.Model" :key="'pane-' + index"
                         :id="'featured-category-' + index">
                        <div class="item-row">
                            <div :key="Model.Id" class="col-for-5-xl col-xl-3 col-lg-3 col-md-4 col-sm-6 col-6" v-for="Model in Category.FeaturedProducts">
                                <product-box v-bind="{ Model: Model }"></product-box>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="application/json" data-grand-vm="state">@Json.Serialize(new { name = "homePCategoryProducts", data = new { Model } })</script>