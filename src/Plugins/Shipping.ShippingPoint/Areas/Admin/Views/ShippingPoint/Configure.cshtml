@{
    Layout = "_AdminLayout";
    ViewBag.Title = Loc["Shipping.ShippingPoint.FriendlyName"];
}
<input id="active-menu-item" type="hidden" value="/Admin/Shipping/Providers"/>
@* the points grid in a flush card, Add new in its header; the grid deletes and the popups save,
   so the screen has no primary action of its own *@
<form asp-controller="ShippingPoint" asp-action="Configure" method="post" id="shipping-instore-form">
    <admin-page title="@Loc["Shipping.ShippingPoint.FriendlyName"]" icon="bi-geo-alt">
        <admin-card flush>
            <card-actions>
                <a id="btnAddNewOption" class="btn btn-outline-secondary btn-sm" href="@(Url.Action("Create", "ShippingPoint") + "?btnId=btnRefresh&formId=shipping-instore-form")">
                    <i class="bi bi-plus-lg"></i> @Loc["Admin.Common.AddNew"]
                </a>
                <input type="submit" id="btnRefresh" style="display: none"/>
            </card-actions>
            <admin-grid id="shipping-points-grid"
                        read-url="@Url.Action("List", "ShippingPoint")"
                        destroy-url="@Url.Action("Delete", "ShippingPoint")"
                        pager="Compact"
                        confirm-destroy="true"
                        on-data-bound="bindShippingPointEditPopups">
                <grid-text name="edit" value="@Loc["Admin.Common.Edit"]"/>
                <grid-column field="ShippingPointName" title="@Loc["Shipping.ShippingPoint.Fields.ShippingPointName"]" width="200"/>
                <grid-column field="OpeningHours" title="@Loc["Shipping.ShippingPoint.Fields.OpeningHours"]" width="200"/>
                <grid-column field="PickupFee" title="@Loc["Shipping.ShippingPoint.Fields.PickupFee"]" width="150"/>
                <grid-column field="StoreName" title="@Loc["Shipping.ShippingPoint.Fields.Store"]" width="100"/>
                <grid-column field="Id" title="@Loc["Admin.Common.Edit"]" width="100">
                    <cell-template>
                        <a href="@Url.Action("Edit", "ShippingPoint")?id={{ Id }}&btnId=btnRefresh&formId=shipping-instore-form" class='btn btn-outline-secondary btn-sm editpopup'>{{ $texts.edit }}</a>
                    </cell-template>
                </grid-column>
                <grid-commands destroy="true" title="@Loc["Admin.Common.Delete"]" width="100"/>
            </admin-grid>
        </admin-card>
    </admin-page>
    <script>
        $(document).ready(function () {
            $('#btnAddNewOption').magnificPopup({
                type: 'ajax',
                settings: { cache: false, async: false },
                midClick: true,
                callbacks: {
                    parseAjax: function (mfpResponse) {
                        mfpResponse.data = $('<div></div>').html(mfpResponse.data);
                    },
                    ajaxContentAdded: function () {
                        $('.mfp-wrap').removeAttr('tabindex');
                    }
                }
            });
        });
        function bindShippingPointEditPopups() {
            $('.editpopup').magnificPopup({
                type: 'ajax',
                settings: { cache: false, async: false },
                midClick: true,
                callbacks: {
                    parseAjax: function (mfpResponse) {
                        mfpResponse.data = $('<div></div>').html(mfpResponse.data);
                    },
                    ajaxContentAdded: function () {
                        $('.mfp-wrap').removeAttr('tabindex');
                    }
                }
            });
        }
    </script>

    <script>
        $(document).ready(function () {
            $('#btnRefresh').click(function () {
                var grid = $("#shipping-points-grid").data('kendoGrid');
                grid.dataSource.read();
                return false;
            });
        });
    </script>
</form>
