@{
    Layout = "~/Areas/Store/Views/Shared/_StoreLayout.cshtml";
    ViewBag.Title = Loc["Admin.Configuration.Shipping.Providers"];
}
<input id="active-menu-item" type="hidden" value="/Store/Shipping/Providers"/>

<form asp-controller="ShippingPoint" asp-action="Configure" asp-route-area="Store" method="post" id="shipping-instore-form">
    <div class="row">
        <div class="col-md-12">
            <div class="x_panel light form-fit">
                <div class="x_title">
                    <div class="caption level-caption">
                        <i class="fa fa-map-marker"></i>
                        @Loc["Shipping.ShippingPoint.FriendlyName"]
                    </div>
                </div>
                <div class="x_content form">
                    <admin-grid id="shipping-points-grid"
                                read-url="@Url.Action("List", "ShippingPoint", new { area = "Store" })"
                                destroy-url="@Url.Action("Delete", "ShippingPoint", new { area = "Store" })"
                                pager="Compact"
                                confirm-destroy="true"
                                on-data-bound="bindShippingPointEditPopups">
                        <grid-text name="edit" value="@Loc["Admin.Common.Edit"]"/>
                        <grid-column field="ShippingPointName" title="@Loc["Shipping.ShippingPoint.Fields.ShippingPointName"]" width="200"/>
                        <grid-column field="OpeningHours" title="@Loc["Shipping.ShippingPoint.Fields.OpeningHours"]" width="200"/>
                        <grid-column field="PickupFee" title="@Loc["Shipping.ShippingPoint.Fields.PickupFee"]" width="150"/>
                        <grid-column field="Id" title="@Loc["Admin.Common.Edit"]" width="100">
                            <cell-template>
                                <a href="@Url.Action("Edit", "ShippingPoint", new { area = "Store" })?id={{ Id }}&btnId=btnRefresh&formId=shipping-instore-form" class='k-button editpopup k-button-icontext'>{{ $texts.edit }}</a>
                            </cell-template>
                        </grid-column>
                        <grid-commands destroy="true" title="@Loc["Admin.Common.Delete"]" width="100"/>
                    </admin-grid>
                </div>
                <div class="panel-footer">
                    <a id="btnAddNewOption" class="btn btn-primary" href="@(Url.Action("Create", "ShippingPoint", new { area = "Store" }) + "?btnId=btnRefresh&formId=shipping-instore-form")">
                        @Loc["Admin.Common.AddNew"]
                    </a>
                    <input type="submit" id="btnRefresh" class="btn btn-default" style="display: none"/>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            $('#btnAddNewOption').magnificPopup({
                type: 'ajax',
                settings: { cache: false, async: false },
                midClick: true,
                callbacks: {
                    parseAjax: function (mfpResponse) {
                        mfpResponse.data = $('<div></div>').html(mfpResponse.data);
                    },
                    ajaxContentAdded: function () {
                        $('.mfp-wrap').removeAttr('tabindex');
                    }
                }
            });
        });
        function bindShippingPointEditPopups() {
            $('.editpopup').magnificPopup({
                type: 'ajax',
                settings: { cache: false, async: false },
                midClick: true,
                callbacks: {
                    parseAjax: function (mfpResponse) {
                        mfpResponse.data = $('<div></div>').html(mfpResponse.data);
                    },
                    ajaxContentAdded: function () {
                        $('.mfp-wrap').removeAttr('tabindex');
                    }
                }
            });
        }
    </script>

    <script>
        $(document).ready(function () {
            $('#btnRefresh').click(function () {
                var grid = $("#shipping-points-grid").data('kendoGrid');
                grid.dataSource.read();
                return false;
            });
        });
    </script>
</form>
