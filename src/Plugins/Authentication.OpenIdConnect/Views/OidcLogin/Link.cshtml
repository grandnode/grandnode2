@model Authentication.OpenIdConnect.Models.LinkModel
@{
    Layout = "_SingleColumn";
}
<div class="page oidc-link-page">
    <div class="page-title"><h1>@Loc["Plugins.ExternalAuth.OpenIdConnect.Link.Title"]</h1></div>
    <div class="page-body">
        <p>@string.Format(Loc["Plugins.ExternalAuth.OpenIdConnect.Link.Text"], Model.Email)</p>
        @if (Model.SignedIn)
        {
            <a href="@Model.CompleteUrl" class="btn btn-primary">@Loc["Plugins.ExternalAuth.OpenIdConnect.Link.Title"]</a>
        }
        else
        {
            <a href="@Model.LoginUrl" class="btn btn-primary">@Loc["Plugins.ExternalAuth.OpenIdConnect.Link.SignIn"]</a>
        }
    </div>
</div>
