@model Authentication.OpenIdConnect.Models.ConfigurationModel
@{
    Layout = "_AdminLayout";
    ViewBag.Title = "OpenID Connect";
}

<input id="active-menu-item" type="hidden" value="/Admin/ExternalAuthentication/Methods"/>
@* the identity provider and the client come from appsettings and are shown read-only; the secret is never shown *@
<form asp-controller="OidcLoginSettings" asp-area="Admin" asp-action="Configure" method="post">
    <admin-page title="OpenID Connect" icon="bi-person-badge">
        <page-actions>
            <button type="submit" name="save" class="btn btn-primary">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
        </page-actions>

        <div class="note note-info">
            @Html.Raw(Loc["Plugins.ExternalAuth.OpenIdConnect.Description"])
        </div>
        <admin-card>
            <div class="grand-fields grand-fields--2col">
                <admin-field asp-for="Authority">
                    <input asp-for="Authority" type="text" disabled class="form-control text-box single-line"/>
                </admin-field>
                <admin-field asp-for="ClientId">
                    <input asp-for="ClientId" type="text" disabled class="form-control text-box single-line"/>
                </admin-field>
                <admin-field asp-for="ClientSecret">
                    <input asp-for="ClientSecret" type="text" disabled class="form-control text-box single-line"/>
                </admin-field>
                <admin-field asp-for="DisplayOrder" size="sm"/>
            </div>
        </admin-card>
    </admin-page>
</form>
