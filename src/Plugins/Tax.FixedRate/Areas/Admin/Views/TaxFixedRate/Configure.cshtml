@{
    Layout = "_ConfigurePlugin";
}
<input id="active-menu-item" type="hidden" value="/Admin/Tax/Providers"/>
<admin-grid id="tax-categories-grid"
            key="TaxCategoryId"
            read-url="@Url.Action("Configure", "TaxFixedRate")"
            update-url="@Url.Action("TaxRateUpdate", "TaxFixedRate")"
            pager="Compact"
            edit-mode="Inline">
    <grid-column field="TaxCategoryName" title="@Loc["Plugins.Tax.FixedRate.Fields.TaxCategoryName"]" width="400"/>
    <grid-column field="Rate" title="@Loc["Plugins.Tax.FixedRate.Fields.Rate"]" width="200" editor="Numeric" decimals="8"/>
    <grid-commands edit="true" title="@Loc["Admin.Common.Edit"]" width="150"/>
</admin-grid>
