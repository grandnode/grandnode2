@model Authentication.Google.Models.ConfigurationModel
@{
    Layout = "_AdminLayout";
    ViewBag.Title = "Google authentication";
}

<input id="active-menu-item" type="hidden" value="/Admin/ExternalAuthentication/Methods"/>
@* the setup steps (their own heading comes from the Title resource) stay a note; the client key
   and secret come from App_Settings.json and are shown read-only. The page title is the plugin's
   friendly name, which _ConfigurePlugin used to print *@
<form asp-controller="GoogleAuthenticationSettings" asp-area="Admin" asp-action="Configure" method="post">
    <admin-page title="Google authentication" icon="bi-google">
        <page-actions>
            <button type="submit" name="save" class="btn btn-primary">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
        </page-actions>

        <div class="note note-info">
            @Html.Raw(Loc["Plugins.ExternalAuth.Google.Title"])
            @Html.Raw(Loc["Plugins.ExternalAuth.Google.Description"])
            <p>
                To edit google settings in the grandnode application, please open the file App_Settings.json,
                find section GoogleSettings and enter the correct values.
            </p>
        </div>
        <admin-card>
            <div class="grand-fields grand-fields--2col">
                <admin-field asp-for="ClientKeyIdentifier">
                    <input asp-for="ClientKeyIdentifier" type="text" disabled class="form-control text-box single-line"/>
                </admin-field>
                <admin-field asp-for="ClientSecret">
                    <input asp-for="ClientSecret" type="text" disabled class="form-control text-box single-line"/>
                </admin-field>
                <admin-field asp-for="DisplayOrder" size="sm"/>
            </div>
        </admin-card>
    </admin-page>
</form>
