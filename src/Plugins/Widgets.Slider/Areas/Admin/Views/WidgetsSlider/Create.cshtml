@model SlideModel
@{
    //page title
    ViewBag.Title = Loc["Widgets.Slider.AddNew"];
    Layout = "_AdminLayout";
}
@* the detail screen's shell: Save as the one primary action, Save and continue beside it, the
   back link to the slide list under the title *@
<form asp-controller="WidgetsSlider" asp-action="Create" method="post" id="slider-form">
    <admin-page sticky
                title="@Loc["Widgets.Slider.AddNew"]"
                icon="bi-diagram-3"
                back-url="@Url.Action("Configure")"
                back-text="@Loc["Widgets.Slider.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
        </page-actions>

        <partial name="_CreateOrUpdate.cshtml" model="Model"/>
    </admin-page>
</form>
