@model ConfigurationModel
@{
    Layout = "_AdminLayout";
    //page title
    ViewBag.Title = Loc["Widgets.Slider.Manage"];
}
@* a list screen: Add new as the one primary action, the slides in a flush card, then the widget's
   own settings in a card of their own (saved by their own button, see _Settings) *@
<admin-page title="@Loc["Widgets.Slider.Manage"]" icon="bi-diagram-3">
    <page-actions>
        <a href="@Url.Action("Create", "WidgetsSlider")" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> @Loc["Admin.Common.AddNew"]
        </a>
    </page-actions>

    <admin-card flush>
        <admin-grid id="slider-grid"
                    read-url="@Url.Action("List", "WidgetsSlider")"
                    destroy-url="@Url.Action("Delete", "WidgetsSlider")"
                    confirm-destroy="true">
            <grid-column field="PictureUrl" title="@Loc["Widgets.Slider.Fields.Picture"]" width="200">
                <cell-template>
                    <span data-if="PictureUrl"><a href="{{ PictureUrl }}" target="_blank"><img src="{{ PictureUrl }}" width="150" /></a></span>
                </cell-template>
            </grid-column>
            <grid-column field="Name" title="@Loc["Widgets.Slider.Fields.Title"]" width="300">
                <cell-template>
                    <a class="text-decoration-none" href="Edit/{{ Id }}">{{ Name }}</a>
                </cell-template>
            </grid-column>
            <grid-column field="Link" title="@Loc["Widgets.Slider.Fields.Link"]" width="150"/>
            <grid-column field="ObjectType" title="@Loc["Widgets.Slider.Fields.ObjectType"]" width="150"/>
            <grid-column field="DisplayOrder" title="@Loc["Widgets.Slider.Fields.DisplayOrder"]" width="100" align="Center"/>
            <grid-column field="Published" title="@Loc["Widgets.Slider.Fields.Published"]" width="100" align="Center" min-screen-width="500">
                <cell-template>
                    <i data-if="Published" class="bi bi-check-lg text-success" aria-hidden="true"></i>
                    <i data-else class="bi bi-x-lg text-danger" aria-hidden="true"></i>
                </cell-template>
            </grid-column>
            <grid-commands destroy="true" width="200"/>
        </admin-grid>
    </admin-card>
    <partial name="_Settings.cshtml" model="Model"/>
</admin-page>
