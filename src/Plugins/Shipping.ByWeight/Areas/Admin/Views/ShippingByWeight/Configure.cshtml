@model Shipping.ByWeight.Models.ShippingByWeightListModel
@{
    Layout = "_AdminLayout";
    ViewBag.Title = Loc["Shipping.ByWeight.FriendlyName"];
}
<input id="active-menu-item" type="hidden" value="/Admin/Shipping/Providers"/>
@* the rates grid in a flush card with Add record in its header, then the general settings; Save
   (which posts those settings through the #savegeneralsettings script) is the one primary action.
   The form still wraps everything the script serializes *@
<form asp-controller="ShippingByWeight" asp-action="Configure" method="post" id="shipping-byweight-form">
    @{
        var addNewUrl = Url.Action("AddPopup", "ShippingByWeight", new { btnId = "btnRefresh", formId = "shipping-byweight-form" });
    }
    <admin-page title="@Loc["Shipping.ByWeight.FriendlyName"]" icon="bi-truck">
        <page-actions>
            <button type="button" id="savegeneralsettings" class="btn btn-primary">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
        </page-actions>

        <div class="note note-info">
            <strong>@Loc["Plugins.Shipping.ByWeight.Formula"]:</strong>
            @Loc["Plugins.Shipping.ByWeight.Formula.Value"]
        </div>

        <admin-card flush>
            <card-actions>
                <a id="btnAddNewOption" href="@(addNewUrl)" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-plus-lg"></i> @Loc["Plugins.Shipping.ByWeight.AddRecord"]
                </a>
                <input type="submit" id="btnRefresh" style="display: none"/>
            </card-actions>
            <admin-grid id="shipping-byweight-grid"
                        read-url="@Url.Action("RatesList", "ShippingByWeight")"
                        destroy-url="@Url.Action("RateDelete", "ShippingByWeight")"
                        on-data-bound="bindShippingByWeightEditPopups">
                <grid-column field="StoreName" title="@Loc["Plugins.Shipping.ByWeight.Fields.Store"]" width="300"/>
                <grid-column field="WarehouseName" title="@Loc["Plugins.Shipping.ByWeight.Fields.Warehouse"]" width="300"/>
                <grid-column field="CountryName" title="@Loc["Plugins.Shipping.ByWeight.Fields.Country"]" width="200"/>
                <grid-column field="StateProvinceName" title="@Loc["Plugins.Shipping.ByWeight.Fields.StateProvince"]" width="200"/>
                <grid-column field="Zip" title="@Loc["Plugins.Shipping.ByWeight.Fields.Zip"]" width="200"/>
                <grid-column field="ShippingMethodName" title="@Loc["Plugins.Shipping.ByWeight.Fields.ShippingMethod"]" width="200"/>
                @*DataHtml is markup the plugin builds from the rate values*@
                <grid-column field="DataHtml" title="@Loc["Plugins.Shipping.ByWeight.Fields.DataHtml"]" width="200" encoded="false"/>
                <grid-column field="Id" title="@Loc["Admin.Common.Edit"]" width="100">
                    <cell-template>
                        <a href="@Url.Action("EditPopup", "ShippingByWeight")?id={{ Id }}&btnId=btnRefresh&formId=shipping-byweight-form" class="btn btn-outline-secondary btn-sm editpopup">@Loc["Admin.Common.Edit"]</a>
                    </cell-template>
                </grid-column>
                <grid-commands destroy="true" title="@Loc["Admin.Common.Delete"]" width="100"/>
            </admin-grid>
        </admin-card>

        <admin-card>
            <div class="grand-fields grand-fields--2col">
                <admin-field asp-for="LimitMethodsToCreated"/>
                <admin-field asp-for="DisplayOrder" size="sm"/>
            </div>
        </admin-card>
    </admin-page>
    <script>
        $(document).ready(function () {
            $('#btnAddNewOption').magnificPopup({
                type: 'ajax',
                settings: { cache: false, async: false },
                midClick: true,
                callbacks: {
                    parseAjax: function (mfpResponse) {
                        mfpResponse.data = $('<div></div>').html(mfpResponse.data);
                    },
                    ajaxContentAdded: function () {
                        $('.mfp-wrap').removeAttr('tabindex');
                    }
                }
            });
        });
    </script>

    <script>
        function bindShippingByWeightEditPopups() {
            $('.editpopup').magnificPopup({
                type: 'ajax',
                settings: { cache: false, async: false },
                callbacks: {
                    parseAjax: function (mfpResponse) {
                        mfpResponse.data = $('<div></div>').html(mfpResponse.data);
                    },
                    ajaxContentAdded: function () {
                        $('.mfp-wrap').removeAttr('tabindex');
                    }
                }
            });
        }

        $(document).ready(function () {
            $('#btnRefresh').click(function () {
                //refresh grid
                var grid = GrandAdmin.grids.get("#shipping-byweight-grid");
                //grid.dataSource.page(1); //new search. Set page size to 1
                grid.dataSource.read();

                //return false to don't reload a page
                return false;
            });
        });
    </script>

        <script>
    $(function () {
        $('#savegeneralsettings').click(function () {

            var postData = $(this.form).serialize();
            addAntiForgeryToken(postData);

            $.ajax({
                cache: false,
                type: 'POST',
                url: '@Url.Action("SaveGeneralSettings", "ShippingByWeight")',
                data: postData,
                dataType: 'json',
                success: function (data) {
                    alert('Saved');
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    alert('Failed to add record.');
                }
            });
            return false;
        });
    });
        </script>
</form>
