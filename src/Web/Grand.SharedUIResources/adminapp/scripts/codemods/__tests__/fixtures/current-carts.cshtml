@inject AdminAreaSettings adminAreaSettings

<div id="carts-grid"></div>
<script>
$(document).ready(function() {
    $("#carts-grid").kendoGrid({
        dataSource: {
            transport: {
                read: {
                    url: "@Html.Raw(Url.Action("CurrentCarts", "ShoppingCart", new { area = Constants.AreaAdmin }))",
                    type: "POST",
                    dataType: "json",
                    data: addAntiForgeryToken
                }
            },
            schema: { data: "Data", total: "Total", errors: "Errors" },
            error: function(e) {
                display_kendoui_grid_error(e);
                // Cancel the changes
                this.cancelChanges();
            },
            pageSize: @(adminAreaSettings.DefaultGridPageSize),
            serverPaging: true,
            serverFiltering: true,
            serverSorting: true
        },
        pageable: { refresh: true, pageSizes: [@(adminAreaSettings.GridPageSizes)] },
        detailInit: detailInitCart,
        scrollable: false,
        columns: [
            {
                field: "CustomerId",
                title: "@Loc["Admin.CurrentCarts.Customer"]",
                template: '<a href="@Url.Action("Edit", "Customer", new { area = Constants.AreaAdmin })/#=CustomerId#">#:CustomerEmail#</a>'
            },
            @if (!adminAreaSettings.HideStoreColumn)
            {
                <text>
                {
                    field: "Store",
                    title: "@Loc["Admin.CurrentCarts.Store"]",
                    width: 150
                },
                </text>
            }
            {
                field: "TotalItems",
                title: "@Loc["Admin.CurrentCarts.TotalItems"]",
                width: 150
            }
        ]
    });
});

function detailInitCart(e) {
    $("<div/>").appendTo(e.detailCell).kendoGrid({
        dataSource: {
            transport: {
                read: {
                    url: "@Html.Raw(Url.Action("GetCartDetails", "ShoppingCart", new { area = Constants.AreaAdmin }))?customerId=" + e.data.CustomerId,
                    type: "POST",
                    dataType: "json",
                    data: addAntiForgeryToken
                }
            },
            schema: { data: "Data", total: "Total", errors: "Errors" }
        },
        columns: [
            {
                field: "ProductName",
                template: '#:ProductName#' + '# if(AttributeInfo && AttributeInfo.length > 0) {# <br />#=AttributeInfo# #} #'
            }
        ]
    });
}

function reload() {
    $("#carts-grid").data("kendoGrid").dataSource.read();
    //$("#old-grid").kendoGrid({ columns: [] });
}
</script>
