@using Grand.Web.Common.Security.Authorization
@using Grand.Domain.Permissions
@using Grand.SharedKernel.Extensions

@model string
@inject IRequestPermissionService permissionService
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery antiforgery
@{
    var allowFileman = await permissionService.Authorize(StandardPermission.HtmlEditorManagePictures);
    var random = CommonHelper.GenerateRandomInteger();
    //the editor is not always rendered inside a form, so the token comes from IAntiforgery
    //(which also issues the cookie) rather than from a __RequestVerificationToken input
    var requestToken = antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<div id="s-@(random)-summernote" class="summernote" data-name="null" data-file="null" data-format="null">
    @Html.Raw(ViewData.TemplateInfo.FormattedModelValue)
</div>
@Html.TextArea(string.Empty, /* Name suffix */
    ViewData.TemplateInfo.FormattedModelValue /* Initial value */
)
<script>
    function fileManager@(random)() {
        GrandAdmin.fileManager.open({
            urls: {
                list: '@Url.Action("List", "FileManager", new { area = "Admin" })',
                upload: '@Url.Action("Upload", "FileManager", new { area = "Admin" })',
                createFolder: '@Url.Action("CreateFolder", "FileManager", new { area = "Admin" })',
                rename: '@Url.Action("Rename", "FileManager", new { area = "Admin" })',
                delete: '@Url.Action("Delete", "FileManager", new { area = "Admin" })'
            },
            token: '@requestToken',
            texts: @Json.Serialize(new {
                title = Loc["Admin.FileManager.Picture"].Value,
                up = Loc["Admin.FileManager.Up"].Value,
                newFolder = Loc["Admin.FileManager.NewFolder"].Value,
                upload = Loc["Admin.FileManager.Upload"].Value,
                rename = Loc["Admin.FileManager.Rename"].Value,
                delete = Loc["Admin.Common.Delete"].Value,
                insert = Loc["Admin.FileManager.Insert"].Value,
                cancel = Loc["Admin.Common.Cancel"].Value,
                ok = Loc["Admin.Common.Save"].Value,
                empty = Loc["Admin.FileManager.Empty"].Value,
                root = Loc["Admin.FileManager.Root"].Value,
                folderName = Loc["Admin.FileManager.FolderName"].Value,
                newName = Loc["Admin.FileManager.NewName"].Value,
                deleteConfirm = Loc["Admin.FileManager.DeleteConfirm"].Value,
                deleteFolderConfirm = Loc["Admin.FileManager.DeleteFolderConfirm"].Value,
                uploading = Loc["Admin.FileManager.Uploading"].Value,
                failed = Loc["Admin.FileManager.Error.Failed"].Value
            }),
            onPick: function (file) {
                var editor = $('#s-@(random)-summernote');
                if (file.kind === 'video') {
                    var node = document.createElement('iframe');
                    node.src = file.url;
                    editor.summernote('editor.insertNode', node);
                } else if (file.kind === 'image') {
                    editor.summernote('editor.insertImage', file.url);
                } else {
                    editor.summernote('editor.createLink', {
                        text: file.name,
                        url: file.url,
                        isNewWindow: false
                    });
                }
            }
        });
    }
</script>
<script>
    $(document).ready(function () {
         var FileManager = function (context) {
            var ui = $.summernote.ui;
            // create button
            var button = ui.button({
                contents: '<i class="note-icon-picture"/>',
                tooltip: '@Loc["Admin.FileManager.Picture"]',
                click: function () {
                    fileManager@(random)();
                }
            });
            return button.render();   // return button as jquery object
        }

        $('#s-@(random)-summernote').summernote({
            toolbar: [
                ['style', ['style']],
                ['font', ['bold', 'underline', 'clear']],
                ['fontname', ['fontname']],
                ['color', ['color']],
                ['para', ['ul', 'ol', 'paragraph']],
                ['table', ['table']],
                ['insert', ['link', 'image', 'filemanager', 'hr']],
                ['view', ['fullscreen', 'codeview', 'help']],
            ],
            buttons: {
                @if (allowFileman)
                {
                    <text> filemanager: FileManager, </text>
                }
            },
            callbacks: {
                    onChange: function (contents) {
                            var textarea = this.nextSibling.nextElementSibling;
                            textarea.value = contents;
                        },
            },
        });
    });
</script>