@using System.Text.Json
@model string
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    //GrandAdmin.select (adminapp/src/ui/select.js, Tom Select) in place of the Kendo
    //DropDownList: this input is hidden and keeps posting the chosen Id
    var options = JsonSerializer.Serialize(new {
        url = Url.Action("Brand", "Search", new { area, brandId = Model }),
        placeholder = "Select brand...",
        textField = "Name",
        valueField = "Id",
        filter = "startswith"
    });
}
@Html.TextBoxFor(model => model, new { @class = "col-md-12", style = "width: 100%;", data_grand_select = options })
