@model DateTime
@{
    var time = Model > DateTime.MinValue ? Model : DateTime.Today;
}
<input id="@Html.IdForModel()" name="@Html.NameForModel()" value="@time.ToString("HH:mm")" data-grand-date="time"
       data-grand-date-value="@time.ToString("yyyy-MM-ddTHH:mm:ss", CultureInfo.InvariantCulture)"/>
