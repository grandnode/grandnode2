@using System.Text.Json
@model string
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var options = JsonSerializer.Serialize(new {
        url = Url.Action("Vendor", "Search", new { area, vendorId = Model }),
        placeholder = "Select vendor...",
        textField = "Name",
        valueField = "Id",
        filter = "startswith"
    });
}
@Html.TextBoxFor(model => model, new { @class = "col-md-12", style = "width: 100%;", data_grand_select = options })
