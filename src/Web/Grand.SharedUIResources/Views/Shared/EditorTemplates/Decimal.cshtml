@model decimal
@*GrandAdmin.numeric (adminapp/src/ui/numeric.js) in place of the Kendo NumericTextBox:
    this input is hidden and keeps posting the value in the request culture.*@
<input asp-for="@Model" data-grand-numeric='{"format":"n2","decimals":2}'/>
<script>
    $(document).ready(function() {
       try {
        $("#@Html.IdForModel()").rules("remove", 'number');
       }
       catch {}
    });
</script>
