@using System.Text.Json
@using Grand.Infrastructure.Configuration
@model string[]
@inject AccessControlConfig AccessControlConfig;
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var warnings = true;
    if (ViewData["DisableIgnoreAclWarnings"] != null)
    {
        warnings = !(bool)ViewData["DisableIgnoreAclWarnings"];
    }
    var options = JsonSerializer.Serialize(new {
        mode = "multiple",
        url = Url.Action("CustomerGroup", "Search", new { area, customerGroups = Model }),
        textField = "Name",
        valueField = "Id",
        filter = "startswith",
        values = Model ?? []
    });
}
@Html.ListBoxFor(model => model, new List<SelectListItem>(), new { data_grand_select = options })
@if (AccessControlConfig.IgnoreAcl && warnings)
{
    <div class="note note-info">@Loc["Admin.System.Warnings.IgnoreAcl"]</div>
}
