@using Microsoft.AspNetCore.Mvc.Razor
@model NewsItemModel

@{
    Func<int, HelperResult>
        template = @<div class="form-group">
            <label class="form-label">@Loc["Admin.Content.News.NewsItems.Fields.Title"]</label>
            <input asp-for="@Model.Locales[item].Title" class="form-control"/>
            <span asp-validation-for="@Model.Locales[item].Title" class="text-danger"></span>
            
            <label class="form-label mt-3">@Loc["Admin.Content.News.NewsItems.Fields.Short"]</label>
            <textarea asp-for="@Model.Locales[item].Short" class="form-control" rows="3"></textarea>
            <span asp-validation-for="@Model.Locales[item].Short" class="text-danger"></span>
            
            <label class="form-label mt-3">@Loc["Admin.Content.News.NewsItems.Fields.Full"]</label>
            <textarea asp-for="@Model.Locales[item].Full" class="form-control" rows="10"></textarea>
            <span asp-validation-for="@Model.Locales[item].Full" class="text-danger"></span>
            
            <input asp-for="Locales[item].LanguageId" type="hidden"/>
        </div>;
}

<div class="form-horizontal">
    <div class="row">
        <div class="col-md-12">
            <localized-editor localized-template="@template" name="newsitem-info-localized" language-ids="@Model.Locales.Select(c => c.LanguageId).ToList()">
                <div class="form-group">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control"/>
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Short" class="form-label"></label>
                    <textarea asp-for="Short" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Short" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Full" class="form-label"></label>
                    <textarea asp-for="Full" class="form-control" rows="10"></textarea>
                    <span asp-validation-for="Full" class="text-danger"></span>
                </div>
            </localized-editor>
            
            <div class="form-group">
                <label asp-for="PictureId" class="form-label"></label>
                <input asp-for="PictureId" class="form-control"/>
                <span asp-validation-for="PictureId" class="text-danger"></span>
            </div>
            
            <div class="form-check">
                <input asp-for="AllowComments" class="form-check-input"/>
                <label asp-for="AllowComments" class="form-check-label"></label>
                <span asp-validation-for="AllowComments" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="StartDate" class="form-label"></label>
                <input asp-for="StartDate" class="form-control" type="datetime-local"/>
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="EndDate" class="form-label"></label>
                <input asp-for="EndDate" class="form-control" type="datetime-local"/>
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>
            
            <div class="form-check">
                <input asp-for="Published" class="form-check-input"/>
                <label asp-for="Published" class="form-check-label"></label>
                <span asp-validation-for="Published" class="text-danger"></span>
            </div>
        </div>
    </div>
</div>