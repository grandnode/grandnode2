@model NewsItemModel
@{
    ViewBag.Title = T("Admin.Content.News.NewsItems.EditNewsItemDetails");
    Layout = Constants.LayoutStore;
}

<form asp-area="Store" asp-controller="News" asp-action="Edit" method="post">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fa fa-edit"></i>
                        @T("Admin.Content.News.NewsItems.EditNewsItemDetails") - @Model.Title
                    </h3>
                    <div class="card-tools">
                        <a href="@Url.Action("List")" class="btn btn-secondary btn-sm">
                            <i class="fa fa-arrow-left"></i> @T("Admin.Content.News.NewsItems.BackToList")
                        </a>
                        <a href="@Url.Action("Preview", new { id = Model.Id })" class="btn btn-info btn-sm" target="_blank">
                            <i class="fa fa-eye"></i> @T("Admin.Common.Preview")
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <partial name="Partials/CreateOrUpdate" model="Model"/>
                </div>
                <div class="card-footer">
                    <div class="float-left">
                        <button type="button" class="btn btn-danger" onclick="deleteNews()">
                            <i class="fa fa-trash"></i> @T("Admin.Common.Delete")
                        </button>
                    </div>
                    <div class="float-right">
                        <button class="btn btn-success" type="submit" name="save">
                            <i class="fa fa-check"></i> @T("Admin.Common.Save")
                        </button>
                        <button class="btn btn-info" type="submit" name="save-continue">
                            <i class="fa fa-check-circle"></i> @T("Admin.Common.SaveContinue")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<script>
    function deleteNews() {
        if (confirm('@T("Admin.Common.AreYouSure")')) {
            var postData = {
                id: '@Model.Id'
            };
            addAntiForgeryToken(postData);
            
            $.ajax({
                cache: false,
                type: "POST",
                url: "@(Url.Action("Delete", "News"))",
                data: postData,
                success: function (data) {
                    window.location = '@Url.Action("List")';
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    alert('Failed to delete news item');
                }
            });
        }
    }
</script>