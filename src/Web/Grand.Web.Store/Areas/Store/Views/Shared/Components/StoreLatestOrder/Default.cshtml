@inject AdminAreaSettings adminAreaSettings

<admin-grid id="latest-orders-grid"
            read-url="@Url.Action("OrderList", "Order", new { area = Constants.AreaStore })"
            additional-data="latestOrdersAdditionalData"
            page-size="5"
            page-sizes="5,10,15">
    <grid-column field="OrderNumber" title="@Loc["Admin.Orders.Fields.Id"]" width="50">
        <cell-template>
            <a class="k-link" href="Store/Order/Edit/{{ Id }}">{{ OrderNumber }}</a>
        </cell-template>
    </grid-column>
    <grid-column field="CustomerEmail" title="@Loc["Admin.Orders.Fields.Customer"]" width="300">
        <cell-template>
            <a class="k-link" href="@Url.Action("Edit", "Customer", new { area = Constants.AreaStore })/{{ CustomerId }}">{{ CustomerFullName }} ({{ CustomerEmail }})</a>
        </cell-template>
    </grid-column>
    @if (!adminAreaSettings.HideStoreColumn)
    {
        <grid-column field="StoreName" title="@Loc["Admin.Orders.Fields.Store"]" width="200" align="Center"/>
    }
    <grid-column field="PaymentStatus" title="@Loc["Admin.Orders.Fields.PaymentStatus"]" width="120" align="Center"/>
    <grid-column field="OrderTotal" title="@Loc["Admin.Orders.Fields.OrderTotal"]" width="200" align="Center"/>
    <grid-column field="CreatedOn" title="@Loc["Admin.Orders.Fields.CreatedOn"]" width="200" align="Center" format="{0:G}"/>
</admin-grid>

<script>
    //the Kendo grid kept the response ExtraData in a reportAggregates global that no dashboard script reads
    function latestOrdersAdditionalData() {
        var data = {
            startdate: $('#dashboard-report-range').data('daterangepicker').startDate.format('YYYY-MM-DD'),
            endDate: $('#dashboard-report-range').data('daterangepicker').endDate.format('YYYY-MM-DD'),
        };
        addAntiForgeryToken(data);
        return data;
    }
</script>
