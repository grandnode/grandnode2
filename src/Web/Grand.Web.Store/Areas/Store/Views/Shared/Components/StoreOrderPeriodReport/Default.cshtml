<admin-grid id="order-period-grid"
            read-url="@Url.Action("ReportOrderPeriodList", "Reports", new { area = Constants.AreaStore })"
            pager="Compact">
    <grid-column field="Period" title="@Loc["Admin.Reports.Period.Name"]"/>
    <grid-column field="Count" title="@Loc["Admin.Reports.Period.Count"]" width="50"/>
    <grid-column field="Amount" title="@Loc["Admin.Reports.Period.Amount"]" width="150"/>
</admin-grid>
