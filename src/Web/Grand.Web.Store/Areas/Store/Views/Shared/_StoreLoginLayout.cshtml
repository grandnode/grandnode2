@using Constants = Grand.SharedUIResources.Constants
@using Grand.Web.AdminShared.Models.Common
@model LoginModel
@{
    //page title
    Layout = "";
}
@{
    //page title
    var adminPageTitle = "";
    if (!string.IsNullOrWhiteSpace(ViewBag.Title))
    {
        adminPageTitle = ViewBag.Title + " / ";
    }

    adminPageTitle += Loc["Admin.Login.PageTitle"];
}

<!DOCTYPE html>
<html>
<head>
    <title>@adminPageTitle</title>
    <meta http-equiv="Content-type" content="text/html;charset=UTF-8"/>
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">

    <link rel="stylesheet" type="text/css" href="@(Constants.WwwRoot)/administration/bundles/admin.bootstrap.css" asp-append-version="true"/>

    <script src="@(Constants.WwwRoot)/administration/build/js/jquery.min.js"></script>
    <script src="@(Constants.WwwRoot)/administration/build/js/moment.min.js"></script>
    <script src="@(Constants.WwwRoot)/administration/jquery.validate.min.js"></script>
    <script src="@(Constants.WwwRoot)/administration/jquery.validate.unobtrusive.min.js"></script>
    <script src="@(Constants.WwwRoot)/administration/jquery-ui/jquery-ui.min.js"></script>
    <script src="@(Constants.WwwRoot)/administration/bundles/admin.bootstrap.js"></script>
</head>
<body>
@Html.AntiForgeryToken()
<div class="container body admin-login-layout">
    <div class="main_container">
        @RenderBody()
    </div>
</div>
</body>
</html>