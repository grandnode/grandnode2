@model AddressAttributeStoreModel

<div asp-validation-summary="All"></div>
<input asp-for="Id" type="hidden"/>

<admin-tabstrip name="addressattribute-edit">
    <items>
        <tabstrip-item text="@Loc["Admin.Address.AddressAttributes.Info"]" tab-index="0">
            <content>
                <div>
                    <partial name="Partials/CreateOrUpdate.TabInfo" model="Model"/>
                </div>
            </content>
        </tabstrip-item>
        <tabstrip-item text="@Loc["Admin.Address.AddressAttributes.Values"]" tab-index="1" id="tab-addressattributesvalues">
            <content>
                <div>
                    <partial name="Partials/CreateOrUpdate.TabValues" model="Model"/>
                </div>
            </content>
        </tabstrip-item>
    </items>
</admin-tabstrip>
