@inject IContextAccessor contextAccessor
@{
    //page title
    ViewBag.Title = Loc["Admin.Dashboard.Statistics"];
}

<div class="grand-dashboard">
    <header class="grand-dashboard__header">
        <div>
            <h1 class="grand-dashboard__title">@Loc["Admin.Dashboard.Statistics"]</h1>
            <p class="grand-dashboard__subtitle">
                <i class="bi bi-shop" aria-hidden="true"></i>
                <span>@contextAccessor.StoreContext.CurrentStore.Name</span>
            </p>
        </div>
    </header>

    <vc:store-widget widget-zone="store_dashboard_statistics_before"/>
    <div class="row g-3">
        <div class="col-12 col-xl-6">
            <section class="grand-card h-100" aria-labelledby="statistics-bestsellers-quantity">
                <header class="grand-card__header">
                    <i class="bi bi-trophy grand-card__icon" aria-hidden="true"></i>
                    <h2 id="statistics-bestsellers-quantity" class="grand-card__title">@Loc["Admin.Reports.BestSellers.ByQuantity"]</h2>
                </header>
                <div class="grand-card__body">
                    <vc:store-bestsellers-brief-report-by-quantity></vc:store-bestsellers-brief-report-by-quantity>
                </div>
            </section>
        </div>
        <div class="col-12 col-xl-6">
            <section class="grand-card h-100" aria-labelledby="statistics-bestsellers-amount">
                <header class="grand-card__header">
                    <i class="bi bi-cash-coin grand-card__icon" aria-hidden="true"></i>
                    <h2 id="statistics-bestsellers-amount" class="grand-card__title">@Loc["Admin.Reports.BestSellers.ByAmount"]</h2>
                </header>
                <div class="grand-card__body">
                    <vc:store-bestsellers-brief-report-by-amount></vc:store-bestsellers-brief-report-by-amount>
                </div>
            </section>
        </div>
    </div>
    <vc:store-widget widget-zone="store_dashboard_statistics_after"/>
</div>
