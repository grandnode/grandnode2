@model PageModel
@using Grand.Web.Store.Extensions
@{
    ViewBag.Title = Loc["Store.Content.Pages.EditPageDetails"];
}

<form asp-area="@Constants.AreaStore" asp-controller="Page" asp-action="Edit" method="post">
    <input asp-for="Id" type="hidden"/>
    <input asp-for="IsSystemPage" type="hidden"/>
    
    <div class="row">
        <div class="col-md-12">
            <div class="x_panel light form-fit">
                <div class="x_title">
                    <div class="caption">
                        <i class="fa fa-fw fa-file-o"></i>
                        @Loc["Store.Content.Pages.EditPageDetails"] - @Model.SystemName
                        <small>
                            <i class="fa fa-arrow-circle-left"></i>@Html.ActionLink(Loc["Store.Content.Pages.BackToList"], "List")
                        </small>
                    </div>
                    <div class="actions">
                        <div class="btn-group btn-group-devided">
                            <button class="btn btn-success" type="submit" name="save">
                                <i class="fa fa-check"></i> @Loc["Store.Common.Save"]
                            </button>
                            <button class="btn btn-success" type="submit" name="save-continue">
                                <i class="fa fa-check-circle"></i> @Loc["Store.Common.SaveContinue"]
                            </button>
                            @if (!Model.IsSystemPage)
                            {
                                <button type="button" id="page-delete" class="btn red">
                                    <i class="fa fa-trash-o"></i> @Loc["Store.Common.Delete"]
                                </button>
                            }
                        </div>
                    </div>
                </div>
                <div class="x_content form">
                    @if (Model.IsSystemPage)
                    {
                        <div class="alert alert-info">
                            <i class="fa fa-info-circle"></i> @Loc["Store.Content.Pages.SystemPageInfo"]
                        </div>
                    }
                    <div class="form-horizontal">
                        <div class="form-body">
                            @if (!string.IsNullOrEmpty(Model.SystemName))
                            {
                                <div class="form-group">
                                    <label asp-for="SystemName" class="col-sm-3 control-label"></label>
                                    <div class="col-sm-9">
                                        <p class="form-control-static">@Model.SystemName</p>
                                    </div>
                                </div>
                            }
                            <div class="form-group">
                                <label asp-for="Title" class="col-sm-3 control-label"></label>
                                <div class="col-sm-9">
                                    <input asp-for="Title" class="form-control"/>
                                    <span asp-validation-for="Title" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="form-group">
                                <label asp-for="Body" class="col-sm-3 control-label"></label>
                                <div class="col-sm-9">
                                    <textarea asp-for="Body" class="form-control" rows="10"></textarea>
                                    <span asp-validation-for="Body" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="form-group">
                                <label asp-for="DisplayOrder" class="col-sm-3 control-label"></label>
                                <div class="col-sm-9">
                                    <input asp-for="DisplayOrder" class="form-control"/>
                                    <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="form-group">
                                <label asp-for="Published" class="col-sm-3 control-label"></label>
                                <div class="col-sm-9">
                                    <label class="mt-checkbox mt-checkbox-outline control control-checkbox">
                                        <input asp-for="Published" type="checkbox"/>
                                        <div class="control__indicator"></div>
                                    </label>
                                    <span asp-validation-for="Published" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@if (!Model.IsSystemPage)
{
    <form id="delete-form" asp-area="@Constants.AreaStore" asp-controller="Page" asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.Id"/>
    </form>
    
    <script>
        $(document).ready(function() {
            $('#page-delete').click(function() {
                if (confirm('@Loc["Store.Common.AreYouSure"]')) {
                    $('#delete-form').submit();
                }
            });
        });
    </script>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
