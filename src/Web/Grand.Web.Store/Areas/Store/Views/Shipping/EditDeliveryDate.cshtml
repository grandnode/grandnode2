@model DeliveryDateModel
@{
    ViewBag.Title = Loc["Admin.Configuration.Shipping.DeliveryDates.EditDeliveryDateDetails"];
    Layout = Constants.LayoutStore;
}
<form asp-area="@Constants.AreaStore" asp-controller="Shipping" asp-action="EditDeliveryDate" method="post">

    @* the record name as the title, Save as the one primary action, Delete in the overflow menu *@
    <admin-page sticky
                title="@Model.Name"
                icon="bi-card-list"
                meta="@Loc["Admin.Configuration.Shipping.DeliveryDates.EditDeliveryDateDetails"]"
                back-url="@Url.Action("DeliveryDates", "Shipping", new { area = Constants.AreaStore })"
                back-text="@Loc["Admin.Configuration.Shipping.DeliveryDates.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <admin-action-menu>
                <admin-action id="deliverydate-delete" destructive="true" icon="bi-trash"
                              text="@Loc["Admin.Common.Delete"]"/>
            </admin-action-menu>
        </page-actions>

        <partial name="Partials/CreateOrUpdateDeliveryDate" model="Model"/>
    </admin-page>
</form>
<admin-delete-confirmation button-id="deliverydate-delete" action-name="DeleteDeliveryDate"/>
