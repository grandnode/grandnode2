@model ShippingSettingsModel
@{
    ViewBag.Title = Loc["Admin.Configuration.Shipping.Settings"];
    Layout = Constants.LayoutStore;
}
<form asp-area="@Constants.AreaStore" asp-controller="Shipping" asp-action="Settings" method="post">

    <div asp-validation-summary="All"></div>
    <script>
    $(document).ready(function () {
        $("#@Html.IdFor(model => model.FreeShippingOverXEnabled)").click(toggleFreeShippingOverX);
            toggleFreeShippingOverX();
        });

        function toggleFreeShippingOverX() {
            if ($('#@Html.IdFor(model => model.FreeShippingOverXEnabled)').is(':checked')) {
            $('#pnlValueOfX').show();
            $('#pnlValueOfXincltax').show();
        } else {
            $('#pnlValueOfX').hide();
            $('#pnlValueOfXincltax').hide();
        }
    }
    </script>
    @* the switches in two columns, free shipping with the fields it opens right under it, and the
       origin address in a card of its own *@
    <admin-page sticky title="@Loc["Admin.Configuration.Shipping.Settings"]" icon="bi-sliders">
        <page-actions>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
        </page-actions>

        <admin-card>
            <div class="grand-fields grand-fields--2col">
                <admin-field asp-for="AllowPickUpInStore"/>
                <admin-field asp-for="EstimateShippingEnabled"/>
                <admin-field asp-for="DisplayShipmentEventsToCustomers"/>
                <admin-field asp-for="DisplayShipmentEventsToStoreOwner"/>
                <admin-field asp-for="SkipShippingMethodSelectionIfOnlyOne"/>
                <admin-field asp-for="AdditionalShippingChargeByQty"/>
                <div class="grand-reveal">
                    <admin-field asp-for="FreeShippingOverXEnabled"/>
                    <div class="grand-reveal__body grand-fields grand-fields--2col">
                        <admin-field asp-for="FreeShippingOverXValue" id="pnlValueOfX" size="md"/>
                        <admin-field asp-for="FreeShippingOverXIncludingTax" id="pnlValueOfXincltax"/>
                    </div>
                </div>
            </div>
        </admin-card>
        <admin-card title="@Loc["Admin.Configuration.Shipping.Settings.shippingoriginaddress"]">
            <div id="pnlShippingOriginAddress">
                <admin-input asp-for="ShippingOriginAddress" asp-template="Address"/>
            </div>
        </admin-card>
    </admin-page>
</form>
