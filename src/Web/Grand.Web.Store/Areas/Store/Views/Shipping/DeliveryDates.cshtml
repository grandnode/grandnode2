@{
    ViewBag.Title = Loc["Admin.Configuration.Shipping.DeliveryDates"];
    Layout = Constants.LayoutStore;
}

<admin-page title="@Loc["Admin.Configuration.Shipping.DeliveryDates"]" icon="bi-card-list">
    <page-actions>
        <a href="@Url.Action("CreateDeliveryDate", "Shipping", new { area = Constants.AreaStore })" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> @Loc["Admin.Common.AddNew"]
        </a>
    </page-actions>

    <admin-card flush>
        <admin-grid id="deliverydate-grid"
                    read-url="@Url.Action("DeliveryDatesListData", "Shipping", new { area = Constants.AreaStore })"
                    pager="Compact">
            <grid-column field="Name" title="@Loc["Admin.Configuration.Shipping.DeliveryDates.Fields.Name"]">
                <cell-template>
                    <a class="text-decoration-none" href="@Url.Action("EditDeliveryDate", "Shipping", new { area = Constants.AreaStore })/{{ Id }}">{{ Name }}</a>
                </cell-template>
            </grid-column>
            <grid-column field="DisplayOrder" title="@Loc["Admin.Configuration.Shipping.DeliveryDates.Fields.DisplayOrder"]" width="120"/>
        </admin-grid>
    </admin-card>
</admin-page>
