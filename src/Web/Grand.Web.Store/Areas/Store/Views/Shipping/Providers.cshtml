@{
    ViewBag.Title = Loc["Admin.Configuration.Shipping.Providers"];
    Layout = Constants.LayoutStore;
}

@* the grid edits inline, so there is no primary action on this screen *@
<admin-page title="@Loc["Admin.Configuration.Shipping.Providers"]" icon="bi-card-list">
    <admin-card flush>
        <admin-grid id="shippingproviders-grid"
                    key="SystemName"
                    read-url="@Url.Action("Providers", "Shipping", new { area = Constants.AreaStore })"
                    update-url="@Url.Action("ProviderUpdate", "Shipping", new { area = Constants.AreaStore })"
                    pager="Compact"
                    edit-mode="Inline">
            <grid-column field="FriendlyName" title="@Loc["Admin.Configuration.Shipping.Providers.Fields.FriendlyName"]" width="250">
                <cell-template>
                    <a data-if="ConfigurationUrl" class="text-decoration-none" href="{{ ConfigurationUrl }}">{{ FriendlyName }}</a>
                    <span data-else>{{ FriendlyName }}</span>
                </cell-template>
            </grid-column>
            <grid-column field="SystemName" title="@Loc["Admin.Configuration.Shipping.Providers.Fields.SystemName"]" width="250">
                <cell-template>
                    <a data-if="ConfigurationUrl" class="text-decoration-none" href="{{ ConfigurationUrl }}">{{ SystemName }}</a>
                    <span data-else>{{ SystemName }}</span>
                </cell-template>
            </grid-column>
            <grid-column field="DisplayOrder" title="@Loc["Admin.Configuration.Shipping.Providers.Fields.DisplayOrder"]" width="100" format="{0:0}"/>
            <grid-column field="IsActive" title="@Loc["Admin.Configuration.Shipping.Providers.Fields.IsActive"]" width="100" align="Center" editor="Checkbox">
                <cell-template>
                    <i data-if="IsActive" class="bi bi-check-lg text-success" aria-hidden="true"></i>
                    <i data-else class="bi bi-x-lg text-danger" aria-hidden="true"></i>
                </cell-template>
            </grid-column>
            <grid-commands edit="true" title="@Loc["Admin.Common.Edit"]" width="150"/>
        </admin-grid>
    </admin-card>
</admin-page>
