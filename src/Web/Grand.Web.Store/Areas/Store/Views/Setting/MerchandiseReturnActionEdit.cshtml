@model MerchandiseReturnActionModel
@{
    ViewBag.Title = Loc["Admin.Settings.Order.MerchandiseReturnActions.EditDetails"];
}
<form asp-area="@Constants.AreaStore" asp-controller="Setting" asp-action="MerchandiseReturnActionEdit" method="post">
    <div class="row">
        <div class="col-md-12">
            <div class="x_panel light form-fit">
                <div class="x_title">
                    <div class="caption">
                        <i class="bi bi-card-list"></i>
                        @Loc["Admin.Settings.Order.MerchandiseReturnActions.EditDetails"] - @Model.Name
                        <small>
                            <i class="bi bi-arrow-left-circle"></i>
                            <a href="@Url.Action("Sales", "Setting", new { area = Constants.AreaStore })">@Loc["Admin.Settings.Order.MerchandiseReturnActions.BackToList"]</a>
                        </small>
                    </div>
                    <div class="actions">
                        <div class="btn-group btn-group-devided util-btn-margin-bottom-5">
                            <button class="btn btn-success" type="submit" name="save">
                                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
                            </button>
                            <button class="btn btn-success" type="submit" name="save-continue">
                                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
                            </button>
                            <span id="merchandisereturnaction-delete" class="btn red">
                                <i class="bi bi-trash"></i> <span class="d-none d-sm-inline"> @Loc["Admin.Common.Delete"]</span>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="x_content form">
                    <partial name="Partials/CreateOrUpdate.MerchandiseReturnAction" model="Model"/>
                </div>
            </div>
        </div>
    </div>
</form>
<admin-delete-confirmation button-id="merchandisereturnaction-delete" action-name="MerchandiseReturnActionDelete"/>
