@model CatalogSettingsModel

<script>
    $(document).ready(function () {

        $("#@Html.IdFor(model => model.ShowCategoryProductNumber)").click(toggleShowCategoryProductNumberIncludingSubcategories);
        $("#@Html.IdFor(model => model.EmailAFriendEnabled)").click(toggleEmailAFriend);
        $("#@Html.IdFor(model => model.RecentlyViewedProductsEnabled)").click(toggleRecentlyViewedProducts);
        $("#@Html.IdFor(model => model.SuggestedProductsEnabled)").click(toggleSuggestedProducts);
        $("#@Html.IdFor(model => model.PersonalizedProductsEnabled)").click(togglePersonalizedProducts);
        $("#@Html.IdFor(model => model.NewProductsEnabled)").click(toggleNewProducts);
        $("#@Html.IdFor(model => model.NewProductsOnHomePage)").click(toggleNewProductsHomePage);
        $("#@Html.IdFor(model => model.ShowBestsellersOnHomepage)").click(toggleBestsellersOnHomepage);
        $("#@Html.IdFor(model => model.BestsellersFromReports)").click(toggleBestsellersFromReports);
        $("#@Html.IdFor(model => model.ProductsAlsoPurchasedEnabled)").click(toggleProductsAlsoPurchasedNumber);
        $("#@Html.IdFor(model => model.ProductsByTagAllowCustomersToSelectPageSize)").click(toggleProductsByTagPageSize);

        toggleShowCategoryProductNumberIncludingSubcategories();
        toggleEmailAFriend();
        toggleRecentlyViewedProducts();
        toggleSuggestedProducts();
        togglePersonalizedProducts();
        toggleNewProducts();
        toggleNewProductsHomePage();
        toggleBestsellersOnHomepage();
        toggleBestsellersFromReports();
        toggleProductsAlsoPurchasedNumber();
        toggleProductsByTagPageSize();
    });

    function toggleShowCategoryProductNumberIncludingSubcategories() {
        if ($('#@Html.IdFor(model => model.ShowCategoryProductNumber)').is(':checked')) {
            $('#pnlShowCategoryProductNumberIncludingSubcategories').show();
        }
        else {
            $('#pnlShowCategoryProductNumberIncludingSubcategories').hide();
        }
    }

    function toggleEmailAFriend() {
        if ($('#@Html.IdFor(model => model.EmailAFriendEnabled)').is(':checked')) {
            $('#pnlAllowAnonymousUsersToEmailAFriend').show();
        }
        else {
            $('#pnlAllowAnonymousUsersToEmailAFriend').hide();
        }
    }

    function toggleRecentlyViewedProducts() {
        if ($('#@Html.IdFor(model => model.RecentlyViewedProductsEnabled)').is(':checked')) {
            $('#pnlRecentlyViewedProductsNumber').show();
        }
        else {
            $('#pnlRecentlyViewedProductsNumber').hide();
        }
    }

    function toggleSuggestedProducts() {
        if ($('#@Html.IdFor(model => model.SuggestedProductsEnabled)').is(':checked')) {
            $('#pnlSuggestedProductsNumber').show();
        }
        else {
            $('#pnlSuggestedProductsNumber').hide();
        }
    }

    function togglePersonalizedProducts() {
        if ($('#@Html.IdFor(model => model.PersonalizedProductsEnabled)').is(':checked')) {
            $('#pnlPersonalizedProductsNumber').show();
        }
        else {
            $('#pnlPersonalizedProductsNumber').hide();
        }
    }

    function toggleNewProducts() {
        if ($('#@Html.IdFor(model => model.NewProductsEnabled)').is(':checked')) {
            $('#pnlNewProductsNumber').show();
        }
        else {
            $('#pnlNewProductsNumber').hide();
        }
    }

    function toggleNewProductsHomePage() {
        if ($('#@Html.IdFor(model => model.NewProductsOnHomePage)').is(':checked')) {
            $('#pnlNewProductsNumberOnHomePage').show();
        }
        else {
            $('#pnlNewProductsNumberOnHomePage').hide();
        }
    }
    function toggleBestsellersOnHomepage() {
        if ($('#@Html.IdFor(model => model.ShowBestsellersOnHomepage)').is(':checked')) {
            $('#pnlNumberOfBestsellersOnHomepage').show();
            $('#pnlBestsellersFromReports').show();
        }
        else {
            $('#pnlNumberOfBestsellersOnHomepage').hide();
            $('#pnlBestsellersFromReports').hide();
        }
    }
    function toggleBestsellersFromReports() {
        if ($('#@Html.IdFor(model => model.BestsellersFromReports)').is(':checked')) {
            $('#pnlPeriodBestsellers').show();
        }
        else {
            $('#pnlPeriodBestsellers').hide();
        }
    }

    function toggleProductsAlsoPurchasedNumber() {
        if ($('#@Html.IdFor(model => model.ProductsAlsoPurchasedEnabled)').is(':checked')) {
            $('#pnlProductsAlsoPurchasedNumber').show();
        }
        else {
            $('#pnlProductsAlsoPurchasedNumber').hide();
        }
    }

    function toggleProductsByTagPageSize() {
        if ($('#@Html.IdFor(model => model.ProductsByTagAllowCustomersToSelectPageSize)').is(':checked')) {
            $('#pnlProductsByTagPageSize').hide();
            $('#pnlProductsByTagPageSizeOptions').show();
        } else {
            $('#pnlProductsByTagPageSize').show();
            $('#pnlProductsByTagPageSizeOptions').hide();
        }
    }
</script>
@* the product page, the catalog pages, the product blocks each switch reveals the size of,
   then product tags. A page size is fixed while customers may not choose it and becomes a
   list of options once they may, so the two stand next to their switch in turn *@
<admin-card>
    <div class="grand-fields grand-fields--2col">
        <admin-field asp-for="AllowViewUnpublishedProductPage"/>
        <admin-field asp-for="DisplayDiscontinuedMessageForUnpublishedProducts"/>
        <admin-field asp-for="ShowSkuOnProductDetailsPage"/>
        <admin-field asp-for="ShowSkuOnCatalogPages"/>
        <admin-field asp-for="ShowMpn"/>
        <admin-field asp-for="ShowGtin"/>
        <admin-field asp-for="ShowFreeShippingNotification"/>
        <admin-field asp-for="AskQuestionOnProduct"/>
        <admin-field asp-for="DisplayTierPricesWithDiscounts"/>
        <admin-field asp-for="PublishBackProductWhenCancellingOrders"/>
        <admin-field asp-for="NumberOfReview" size="sm"/>
    </div>
</admin-card>
<admin-card>
    <div class="grand-fields grand-fields--2col">
        <admin-field asp-for="AllowProductSorting"/>
        <admin-field asp-for="SortingByAvailability"/>
        <admin-field asp-for="AllowProductViewModeChanging"/>
        <admin-field asp-for="DefaultViewMode" asp-items="Model.DefaultViewModes" size="md"/>
        <admin-field asp-for="ShowProductsFromSubcategories"/>
        <admin-field asp-for="ShowProductsFromSubcategoriesInSearchBox"/>
        <div class="grand-reveal">
            <admin-field asp-for="ShowCategoryProductNumber"/>
            <div class="grand-reveal__body grand-fields grand-fields--2col">
                <admin-field asp-for="ShowCategoryProductNumberIncludingSubcategories" id="pnlShowCategoryProductNumberIncludingSubcategories"/>
            </div>
        </div>
        <admin-field asp-for="CategoryBreadcrumbEnabled"/>
        <admin-field asp-for="ShowSpecAttributeOnCatalogPages"/>
        <admin-field asp-for="SecondPictureOnCatalogPages"/>
        <admin-field asp-for="IncludeFeaturedProductsInNormalLists"/>
        <admin-field asp-for="DisplayQuantityOnCatalogPages"/>
        <admin-field asp-for="DefaultPageSize" size="sm"/>
        <admin-field asp-for="DefaultPageSizeOptions" size="md"/>
        <admin-field asp-for="MaxCatalogPageSize" size="sm"/>
        <admin-field asp-for="LimitOfFeaturedProducts" size="sm"/>
        <admin-field asp-for="CollectionsBlockItemsToDisplay" size="sm"/>
    </div>
</admin-card>
<admin-card>
    <div class="grand-fields grand-fields--2col">
        <div class="grand-reveal">
            <admin-field asp-for="EmailAFriendEnabled"/>
            <div class="grand-reveal__body grand-fields grand-fields--2col">
                <admin-field asp-for="AllowAnonymousUsersToEmailAFriend" id="pnlAllowAnonymousUsersToEmailAFriend"/>
            </div>
        </div>
        <div class="grand-reveal">
            <admin-field asp-for="RecentlyViewedProductsEnabled"/>
            <div class="grand-reveal__body grand-fields grand-fields--2col">
                <admin-field asp-for="RecentlyViewedProductsNumber" id="pnlRecentlyViewedProductsNumber" size="sm"/>
            </div>
        </div>
        <admin-field asp-for="RecommendedProductsEnabled"/>
        <div class="grand-reveal">
            <admin-field asp-for="SuggestedProductsEnabled"/>
            <div class="grand-reveal__body grand-fields grand-fields--2col">
                <admin-field asp-for="SuggestedProductsNumber" id="pnlSuggestedProductsNumber" size="sm"/>
            </div>
        </div>
        <div class="grand-reveal">
            <admin-field asp-for="PersonalizedProductsEnabled"/>
            <div class="grand-reveal__body grand-fields grand-fields--2col">
                <admin-field asp-for="PersonalizedProductsNumber" id="pnlPersonalizedProductsNumber" size="sm"/>
            </div>
        </div>
        <div class="grand-reveal">
            <admin-field asp-for="NewProductsEnabled"/>
            <div class="grand-reveal__body grand-fields grand-fields--2col">
                <admin-field asp-for="NewProductsNumber" id="pnlNewProductsNumber" size="sm"/>
            </div>
        </div>
        <div class="grand-reveal">
            <admin-field asp-for="NewProductsOnHomePage"/>
            <div class="grand-reveal__body grand-fields grand-fields--2col">
                <admin-field asp-for="NewProductsNumberOnHomePage" id="pnlNewProductsNumberOnHomePage" size="sm"/>
            </div>
        </div>
        <div class="grand-reveal">
            <admin-field asp-for="ShowBestsellersOnHomepage"/>
            <div class="grand-reveal__body grand-fields grand-fields--2col">
                <admin-field asp-for="NumberOfBestsellersOnHomepage" id="pnlNumberOfBestsellersOnHomepage" size="sm"/>
                <div class="grand-reveal">
                    <admin-field asp-for="BestsellersFromReports" id="pnlBestsellersFromReports"/>
                    <div class="grand-reveal__body grand-fields grand-fields--2col">
                        <admin-field asp-for="PeriodBestsellers" id="pnlPeriodBestsellers" size="sm"/>
                    </div>
                </div>
            </div>
        </div>
        <div class="grand-reveal">
            <admin-field asp-for="ProductsAlsoPurchasedEnabled"/>
            <div class="grand-reveal__body grand-fields grand-fields--2col">
                <admin-field asp-for="ProductsAlsoPurchasedNumber" id="pnlProductsAlsoPurchasedNumber" size="sm"/>
            </div>
        </div>
    </div>
</admin-card>
<admin-card>
    <div class="grand-fields grand-fields--2col">
        <admin-field asp-for="NumberOfProductTags" size="sm"/>
    </div>
    <div class="grand-fields grand-fields--2col mt-3">
        <admin-field asp-for="ProductsByTagAllowCustomersToSelectPageSize"/>
        <admin-field asp-for="ProductsByTagPageSize" id="pnlProductsByTagPageSize" size="sm"/>
        <admin-field asp-for="ProductsByTagPageSizeOptions" id="pnlProductsByTagPageSizeOptions" size="md"/>
    </div>
</admin-card>