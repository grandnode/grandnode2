@model MediaSettingsModel
@{
    ViewBag.Title = Loc["Admin.Settings.Media"];
}
<form asp-area="@Constants.AreaStore" asp-controller="Setting" asp-action="Media" method="post">

    <div asp-validation-summary="All"></div>
    @* the size of every picture the storefront draws, then how an upload is stored *@
    <admin-page sticky title="@Loc["Admin.Settings.Media"]" icon="bi-sliders">
        <page-actions>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
        </page-actions>

        <admin-card>
            <div class="grand-fields grand-fields--2col">
                <admin-field asp-for="ProductThumbPictureSize" size="sm"/>
                <admin-field asp-for="ProductDetailsPictureSize" size="sm"/>
                <admin-field asp-for="ProductThumbPictureSizeOnProductDetailsPage" size="sm"/>
                <admin-field asp-for="AssociatedProductPictureSize" size="sm"/>
                <admin-field asp-for="ProductBundlePictureSize" size="sm"/>
                <admin-field asp-for="CategoryThumbPictureSize" size="sm"/>
                <admin-field asp-for="BrandThumbPictureSize" size="sm"/>
                <admin-field asp-for="CollectionThumbPictureSize" size="sm"/>
                <admin-field asp-for="VendorThumbPictureSize" size="sm"/>
                <admin-field asp-for="CartThumbPictureSize" size="sm"/>
                <admin-field asp-for="MiniCartThumbPictureSize" size="sm"/>
                <admin-field asp-for="AddToCartThumbPictureSize" size="sm"/>
                <admin-field asp-for="AutoCompleteSearchThumbPictureSize" size="sm"/>
                <admin-field asp-for="BlogThumbPictureSize" size="sm"/>
                <admin-field asp-for="CourseThumbPictureSize" size="sm"/>
                <admin-field asp-for="LessonThumbPictureSize" size="sm"/>
                <admin-field asp-for="NewsListThumbPictureSize" size="sm"/>
                <admin-field asp-for="NewsThumbPictureSize" size="sm"/>
                <admin-field asp-for="ImageSquarePictureSize" size="sm"/>
            </div>
        </admin-card>
        <admin-card>
            <div class="grand-fields grand-fields--2col">
                <admin-field asp-for="MaximumImageSize" size="sm"/>
                <admin-field asp-for="ImageQuality" size="sm"/>
                <admin-field asp-for="DefaultPictureZoomEnabled"/>
                <admin-field asp-for="DefaultImageName" size="md"/>
            </div>
        </admin-card>
    </admin-page>
</form>
