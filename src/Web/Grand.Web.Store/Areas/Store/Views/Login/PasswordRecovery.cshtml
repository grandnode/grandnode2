@using Grand.Web.AdminShared.Models.Common
@model PasswordRecoveryModel
@{
    Layout = Constants.LayoutStoreLogin;
    ViewBag.Title = Loc["Account.PasswordRecovery"];
}

<form asp-route="StorePasswordRecovery" method="post" class="grand-page grand-login__panel">
    <div class="grand-login__brand">
        <img src="@(Grand.SharedUIResources.Constants.WwwRoot)/administration/build/images/grand-logo.svg" width="40" height="40" alt=""/>
        <span>GrandNode</span>
    </div>
    <div class="grand-card">
        <div class="grand-card__body">
            <div class="grand-login__heading">
                <span class="grand-login__icon"><i class="bi bi-key" aria-hidden="true"></i></span>
                <h1 class="grand-login__title">@Loc["Account.PasswordRecovery"]</h1>
                @if (!Model.Sent)
                {
                    <p class="grand-login__lead">@Loc["Account.PasswordRecovery.Tooltip"]</p>
                }
            </div>
            @if (Model.Sent)
            {
                <div class="grand-login__notice" role="status">
                    <i class="bi bi-envelope-check" aria-hidden="true"></i>
                    <span>@Model.Result</span>
                </div>
            }
            else
            {
                <div asp-validation-summary="ModelOnly"></div>
                <div class="grand-fields">
                    <div class="grand-field">
                        <label asp-for="Email" class="grand-field__label">@Loc["Account.PasswordRecovery.Email"]</label>
                        <div class="grand-field__control">
                            <input asp-for="Email" class="form-control email" autocomplete="email" autofocus="autofocus"/>
                        </div>
                        <span asp-validation-for="Email"></span>
                    </div>
                    @if (Model.DisplayCaptcha)
                    {
                        <div class="captcha-box">
                            <captcha/>
                        </div>
                    }
                </div>
                <input class="btn btn-primary grand-login__submit" type="submit" value="@Loc["Account.PasswordRecovery.RecoverButton"]"/>
            }
            <a class="grand-login__link grand-login__back" asp-route="StoreLogin">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> @Loc["Admin.Login.LoginButton"]
            </a>
        </div>
    </div>
</form>