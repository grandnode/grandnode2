@model BrandListModel
@{
    ViewBag.Title = Loc["Admin.Catalog.Brands"];
}

<div class="row">
    <div class="col-md-12">
        <div class="x_panel light form-fit">
            <div class="x_title">
                <div class="caption">
                    <i class="fa fa-building-o"></i>
                    @Loc["Admin.Catalog.Brands"]
                </div>
                <div class="actions btn-group btn-group-devided util-btn-margin-bottom-5">
                    <a href="@Url.Action("Create", new { area = Constants.AreaStore })" class="btn green">
                        <i class="fa fa-plus"></i><span class="d-none d-sm-inline"> @Loc["Admin.Common.AddNew"] </span>
                    </a>
                    <partial name="Partials/WidgetZone.ListButtons"/>
                </div>
            </div>
            <div class="x_content form">
                <div class="form-horizontal">
                    <div class="form-body">
                        <div class="row align-items-end">
                            <div class="col-md-6 col-sm-12 col-12">
                                <div class="form-group mb-0">
                                    <admin-label asp-for="SearchBrandName" class="d-flex flex-column align-items-start mw-100 px-0 text-left"/>
                                    <admin-input asp-for="SearchBrandName"/>
                                </div>
                            </div>                            
                            <div class="col-md-3 col-sm-12 col-12 mt-md-0 mt-3">
                                <div class="form-actions">
                                    <button class="btn btn-success filter-submit" id="search-brands">
                                        <i class="fa fa-search"></i> @Loc["Admin.Common.Search"]
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="x_content">
                <admin-grid id="brands-grid"
                            read-url="@Url.Action("List", "Brand", new { area = Constants.AreaStore })"
                            additional-data="additionalData">
                    <grid-column field="Name" title="@Loc["Admin.Catalog.Brands.Fields.Name"]">
                        <cell-template>
                            <a class="k-link" href="Edit/{{ Id }}">{{ Name }}</a>
                        </cell-template>
                    </grid-column>
                    <grid-column field="ShowOnHomePage" title="@Loc["Admin.Catalog.Brands.Fields.ShowOnHomePage"]" width="175" align="Center" min-screen-width="750">
                        <cell-template>
                            <i data-if="ShowOnHomePage" class="fa fa-check" aria-hidden="true" style="color:green"></i>
                            <i data-else class="fa fa-times" aria-hidden="true" style="color:red"></i>
                        </cell-template>
                    </grid-column>
                    <grid-column field="IncludeInMenu" title="@Loc["Admin.Catalog.Brands.Fields.IncludeInMenu"]" width="175" align="Center" min-screen-width="750">
                        <cell-template>
                            <i data-if="IncludeInMenu" class="fa fa-check" aria-hidden="true" style="color:green"></i>
                            <i data-else class="fa fa-times" aria-hidden="true" style="color:red"></i>
                        </cell-template>
                    </grid-column>
                    <grid-column field="Published" title="@Loc["Admin.Catalog.Brands.Fields.Published"]" width="100" align="Center" min-screen-width="500">
                        <cell-template>
                            <i data-if="Published" class="fa fa-check" aria-hidden="true" style="color:green"></i>
                            <i data-else class="fa fa-times" aria-hidden="true" style="color:red"></i>
                        </cell-template>
                    </grid-column>
                    <grid-column field="DisplayOrder" title="@Loc["Admin.Catalog.Brands.Fields.DisplayOrder"]" width="125" align="Center" min-screen-width="750"/>
                </admin-grid>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        //search button
        $('#search-brands').click(function () {
            //search
            var grid = $('#brands-grid').data('kendoGrid');
            grid.dataSource.page(1);
            return false;
        });

        $("#@Html.IdFor(model => model.SearchBrandName)").keydown(function (event) {
            if (event.keyCode == 13) {
                $("#search-brands").click();
                return false;
            }
        });
    });

    function additionalData() {
        var data = {
            SearchBrandName: $('#@Html.IdFor(model => model.SearchBrandName)').val(),            
        };
        addAntiForgeryToken(data);
        return data;
    }
</script>