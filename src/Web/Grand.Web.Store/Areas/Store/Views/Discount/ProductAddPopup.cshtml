@model DiscountModel.AddProductToDiscountModel
@{
    Layout = "";
    ViewBag.Title = Loc["admin.marketing.Discounts.AppliedToProducts.AddNew"];
}

<form id="ProductAddPopup" asp-area="@Constants.AreaStore" asp-controller="Discount" asp-action="ProductAddPopup" method="post"
      asp-route-DiscountId="@HtmlExtensions.HtmlEncodeSafe(Context.Request.Query["DiscountId"])"
      asp-route-btnId="@HtmlExtensions.HtmlEncodeSafe(Context.Request.Query["btnId"])"
      asp-route-formId="@HtmlExtensions.HtmlEncodeSafe(Context.Request.Query["formId"])">

    <div class="row">
        <div class="col-md-12">
            <div class="x_panel light form-fit popup-window">
                <div class="x_title">
                    <div class="caption">
                        <i class="fa fa-cubes"></i>
                        @Loc["admin.marketing.Discounts.AppliedToProducts.AddNew"]
                    </div>
                </div>
                <div class="x_content form">
                    <div class="form-horizontal">
                        <div class="form-body">
                            <div class="main-header col-12 px-0">
                                <div class="row align-items-end">
                                    <div class="col-md col-ms-12 col-12">
                                        <div class="mb-0">
                                            <admin-label asp-for="SearchProductName" class="control-label"/>
                                            <admin-input asp-for="SearchProductName"/>
                                        </div>
                                    </div>
                                    <div class="col-md-auto col-sm-12 col-12">
                                        <div class="form-actions">
                                            <div class="btn-group btn-group-devided">
                                                <button class="btn btn-success filter-submit" id="search-products">
                                                    <i class="fa fa-search"></i>&nbsp; @Loc["Admin.Common.Search"]
                                                </button>
                                            </div>
                                            <button class="btn btn-success" type="submit" name="save"><i class="fa fa-check"></i> &nbsp; @Loc["Admin.Common.Save"] </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <admin-grid id="products-grid"
                                        read-url="@Url.Action("ProductAddPopupList", "Discount", new { area = Constants.AreaStore })"
                                        additional-data="additionalData"
                                        selectable="Checkbox"
                                        selection-name="SelectedProductIds">
                                <grid-column field="Name" title="@Loc["Admin.Catalog.Products.Fields.Name"]"/>
                                <grid-column field="Published" title="@Loc["Admin.Catalog.Products.Fields.Published"]" width="100" align="Center">
                                    <cell-template>
                                        <i data-if="Published" class="fa fa-check" aria-hidden="true" style="color:green"></i>
                                        <i data-else class="fa fa-times" aria-hidden="true" style="color:red"></i>
                                    </cell-template>
                                </grid-column>
                            </admin-grid>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        var mfp = $.magnificPopup.instance;
        $("#ProductAddPopup").submit(function (e) {
            e.preventDefault();
            var form = $(this);
            var url = form.attr('action');
            $.ajax({
                type: "POST",
                url: url,
                data: form.serialize(),
                success: function (data) {
                    if (data == "") {
                        mfp.close();
                        $('#btnRefreshProducts').click();
                    } else {
                        $.magnificPopup.open({
                            items: {
                                src: data,
                                type: 'inline'
                            },
                            callbacks: {
                                open: function () {
                                    $('.mfp-wrap').removeAttr('tabindex');
                                }
                            }
                        });
                    }
                }
            });
        });


        $('#search-products').click(function() {
            var grid = $('#products-grid').data('kendoGrid');
            grid.dataSource.page(1);
            grid.clearSelection();
            return false;
        });

        $("#@Html.IdFor(model => model.SearchProductName)").keydown(function(event) {
            if (event.keyCode == 13) {
                $("#search-products").click();
                return false;
            }
        });


        function additionalData() {
            var data = {
                SearchProductName: $('#@Html.IdFor(model => model.SearchProductName)').val(),
            };
            addAntiForgeryToken(data);
            return data;
        }

    </script>
</form>
