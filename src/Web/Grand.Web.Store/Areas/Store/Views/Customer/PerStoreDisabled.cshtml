@{
    ViewBag.Title = Loc["Admin.Customers.Customers"];
}

<div class="row">
    <div class="col-md-12">
        <div class="x_panel light form-fit">
            <div class="x_title">
                <div class="caption">
                    <i class="fa fa-users"></i>
                    @Loc["Admin.Customers.Customers"]
                </div>
            </div>
            <div class="x_content">
                <div class="alert alert-warning">
                    Customer management from the store panel is disabled. It requires per-store customer
                    identity. Ask an administrator to set <strong>Customer:RegisterCustomersPerStore</strong>
                    to <strong>true</strong> in appsettings.json.
                </div>
            </div>
        </div>
    </div>
</div>
