@model CustomerModel.AddProductModel
@{
    Layout = "";
    ViewBag.Title = Loc["Admin.Customers.Products.AddNew"];
}

<form id="ProductAddPopup" asp-area="@Constants.AreaStore" asp-controller="Customer" asp-action="ProductAddPopup" method="post"
      asp-route-CustomerId="@HtmlExtensions.HtmlEncodeSafe(Context.Request.Query["CustomerId"])"
      asp-route-btnId="@HtmlExtensions.HtmlEncodeSafe(Context.Request.Query["btnId"])"
      asp-route-formId="@HtmlExtensions.HtmlEncodeSafe(Context.Request.Query["formId"])"
      asp-route-personalized="@HtmlExtensions.HtmlEncodeSafe(Context.Request.Query["personalized"])">

    @* a product picker: the name search, the
       grid in a flush card and Save as the popup's one primary action, so Search steps down *@
    <admin-popup title="@Loc["Admin.Customers.Products.AddNew"]" icon="bi-diagram-3">
        <admin-filters id="product-picker-filters" submit-id="search-products" secondary-submit="true">
            <filters-search>
                <admin-input asp-for="SearchProductName"/>
            </filters-search>
        </admin-filters>
        <admin-card flush>
            <admin-grid id="products-grid"
                        read-url="@Url.Action("ProductAddPopupList", "Customer", new { area = Constants.AreaStore })"
                        additional-data="additionalData"
                        selectable="Checkbox"
                        selection-name="SelectedProductIds">
                <grid-column field="Name" title="@Loc["Admin.Catalog.Products.Fields.Name"]"/>
                <grid-column field="Published" title="@Loc["Admin.Catalog.Products.Fields.Published"]" width="100" align="Center">
                    <cell-template>
                        <i data-if="Published" class="bi bi-check-lg text-success" aria-hidden="true"></i>
                        <i data-else class="bi bi-x-lg text-danger" aria-hidden="true"></i>
                    </cell-template>
                </grid-column>
            </admin-grid>
        </admin-card>
        <div class="grand-popup__actions">
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
        </div>
    </admin-popup>
    <script>
        var mfp = $.magnificPopup.instance;
        $("#ProductAddPopup").submit(function (e) {
            e.preventDefault();
            var form = $(this);
            var url = form.attr('action');
            $.ajax({
                type: "POST",
                url: url,
                data: form.serialize(),
                success: function (data) {
                    if (data == "") {
                        mfp.close();
                        $('#btnRefreshPersonalizedProducts').click();
                        $('#btnRefreshProducts').click();
                    } else {
                        $.magnificPopup.open({
                            items: {
                                src: data,
                                type: 'inline'
                            },
                            callbacks: {
                                open: function () {
                                    $('.mfp-wrap').removeAttr('tabindex');
                                }
                            }
                        });
                    }
                }
            });
        });


        $('#search-products').click(function() {
            var grid = GrandAdmin.grids.get('#products-grid');
            grid.dataSource.page(1);
            grid.clearSelection();
            return false;
        });

        $("#@Html.IdFor(model => model.SearchProductName)").keydown(function(event) {
            if (event.keyCode == 13) {
                $("#search-products").click();
                return false;
            }
        });


        function additionalData() {
            var data = {
                SearchProductName: $('#@Html.IdFor(model => model.SearchProductName)').val()
            };
            addAntiForgeryToken(data);
            return data;
        }

    </script>
</form>
