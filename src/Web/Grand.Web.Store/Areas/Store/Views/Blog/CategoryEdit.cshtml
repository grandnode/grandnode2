@model BlogCategoryModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Content.Blog.BlogCategory.EditBlogCategoryDetails"];
}

<form asp-area="@Grand.Web.Store.Extensions.Constants.AreaStore" asp-controller="Blog" asp-action="CategoryEdit" method="post" id="category-form">

    <div class="row">
        <div class="col-md-12">
            <div class="x_panel light form-fit">
                <div class="x_title">
                    <div class="caption">
                        <i class="fa fa-comment"></i>
                        @Loc["Admin.Content.Blog.BlogCategory.EditBlogCategoryDetails"]
                        <small>
                            <i class="fa fa-arrow-circle-left"></i>@Html.ActionLink(Loc["Admin.Content.Blog.BlogCategory.BackToList"], "CategoryList")
                        </small>
                    </div>
                    <div class="actions">
                        <div class="btn-group btn-group-devided">
                            <button class="btn btn-success" type="submit" name="save">
                                <i class="fa fa-check"></i> @Loc["Admin.Common.Save"]
                            </button>
                            <button class="btn btn-success" type="submit" name="save-continue">
                                <i class="fa fa-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
                            </button>
                            <span id="blogcategory-delete" class="btn red">
                                <i class="fa fa-trash-o"></i> @Loc["Admin.Common.Delete"]
                            </span>
                        </div>
                    </div>
                </div>
                <vc:admin-widget widget-zone="blog_category_buttons" additional-data="Model"/>
                <div class="x_content form">
                    <partial name="Partials/CreateOrUpdateCategory" model="Model"/>
                </div>
            </div>
        </div>
    </div>
</form>

<script>
    $(document).ready(function() {
        $('#blogcategory-delete').click(function() {
            if (confirm('@Loc["Admin.Common.AreYouSure"]')) {
                var postData = {
                    id: '@Model.Id'
                };
                addAntiForgeryToken(postData);
                
                $.ajax({
                    cache: false,
                    type: "POST",
                    url: "@(Url.Action("CategoryDelete", "Blog", new { area = Grand.Web.Store.Extensions.Constants.AreaStore }))",
                    data: postData,
                    success: function() {
                        location.href = "@(Url.Action("CategoryList", "Blog", new { area = Grand.Web.Store.Extensions.Constants.AreaStore }))";
                    },
                    error: function(xhr, ajaxOptions, thrownError) {
                        alert('Failed to delete');
                    }
                });
            }
            return false;
        });
    });
</script>