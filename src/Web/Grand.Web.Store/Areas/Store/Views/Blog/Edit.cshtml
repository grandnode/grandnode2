@model BlogPostModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Content.Blog.BlogPosts.EditDetails"];
    Layout = Constants.LayoutStore;
}
<form asp-area="@Constants.AreaStore" asp-controller="Blog" asp-action="Edit" method="post">

    <div class="row">
        <div class="col-md-12">
            <div class="x_panel light form-fit">
                <div class="x_title">
                    <div class="caption">
                        <i class="fa fa-blog"></i>
                        @Loc["Admin.Content.Blog.BlogPosts.EditDetails"] - @Model.Title
                        <small>
                            <i class="fa fa-arrow-circle-left"></i>@Html.ActionLink(Loc["Admin.Content.Blog.BlogPosts.BackToList"], "List")
                        </small>
                    </div>
                    <div class="actions">
                        <div class="btn-group btn-group-devided">
                            <button class="btn btn-success" type="submit" name="save">
                                <i class="fa fa-check"></i> @Loc["Admin.Common.Save"]
                            </button>
                            <button class="btn btn-success" type="submit" name="save-continue">
                                <i class="fa fa-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
                            </button>
                            <a href="@Url.Action("Preview", new { id = Model.Id })" class="btn btn-info" target="_blank">
                                <i class="fa fa-eye"></i> @Loc["Admin.Common.Preview"]
                            </a>
                            <button type="submit" name="Delete" onclick="javascript:return confirm('@Loc["Admin.Common.AreYouSure"]');" class="btn red">
                                <i class="fa fa-trash-o"></i> @Loc["Admin.Common.Delete"]
                            </button>
                            <vc:admin-widget widget-zone="blog_details_buttons" additional-data="Model"/>
                        </div>
                    </div>
                </div>
                <div class="x_content form">
                    <partial name="Partials/CreateOrUpdate" model="Model"/>
                </div>
            </div>
        </div>
    </div>
</form>