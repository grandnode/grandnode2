@model ProductDetailsModel
<div class="delivery generalMarginSupporter">
    @if (Model.FreeShippingNotificationEnabled && Model.IsFreeShipping)
    {
        <div class="free-shipping d-inline-flex align-items-center w-100">
            <i class="b-icon bi bi-truck me-2" aria-hidden="true"></i> <strong>@Loc["Products.FreeShipping"]</strong>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.DeliveryDate))
    {
        <div class="delivery-date" style="color:'@Model.DeliveryColorSquaresRgb'">
            <span class="label">@Loc["Products.DeliveryDate"]:</span>
            <span class="value">@Model.DeliveryDate</span>
        </div>
    }
    @if (Model.NotReturnable)
    {
        <div class="d-inline-flex align-items-center w-100">
            <i class="b-icon bi bi-truck me-2" aria-hidden="true"></i> @Loc["Products.NotReturnable"]
        </div>
    }
    @if (Model.AdditionalShippingCharge > 0 && !Model.IsFreeShipping)
    {
        <div class="additional-shipping-charge btn btn-sm btn-secondary">
            <i class="b-icon bi bi-truck me-2" aria-hidden="true"></i>
            <span class="label">@Loc["Products.AdditionalShippingCharge"]</span>
            <span class="value">@Model.AdditionalShippingChargeStr</span>
        </div>
    }
</div>