@model ProductDetailsModel
<div class="availability generalMarginSupporter">
    @if (!string.IsNullOrWhiteSpace(Model.StockAvailability))
    {
        <div class="stock">
            <span class="label">@Loc["Products.Availability"]:</span>
            @*no itemprop here: this block sits in the Product scope, and availability is an
              Offer property - Partials/Prices states it, from the same Model.Availability*@
            <span class="value" id="stock-availability-value-@Model.Id">@Model.StockAvailability</span>
        </div>
    }
    @if (Model.DisplayOutOfStockSubscription)
    {
        <partial name="Partials/OutOfStockSubscription" model="Model"/>
    }
</div>