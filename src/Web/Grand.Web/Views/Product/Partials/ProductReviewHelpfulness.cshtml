@model ProductReviewHelpfulnessModel
<div class="product-review-helpfulness d-inline-flex justify-content-end align-items-center flex-wrap">
    <span class="question">@Loc["Reviews.Helpfulness.WasHelpful?"]</span>
    <span class="vote-options btn-group">
        <span id="vote-yes-@(Model.ProductReviewId)" class="btn btn-sm btn-outline vote">
            <i class="b-icon text-success bi bi-hand-thumbs-up" aria-hidden="true"></i>
        </span>
        <span id="vote-no-@(Model.ProductReviewId)" class="btn btn-sm btn-outline vote">
            <i class="b-icon text-danger bi bi-hand-thumbs-down" aria-hidden="true"></i>
        </span>
    </span>
    <span class="vote-stats d-inline-flex">
        (<span id="helpfulness-vote-yes-@(Model.ProductReviewId)">@(Model.HelpfulYesTotal)</span>/<span id="helpfulness-vote-no-@(Model.ProductReviewId)">@(Model.HelpfulNoTotal)</span>)
    </span>
</div>