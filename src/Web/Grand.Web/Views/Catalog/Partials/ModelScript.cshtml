@model object
@*
    Data island for the catalog listing view-model. The behaviour lives in
    vueapp/src/views/catalog.js, which publishes the global `catalog`.

    The model is declared as object because the callers pass a category, brand,
    collection, tag, vendor or search model; System.Text.Json serializes the
    runtime type.
*@
<script type="application/json" data-grand-vm="catalog">@Json.Serialize(new {
                                                            model = Model,
                                                            res = new {
                                                                warning = Loc["common.warning"].ToString(),
                                                                loadFailed = Loc["catalog.loadfailed"].ToString()
                                                            }
                                                        })</script>
