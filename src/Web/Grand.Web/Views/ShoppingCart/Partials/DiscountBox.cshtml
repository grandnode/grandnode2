<div v-if="vmorder.cart.DiscountBox.Display" class="coupon-box">
    <div class="accordion" role="tablist">
        <div class="card mb-1">
            <div class="card-header p-1" role="tab">
                <button class="btn btn-light w-100 coupon-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#accordion-discount" aria-expanded="false" aria-controls="accordion-discount">@Loc["ShoppingCart.DiscountCouponCode.Tooltip"]</button>
            </div>
            <div class="collapse" id="accordion-discount" role="tabpanel">
                <div class="card-body">
                    <div class="coupon-code">
                        <div class="form-group">
                            <span class="col-form-label">@Loc["ShoppingCart.DiscountCouponCode"]</span>
                            <div class="input-group">
                                <input type="text" id="discountcouponcode" name="discountcouponcode" class="form-control discount-coupon-code">
                                <label for="discountcouponcode" class="visually-hidden">@Loc["ShoppingCart.Code.Button"]</label>
                                <span class="input-group-append">
                                    <button type="button" name="applydiscountcouponcode" id="applydiscountcouponcode" @@click="vmorder.ApplyDiscountCode('@Url.RouteUrl("ApplyDiscountCoupon")')" class="btn btn-outline-secondary apply-discount-coupon-code-button">
                                        @Loc["ShoppingCart.DiscountCouponCode.Button"]
                                    </button>
                                </span>
                            </div>
                        </div>
                    </div>

                    <div v-if="vmorder.cart.DiscountBox.Message !== null && vmorder.cart.DiscountBox.IsApplied" class="alert alert-success message-success text-center">
                        {{vmorder.cart.DiscountBox.Message}}
                    </div>
                    <div v-if="vmorder.cart.DiscountBox.Message !== null && vmorder.cart.DiscountBox.IsApplied == false" class="alert alert-danger message-failure text-center">
                        {{vmorder.cart.DiscountBox.Message}}
                    </div>
                    <div v-if="vmorder.cart.DiscountBox.AppliedDiscountsWithCodes[0]" v-for="discount in vmorder.cart.DiscountBox.AppliedDiscountsWithCodes" class="alert alert-success text-center">
                        <span>@Loc["ShoppingCart.DiscountCouponCode.CurrentCode"].ToString().Replace("{0}", "{{discount.CouponCode}}")</span>
                        <a class="mx-1" href="#" name="removediscount" title="@Loc["Common.Remove"]" @@click.prevent="vmorder.RemoveDiscountId('@Url.RouteUrl("RemoveDiscountCoupon")?discountId=' + discount.Id)">
                            <i class="b-icon bi bi-trash text-danger" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>