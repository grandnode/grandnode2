@model ShoppingCartModel
@*
    Data island for the cart page view-model. The behaviour lives in
    vueapp/src/views/shopping-cart.js, which publishes the global `vmorder`.
*@
@{
    var payload = new {
        model = Model,
        routes = new {
            summary = Url.RouteUrl("ShoppingCartSummary"),
            total = Url.RouteUrl("ShoppingCartTotal"),
            checkout = Url.RouteUrl("Checkout"),
            loginReturningToCart = $"{Url.RouteUrl("Login")}?returnurl={Url.RouteUrl("ShoppingCart")}",
            startCheckout = Url.RouteUrl("StartCheckout"),
            shoppingCart = Url.RouteUrl("ShoppingCart"),
            updateQuantity = Url.RouteUrl("UpdateQuantityCart"),
            changeTypeCartItem = Url.RouteUrl("ChangeTypeCartItem"),
            getItemCart = Url.RouteUrl("GetItemCart"),
            sidebarShoppingCart = Url.RouteUrl("SidebarShoppingCart")
        },
        res = new {
            warning = Loc["common.warning"].ToString()
        }
    };
}
<script type="application/json" data-grand-vm="shoppingCart">@Json.Serialize(payload)</script>
