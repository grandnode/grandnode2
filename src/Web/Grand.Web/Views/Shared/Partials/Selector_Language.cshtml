@using Grand.Business.Core.Interfaces.Common.Localization
@inject ILanguageService languageService
@inject IContextAccessor contextAccessor
@{
    var availableLanguages = (await languageService.GetAllLanguages(storeId: contextAccessor.StoreContext.CurrentStore.Id))
        .Select(x => new LanguageModel
        {
            Id = x.Id,
            Name = x.Name,
            Rtl = x.Rtl,
            LanguageCulture = x.LanguageCulture,
            UniqueSeoCode = x.UniqueSeoCode
        }).ToList();

    var returnurl = Context?.Request?.GetEncodedPathAndQuery();
    if (availableLanguages.Count > 1)
    {
        <div>
            <div class="dropdown btn-group me-2">
        <button type="button" class="btn btn-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">@availableLanguages.FirstOrDefault(x => x.Id == contextAccessor.WorkContext.WorkingLanguage.Id)?.Name</button>
        <ul class="dropdown-menu">
                @foreach (var lang in availableLanguages)
                {
                    var className = lang.Id == contextAccessor.WorkContext.WorkingLanguage.Id ? "active" : "";
                    <li><a class="dropdown-item @className" href="@Url.RouteUrl("ChangeLanguage", new { langcode = lang.UniqueSeoCode, returnurl })">
                        @lang.Name
                    </a></li>
                }
            </ul>
    </div>
        </div>
    }
}