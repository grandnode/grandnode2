@model int
@inject IContextAccessor contextAccessor
@{
    var supportRtl = contextAccessor.WorkContext.WorkingLanguage.Rtl;
}
<li class="nav-item">
    <ul class="sidebar-cart px-0">
        <li class="nav-item">
            <a href="#" target="_self" class="nav-link">
                <i class="b-icon bi bi-cart" :class="[darkMode ? 'text-white' : 'text-dark']" @@click="flycartfirstload && updateSidebarShoppingCart('@Url.RouteUrl("SidebarShoppingCart")')" data-bs-toggle="offcanvas" data-bs-target="#sidebar-cart" aria-controls="sidebar-cart" aria-hidden="true"></i>
                <span class="qty-indicator cart-qty">
                    <template v-if="flycartindicator == null">
                        @Loc["ShoppingCart.HeaderQuantity", Model]
                    </template>
                    <template v-else>
                        {{flycartindicator}}
                    </template>
                </span>
            </a>
        </li>
    </ul>
</li>