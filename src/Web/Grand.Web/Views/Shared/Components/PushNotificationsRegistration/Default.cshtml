@model Grand.Web.Models.PushNotifications.PublicInfoModel
@inject IPageHeadBuilder pagebuilder

<script asp-location="Footer" asp-src="https://www.gstatic.com/firebasejs/8.6.5/firebase.js"></script>

<script type="application/json" data-grand-vm="pushNotifications">@Json.Serialize(new {
                                                                      firebase = new {
                                                                          publicApiKey = Model.PublicApiKey,
                                                                          senderId = Model.SenderId,
                                                                          projectId = Model.ProjectId,
                                                                          authDomain = Model.AuthDomain,
                                                                          storageBucket = Model.StorageBucket,
                                                                          databaseUrl = Model.DatabaseUrl,
                                                                          appId = Model.AppId
                                                                      },
                                                                      route = Url.Action("ProcessRegistration", "PushNotifications")
                                                                  })</script>
