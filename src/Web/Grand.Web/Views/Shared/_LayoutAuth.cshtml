@*
    The sign-in surface of a store the customer may not browse: guests without "Public store. Allow navigation",
    or anyone without access to a closed store. The guest account screens (login, register, password recovery,
    two-factor, activation) and Store closed render here instead of _SingleColumn.

    Nothing from the catalog belongs on this page - no header, menu, search box, footer or body widget zones -
    because every one of them shows what the store is hiding behind the sign-in.
*@
<!DOCTYPE html>
<html use-lang="true">
<head>
    <title asp-default-title="true"></title>
    <meta charset="utf-8">
    <meta-description>
    <meta-keywords>
    <meta name="generator" content="grandnode">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    @await RenderSectionAsync("meta", false)
    <head-custom>
    <partial name="Partials/Head"/>
    <vc:widget widget-zone="head_html_tag" additional-data="null"></vc:widget>
    <canonical-urls>
    <partial name="Partials/Favicons"/>
    <resources asp-type="HeadLink"/>
    <resources asp-type="HeadScript"/>
    @await RenderSectionAsync("head", false)
</head>
<body>
@Html.AntiForgeryToken()

<resources asp-type="TemplateHeader"/>
<resources asp-type="ScriptHeader"/>

<div id="app">
    <div class="page-loader-container">
        <div class="page-loader"></div>
    </div>
    <main id="content" class="container py-4" tabindex="-1">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <partial name="Partials/Logo"/>
            <partial name="Partials/Selector_Language"/>
        </div>
        @RenderBody()
    </main>
    <partial name="Partials/Cookie"/>
    <partial name="Partials/Notifications"/>
</div>
<resources asp-type="ScriptFooter"/>
<resources asp-type="TemplateFooter"/>
</body>
</html>
