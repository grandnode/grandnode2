@model NewsletterCategoryModel
<div class="modal fade" id="ModalNewsletterCategory" tabindex="-1" aria-labelledby="ModalNewsletterCategory-label" aria-hidden="true" :dark-theme="darkMode">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ModalNewsletterCategory-label">@Loc["NewsletterCategory.Title"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
    <div class="newsletter-category">
        <form id="newsletter-category-method-form" action="">
            <input asp-for="NewsletterEmailId" type="hidden"/>
            <div class="newsletter-category-body form-group">
                @foreach (var category in Model.NewsletterCategories)
                {
                    <label for="Category_@(category.Id)" class="form-check col-12">
                        <input id="Category_@(category.Id)" name="category" type="checkbox" value="@(category.Id)"
                               class="form-check-input" @(category.Selected ? "checked" : "")>
                        <span class="form-check-label"></span>
                        <span class="custom-control-description">@category.Name</span>
                    </label>
                    <div>
                        @Html.Raw(category.Description)
                    </div>
                }
                <div class="newsletter-category-save pt-1 pb-1">
                    <input type="button" value="@Loc["NewsletterCategory.Options.Save"]" id="newsletter-category-button" data-bs-dismiss="modal" @@click="vm.newsletterSubscribeCategory('@(Url.RouteUrl("SubscribeNewsletterCategory"))')" class="btn btn-outline-info newsletter-subscribe-button"/>
                </div>
            </div>
        </form>
    </div>
</div>
        </div>
    </div>
</div>