@using Grand.Business.Core.Interfaces.Common.Directory
@model SubAccountEditModel
@inject CustomerSettings customerSettings 
@inject IEnumTranslationService EnumTranslationService
@inject ICurrencyService CurrencyService
@{
    var approverRole = (int)SubAccountRole.Approver;
    var primaryCurrency = await CurrencyService.GetPrimaryStoreCurrency();
}
<input asp-for="Id" type="hidden"/>
<div class="edit-subaccount row">
    <div class="form-group col-sm-12 col-md-6">
        <validation-provider tag="div" rules="required" name="FirstName" v-slot="{ errors, classes }">
            <label asp-for="FirstName" class="col-form-label">@Loc["Account.Fields.FirstName"]:</label>
            <span class="required">*</span>
            <input asp-for="FirstName" v-model="createorupdatesubaccount.FirstName" v-bind:class="[classes , 'form-control']" autofocus="autofocus" data-val-required=@Loc["Account.Fields.FirstName.Required"]/>
            <span class="field-validation-error">{{ errors[0] }}</span>
            <span asp-validation-for="FirstName"></span>
        </validation-provider>
    </div>
    <div class="form-group col-sm-12 col-md-6">
        <validation-provider tag="div" rules="required" name="LastName" v-slot="{ errors, classes }">
            <label asp-for="LastName" class="col-form-label">@Loc["Account.Fields.LastName"]:</label>
            <span class="required">*</span>
            <input asp-for="LastName" v-model="createorupdatesubaccount.LastName" v-bind:class="[classes , 'form-control']" autofocus="autofocus" data-val-required=@Loc["Account.Fields.LastName.Required"]/>
            <span class="field-validation-error">{{ errors[0] }}</span>
            <span asp-validation-for="LastName"></span>
        </validation-provider>
    </div>
    <div class="form-group col-sm-12">
        @* Same rule as Account/Info: do not validate the format of a field the
           visitor cannot edit - it could only block the form, never help. *@
        <validation-provider tag="div" rules="@(customerSettings.AllowUsersToChangeEmail ? "required|email" : "required")" name="Email" v-slot="{ errors, classes }">
            <label asp-for="Email" class="col-form-label">@Loc["Account.Fields.Email"]:</label>
            <span class="required">*</span>
            <input asp-for="Email" v-model="createorupdatesubaccount.Email" v-bind:class="[classes , 'form-control']" autofocus="autofocus" asp-readonly="@(!customerSettings.AllowUsersToChangeEmail)" data-val-email=@Loc["Common.WrongEmail"] data-val-required=@Loc["Account.Fields.Email.Required"]/>
            <span class="field-validation-error">{{ errors[0] }}</span>
            <span asp-validation-for="Email"></span>
        </validation-provider>
    </div>
    <div class="form-group col-sm-12">
        <validation-provider tag="div" name="Password" v-slot="{ errors, classes }">
            <label asp-for="Password" class="col-form-label">@Loc["Account.Fields.Password"]:</label>
            <input asp-for="Password" v-model="createorupdatesubaccount.Password" v-bind:class="[classes , 'form-control']" autocomplete="off"/>
            <span class="field-validation-error">{{ errors[0] }}</span>
            <span asp-validation-for="Password"></span>
        </validation-provider>
    </div>
    <div class="form-group col-sm-12 col-md-6">
        <label asp-for="Role" class="col-form-label">@Loc["Account.SubAccounts.Fields.Role"]:</label>
        <select asp-for="Role" asp-items="@EnumTranslationService.ToSelectList(Model.Role, false).ToList()" v-model.number="createorupdatesubaccount.Role" class="form-control form-select"></select>
        <span asp-validation-for="Role" class="field-validation-error"></span>
    </div>
    @* An approver orders without a limit, so the field goes away for that role; the server drops it anyway. *@
    <div class="form-group col-sm-12 col-md-6" v-if="createorupdatesubaccount.Role !== @approverRole">
        <label asp-for="OrderApprovalLimit" class="col-form-label">@Loc["Account.SubAccounts.Fields.OrderApprovalLimit"] (@primaryCurrency.CurrencyCode):</label>
        <input asp-for="OrderApprovalLimit" type="number" min="0" step="any" v-model="createorupdatesubaccount.OrderApprovalLimit" class="form-control"/>
        <small class="form-text text-muted">@Loc["Account.SubAccounts.Fields.OrderApprovalLimit.Hint"]</small>
        <span asp-validation-for="OrderApprovalLimit" class="field-validation-error"></span>
    </div>
    <div class="form-group col-sm-12">
        <label asp-for="Active" class="col-form-label">@Loc["Account.Fields.Active"]:</label>
        <label class="form-check">
            <input asp-for="Active" class="form-check-input"/>
            <span class="form-check-label"></span>
        </label>
    </div>
</div>
<script type="application/json" data-grand-vm="state">@Json.Serialize(new { name = "createorupdatesubaccount", data = new { Model.FirstName, Model.LastName, Model.Email, Password = "", Role = (int)Model.Role, Model.OrderApprovalLimit } })</script>