@*The result element used to be injected by the script with insertAdjacentHTML;
    it belongs in the markup. Behaviour lives in vueapp/src/behaviours/username-availability.js.*@
<span id="username-availabilty"></span>
<input type="button" id="check-availability-button" class="btn btn-outline-info check-username-availability-button mt-3" value="@Loc["Account.CheckUsernameAvailability.Button"]"/>
<span id="availability-check-progress" style="display: none;" class="please-wait">@Loc["Common.Wait..."]</span>
<script type="application/json" data-grand-vm="usernameAvailability">@Json.Serialize(new {
                                                                         route = Url.RouteUrl("CheckUsernameAvailability"),
                                                                         elements = new {
                                                                             buttonId = "check-availability-button",
                                                                             usernameId = "Username",
                                                                             resultId = "username-availabilty",
                                                                             progressId = "availability-check-progress"
                                                                         },
                                                                         res = new {
                                                                             enterUsername = Loc["Account.CheckUsernameAvailability.EnterUsername"].ToString(),
                                                                             warning = Loc["common.warning"].ToString()
                                                                         }
                                                                     })</script>
