@model IList<MerchandiseReturnInStorePointModel>

<div class="return-in-store-points">
    @foreach (var point in Model)
    {
        var id = $"returnshipping-pickupPointId-{point.Id}";
        <div class="form-check">
            <input type="radio" class="form-check-input" id="@id" name="returnshipping.pickupPointId" value="@point.Id" checked="@(Model.Count == 1)"/>
            <label class="form-check-label" for="@id">
                <span class="name">@point.Name</span>
                <span class="address d-block text-muted">@point.Address</span>
            </label>
        </div>
    }
</div>
