@model MerchandiseReturnModel
@inject IPageHeadBuilder pagebuilder
@inject Grand.Domain.Media.MediaSettings mediaSettings
@{
    Layout = "_SingleColumn";

    //the image types the server takes for a photo; the form checks them, and the size and count, before the post
    var photoTypes = Grand.SharedKernel.Extensions.FileExtensions.GetAllowedMediaFileTypes(mediaSettings.AllowedFileTypes);
    var allowedPhotoTypes = string.Join(",", photoTypes);

    //title
    pagebuilder.AddTitleParts(Loc["Title.ReturnItems"]);
}
<div class="page return-request-page" vue-island="merchandisereturns">
    <h1 class="text-center generalTitle h2">@string.Format(Loc["MerchandiseReturns.Title"], Model.OrderNumber)</h1>
    @if (!string.IsNullOrEmpty(Model.Result))
    {
        @* v-pre: texts from the database and providers are shown, never compiled as a template *@
        <div class="result alert alert-info" v-pre>
            @Html.Raw(Model.Result)
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="result alert alert-danger" v-pre>
                @Model.Error
            </div>
        }

        <validation-observer v-slot="{ handleSubmit, validate }">
            @* with a return method, the form of the chosen one is checked before the submit *@
            <form asp-route="MerchandiseReturn" method="post" enctype="multipart/form-data" ref="form" v-on:submit.prevent="handleSubmit(merchandisereturns.submit)">
                @*
                    Three steps of one form, posted once at the end. Without scripts every step is shown, as one
                    long form, and the step buttons stay hidden.
                *@
                <ol class="return-steps list-inline d-flex gap-3 mt-2" style="display: none" v-show="true">
                    <li class="list-inline-item" v-bind:class="{ 'fw-bold': merchandisereturns.step === 1 }">1. @Loc["MerchandiseReturns.Wizard.Items"]</li>
                    <li class="list-inline-item" v-bind:class="{ 'fw-bold': merchandisereturns.step === 2 }">2. @Loc["MerchandiseReturns.Wizard.Method"]</li>
                    <li class="list-inline-item" v-bind:class="{ 'fw-bold': merchandisereturns.step === 3 }">3. @Loc["MerchandiseReturns.Wizard.Summary"]</li>
                </ol>
                <section class="return-step return-step-items" v-show="merchandisereturns.step === 1">
                <div class="mt-2">
                    <h2 class="h5 mt-3">
                        <strong>@Loc["MerchandiseReturns.SelectProduct(s)"]</strong>
                    </h2>
                    <div class="table-responsive">
                        <table class="table table-hover merchandise-table data-table">
                            <thead class="table-inverse">
                            <tr>
                                <th class="product">
                                    @Loc["MerchandiseReturns.Products.Name"]
                                </th>
                                <th class="unit-price">
                                    @Loc["MerchandiseReturns.Products.Price"]
                                </th>
                                <th class="quantity">
                                    @Loc["MerchandiseReturns.Products.Quantity"]
                                </th>
                                <th>
                                    @Loc["MerchandiseReturns.ReturnReason"]
                                </th>
                                @if (!Model.HideRequestedAction)
                                {
                                    <th>
                                        @Loc["MerchandiseReturns.ReturnAction"]
                                    </th>
                                }
                            </tr>
                            </thead>
                            <tbody>
                            <tr>
                            </tr>
                            <tr>
                                @for (var j = 0; j < Model.Items.Count; j++)
                                {
                                    var item = Model.Items[j];
                                    <td>
                                        <div class="product" v-pre>
                                            <a href="@Url.RouteUrl("Product", new { SeName = item.ProductSeName })">@item.ProductName</a>
                                            @if (!string.IsNullOrEmpty(item.AttributeInfo))
                                            {
                                                <a id="attributes-btn" class="btn btn-sm btn-outline-info" data-bs-toggle="tooltip" data-bs-placement="right" data-bs-html="true" title="@Html.Raw(item.AttributeInfo)">Attributes</a>
                                            }
                                            @if (!string.IsNullOrEmpty(item.VendorName))
                                            {
                                                <div class="vendor">
                                                    @item.VendorName
                                                </div>
                                            }
                                        </div>
                                        <div class="unit-price" v-pre>
                                            @item.UnitPrice
                                        </div>
                                        <div class="quantity">
                                            <input type="hidden" asp-for="@Model.Items[j].Id"/>
                                            <input type="hidden" asp-for="@Model.Items[j].ProductName"/>
                                            <validation-provider tag="div" rules="required" v-slot="{ errors, classes }">
                                                <select data-val-required="@(string.Format(Loc["Fields.IsRequired"], Loc["MerchandiseReturns.Products.Quantity"]))"
                                                        v-bind:class="[classes , 'form-select form-control']" v-model="merchandisereturns.quantity_@(item.Id)"
                                                        ref="quantity@(item.Id)" v-on:change="merchandisereturns.loadOffers($event)"
                                                        asp-for="@Model.Items[j].Quantity">
                                                    @for (var i = 0; i <= item.Quantity; i++)
                                                    {
                                                        <option value="@(i)">@(i)</option>
                                                    }
                                                </select>
                                                <span class="field-validation-error">{{ errors[0] }}</span>
                                            </validation-provider>
                                        </div>
                                        <div>
                                            @{
                                                var reasonsSelectList = Model.AvailableReturnReasons.Select(x => new SelectListItem
                                                {
                                                    Text = x.Name,
                                                    Value = x.Id.ToString()
                                                }).ToList();
                                            }
                                            @* nothing chosen at first: the first reason may ship free, and taken
                                               for granted it made every return free *@
                                            <validation-provider tag="div" v-slot="{ errors, classes }"
                                                                 v-bind:rules="@(Model.AvailableReturnReasons.Any() ? $"Number(merchandisereturns.quantity_{item.Id}) > 0 ? 'required' : ''" : "''")">
                                                <select asp-for="@Model.Items[j].MerchandiseReturnReasonId"
                                                        asp-items="@reasonsSelectList" class="form-control form-select return-reasons"
                                                        v-bind:class="classes"
                                                        data-val-required="@(string.Format(Loc["Fields.IsRequired"], Loc["MerchandiseReturns.ReturnReason"]))"
                                                        v-on:change="merchandisereturns.loadOffers($event)">
                                                    <option value="">@Loc["MerchandiseReturns.ReturnReason.Select"]</option>
                                                </select>
                                                <span class="field-validation-error">{{ errors[0] }}</span>
                                            </validation-provider>
                                        </div>
                                        @if (!Model.HideRequestedAction)
                                        {
                                            <div>
                                                @{
                                                    var actionsSelectList = Model.AvailableReturnActions.Select(x => new SelectListItem
                                                    {
                                                        Text = x.Name,
                                                        Value = x.Id.ToString()
                                                    }).ToList();
                                                }
                                                @* optional: left empty, the return names no action; it never changes the cost *@
                                                <select asp-for="@Model.Items[j].MerchandiseReturnActionId"
                                                        asp-items="@actionsSelectList" class="form-control form-select return-actions">
                                                    <option value="">@Loc["MerchandiseReturns.ReturnAction.Select"]</option>
                                                </select>
                                            </div>
                                        }
                                        @* checked on the server with the rest of the return: type, size, count, and
                                           whether the reason chosen asks for one *@
                                        <div class="return-photos mt-1">
                                            <label class="form-label small mb-0" for="photos-@(item.Id)">@Loc["MerchandiseReturns.Photos"]</label>
                                            <input type="file" class="form-control form-control-sm" id="photos-@(item.Id)" name="photos.@(item.Id)" multiple accept="@allowedPhotoTypes"/>
                                            <small class="text-muted">@Loc["MerchandiseReturns.Photos.Hint"]</small>
                                        </div>
                                    </td>
                                }
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="form-fields">
                    <div class="form-group">
                        <label asp-for="Comments" class="col-form-label">@Loc["MerchandiseReturns.Comments"]:</label>
                        <textarea asp-for="Comments" class="form-control comment"></textarea>
                        <span asp-validation-for="Comments"></span>
                    </div>
                    @if (Model.ShowPickupAddress)
                    {
                        <div class="form-group">
                            <div class="pickup-addresses" id="pickup-addresses-form">
                                @if (Model.ExistingAddresses.Any())
                                {
                                    <div class="section select-pickup-address">
                                        <label for="pickup-address-select">@Loc["MerchandiseReturns.SelectPickupAddressOrEnterNewOne"]</label>
                                        <div>
                                            <select name="PickupAddressId" id="pickup-address-select" class="form-select address-select"
                                                    title="" @@change="merchandisereturns.isNewAddress()">
                                                @foreach (var address in Model.ExistingAddresses)
                                                {
                                                    var addressLine = "";
                                                    addressLine += address.FirstName;
                                                    addressLine += " " + address.LastName;
                                                    if (address.StreetAddressEnabled && !string.IsNullOrEmpty(address.Address1))
                                                    {
                                                        addressLine += ", " + address.Address1;
                                                    }

                                                    if (address.CityEnabled && !string.IsNullOrEmpty(address.City))
                                                    {
                                                        addressLine += ", " + address.City;
                                                    }

                                                    if (address.StateProvinceEnabled && !string.IsNullOrEmpty(address.StateProvinceName))
                                                    {
                                                        addressLine += ", " + address.StateProvinceName;
                                                    }

                                                    if (address.ZipPostalCodeEnabled && !string.IsNullOrEmpty(address.ZipPostalCode))
                                                    {
                                                        addressLine += " " + address.ZipPostalCode;
                                                    }

                                                    if (address.CountryEnabled && !string.IsNullOrWhiteSpace(address.CountryName))
                                                    {
                                                        addressLine += ", " + address.CountryName;
                                                    }

                                                    <option selected="@(!Model.NewAddressPreselected && Model.ExistingAddresses[0].Id == address.Id)" value="@(address.Id)">@(addressLine)</option>
                                                }
                                                <option value="" selected="@Model.NewAddressPreselected">@Loc["MerchandiseReturns.NewAddress"]</option>
                                            </select>
                                        </div>
                                    </div>
                                }
                                <template v-if="merchandisereturns.newAddress">
                                    <div class="section new-pickup-address" id="pickup-new-address-form" ref="visible">
                                        <div class="enter-address">
                                            @{
                                                var dataDictAddress = new ViewDataDictionary(ViewData)
                                                {
                                                    TemplateInfo =
                                                    {
                                                        HtmlFieldPrefix = "MerchandiseReturnNewAddress"
                                                    }
                                                };
                                                <partial name="Partials/CreateOrUpdateAddress" model="Model.MerchandiseReturnNewAddress" view-data="dataDictAddress"/>
                                            }
                                        </div>
                                    </div>
                                </template>
                            </div>
                        </div>
                    }
                    @if (Model.ShowPickupDate)
                    {
                        if (Model.PickupDateRequired)
                        {
                            <div class="form-group">
                                <validation-provider tag="div" rules="required" name="PickupDate" v-slot="{ errors, classes }">
                                    <label class="col-form-label">@Loc["MerchandiseReturns.PickupDate"]:</label>
                                    <span class="required">*</span>
                                    <input asp-for="PickupDate" type="date" v-model="merchandisereturns.PickupDate" v-bind:class="[classes , 'form-control datepicker']" data-val-required=@Loc["MerchandiseReturns.PickupDateRequired"]/>
                                    <span class="field-validation-error">{{ errors[0] }}</span>
                                </validation-provider>
                            </div>
                        }
                        else
                        {
                            <div class="form-group">
                                <label class="col-form-label">@Loc["MerchandiseReturns.PickupDate"]:</label>
                                <input asp-for="PickupDate" type="date" v-model="merchandisereturns.PickupDate" class="form-control datepicker"/>
                            </div>
                        }
                    }
                </div>
                <span class="field-validation-error d-block" v-if="merchandisereturns.itemsError">{{ merchandisereturns.itemsError }}</span>
                <div class="mt-2" style="display: none" v-show="true">
                    <button type="button" class="btn btn-secondary" v-on:click="validate().then(ok => ok && merchandisereturns.toMethod())">@Loc["MerchandiseReturns.Wizard.Next"]</button>
                </div>
                </section>
                <section class="return-step return-step-method" v-show="merchandisereturns.step === 2">
                @if (Model.ReturnShippingEnabled)
                {
                    @*
                        The options depend on the items, reasons and actions chosen, so they are loaded once a
                        quantity is chosen. Their names and descriptions are text bindings: they come from
                        resources the admin edits and must never be compiled as a template. The form of an option
                        comes from the server as HTML and is inserted, not compiled, under the option.
                    *@
                    <div class="return-shipping mt-3" v-if="merchandisereturns.offers.length">
                        <h2 class="h5 mt-3">
                            <strong>@Loc["MerchandiseReturns.ReturnShipping.Title"]</strong>
                        </h2>
                        @* asked for once the customer is at this step: the items step goes on without it *@
                        <validation-provider tag="div" v-bind:rules="merchandisereturns.step >= 2 ? 'required' : ''" v-slot="{ errors }">
                            <div class="form-check return-shipping-option" v-for="offer in merchandisereturns.offers" v-bind:key="merchandisereturns.offerKey(offer)">
                                <input type="radio" class="form-check-input" name="ReturnShippingOffer"
                                       v-bind:id="'returnshipping-offer-' + merchandisereturns.offerKey(offer)"
                                       v-bind:value="merchandisereturns.offerKey(offer)"
                                       v-model="merchandisereturns.selectedKey"
                                       v-on:change="merchandisereturns.selectOffer(offer)"
                                       data-val-required="@Loc["MerchandiseReturns.ReturnShipping.Choose"]"/>
                                <label class="form-check-label" v-bind:for="'returnshipping-offer-' + merchandisereturns.offerKey(offer)">
                                    <span class="name fw-bold">{{ offer.Name }}</span>
                                    <span class="cost ms-2">{{ offer.Cost }}</span>
                                    <span class="parcels ms-1 text-muted" v-if="offer.ParcelsText">{{ offer.ParcelsText }}</span>
                                    <span class="description d-block text-muted" v-if="offer.Description">{{ offer.Description }}</span>
                                </label>
                                <div class="return-shipping-form mt-2"
                                     v-if="merchandisereturns.selectedKey === merchandisereturns.offerKey(offer) && merchandisereturns.formHtml"
                                     v-on:change="merchandisereturns.formError = ''"
                                     v-html="merchandisereturns.formHtml"></div>
                            </div>
                            <span class="field-validation-error">{{ errors[0] }}</span>
                            <span class="field-validation-error d-block" v-if="merchandisereturns.formError">{{ merchandisereturns.formError }}</span>
                        </validation-provider>
                        <template v-if="merchandisereturns.selectedOffer">
                            <input type="hidden" name="ReturnShippingProvider" v-bind:value="merchandisereturns.selectedOffer.ProviderSystemName"/>
                            <input type="hidden" name="ReturnShippingOption" v-bind:value="merchandisereturns.selectedOffer.OptionCode"/>
                        </template>
                    </div>
                }
                @* why the return could not be submitted as it is, e.g. a quantity another return took meanwhile *@
                <span class="field-validation-error d-block" v-if="merchandisereturns.estimateError">{{ merchandisereturns.estimateError }}</span>
                <div class="mt-2 d-flex gap-2" style="display: none" v-show="true">
                    <button type="button" class="btn btn-outline-secondary" v-on:click="merchandisereturns.back()">@Loc["MerchandiseReturns.Wizard.Back"]</button>
                    <button type="button" class="btn btn-secondary" v-on:click="validate().then(ok => ok && merchandisereturns.toSummary())">@Loc["MerchandiseReturns.Wizard.Next"]</button>
                </div>
                </section>
                <section class="return-step return-step-summary" v-show="merchandisereturns.step === 3">
                    @*
                        Text bindings only: the product and method names come from the database and the providers.
                        The amounts are worked out on the server as the refund will be.
                    *@
                    <div class="return-summary mt-3" style="display: none" v-show="true">
                        <ul class="list-unstyled mb-2">
                            <li v-for="line in merchandisereturns.summaryItems" v-bind:key="line.id">{{ line.quantity }} × {{ line.name }}</li>
                        </ul>
                        <p class="mb-2" v-if="merchandisereturns.selectedOffer">@Loc["MerchandiseReturns.ReturnShipping.Title"]: {{ merchandisereturns.selectedOffer.Name }}</p>
                        <div class="return-estimate card" v-if="merchandisereturns.estimate">
                            <div class="card-body">
                                <h2 class="h6">@Loc["MerchandiseReturns.Estimate.Title"]</h2>
                                <div>@Loc["MerchandiseReturns.Estimate.ItemsAmount"]: {{ merchandisereturns.estimate.ItemsAmount }}</div>
                                <div>@Loc["MerchandiseReturns.Estimate.ReturnShippingCost"]: {{ merchandisereturns.estimate.ReturnShippingCost }}</div>
                                <div class="fw-bold">@Loc["MerchandiseReturns.Estimate.Title"]: {{ merchandisereturns.estimate.Amount }}</div>
                                <p class="return-refund-destination mt-2 mb-0" v-if="merchandisereturns.estimate.ToPaymentMethod">@Loc["MerchandiseReturns.Estimate.Destination"]</p>
                                <small class="text-muted d-block">@Loc["MerchandiseReturns.Estimate.Note"]</small>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 d-flex gap-2 mt-2 mb-1">
                            <button type="button" class="btn btn-outline-secondary" style="display: none" v-show="true" v-on:click="merchandisereturns.back()">@Loc["MerchandiseReturns.Wizard.Back"]</button>
                            <input type="submit" name="submit-return-request" class="btn btn-secondary submit-return-request-button" value="@Loc["MerchandiseReturns.Submit"]" v-bind:disabled="merchandisereturns.submitting"/>
                        </div>
                    </div>
                </section>
            </form>
        </validation-observer>
    }
</div>
@*
    PickupDate is formatted for <input type="date">, which only accepts
    yyyy-MM-dd. It used to be written out with the server's default DateTime
    formatting, so the input silently rejected it and came up empty.
*@
<script type="application/json" data-grand-vm="merchandiseReturn">@Json.Serialize(new {
                                                                    showPickupDate = Model.ShowPickupDate,
                                                                    pickupDate = Model.PickupDate?.ToString("yyyy-MM-dd"),
                                                                    itemIds = Model.Items.Select(item => item.Id),
                                                                    items = Model.Items.Select(item => new { id = item.Id, name = item.ProductName }),
                                                                    photoReasonIds = Model.AvailableReturnReasons.Where(x => x.PhotoRequired).Select(x => x.Id),
                                                                    photosRequired = Loc["MerchandiseReturns.Photos.Required"].Value,
                                                                    photosInvalid = Loc["MerchandiseReturns.Photos.Invalid"].Value,
                                                                    nothingChosen = Loc["MerchandiseReturns.NoItemsSubmitted"].Value,
                                                                    photoTypes,
                                                                    maxPhotoBytes = Grand.Web.Extensions.MerchandiseReturnUploads.MaxFileBytes,
                                                                    maxPhotosPerItem = Grand.Web.Extensions.MerchandiseReturnUploads.MaxPhotosPerItem,
                                                                    maxPhotosPerSubmit = Grand.Web.Extensions.MerchandiseReturnUploads.MaxPhotosPerSubmit,
                                                                    estimateUrl = Url.RouteUrl("MerchandiseReturnEstimate", new { orderId = Model.OrderId }),
                                                                    returnShipping = Model.ReturnShippingEnabled,
                                                                    choosePoint = Model.ReturnShippingEnabled
                                                                        ? Loc["MerchandiseReturns.ReturnShipping.InStore.ChoosePoint"].Value
                                                                        : null,
                                                                    offersUrl = Model.ReturnShippingEnabled
                                                                        ? Url.RouteUrl("MerchandiseReturnShippingOffers", new { orderId = Model.OrderId })
                                                                        : null
                                                                })</script>