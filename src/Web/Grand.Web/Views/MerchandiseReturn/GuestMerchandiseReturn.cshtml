@model GuestMerchandiseReturnModel
@inject IPageHeadBuilder pagebuilder
@{
    Layout = "_SingleColumn";

    //title
    pagebuilder.AddTitleParts(Loc["MerchandiseReturns.Guest.Title"]);
}
@* a guest who ordered without an account asks for a link to the order's e-mail address;
   the page answers the same whatever was found *@
<div class="page guest-merchandise-return-page">
    <h1 class="generalTitle h2">@Loc["MerchandiseReturns.Guest.Title"]</h1>
    @if (!string.IsNullOrEmpty(Model.Result))
    {
        <div class="result alert alert-info mt-3">
            @Model.Result
        </div>
    }
    <form asp-route="GuestMerchandiseReturn" method="post">
        <div asp-validation-summary="All" class="message-error"></div>
        <p>@Loc["MerchandiseReturns.Guest.Intro"]</p>
        <div class="form-group">
            <label asp-for="OrderNumber" class="col-form-label">@Loc["MerchandiseReturns.Guest.OrderNumber"]:</label>
            <input asp-for="OrderNumber" class="form-control" inputmode="numeric" autofocus="autofocus"/>
        </div>
        <div class="form-group">
            <label asp-for="Email" class="col-form-label">@Loc["MerchandiseReturns.Guest.Email"]:</label>
            <input asp-for="Email" class="form-control" type="email" autocomplete="email"/>
        </div>
        @if (Model.DisplayCaptcha)
        {
            <div class="form-group">
                <div class="captcha-box">
                    <captcha/>
                </div>
            </div>
        }
        <div class="row text-xs-center mt-3">
            <div class="col-12">
                <button type="submit" class="btn btn-secondary guest-merchandise-return-button">@Loc["MerchandiseReturns.Guest.Send"]</button>
            </div>
        </div>
    </form>
</div>
