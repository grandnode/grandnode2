@model GuestOrderModel
@inject IPageHeadBuilder pagebuilder
@{
    Layout = "_SingleColumn";

    //title
    pagebuilder.AddTitleParts(Loc["Order.Guest.Title"]);
}
@* a guest who ordered without an account asks for a link to the order's e-mail address;
   the page answers the same whatever was found *@
<div class="page guest-order-page">
    <h1 class="generalTitle h2">@Loc["Order.Guest.Title"]</h1>
    @if (!string.IsNullOrEmpty(Model.Result))
    {
        <div class="result alert alert-info mt-3">
            @Model.Result
        </div>
    }
    <form asp-route="GuestOrder" method="post">
        <div asp-validation-summary="All" class="message-error"></div>
        <p>@Loc["Order.Guest.Intro"]</p>
        <div class="form-group">
            <label asp-for="OrderNumberOrCode" class="col-form-label">@Loc["Order.Guest.OrderNumberOrCode"]:</label>
            <input asp-for="OrderNumberOrCode" class="form-control" autocapitalize="characters" autocomplete="off" spellcheck="false" autofocus="autofocus"/>
        </div>
        <div class="form-group">
            <label asp-for="Email" class="col-form-label">@Loc["Order.Guest.Email"]:</label>
            <input asp-for="Email" class="form-control" type="email" autocomplete="email"/>
        </div>
        @if (Model.DisplayCaptcha)
        {
            <div class="form-group">
                <div class="captcha-box">
                    <captcha/>
                </div>
            </div>
        }
        <div class="row text-xs-center mt-3">
            <div class="col-12">
                <button type="submit" class="btn btn-secondary guest-order-button">@Loc["Order.Guest.Send"]</button>
            </div>
        </div>
    </form>
</div>
