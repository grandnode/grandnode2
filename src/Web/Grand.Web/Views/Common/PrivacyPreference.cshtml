@model IList<PrivacyPreferenceModel>
<div class="modal fade" id="ModalPrivacyPreference" tabindex="-1" aria-labelledby="ModalPrivacyPreference-label" aria-hidden="true" :dark-theme="darkMode">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ModalPrivacyPreference-label">@Loc["PrivacyPreference.Center"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
    <div class="alert">
        @Loc["PrivacyPreference.Description"]
    </div>
    @if (Model.Any())
    {
        <form id="frmPrivacyPreference">
            <div class="mt-3">
                @foreach (var item in Model)
                {
                    <div class="d-inline-flex align-items-start justify-content-between w-100 mb-3">
                        <div class="d-flex flex-column">
                            <div class="h5">@item.Name</div>
                            <div>@item.Description</div>
                        </div>
                        <div class="form-check form-switch">
                            <input
                                @if (!item.AllowToDisable)
                                {
                                    <text> checked</text>
                                }
                                @if (item.State)
                                {
                                    <text> checked</text>
                                }
                                type="checkbox"
                                value="@item.SystemName" class="form-check-input" id="ConsentCookies_@item.SystemName" name="ConsentCookies_@item.SystemName">
                            <label class="form-check-label" for="ConsentCookies_@item.SystemName"></label>
                        </div>
                    </div>
                }
                <input type="button" class="btn btn-info w-100" data-bs-dismiss="modal" @@click="vm.savePrivacyPreference('@Url.RouteUrl("PrivacyPreference")')" value="Save"/>
            </div>
        </form>
    }
</div>
        </div>
    </div>
</div>