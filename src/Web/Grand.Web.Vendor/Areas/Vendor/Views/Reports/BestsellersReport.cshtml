@model BestsellersReportModel
@{
    //page title
    ViewBag.Title = Loc["Vendor.Reports.Bestsellers"];
}

@* The shared bestsellers report's shape, minus the store, order status and vendor criteria the
   vendor panel never offered: the filter bar opened on load, the grid in a flush card, Search as
   the one primary action. The ids the script below looks up are unchanged. *@
<admin-page title="@Loc["Vendor.Reports.Bestsellers"]" icon="bi-card-list">
    <vc:vendor-widget widget-zone="vendor_bestsellers_report" additional-data="Model"/>

    <admin-filters id="salesreport-filters" submit-id="search-salesreport" expanded="true">
        <div class="grand-range">
            <admin-field asp-for="StartDate"/>
            <admin-field asp-for="EndDate"/>
        </div>
        <admin-field asp-for="PaymentStatusId" asp-items="Model.AvailablePaymentStatuses"/>
        <admin-field asp-for="BillingCountryId" asp-items="Model.AvailableCountries"/>
    </admin-filters>

    <admin-card flush>
        <admin-grid id="salesreport-grid"
                    read-url="@Url.Action("BestsellersReportList", "Reports", new { area = Constants.AreaVendor })"
                    additional-data="additionalData">
            <grid-column field="ProductName" title="@Loc["Vendor.Reports.Bestsellers.Fields.Name"]">
                <cell-template>
                    <a class="text-decoration-none" href="@Url.Action("Edit", "Product", new { area = Constants.AreaVendor })/{{ ProductId }}">{{ ProductName }}</a>
                </cell-template>
            </grid-column>
            <grid-column field="TotalQuantity" title="@Loc["Vendor.Reports.Bestsellers.Fields.TotalQuantity"]"/>
            <grid-column field="TotalAmount" title="@Loc["Vendor.Reports.Bestsellers.Fields.TotalAmount"]"/>
        </admin-grid>
    </admin-card>
</admin-page>

<script>

    $(document).ready(function () {

        $('#search-salesreport').click(function () {
            var grid = GrandAdmin.grids.get('#salesreport-grid');
            grid.dataSource.page(1); //new search. Set page size to 1
            //grid.dataSource.read(); we already loaded the grid above using "page" function
            return false;
        });

    });

    function additionalData() {
        var data = {
            StartDate: $('#@Html.IdFor(model => model.StartDate)').val(),
            EndDate: $('#@Html.IdFor(model => model.EndDate)').val(),
            StoreId: $('#StoreId').val(),
            PaymentStatusId: $('#PaymentStatusId').val(),
            BillingCountryId: $('#BillingCountryId').val(),
            VendorId: $('#VendorId').val()
        };
        addAntiForgeryToken(data);
        return data;
    }

</script>