@model CountryReportModel
@{
    //page title
    ViewBag.Title = Loc["Vendor.Reports.Country"];
}

@* The shared country report's shape, without the order status criterion the vendor panel never
   offered: the filter bar opened on load, the grid in a flush card, Search as the one primary
   action. The ids the script below looks up are unchanged. *@
<admin-page title="@Loc["Vendor.Reports.Country"]" icon="bi-card-list">
    <vc:vendor-widget widget-zone="vendor_country_report" additional-data="Model"/>

    <admin-filters id="countryreport-filters" submit-id="search-countryreport" expanded="true">
        <div class="grand-range">
            <admin-field asp-for="StartDate"/>
            <admin-field asp-for="EndDate"/>
        </div>
        <admin-field asp-for="PaymentStatusId" asp-items="Model.AvailablePaymentStatuses"/>
    </admin-filters>

    <admin-card flush>
        <admin-grid id="countryreport-grid"
                    read-url="@Url.Action("CountryReportList", "Reports", new { area = Constants.AreaVendor })"
                    additional-data="additionalData"
                    pager="Compact">
            <grid-column field="CountryName" title="@Loc["Vendor.Reports.Country.Fields.CountryName"]"/>
            <grid-column field="TotalOrders" title="@Loc["Vendor.Reports.Country.Fields.TotalOrders"]"/>
            <grid-column field="SumOrders" title="@Loc["Vendor.Reports.Country.Fields.SumOrders"]"/>
        </admin-grid>
    </admin-card>
</admin-page>

<script>

        $(document).ready(function () {

            $('#search-countryreport').click(function () {
                var grid = $('#countryreport-grid').data('kendoGrid');
                grid.dataSource.read();
                return false;
            });

        });

        function additionalData() {
            var data = {
                StartDate: $('#@Html.IdFor(model => model.StartDate)').val(),
                EndDate: $('#@Html.IdFor(model => model.EndDate)').val(),
                OrderStatusId: $('#OrderStatusId').val(),
                PaymentStatusId: $('#PaymentStatusId').val()
            };
            addAntiForgeryToken(data);
            return data;
        }

    </script>