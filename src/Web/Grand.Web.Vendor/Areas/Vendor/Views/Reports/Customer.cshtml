@model CustomerReportsModel
@{
    //page title
    ViewBag.Title = Loc["Vendor.Reports.Customer"];
}

@* The vendor panel keeps one report (best customers by order total) instead of the shared tabs:
   the filter bar opened on load, the grid in a flush card, Search as the one primary action. The
   ids the script below looks up are unchanged, the grid's odd id included. *@
<admin-page title="@Loc["Vendor.Reports.Customer"]" icon="bi-card-list">
    <vc:vendor-widget widget-zone="vendor_customer_report" additional-data="Model"/>

    <admin-filters id="customerreport-filters" submit-id="search-customerreport" expanded="true">
        <div class="grand-range">
            <admin-field asp-for="BestCustomersByOrderTotal.StartDate"/>
            <admin-field asp-for="BestCustomersByOrderTotal.EndDate"/>
        </div>
        <admin-field asp-for="BestCustomersByOrderTotal.PaymentStatusId" asp-items="Model.BestCustomersByOrderTotal.AvailablePaymentStatuses"/>
    </admin-filters>

    <admin-card flush>
        <admin-grid id="bestsellers-byamount-grid"
                    read-url="@Url.Action("ReportBestCustomersByOrderTotalList", "Reports", new { area = Constants.AreaVendor })"
                    additional-data="additionalData">
            <grid-column field="CustomerName" title="@Loc["Vendor.Reports.Customer.BestBy.Fields.Customer"]"/>
            <grid-column field="OrderTotal" title="@Loc["Vendor.Reports.Customer.BestBy.Fields.OrderTotal"]"/>
            <grid-column field="OrderCount" title="@Loc["Vendor.Reports.Customer.BestBy.Fields.OrderCount"]"/>
        </admin-grid>
    </admin-card>
</admin-page>

<script>

        $(document).ready(function () {

            $('#search-customerreport').click(function () {
                var grid = $('#bestsellers-byamount-grid').data('kendoGrid');
                grid.dataSource.read();
                return false;
            });

        });

        function additionalData() {
            var data = {
                StartDate: $('#@Html.IdFor(model => model.BestCustomersByOrderTotal.StartDate)').val(),
                EndDate: $('#@Html.IdFor(model => model.BestCustomersByOrderTotal.EndDate)').val(),
                PaymentStatusId: $('#@Html.IdFor(model => model.BestCustomersByOrderTotal.PaymentStatusId)').val()
            };
            addAntiForgeryToken(data);
            return data;
        }

    </script>