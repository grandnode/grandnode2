@inject IContextAccessor contextAccessor
@{
    //page title
    ViewBag.Title = Loc["Vendor.Dashboard"];
}

<div class="grand-dashboard">
    <vc:vendor-widget widget-zone="vendor_dashboard_top" additional-data="null"/>

    <header class="grand-dashboard__header">
        <div>
            <h1 class="grand-dashboard__title">@Loc["Vendor.Dashboard"]</h1>
            <p class="grand-dashboard__subtitle">
                <i class="bi bi-person-badge" aria-hidden="true"></i>
                <span>@contextAccessor.WorkContext.CurrentVendor.Name</span>
            </p>
        </div>
        <button type="button" id="dashboard-report-range" class="btn grand-dashboard__range" title="@Loc["Vendor.Dashboard.Summary"]">
            <i class="bi bi-calendar3" aria-hidden="true"></i>
            <span class="grand-dashboard__range-text"></span>
            <i class="bi bi-chevron-down" aria-hidden="true"></i>
        </button>
    </header>

    <vc:vendor-page system-name="VendorPortalInfo"/>

    <section class="grand-card" aria-labelledby="dashboard-latest-orders">
        <header class="grand-card__header">
            <i class="bi bi-receipt grand-card__icon" aria-hidden="true"></i>
            <h2 id="dashboard-latest-orders" class="grand-card__title">@Loc["Vendor.Dashboard.ReportLatestOrder"]</h2>
            <a class="grand-card__action" href="@Url.Action("List", "Order", new { area = Constants.AreaVendor })">
                @Loc["Admin.Dashboard.ViewMore"]
                <i class="bi bi-arrow-right grand-card__action-arrow" aria-hidden="true"></i>
            </a>
        </header>
        <div class="grand-card__body">
            @await Component.InvokeAsync("LatestVendorOrder")
        </div>
    </section>

    <div class="row g-3">
        <div class="col-12 col-xl-6">
            <section class="grand-card h-100" aria-labelledby="dashboard-bestsellers-quantity">
                <header class="grand-card__header">
                    <i class="bi bi-trophy grand-card__icon" aria-hidden="true"></i>
                    <h2 id="dashboard-bestsellers-quantity" class="grand-card__title">@Loc["Vendor.Reports.BestSellers.ByQuantity"]</h2>
                </header>
                <div class="grand-card__body">
                    <vc:vendor-bestsellers-brief-report-by-quantity></vc:vendor-bestsellers-brief-report-by-quantity>
                </div>
            </section>
        </div>
        <div class="col-12 col-xl-6">
            <section class="grand-card h-100" aria-labelledby="dashboard-bestsellers-amount">
                <header class="grand-card__header">
                    <i class="bi bi-cash-coin grand-card__icon" aria-hidden="true"></i>
                    <h2 id="dashboard-bestsellers-amount" class="grand-card__title">@Loc["Vendor.Reports.BestSellers.ByAmount"]</h2>
                </header>
                <div class="grand-card__body">
                    <vc:vendor-bestsellers-brief-report-by-amount></vc:vendor-bestsellers-brief-report-by-amount>
                </div>
            </section>
        </div>
    </div>

    <vc:vendor-widget widget-zone="vendor_dashboard_bottom" additional-data="null"/>
</div>
<partial name="Partials/DashboardRange"/>
