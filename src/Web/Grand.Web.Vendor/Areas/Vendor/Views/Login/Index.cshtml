@using Grand.Web.AdminShared.Models.Common
@model LoginModel
@{
    //page title
    Layout = Constants.LayoutVendorLogin;
}

<form asp-route="VendorLogin" method="post" class="grand-page grand-login__panel">
    <div class="grand-login__brand">
        <img src="@(Grand.SharedUIResources.Constants.WwwRoot)/administration/build/images/grand-logo.svg" width="40" height="40" alt=""/>
        <span>GrandNode</span>
    </div>
    <div class="grand-card">
        <div class="grand-card__body">
            <div class="grand-login__heading">
                <span class="grand-login__icon"><i class="bi bi-person-lock" aria-hidden="true"></i></span>
                <h1 class="grand-login__title">@Loc["Vendor.Login.Title"]</h1>
            </div>
            <div asp-validation-summary="All"></div>
            <div class="grand-fields">
                @if (Model.UsernamesEnabled)
                {
                    <div class="grand-field">
                        <label asp-for="Username" class="grand-field__label">@Loc["Vendor.Login.UserName"]</label>
                        <div class="grand-field__control">
                            <input asp-for="Username" class="form-control username" autocomplete="username" autofocus="autofocus"/>
                        </div>
                        <span asp-validation-for="Username"></span>
                    </div>
                }
                else
                {
                    <div class="grand-field">
                        <label asp-for="Email" class="grand-field__label">@Loc["Vendor.Login.Email"]</label>
                        <div class="grand-field__control">
                            <input asp-for="Email" class="form-control email" autocomplete="email" autofocus="autofocus"/>
                        </div>
                        <span asp-validation-for="Email"></span>
                    </div>
                }
                <div class="grand-field">
                    <label asp-for="Password" class="grand-field__label">@Loc["Vendor.Login.Password"]</label>
                    <div class="grand-field__control">
                        <input asp-for="Password" class="form-control password" autocomplete="off"/>
                    </div>
                    <span asp-validation-for="Password"></span>
                </div>
                <div class="grand-login__options">
                    <div class="grand-field grand-field--check">
                        <div class="grand-field__control">
                            <input class="form-check-input" asp-for="RememberMe"/>
                            <input name="RememberMe" type="hidden" value="false">
                        </div>
                        <label class="grand-field__label" asp-for="RememberMe">@Loc["Vendor.Login.RememberMe"]</label>
                    </div>
                    <a class="grand-login__link forgot-password" asp-route="VendorPasswordRecovery">@Loc["Vendor.Login.ForgotPassword"]</a>
                </div>
                @if (Model.DisplayCaptcha)
                {
                    <div class="captcha-box">
                        <captcha/>
                    </div>
                }
            </div>
            <input class="btn btn-primary grand-login__submit login-button" type="submit" value="@Loc["Vendor.Login.LoginButton"]"/>
        </div>
    </div>
</form>