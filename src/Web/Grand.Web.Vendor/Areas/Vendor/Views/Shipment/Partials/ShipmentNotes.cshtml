@model ShipmentModel

<div class="grand-card">
    <partial name="Partials/WidgetZone.Notes.Top" model="Model"/>
    <div class="grand-card__body grand-card__body--flush">
        <admin-grid id="shipmentnotes-grid"
                    read-url="@Url.Action("ShipmentNotesSelect", "Shipment", new { shipmentId = Model.Id, area = Constants.AreaVendor })"
                    destroy-url="@Url.Action("ShipmentNoteDelete", "Shipment", new { shipmentId = Model.Id, area = Constants.AreaVendor })"
                    pager="Compact">
            <grid-column field="CreatedOn" title="@Loc["Vendor.Orders.Shipments.ShipmentNotes.CreatedOn"]" width="180" format="{0:G}"/>
            <grid-column field="Note" title="@Loc["Vendor.Orders.Shipments.ShipmentNotes.Note"]" width="350"/>
            <grid-column field="CreatedByCustomer" title="@Loc["Vendor.Orders.Shipments.ShipmentNotes.CreatedByCustomer"]" width="100" align="Center">
                <cell-template>
                    <i data-if="CreatedByCustomer" class="bi bi-check-lg text-success" aria-hidden="true"></i>
                    <i data-else class="bi bi-x-lg text-danger" aria-hidden="true"></i>
                </cell-template>
            </grid-column>
            <grid-column field="DisplayToCustomer" title="@Loc["Vendor.Orders.Shipments.ShipmentNotes.Fields.DisplayToCustomer"]" width="100" align="Center">
                <cell-template>
                    <i data-if="DisplayToCustomer" class="bi bi-check-lg text-success" aria-hidden="true"></i>
                    <i data-else class="bi bi-x-lg text-danger" aria-hidden="true"></i>
                </cell-template>
            </grid-column>
            <grid-commands destroy="true" title="@Loc["Vendor.Common.Delete"]" width="100"/>
        </admin-grid>
    </div>
    <partial name="Partials/WidgetZone.Notes.Bottom" model="Model"/>
</div>


<admin-card title="@Loc["Vendor.Orders.Shipments.ShipmentNotes.AddTitle"]">
    <div class="grand-fields">
        <admin-field asp-for="AddShipmentNoteMessage">
            <admin-textarea asp-for="AddShipmentNoteMessage"></admin-textarea>
        </admin-field>
        <admin-field asp-for="AddShipmentNoteDisplayToCustomer"/>
    </div>
    <div class="mt-3">
        <button type="button" id="addShipmentNote" class="btn btn-outline-secondary btn-sm"><i class="bi bi-plus-lg"></i> @Loc["Vendor.Orders.Shipments.ShipmentNotes.AddButton"]</button>
    </div>
</admin-card>

<script>
    $(document).ready(function () {
        $('#addShipmentNote').click(function () {
            var shipmentNoteMessage = $("#@Html.IdFor(model => model.AddShipmentNoteMessage)").val();
            if (shipmentNoteMessage.length == 0) {
                alert('Message text is required');
                return;
            }
            
            var shipmentNoteDisplayToCustomer = $("#@Html.IdFor(model => model.AddShipmentNoteDisplayToCustomer)").is(':checked');
            $('#addShipmentNote').attr('disabled', true);
            var postData = {
                DisplayToCustomer: shipmentNoteDisplayToCustomer,
                message: shipmentNoteMessage,                
                shipmentId: '@Model.Id'
            };
            addAntiForgeryToken(postData);

            $.ajax({
                cache:false,
                type: "POST",
                url: "@(Url.Action("ShipmentNoteAdd", "Shipment", new { area = Constants.AreaVendor }))",
                data: postData,
                success: function (data) {
                    var grid = GrandAdmin.grids.get("#shipmentnotes-grid");
                    grid.dataSource.read();
                    $('#addShipmentNote').attr('disabled', false);
                },
                error:function (xhr, ajaxOptions, thrownError){
                    alert('Failed to add shipment note.');
                    $('#addShipmentNote').attr('disabled', false);
                }
            });
        });
    });
</script>