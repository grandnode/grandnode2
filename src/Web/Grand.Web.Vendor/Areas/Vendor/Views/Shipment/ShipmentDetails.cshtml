@model ShipmentModel
@{
    //page title
    ViewBag.Title = Loc["Vendor.Orders.Shipments.ViewDetails"];
}
<form asp-area="@Constants.AreaVendor" asp-controller="Shipment" asp-action="ShipmentDetails" method="post">
    <input type="hidden" asp-for="Id"/>
    <div asp-validation-summary="All"></div>
    <div class="row">
        <div class="col-md-12">
            <div class="x_panel light form-fit">
                <div class="x_title">
                    <div class="caption">
                        <i class="bi bi-truck"></i>
                        @Loc["Vendor.Orders.Shipments.ViewDetails"] - @Model.ShipmentNumber
                        <small>
                            <i class="bi bi-arrow-left-circle"></i>
                            @Html.ActionLink(Loc["Vendor.Orders.Shipments.BackToList"], "List")
                        </small>
                    </div>
                    <div class="actions">
                        <div class="btn-group btn-group-devided">
                            @* both notify the customer and cannot be undone, so they ask first and
                               stay out of the info form's Save *@
                            @if (Model.CanShip)
                            {
                                <input type="submit" name="setasshipped" asp-action="SetAsShipped" id="setasshipped"
                                       value="@Loc["Vendor.Orders.Shipments.ShippedDate.Button"]" class="btn btn-success"
                                       onclick="return confirm('@Loc["Vendor.Common.AreYouSure"]');"/>
                            }
                            @if (Model.CanDeliver)
                            {
                                <input type="submit" name="setasdelivered" asp-action="SetAsDelivered" id="setasdelivered"
                                       value="@Loc["Vendor.Orders.Shipments.DeliveryDate.Button"]" class="btn btn-success"
                                       onclick="return confirm('@Loc["Vendor.Common.AreYouSure"]');"/>
                            }
                            <a href="@Url.Action("PdfPackagingSlip", new { shipmentId = Model.Id, area = Constants.AreaVendor })" class="btn purple">
                                <i class="bi bi-file-earmark-pdf"></i> @Loc["Vendor.Orders.Shipments.PrintPackagingSlip"]
                            </a>
                            <span id="shipment-delete" class="btn red">
                                <i class="bi bi-trash"></i> @Loc["Vendor.Common.Delete"]
                            </span>
                            <partial name="Partials/WidgetZone.DetailsButtons" model="Model"/>
                        </div>
                    </div>
                </div>
                <div class="x_content form">
                    <admin-tabstrip name="shipment-edit" SetTabPos="true">
                        <items>
                            <tabstrip-item text="@Loc["Vendor.Orders.Shipments.ViewDetails.Info"]" tab-index="0">
                                <content>
                                    <div>
                                        <partial name="Partials/Info" model="Model"/>
                                    </div>
                                </content>
                            </tabstrip-item>
                            <tabstrip-item text="@Loc["Vendor.Orders.Shipments.ShipmentNotes"]" tab-index="1">
                                <content>
                                    <div>
                                        <partial name="Partials/ShipmentNotes" model="Model"/>
                                    </div>
                                </content>
                            </tabstrip-item>
                            <partial name="Partials/WidgetZone.DetailsTabs" model="Model"/>
                        </items>
                    </admin-tabstrip>
                </div>
            </div>

        </div>
    </div>
</form>
<admin-delete-confirmation button-id="shipment-delete" action-name="DeleteShipment"/>