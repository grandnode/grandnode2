@model ShipmentModel
@{
    //page title
    ViewBag.Title = Loc["Vendor.Orders.Shipments.ViewDetails"];
}
<form asp-area="@Constants.AreaVendor" asp-controller="Shipment" asp-action="ShipmentDetails" method="post">
    <input type="hidden" asp-for="Id"/>
    <div asp-validation-summary="All"></div>
    @* The order screen's shell: the shipment number as the title. Shipping and delivering
       notify the customer and cannot be undone, so they ask first and stay outline buttons
       beside the packaging slip; the Info tab's Save is the screen's one primary action, and
       Delete is in the overflow menu. *@
    <admin-page sticky
                title="@Model.ShipmentNumber.ToString()"
                icon="bi-truck"
                meta="@Loc["Vendor.Orders.Shipments.ViewDetails"]"
                back-url="@Url.Action("List")"
                back-text="@Loc["Vendor.Orders.Shipments.BackToList"]">
        <page-actions>
            @if (Model.CanShip)
            {
                <input type="submit" name="setasshipped" asp-action="SetAsShipped" id="setasshipped"
                       value="@Loc["Vendor.Orders.Shipments.ShippedDate.Button"]" class="btn btn-outline-secondary"
                       data-grand-confirm="@Loc["Vendor.Common.AreYouSure"]" data-confirm-title="@Loc["Vendor.Orders.Shipments.ShippedDate.Button"]"/>
            }
            @if (Model.CanDeliver)
            {
                <input type="submit" name="setasdelivered" asp-action="SetAsDelivered" id="setasdelivered"
                       value="@Loc["Vendor.Orders.Shipments.DeliveryDate.Button"]" class="btn btn-outline-secondary"
                       data-grand-confirm="@Loc["Vendor.Common.AreYouSure"]" data-confirm-title="@Loc["Vendor.Orders.Shipments.DeliveryDate.Button"]"/>
            }
            <a href="@Url.Action("PdfPackagingSlip", new { shipmentId = Model.Id, area = Constants.AreaVendor })" class="btn btn-outline-secondary">
                <i class="bi bi-file-earmark-pdf"></i> @Loc["Vendor.Orders.Shipments.PrintPackagingSlip"]
            </a>
            <admin-action-menu>
                <admin-action id="shipment-delete" destructive="true" icon="bi-trash"
                              text="@Loc["Vendor.Common.Delete"]"/>
            </admin-action-menu>
            <partial name="Partials/WidgetZone.DetailsButtons" model="Model"/>
        </page-actions>

        <admin-tabstrip name="shipment-edit" SetTabPos="true">
            <items>
                <tabstrip-item text="@Loc["Vendor.Orders.Shipments.ViewDetails.Info"]" tab-index="0">
                    <content>
                        <div>
                            <partial name="Partials/Info" model="Model"/>
                        </div>
                    </content>
                </tabstrip-item>
                <tabstrip-item text="@Loc["Vendor.Orders.Shipments.ShipmentNotes"]" tab-index="1">
                    <content>
                        <div>
                            <partial name="Partials/ShipmentNotes" model="Model"/>
                        </div>
                    </content>
                </tabstrip-item>
                <partial name="Partials/WidgetZone.DetailsTabs" model="Model"/>
            </items>
        </admin-tabstrip>
    </admin-page>
</form>
<admin-delete-confirmation button-id="shipment-delete" action-name="DeleteShipment"/>