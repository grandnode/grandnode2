@using Constants = Grand.SharedUIResources.Constants
@model OrderModel
@* Two cards side by side, billing and shipping; a vendor reads the addresses, it does not edit
   them. *@
<vc:vendor-widget widget-zone="vendor_order_details_address_top" additional-data="Model"/>
<div class="grand-fields grand-fields--2col">
@if (Model.BillingAddress is { } billingAddress)
{
    <admin-card title="@Loc["Vendor.Orders.BillingInfo"]">
        <table class="table table-sm mb-0">
            @if (billingAddress.FirstNameEnabled || billingAddress.LastNameEnabled)
            {
                <tr>
                    <td class="grand-fact__label">@Loc["Vendor.Orders.Address.FullName"]</td>
                    <td>@billingAddress.FirstName @billingAddress.LastName</td>
                </tr>
            }
            @if (billingAddress.EmailEnabled)
            {
                <tr>
                    <td class="grand-fact__label">@Loc["Vendor.Orders.Address.Email"]</td>
                    <td>@billingAddress.Email</td>
                </tr>
            }
            @if (billingAddress.PhoneEnabled)
            {
                <tr>
                    <td class="grand-fact__label">@Loc["Vendor.Orders.Address.Phone"]</td>
                    <td>@billingAddress.PhoneNumber</td>
                </tr>
            }
            @if (billingAddress.FaxEnabled)
            {
                <tr>
                    <td class="grand-fact__label">@Loc["Vendor.Orders.Address.Fax"]</td>
                    <td>@billingAddress.FaxNumber</td>
                </tr>
            }
            @if (billingAddress.CompanyEnabled)
            {
                <tr>
                    <td class="grand-fact__label">@Loc["Vendor.Orders.Address.Company"]</td>
                    <td>@billingAddress.Company</td>
                </tr>
            }
            @if (billingAddress.VatNumberEnabled)
            {
                <tr>
                    <td class="grand-fact__label">@Loc["Vendor.Orders.Address.VatNumber"]</td>
                    <td>@billingAddress.VatNumber</td>
                </tr>
            }
            @if (billingAddress.StreetAddressEnabled)
            {
                <tr>
                    <td class="grand-fact__label">@Loc["Vendor.Orders.Address.Address1"]</td>
                    <td>@billingAddress.Address1</td>
                </tr>
            }
            @if (billingAddress.StreetAddress2Enabled)
            {
                <tr>
                    <td class="grand-fact__label">@Loc["Vendor.Orders.Address.Address2"]</td>
                    <td>@billingAddress.Address2</td>
                </tr>
            }
            @if (billingAddress.CityEnabled)
            {
                <tr>
                    <td class="grand-fact__label">@Loc["Vendor.Orders.Address.City"]</td>
                    <td>@billingAddress.City</td>
                </tr>
            }
            @if (billingAddress.StateProvinceEnabled)
            {
                <tr>
                    <td class="grand-fact__label">@Loc["Vendor.Orders.Address.StateProvince"]</td>
                    <td>@billingAddress.StateProvinceName</td>
                </tr>
            }
            @if (billingAddress.ZipPostalCodeEnabled)
            {
                <tr>
                    <td class="grand-fact__label">@Loc["Vendor.Orders.Address.ZipPostalCode"]</td>
                    <td>@billingAddress.ZipPostalCode</td>
                </tr>
            }
            @if (billingAddress.CountryEnabled)
            {
                <tr>
                    <td class="grand-fact__label">@Loc["Vendor.Orders.Address.Country"]</td>
                    <td>@billingAddress.CountryName</td>
                </tr>
            }
            @if (!string.IsNullOrEmpty(billingAddress.FormattedCustomAddressAttributes))
            {
                <tr class="custom-attributes-view">
                    <td colspan="2">
                        @Html.Raw(billingAddress.FormattedCustomAddressAttributes)
                    </td>
                </tr>
            }
        </table>
    </admin-card>
}

@if (Model.IsShippable)
{
    <admin-card title="@Loc["Vendor.Orders.ShippingInfo"]">
        @if (Model.ShippingAddress != null)
        {
            <table class="table table-sm mb-0">
                @if (Model.ShippingAddress.FirstNameEnabled || Model.ShippingAddress.LastNameEnabled)
                {
                    <tr>
                        <td class="grand-fact__label">@Loc["Vendor.Orders.Address.FullName"]</td>
                        <td>@Model.ShippingAddress.FirstName @Model.ShippingAddress.LastName</td>
                    </tr>
                }
                @if (Model.ShippingAddress.EmailEnabled)
                {
                    <tr>
                        <td class="grand-fact__label">@Loc["Vendor.Orders.Address.Email"]</td>
                        <td>@Model.ShippingAddress.Email</td>
                    </tr>
                }
                @if (Model.ShippingAddress.PhoneEnabled)
                {
                    <tr>
                        <td class="grand-fact__label">@Loc["Vendor.Orders.Address.Phone"]</td>
                        <td>@Model.ShippingAddress.PhoneNumber</td>
                    </tr>
                }
                @if (Model.ShippingAddress.FaxEnabled)
                {
                    <tr>
                        <td class="grand-fact__label">@Loc["Vendor.Orders.Address.Fax"]</td>
                        <td>@Model.ShippingAddress.FaxNumber</td>
                    </tr>
                }
                @if (Model.ShippingAddress.CompanyEnabled)
                {
                    <tr>
                        <td class="grand-fact__label">@Loc["Vendor.Orders.Address.Company"]</td>
                        <td>@Model.ShippingAddress.Company</td>
                    </tr>
                }
                @if (Model.ShippingAddress.StreetAddressEnabled)
                {
                    <tr>
                        <td class="grand-fact__label">@Loc["Vendor.Orders.Address.Address1"]</td>
                        <td>@Model.ShippingAddress.Address1</td>
                    </tr>
                }
                @if (Model.ShippingAddress.StreetAddress2Enabled)
                {
                    <tr>
                        <td class="grand-fact__label">@Loc["Vendor.Orders.Address.Address2"]</td>
                        <td>@Model.ShippingAddress.Address2</td>
                    </tr>
                }
                @if (Model.ShippingAddress.CityEnabled)
                {
                    <tr>
                        <td class="grand-fact__label">@Loc["Vendor.Orders.Address.City"]</td>
                        <td>@Model.ShippingAddress.City</td>
                    </tr>
                }
                @if (Model.ShippingAddress.StateProvinceEnabled)
                {
                    <tr>
                        <td class="grand-fact__label">@Loc["Vendor.Orders.Address.StateProvince"]</td>
                        <td>@Model.ShippingAddress.StateProvinceName</td>
                    </tr>
                }
                @if (Model.ShippingAddress.ZipPostalCodeEnabled)
                {
                    <tr>
                        <td class="grand-fact__label">@Loc["Vendor.Orders.Address.ZipPostalCode"]</td>
                        <td>@Model.ShippingAddress.ZipPostalCode</td>
                    </tr>
                }
                @if (Model.ShippingAddress.CountryEnabled)
                {
                    <tr>
                        <td class="grand-fact__label">@Loc["Vendor.Orders.Address.Country"]</td>
                        <td>@Model.ShippingAddress.CountryName</td>
                    </tr>
                }
                @if (!string.IsNullOrEmpty(Model.ShippingAddress.FormattedCustomAddressAttributes))
                {
                    <tr class="custom-attributes-view">
                        <td colspan="2">
                            @Html.Raw(Model.ShippingAddress.FormattedCustomAddressAttributes)
                        </td>
                    </tr>
                }
            </table>
            <div class="mt-3">
                <i class="bi bi-geo-alt"></i>
                <a href="@Html.Raw(Model.ShippingAddressGoogleMapsUrl)" target="_blank">@Loc["Vendor.Orders.Fields.ShippingAddress.ViewOnGoogleMaps"]</a>
            </div>
        }
        @if (Model.PickupAddress != null)
        {
            <div class="mt-3">
                <admin-label asp-for="PickupAddress" asp-display-hint="false" class="grand-fact__label"/>
                <table class="table table-sm mb-0">
                    @if (!string.IsNullOrEmpty(Model.PickupAddress.Address1))
                    {
                        <tr>
                            <td class="grand-fact__label">@Loc["Vendor.Orders.Address.Address1"]</td>
                            <td>@Model.PickupAddress.Address1</td>
                        </tr>
                    }
                    @if (!string.IsNullOrEmpty(Model.PickupAddress.City))
                    {
                        <tr>
                            <td class="grand-fact__label">@Loc["Vendor.Orders.Address.City"]</td>
                            <td>@Model.PickupAddress.City</td>
                        </tr>
                    }
                    @if (!string.IsNullOrEmpty(Model.PickupAddress.ZipPostalCode))
                    {
                        <tr>
                            <td class="grand-fact__label">@Loc["Vendor.Orders.Address.ZipPostalCode"]</td>
                            <td>@Model.PickupAddress.ZipPostalCode</td>
                        </tr>
                    }
                    @if (!string.IsNullOrEmpty(Model.PickupAddress.CountryName))
                    {
                        <tr>
                            <td class="grand-fact__label">@Loc["Vendor.Orders.Address.Country"]</td>
                            <td>@Model.PickupAddress.CountryName</td>
                        </tr>
                    }
                </table>
            </div>
        }

        <div class="grand-facts mt-3">
            <div>
                <admin-label asp-for="ShippingMethod" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value" id="lblShippingMethod">@Model.ShippingMethod</div>
                @if (!string.IsNullOrEmpty(Model.ShippingAdditionDescription))
                {
                    <div class="grand-field__hint">@Html.Raw(Model.ShippingAdditionDescription)</div>
                }
            </div>
        </div>
    </admin-card>
}
else
{
    <admin-card>
        <div class="note note-info">@Loc["Vendor.Orders.ShippingInfo.NotRequired"]</div>
    </admin-card>
}
</div>

<vc:vendor-widget widget-zone="vendor_order_details_address_bottom" additional-data="Model"/>