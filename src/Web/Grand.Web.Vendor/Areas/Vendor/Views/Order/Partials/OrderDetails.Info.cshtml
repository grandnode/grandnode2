@model OrderModel
@* what the order states, read as facts *@
<vc:vendor-widget widget-zone="vendor_order_details_info_top" additional-data="Model"/>
<admin-card>
    <div class="grand-facts">
        <div>
            <admin-label asp-for="OrderNumber" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Model.OrderNumber</div>
        </div>
        @if (Model.OrderStatusId == (int)OrderStatusSystem.Cancelled)
        {
            <div>
                <admin-label asp-for="OrderStatus" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value"><span class="grand-chip grand-chip--red">@Model.OrderStatus</span></div>
            </div>
        }
        <div>
            <admin-label asp-for="PaymentStatus" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Model.PaymentStatus</div>
        </div>
        @if (!string.IsNullOrEmpty(Model.Code))
        {
            <div>
                <admin-label asp-for="Code" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.Code</div>
            </div>
        }
        <div>
            <admin-label asp-for="CurrencyCode" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">
                @Model.CurrencyCode
                @if (Model.CurrencyRate != 1)
                {
                    <text>(@Model.CurrencyRate)</text>
                }
            </div>
        </div>
        <div>
            <admin-label asp-for="StoreName" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Model.StoreName</div>
        </div>
        <div>
            <admin-label asp-for="CreatedOn" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Html.DisplayFor(model => model.CreatedOn)</div>
        </div>
    </div>
</admin-card>
<vc:vendor-widget widget-zone="vendor_order_details_info_bottom" additional-data="Model"/>