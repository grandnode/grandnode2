@model ProductModel

<div class="panel panel-default">
    <vc:vendor-widget widget-zone="vendor_product_details_purchased_with_orders_top" additional-data="Model"/>
    <div class="panel-body">
        <admin-grid id="purchased-with-orders-grid"
                    read-url="@Url.Action("PurchasedWithOrders", "Product", new { productId = Model.Id, area = Constants.AreaVendor })"
                    auto-bind="false">
            <grid-column field="OrderNumber" title="@Loc["Vendor.Orders.Fields.ID"]" width="80">
                <cell-template>
                    <a class="k-link" href="@Url.Action("Edit", "Order", new { area = Constants.AreaVendor })/{{ Id }}">{{ OrderNumber }}</a>
                </cell-template>
            </grid-column>
            <grid-column field="CustomerEmail" title="@Loc["Vendor.Orders.Fields.CustomerEmail"]" width="200" min-screen-width="500"/>
            <grid-column field="CreatedOn" title="@Loc["Vendor.Orders.Fields.CreatedOn"]" width="150" format="{0:G}"/>
        </admin-grid>
    </div>
    <vc:vendor-widget widget-zone="vendor_product_details_purchased_with_orders_bottom" additional-data="Model"/>
</div>
