@model ProductListModel
@{
    //page title
    ViewBag.Title = Loc["Vendor.Catalog.Products.Manage"];
}
<form asp-area="@Constants.AreaVendor" asp-controller="Product" asp-action="List" method="post">

    <div class="row">
        <div class="col-md-12">
            <div class="x_panel light form-fit popup-window">
                <div class="x_title">
                    <div class="caption">
                        <i class="bi bi-boxes"></i>
                        @Loc["Vendor.Catalog.Products.Manage"]
                    </div>
                    <div class="actions btn-group btn-group-devided util-btn-margin-bottom-5">
                        <a href="@Url.Action("Create", new { area = Constants.AreaVendor })" class="btn green">
                            <i class="bi bi-plus-lg"></i><span class="d-none d-sm-inline"> @Loc["Vendor.Common.AddNew"] </span>
                        </a>
                        <div class="btn-group btn-group-devided">
                            <a class="btn default" href="javascript:;" data-bs-toggle="dropdown" data-hover="dropdown" data-close-others="true">
                                <i class="bi bi-download"></i>
                                @Loc["Vendor.Common.Export"]
                                <i class="bi bi-chevron-down"></i>
                            </a>
                            <ul class="dropdown-menu pull-right">
                                <li>
                                    <input type="submit" name="exportexcel-all" asp-action="ExportExcelAll" class="btn default" style="width: 100%;" value="@Loc["Vendor.Common.ExportToExcel.All"]"/>
                                </li>
                                <li>
                                    <input type="button" id="exportexcel-selected" class="btn default" style="width: 100%;" value="@Loc["Vendor.Common.ExportToExcel.Selected"]"/>
                                </li>
                            </ul>
                        </div>
                        <button type="button" name="delete-selected" id="delete-selected" class="btn red">
                            <i class="bi bi-trash"></i>
                            @Loc["Vendor.Common.Delete.Selected"]
                        </button>
                        <vc:vendor-widget widget-zone="vendor_product_list_buttons" additional-data="null"/>
                    </div>
                </div>
                <div class="x_content form">
                    <div class="form-horizontal">
                        <div class="form-body">
                            <div class="main-header col-12 px-0">
                                <div class="row align-items-end">
                                    <div class="col-md-8 col-ms-12 col-12">
                                        <div class="mb-0">
                                            <admin-label asp-for="SearchProductName" class="control-label"/>
                                            <admin-input asp-for="SearchProductName"/>
                                        </div>
                                    </div>
                                    <div class="col-md-4 col-sm-12 col-12">
                                        <div class="form-actions">
                                            <div class="btn-group">
                                                <button class="btn btn-success filter-submit" id="search-products">
                                                    <i class="bi bi-search"></i> @Loc["Vendor.Common.Search"]
                                                </button>
                                                <button class="btn btn-info" type="button" data-bs-toggle="collapse" data-bs-target="#filterCollapse" aria-expanded="false" aria-controls="filterCollapse">
                                                    <i class="bi bi-funnel"></i>&nbsp; @Loc["Vendor.Common.Filters"]
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="collapse" id="filterCollapse">
                            <div class="drop-filters-container w-100">
                                <div class="mb-3">
                                    <admin-label asp-for="SearchProductTypeId" class="col-sm-3 control-label"/>
                                    <div class="col-md-9 col-sm-9">
                                        <admin-select asp-for="SearchProductTypeId" asp-items="Model.AvailableProductTypes"/>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <admin-label asp-for="SearchPublishedId" class="col-sm-3 control-label"/>
                                    <div class="col-md-9 col-sm-9">
                                        <admin-select asp-for="SearchPublishedId" asp-items="Model.AvailablePublishedOptions"/>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <admin-label asp-for="SearchWarehouseId" class="col-sm-3 control-label"/>
                                    <div class="col-md-9 col-sm-9">
                                        <admin-select asp-for="SearchWarehouseId" asp-items="Model.AvailableWarehouses"/>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <admin-label asp-for="GoDirectlyToSku" class="col-sm-3 control-label"/>
                                    <div class="col-md-9 col-sm-9">
                                        <div class="input-group" style="text-align:left">
                                            <admin-input asp-for="GoDirectlyToSku"/>
                                            <span class="">
                                                <input type="submit" id="go-to-product-by-sku" asp-action="GoToSku" name="go-to-product-by-sku" class="btn default" value="@Loc["Vendor.Common.Go"]"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <admin-label asp-for="SearchCategoryId" class="col-sm-3 control-label"/>
                                    <div class="col-md-9 col-sm-9">
                                        <admin-input asp-for="SearchCategoryId"/>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <admin-label asp-for="SearchIncludeSubCategories" class="col-sm-3 control-label"/>
                                    <div class="col-md-9 col-sm-9">
                                        <label class="mt-checkbox mt-checkbox-outline control control-checkbox">
                                            <admin-input asp-for="SearchIncludeSubCategories"/>
                                            <div class="control__indicator"></div>
                                        </label>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <admin-label asp-for="SearchBrandId" class="col-sm-3 control-label"/>
                                    <div class="col-md-9 col-sm-9">
                                        <admin-input asp-for="SearchBrandId"/>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <admin-label asp-for="SearchCollectionId" class="col-sm-3 control-label"/>
                                    <div class="col-md-9 col-sm-9">
                                        <admin-input asp-for="SearchCollectionId"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="clearfix"></div>
                        <div class="x_content">
                            <admin-grid id="products-grid"
                                        read-url="@Url.Action("ProductList", "Product", new { area = Constants.AreaVendor })"
                                        additional-data="additionalData"
                                        selectable="Checkbox"
                                        on-change="onProductSelectionChange">
                                <grid-column field="PictureThumbnailUrl" title="@Loc["Vendor.Catalog.Products.Fields.PictureThumbnailUrl"]" width="92">
                                    <cell-template>
                                        <a class="k-link" href="Edit/{{ Id }}"><img src="{{ PictureThumbnailUrl }}" alt=""/></a>
                                    </cell-template>
                                </grid-column>
                                <grid-column field="Name" title="@Loc["Vendor.Catalog.Products.Fields.Name"]" width="270">
                                    <cell-template>
                                        <a class="k-link" href="Edit/{{ Id }}">{{ Name }}</a>
                                    </cell-template>
                                </grid-column>
                                <grid-column field="Sku" title="@Loc["Vendor.Catalog.Products.Fields.Sku"]" width="80" align="Center"/>
                                <grid-column field="Price" title="@Loc["Vendor.Catalog.Products.Fields.Price"]" width="100" align="Right">
                                    <cell-template>
                                        <span data-if="ProductTypeId != @((int)ProductType.GroupedProduct)">{{ Price }}</span>
                                    </cell-template>
                                </grid-column>
                                <grid-column field="StockQuantityStr" title="@Loc["Vendor.Catalog.Products.Fields.StockQuantity"]" width="80" align="Right" min-screen-width="750"/>
                                <grid-column field="ProductTypeName" title="@Loc["Vendor.Catalog.Products.Fields.ProductType"]" width="100" align="Center" min-screen-width="1050"/>
                                <grid-column field="Published" title="@Loc["Vendor.Catalog.Products.Fields.Published"]" width="85" align="Center">
                                    <cell-template>
                                        <i data-if="Published" class="bi bi-check-lg" aria-hidden="true" style="color:green"></i>
                                        <i data-else class="bi bi-x-lg" aria-hidden="true" style="color:red"></i>
                                    </cell-template>
                                </grid-column>
                            </admin-grid>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            $('.extend-collapse').hide();
            $('.filter-text-open').hide();
            $('.filter-extend-button').click(function () {
                $('.extend-collapse').toggle("slow");
                $('.filter-text-open').toggle();
                $('.filter-text-close').toggle();
            });
            

        });
    </script>

    <script>

        var selectedIds = [];

        $(document).ready(function () {

            //search button
            $('#search-products').click(function () {
                //search
                var grid = $('#products-grid').data('kendoGrid');
                grid.dataSource.page(1);
                grid.clearSelection();
                return false;
            });

            $("#@Html.IdFor(model => model.SearchProductName)").keydown(function (event) {
                if (event.keyCode == 13) {
                    $("#search-products").click();
                    return false;
                }
            });
            $("#@Html.IdFor(model => model.GoDirectlyToSku)").keydown(function (event) {
                if (event.keyCode == 13) {
                    $("#go-to-product-by-sku").click();
                    return false;
                }
            });

            $('#delete-selected').click(function(e) {
                if (confirm('@Loc["Vendor.Common.AreYouSure"]')) {
                    var postData = {
                        selectedIds: selectedIds
                    };
                    addAntiForgeryToken(postData);

                    $.ajax({
                        cache: false,
                        type: "POST",
                        url: "@(Url.Action("DeleteSelected", "Product", new { area = Constants.AreaVendor }))",
                        data: postData,
                        complete: function (data) {
                            var grid = $('#products-grid').data('kendoGrid');
                            grid.dataSource.read();
                        },
                        error: function (xhr, ajaxOptions, thrownError) {
                            alert(thrownError);
                        },
                        traditional: true
                    });
                }
                return false;
            });
        });

        function additionalData() {
            var data = {
                SearchProductName: $('#@Html.IdFor(model => model.SearchProductName)').val(),
                SearchCategoryId: $('#SearchCategoryId').val(),
                SearchIncludeSubCategories: $('#@Html.IdFor(model => model.SearchIncludeSubCategories)').is(':checked'),
                SearchBrandId: $('#SearchBrandId').val(),
                SearchCollectionId: $('#SearchCollectionId').val(),
                SearchStoreId: $('#SearchStoreId').val(),
                SearchWarehouseId: $('#SearchWarehouseId').val(),
                SearchVendorId: $('#SearchVendorId').val(),
                SearchProductTypeId: $('#SearchProductTypeId').val(),
                SearchPublishedId: $('#SearchPublishedId').val()
            };
            addAntiForgeryToken(data);
            return data;
        }

        function onProductSelectionChange(e) {
            selectedIds = e.selectedIds;
        }
    </script>
</form>

<script>
    $(document).ready(function () {
        $('#exportxml-selected').click(function (e) {
            e.preventDefault();
            var ids = selectedIds.join(",");
            $('#export-xml-selected-form #selectedIds').val(ids);
            $('#export-xml-selected-form').submit();
            return false;
        });
    });

</script>
<form asp-area="@Constants.AreaVendor" asp-controller="Product" asp-action="ExportExcelSelected" method="post" id="export-excel-selected-form">
    <input type="hidden" id="selectedIds" name="selectedIds" value=""/>
</form>
<script>
    $(document).ready(function () {
        $('#exportexcel-selected').click(function (e) {
            e.preventDefault();
            var ids = selectedIds.join(",");
            $('#export-excel-selected-form #selectedIds').val(ids);
            $('#export-excel-selected-form').submit();
            return false;
        });
    });
</script>