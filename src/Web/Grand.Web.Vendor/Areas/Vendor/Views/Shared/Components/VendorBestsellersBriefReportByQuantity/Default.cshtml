@{
    var gridPageSize = 5;
}
<admin-grid id="bestsellers-byquantity-grid"
            read-url="@Url.Action("BestsellersBriefReportByQuantityList", "Reports", new { area = Constants.AreaVendor })"
            page-size="@(gridPageSize)"
            page-sizes="">
    <grid-column field="ProductName" title="@Loc["Vendor.Reports.Bestsellers.Fields.Name"]">
        <cell-template>
            <a class="k-link" href="@Url.Action("Edit", "Product", new { area = Constants.AreaVendor })/{{ ProductId }}">{{ ProductName }}</a>
        </cell-template>
    </grid-column>
    <grid-column field="TotalQuantity" title="@Loc["Vendor.Reports.Bestsellers.Fields.TotalQuantity"]"/>
    <grid-column field="TotalAmount" title="@Loc["Vendor.Reports.Bestsellers.Fields.TotalAmount"]"/>
</admin-grid>

