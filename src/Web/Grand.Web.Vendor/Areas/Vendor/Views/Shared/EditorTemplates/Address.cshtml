@* the fields of the host card: every screen that renders this template puts it inside an
   <admin-card>, so it brings the field grid and no chrome of its own *@
<div class="grand-fields grand-fields--2col">
    @if (Model.NameEnabled)
    {
        <admin-field asp-for="Name"/>
    }
    @if (Model.FirstNameEnabled)
    {
        <admin-field asp-for="FirstName"/>
    }
    @if (Model.LastNameEnabled)
    {
        <admin-field asp-for="LastName"/>
    }
    @if (Model.EmailEnabled)
    {
        <admin-field asp-for="Email"/>
    }
    @if (Model.CompanyEnabled)
    {
        <admin-field asp-for="Company"/>
    }
    @if (Model.VatNumberEnabled)
    {
        <admin-field asp-for="VatNumber"/>
    }
    @if (Model.CountryEnabled)
    {
        <admin-field asp-for="CountryId" asp-items="Model.AvailableCountries"/>
    }
    @if (Model.CountryEnabled && Model.StateProvinceEnabled)
    {
        <admin-field asp-for="StateProvinceId" asp-items="Model.AvailableStates"/>
    }
    @if (Model.CityEnabled)
    {
        <admin-field asp-for="City"/>
    }
    @if (Model.StreetAddressEnabled)
    {
        <admin-field asp-for="Address1"/>
    }
    @if (Model.StreetAddress2Enabled)
    {
        <admin-field asp-for="Address2"/>
    }
    @if (Model.ZipPostalCodeEnabled)
    {
        <admin-field asp-for="ZipPostalCode"/>
    }
    @if (Model.PhoneEnabled)
    {
        <admin-field asp-for="PhoneNumber"/>
    }
    @if (Model.FaxEnabled)
    {
        <admin-field asp-for="FaxNumber"/>
    }
    @if (Model.NoteEnabled)
    {
        <admin-field asp-for="Note"/>
    }
    @if (Model.AddressTypeEnabled)
    {
        <admin-field asp-for="AddressType" asp-items="EnumTranslationService.ToSelectList(AddressType.Any, false)"/>
    }
    @if (Model.CustomAddressAttributes.Count > 0)
    {
        <partial name="Partials/AddressAttributes" model="Model.CustomAddressAttributes"/>
    }
</div>
