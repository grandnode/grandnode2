@model MerchandiseReturnModel
<vc:vendor-widget widget-zone="vendor_merchandisereturn_tab_address_top" additional-data="Model"/>
@if (Model.PickupAddress != null)
{
    <admin-card title="@Loc["Vendor.Orders.MerchandiseReturns.Fields.PickupAddress"]">
        <admin-input asp-for="PickupAddress" asp-template="Address"/>
    </admin-card>
}
<vc:vendor-widget widget-zone="vendor_merchandisereturn_tab_address_bottom" additional-data="Model"/>
