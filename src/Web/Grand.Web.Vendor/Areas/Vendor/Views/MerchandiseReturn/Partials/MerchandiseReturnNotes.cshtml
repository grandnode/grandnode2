@model MerchandiseReturnModel
<div class="panel panel-default">
    <vc:vendor-widget widget-zone="vendor_merchandisereturn_details_notes_top" additional-data="Model"/>
    <div class="panel-body">
        <admin-grid id="merchandisereturnnotes-grid"
                    read-url="@Url.Action("MerchandiseReturnNotesSelect", "MerchandiseReturn", new { merchandisereturnId = Model.Id, area = Constants.AreaVendor })"
                    destroy-url="@Url.Action("MerchandiseReturnNoteDelete", "MerchandiseReturn", new { merchandisereturnId = Model.Id, area = Constants.AreaVendor })"
                    pager="Compact">
            <grid-column field="CreatedOn" title="@Loc["Vendor.Orders.MerchandiseReturns.MerchandiseReturnNotes.Fields.CreatedOn"]" width="180" format="{0:G}"/>
            <grid-column field="Note" title="@Loc["Vendor.Orders.MerchandiseReturns.MerchandiseReturnNotes.Fields.Note"]" width="350"/>
            <grid-column field="CreatedByCustomer" title="@Loc["Vendor.Orders.MerchandiseReturns.MerchandiseReturnNotes.Fields.CreatedByCustomer"]" width="100" align="Center">
                <cell-template>
                    <i data-if="CreatedByCustomer" class="bi bi-check-lg" aria-hidden="true" style="color:green"></i>
                    <i data-else class="bi bi-x-lg" aria-hidden="true" style="color:red"></i>
                </cell-template>
            </grid-column>
            <grid-column field="DisplayToCustomer" title="@Loc["Vendor.Orders.MerchandiseReturns.MerchandiseReturnNotes.Fields.DisplayToCustomer"]" width="100" align="Center">
                <cell-template>
                    <i data-if="DisplayToCustomer" class="bi bi-check-lg" aria-hidden="true" style="color:green"></i>
                    <i data-else class="bi bi-x-lg" aria-hidden="true" style="color:red"></i>
                </cell-template>
            </grid-column>
            <grid-commands destroy="true" title="@Loc["Vendor.Common.Delete"]" width="100"/>
        </admin-grid>
    </div>
    <vc:vendor-widget widget-zone="vendor_merchandisereturn_details_notes_bottom" additional-data="Model"/>
</div>
<p>
    <strong>
        @Loc["Vendor.Orders.MerchandiseReturns.MerchandiseReturnNotes.AddTitle"]
    </strong>
</p>

<div class="form-horizontal">
    <div class="form-body">
        <div class="mb-3">
            <admin-label asp-for="AddMerchandiseReturnNoteMessage"/>
            <div class="col-md-9 col-sm-9">
                <admin-textarea asp-for="AddMerchandiseReturnNoteMessage"></admin-textarea>
                <span asp-validation-for="AddMerchandiseReturnNoteMessage"></span>
            </div>
        </div>
        <div class="mb-3">
            <admin-label asp-for="AddMerchandiseReturnNoteDisplayToCustomer"/>
            <div class="col-md-9 col-sm-9">
                <label class="mt-checkbox mt-checkbox-outline control control-checkbox">
                    <admin-input asp-for="AddMerchandiseReturnNoteDisplayToCustomer"/>
                    <div class="control__indicator"></div>
                </label>
                <span asp-validation-for="AddMerchandiseReturnNoteDisplayToCustomer"></span>
            </div>
        </div>
        <div class="form-actions">
            <div class="offset-md-3 col-md-9 col-sm-9">
                <button type="button" id="addMerchandiseReturnNote" class="btn btn-default btn-sm"><i class="bi bi-plus-lg"></i>&nbsp;@Loc["Vendor.Orders.MerchandiseReturns.MerchandiseReturnNotes.AddButton"]</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('#addMerchandiseReturnNote').click(function () {
            var merchandisereturnNoteMessage = $("#@Html.IdFor(model => model.AddMerchandiseReturnNoteMessage)").val();
            if (merchandisereturnNoteMessage.length == 0) {
                alert('Message text is required');
                return;
            }
            
            var merchandisereturnNoteDisplayToCustomer = $("#@Html.IdFor(model => model.AddMerchandiseReturnNoteDisplayToCustomer)").is(':checked');
            $('#addMerchandiseReturnNote').attr('disabled', true);
            var postData = {
                DisplayToCustomer: merchandisereturnNoteDisplayToCustomer,
                message: merchandisereturnNoteMessage,
                merchandisereturnId: '@Model.Id'
            };
            addAntiForgeryToken(postData);

            $.ajax({
                cache:false,
                type: "POST",
                url: "@(Url.Action("MerchandiseReturnNoteAdd", "MerchandiseReturn", new { area = Constants.AreaVendor }))",
                data: postData,
                success: function (data) {
                    var grid = $("#merchandisereturnnotes-grid").data('kendoGrid');
                    grid.dataSource.read();
                    $('#addMerchandiseReturnNote').attr('disabled', false);
                },
                error:function (xhr, ajaxOptions, thrownError){
                    alert('Failed to add merchandise return note.');
                    $('#addMerchandiseReturnNote').attr('disabled', false);
                }
            });
        });
    });
</script>