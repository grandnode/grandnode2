@model MerchandiseReturnModel
@{
    //page title
    ViewBag.Title = Loc["Vendor.Orders.MerchandiseReturns.EditMerchandiseReturnDetails"];
}
<form asp-area="@Constants.AreaVendor" asp-controller="MerchandiseReturn" asp-action="Edit" method="post">
    @* Enter in a field submits through the form's first button: it saves, it never changes the status *@
    <button type="submit" name="save-continue" hidden aria-hidden="true" tabindex="-1"></button>

    @* the product edit screen's shell: Save as the one primary action, Delete in the overflow
       menu rather than beside Save *@
    <admin-page sticky
                title="@Model.ReturnNumber.ToString()"
                icon="bi-truck"
                meta="@Loc["Vendor.Orders.MerchandiseReturns.EditMerchandiseReturnDetails"]"
                back-url="@Url.Action("List")"
                back-text="@Loc["Vendor.Orders.MerchandiseReturns.BackToList"]">
        <page-actions>
            <partial name="Partials/ChangeStatus.Buttons" model="Model"/>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Vendor.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Vendor.Common.Save"]
            </button>
            <admin-action-menu>
                <admin-action id="merchandisereturn-delete" destructive="true" icon="bi-trash"
                              text="@Loc["Vendor.Common.Delete"]"/>
            </admin-action-menu>
            <vc:vendor-widget widget-zone="vendor_merchandisereturn_details_buttons" additional-data="Model"/>
        </page-actions>

        <partial name="Partials/ChangeStatus.Reject" model="Model"/>

        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>
<admin-delete-confirmation button-id="merchandisereturn-delete"/>