@model VendorReviewListModel
@{
    //page title
    ViewBag.Title = Loc["Vendor.VendorReviews"];
}

@* The admin review list's shape, minus the vendor filter and column: the filter bar searches the
   review text with the dates behind Filters, approve/disapprove in the bulk bar. *@
<admin-page title="@Loc["Vendor.VendorReviews"]" icon="bi-boxes">
    <page-actions>
        <vc:vendor-widget widget-zone="vendor_review_list_buttons" additional-data="Model"/>
    </page-actions>

    <admin-filters id="vendorreview-filters" submit-id="search-vendorreviews">
        <filters-search>
            <admin-input asp-for="SearchText"/>
        </filters-search>
        <div class="grand-range">
            <admin-field asp-for="CreatedOnFrom"/>
            <admin-field asp-for="CreatedOnTo"/>
        </div>
    </admin-filters>

    <admin-card flush>
        <admin-bulkbar grid-id="vendorreviews-grid">
            <button type="button" id="approve-selected" class="btn btn-outline-secondary btn-sm"><span class="bi bi-check-circle"></span> @Loc["Vendor.VendorReviews.ApproveSelected"]</button>
            <button type="button" id="disapprove-selected" class="btn btn-outline-secondary btn-sm"><span class="bi bi-x-circle"></span> @Loc["Vendor.VendorReviews.DisapproveSelected"]</button>
        </admin-bulkbar>
        <admin-grid id="vendorreviews-grid"
                    key="Ids"
                    read-url="@Url.Action("List", "VendorReview", new { area = Constants.AreaVendor })"
                    additional-data="additionalData"
                    selectable="Checkbox"
                    on-change="onVendorReviewsSelectionChange">
            <grid-column field="CustomerId" title="@Loc["Vendor.VendorReviews.Fields.Customer"]" width="200">
                <cell-template>
                    {{ CustomerInfo }}
                </cell-template>
            </grid-column>
            <grid-column field="Title" title="@Loc["Vendor.VendorReviews.Fields.Title"]" width="200">
                <cell-template>
                    <a class="text-decoration-none" href="Edit/{{ Id }}">{{ Title }}</a>
                </cell-template>
            </grid-column>
            <grid-column field="Rating" title="@Loc["Vendor.VendorReviews.Fields.Rating"]" width="100"/>
            <grid-column field="IsApproved" title="@Loc["Vendor.VendorReviews.Fields.IsApproved"]" width="100" align="Center">
                <cell-template>
                    <i data-if="IsApproved" class="bi bi-check-lg text-success" aria-hidden="true"></i>
                    <i data-else class="bi bi-x-lg text-danger" aria-hidden="true"></i>
                </cell-template>
            </grid-column>
            <grid-column field="CreatedOn" title="@Loc["Vendor.VendorReviews.Fields.CreatedOn"]" width="200" format="{0:G}"/>
        </admin-grid>
    </admin-card>
</admin-page>




<script>

                var selectedIds = [];

                $(document).ready(function () {

                    //search button
                    $('#search-vendorreviews').click(function () {
                        //search
                        var grid = $('#vendorreviews-grid').data('kendoGrid');
                        grid.dataSource.page(1); //new search. Set page size to 1
                        //grid.dataSource.read(); we already loaded the grid above using "page" function
                        //clear the selection
                        grid.clearSelection();
                        return false;
                    });

                    //"approve selected" button
                    $('#approve-selected').click(function (e) {
                        e.preventDefault();

                        var postData = {
                            selectedIds: selectedIds,
                        };
                        addAntiForgeryToken(postData);

                        $.ajax({
                            cache:false,
                            type: "POST",
                            url: "@(Url.Action("ApproveSelected", "VendorReview", new { area = Constants.AreaVendor }))",
                            data: postData,
                            complete: function (data) {
                                //reload grid
                                var grid = $('#vendorreviews-grid').data('kendoGrid');
                                grid.dataSource.read();
                            },
                            error:function (xhr, ajaxOptions, thrownError){
                                alert(thrownError);
                            },
                            traditional: true
                        });
                        return false;
                    });

                    //"disapprove selected" button
                    $('#disapprove-selected').click(function (e) {
                        e.preventDefault();

                        var postData = {
                            selectedIds: selectedIds,
                        };
                        addAntiForgeryToken(postData);

                        $.ajax({
                            cache:false,
                            type: "POST",
                            url: "@(Url.Action("DisapproveSelected", "VendorReview", new { area = Constants.AreaVendor }))",
                            data: postData,
                            complete: function (data) {
                                //reload grid
                                var grid = $('#vendorreviews-grid').data('kendoGrid');
                                grid.dataSource.read();
                            },
                            error:function (xhr, ajaxOptions, thrownError){
                                alert(thrownError);
                            },
                            traditional: true
                        });
                        return false;
                    });


                });

                function additionalData() {
                    var data = {
                        CreatedOnFrom: $('#@Html.IdFor(model => model.CreatedOnFrom)').val(),
                        CreatedOnTo: $('#@Html.IdFor(model => model.CreatedOnTo)').val(),
                        SearchText: $('#@Html.IdFor(model => model.SearchText)').val()                        
                    };
                    addAntiForgeryToken(data);
                    return data;
                }

                function onVendorReviewsSelectionChange(e) {
                    selectedIds = e.selectedIds;
                }

</script>