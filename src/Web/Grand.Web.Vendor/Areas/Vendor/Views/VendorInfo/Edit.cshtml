@model VendorModel
@{
    //page title
    ViewBag.Title = Loc["Vendor.EditVendorDetails"];
}
<form asp-area="@Constants.AreaVendor" asp-controller="VendorInfo" asp-action="Edit" method="post">

    @* the vendor's own details: its name as the title and Save as the one primary action *@
    <admin-page sticky
                title="@Model.Name"
                icon="bi-box"
                meta="@Loc["Vendor.EditVendorDetails"]">
        <page-actions>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Vendor.Common.Save"]
            </button>
            <vc:vendor-widget widget-zone="vendor_vendor_details_buttons" additional-data="Model"/>
        </page-actions>

        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>