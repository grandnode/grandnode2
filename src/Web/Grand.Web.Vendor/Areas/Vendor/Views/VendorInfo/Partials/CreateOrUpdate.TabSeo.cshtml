@using Microsoft.AspNetCore.Mvc.Razor
@model VendorModel

<vc:vendor-widget widget-zone="vendor_vendor_details_seo_top" additional-data="Model" />
@{
    Func<int, HelperResult>
        template = @<div class="grand-fields">
                       <admin-field asp-for="@Model.Locales[item].MetaKeywords"/>
                       <admin-field asp-for="@Model.Locales[item].MetaDescription">
                           <admin-textarea asp-for="@Model.Locales[item].MetaDescription"></admin-textarea>
                       </admin-field>
                       <admin-field asp-for="@Model.Locales[item].MetaTitle"/>
                       <admin-field asp-for="@Model.Locales[item].SeName"/>
                       <input asp-for="@Model.Locales[item].LanguageId" type="hidden"/>
                   </div>;
}
@* one column, not two: a meta description is a paragraph and a slug is long *@
<admin-card>
    <localized-editor localized-template="@template" name="vendor-seo-localized" language-ids="@Model.Locales.Select(c => c.LanguageId).ToList()">
        <div class="grand-fields">
            <admin-field asp-for="MetaKeywords"/>
            <admin-field asp-for="MetaDescription">
                <admin-textarea asp-for="MetaDescription"></admin-textarea>
            </admin-field>
            <admin-field asp-for="MetaTitle"/>
            <admin-field asp-for="SeName"/>
        </div>
    </localized-editor>
</admin-card>
<vc:vendor-widget widget-zone="vendor_vendor_details_seo_bottom" additional-data="Model" />