@using Microsoft.AspNetCore.Mvc.Razor
@model VendorModel
<script>
        $(document).ready(function () {
            $("@Model.AllowCustomersToSelectPageSize").click(togglePageSize);
            togglePageSize();
        });

        function togglePageSize() {
            if ($('@Model.AllowCustomersToSelectPageSize').is(':checked')) {
                $('#pnlPageSize').hide();
                $('#pnlPageSizeOptions').show();
            } else {
                $('#pnlPageSize').show();
                $('#pnlPageSizeOptions').hide();
            }
        }
</script>
<vc:vendor-widget widget-zone="vendor_vendor_details_info_top" additional-data="Model"/>

@{
    Func<int, HelperResult>
        template = @<div class="grand-fields">
                       <admin-field asp-for="@Model.Locales[item].Name"/>
                       <admin-field asp-for="@Model.Locales[item].Description">
                           <admin-textarea asp-for="@Model.Locales[item].Description"></admin-textarea>
                       </admin-field>
                       <input asp-for="@Model.Locales[item].LanguageId" type="hidden"/>
                   </div>;
}
@* the admin vendor info tab, minus what only the administrator sets: what the vendor says, how
   its page is shown, then its address. The ids the script above toggles - pnlPageSize,
   pnlPageSizeOptions - sit on the same fields. *@
<admin-card>
    <localized-editor localized-template="@template" name="vendor-info-localized" language-ids="@Model.Locales.Select(c => c.LanguageId).ToList()">
        <div class="grand-fields">
            <admin-field asp-for="Name"/>
            <admin-field asp-for="Description">
                <admin-textarea asp-for="Description"></admin-textarea>
            </admin-field>
        </div>
    </localized-editor>
</admin-card>
<admin-card>
    <div class="grand-fields grand-fields--2col">
        <admin-field asp-for="Email"/>
        <admin-field asp-for="AllowCustomersToSelectPageSize"/>
        <admin-field asp-for="PageSize" id="pnlPageSize" size="sm"/>
        <admin-field asp-for="PageSizeOptions" id="pnlPageSizeOptions"/>
    </div>
</admin-card>
@if (Model.Address.FaxEnabled || Model.Address.PhoneEnabled || Model.Address.StateProvinceEnabled || Model.Address.StreetAddressEnabled || Model.Address.ZipPostalCodeEnabled ||
     Model.Address.CityEnabled || Model.Address.CompanyEnabled || Model.Address.CountryEnabled || Model.Address.StreetAddress2Enabled)
{
    <admin-card title="@Loc["Admin.Vendors.Fields.Address"]">
        <admin-input asp-for="Address" asp-template="Address"/>
    </admin-card>
}
<vc:vendor-widget widget-zone="vendor_vendor_details_info_bottom" additional-data="Model" />