@model MessageTemplateModel
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    ViewBag.Title = Loc["Admin.Content.MessageTemplates.AddNew"];
}
<form asp-area="@area" asp-controller="MessageTemplate" asp-action="Create" method="post">

    @* the same shell as Edit, minus what a template that does not exist yet cannot offer *@
    <admin-page sticky
                title="@Loc["Admin.Content.MessageTemplates.AddNew"]"
                icon="bi-envelope"
                back-url="@Url.Action("List")"
                back-text="@Loc["Admin.Content.MessageTemplates.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <partial name="Partials/WidgetZone.DetailsButtons" model="Model"/>
        </page-actions>

        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>
