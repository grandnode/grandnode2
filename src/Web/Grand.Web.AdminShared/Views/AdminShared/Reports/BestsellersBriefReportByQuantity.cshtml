@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var gridPageSize = 5;
}
<admin-grid id="bestsellers-byquantity-grid"
            read-url="@Url.Action("BestsellersBriefReportByQuantityList", "Reports", new { area })"
            page-size="@(gridPageSize)"
            page-sizes="">
    <grid-text name="view" value="@Loc["Admin.Common.View"]"/>
    <grid-column field="ProductName" title="@Loc["Admin.Reports.Bestsellers.Fields.Name"]"/>
    <grid-column field="TotalQuantity" title="@Loc["Admin.Reports.Bestsellers.Fields.TotalQuantity"]"/>
    <grid-column field="TotalAmount" title="@Loc["Admin.Reports.Bestsellers.Fields.TotalAmount"]"/>
    <grid-column field="ProductId" title="@Loc["Admin.Common.View"]" width="100">
        <cell-template>
            <a class="btn btn-sm btn-default" href="@Url.Action("Edit", "Product", new { area })/{{ ProductId }}"><i class="fa fa-search"></i> {{ $texts.view }}</a>
        </cell-template>
    </grid-column>
</admin-grid>
