@inject IReportDataScope Scope
@{
    //page title
    ViewBag.Title = Loc[$"{Scope.ResourceKeyPrefix}.Reports.LowStockReport"];
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}

<div class="row">
    <div class="col-md-12">
        <div class="x_panel light form-fit">
            <div class="x_title">
                <div class="caption level-caption">
                    <i class="bi bi-boxes"></i>
                    @Loc[$"{Scope.ResourceKeyPrefix}.Reports.LowStockReport"]
                </div>
            </div>
            <div class="x_content form">
                <div class="form-horizontal">
                    <div class="x_content">
                        <admin-grid id="products-grid" read-url="@Url.Action("LowStockReportList", "Reports", new { area })">
                            @*Attributes is markup built by the product attribute formatter*@
                            <grid-column field="Name" title="@Loc["Admin.Catalog.Products.Fields.Name"]" width="300">
                                <cell-template>
                                    <a class="k-link" href="@Url.Action("Edit", "Product", new { area })/{{ Id }}">{{ Name }}
                                    <span data-if="Attributes != null"><br /><i> {{{ Attributes }}} </i></span>
                                    </a>
                                </cell-template>
                            </grid-column>
                            <grid-column field="ManageInventoryMethod" title="@Loc["Admin.Catalog.Products.Fields.ManageInventoryMethod"]" width="150"/>
                            <grid-column field="StockQuantity" title="@Loc["Admin.Catalog.Products.Fields.StockQuantity"]" width="100"/>
                            <grid-column field="Published" title="@Loc["Admin.Catalog.Products.Fields.Published"]" width="100" align="Center">
                                <cell-template>
                                    <i data-if="Published" class="bi bi-check-lg" aria-hidden="true" style="color:green"></i>
                                    <i data-else class="bi bi-x-lg" aria-hidden="true" style="color:red"></i>
                                </cell-template>
                            </grid-column>
                        </admin-grid>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
