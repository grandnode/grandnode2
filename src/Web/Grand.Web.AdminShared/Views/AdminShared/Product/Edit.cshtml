@model ProductModel
@{
    //page title
    ViewBag.Title = Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.EditProductDetails"];
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    //a product the store may see but not change: no Save or Delete (copying it is allowed)
    bool readOnly = ViewBag.IsReadOnly == true;
}
@* The reference detail screen: the header carries the product's name, one primary action
   (Save) and everything else as an outline button, with Copy and Delete in the overflow menu
   so Delete no longer sits a pixel from Save. sticky keeps the header and the tab strip in
   view while a long tab scrolls. *@
<form asp-area="@area" asp-controller="Product" asp-action="Edit" method="post" id="product-form">
    <admin-page sticky
                title="@Model.Name"
                icon="bi-box"
                meta="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.EditProductDetails"]"
                back-url="@Url.Action("List")"
                back-text="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.BackToList"]">
        <page-actions>
            @if (!string.IsNullOrEmpty(Model.SeName))
            {
                <button type="button" onclick="window.open('@Url.RouteUrl("Product", new { Model.SeName })','_blank');" class="btn btn-outline-secondary">
                    <i class="bi bi-eye"></i> @Loc[$"{Scope.ResourceKeyPrefix}.Common.Preview"]
                </button>
            }
            @if (!readOnly)
            {
                <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                    <i class="bi bi-check-circle"></i> @Loc[$"{Scope.ResourceKeyPrefix}.Common.SaveContinue"]
                </button>
                <button class="btn btn-primary" type="submit" name="save">
                    <i class="bi bi-check-lg"></i> @Loc[$"{Scope.ResourceKeyPrefix}.Common.Save"]
                </button>
            }
            <admin-action-menu>
                <admin-action id="copyproduct" name="copyproduct" icon="bi-files"
                              text="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.Copy"]"/>
                @if (!readOnly)
                {
                    <admin-action id="product-delete" destructive="true" icon="bi-trash"
                                  text="@Loc[$"{Scope.ResourceKeyPrefix}.Common.Delete"]"/>
                }
            </admin-action-menu>
            <partial name="Partials/WidgetZone.DetailsButtons" model="Model"/>
        </page-actions>

        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>

@if (!readOnly)
{
    <admin-delete-confirmation button-id="product-delete"/>
}
<div id="copyproduct-window" style="display:none;">
    <form asp-area="@area" asp-controller="Product" asp-action="CopyProduct" method="post">

        <input asp-for="CopyProductModel.Id" type="hidden"/>
        <div class="grand-fields">
            <admin-field asp-for="CopyProductModel.Name"/>
            <admin-field asp-for="CopyProductModel.Published"/>
            <admin-field asp-for="CopyProductModel.CopyImages"/>
        </div>
        <div class="form-actions mt-3">
            <input type="submit" class="btn btn-success" value="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.Copy"]"/>
        </div>
    </form>
</div>
<script>
    $(document).ready(function () {
        $("#copyproduct").click(function (e) {
            e.preventDefault();
            GrandAdmin.modal.open("#copyproduct-window", { width: "400px", title: "@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.Copy"]", actions: ["Close"] });
        });
    });
    </script>
