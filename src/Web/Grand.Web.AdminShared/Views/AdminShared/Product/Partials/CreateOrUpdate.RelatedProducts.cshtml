@model ProductModel
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}

@if (!string.IsNullOrEmpty(Model.Id))
{
    <div class="panel panel-default">
        <div class="panel-heading">
            @Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.RelatedProducts"]
        </div>
        <div class="panel-body">
            <admin-grid id="relatedproducts-grid"
                        read-url="@Url.Action("RelatedProductList", "Product", new { productId = Model.Id, area = area })"
                        update-url="@Url.Action("RelatedProductUpdate", "Product", new { area = area })"
                        destroy-url="@Url.Action("RelatedProductDelete", "Product", new { area = area })"
                        pager="Compact"
                        auto-bind="false"
                        edit-mode="Inline">
                <grid-column field="Product2Name" title="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.RelatedProducts.Fields.Product"]">
                    <cell-template>
                        <a class="k-link" href="@Url.Action("Edit", "Product", new { id = "", area = area })/{{ ProductId2 }}">{{ Product2Name }}</a>
                    </cell-template>
                </grid-column>
                <grid-column field="DisplayOrder" title="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.RelatedProducts.Fields.DisplayOrder"]" width="120" align="Center" format="{0:0}" editor="Integer"/>
                <grid-commands edit="true" destroy="true"/>
            </admin-grid>
        </div>
        <div class="panel-footer">
            <a id="btnAddNewRelatedProduct" href="@(Url.Action("RelatedProductAddPopup", "Product", new { productId = Model.Id, btnId = "btnRefreshRelatedProducts", formId = "product-form", area = area }))" class="k-button"><i class="fa fa-plus"></i>&nbsp;@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.RelatedProducts.AddNew"]</a>
            <input type="submit" id="btnRefreshRelatedProducts" style="display: none"/>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            $('#btnAddNewRelatedProduct').magnificPopup({
                type: 'ajax',
                midClick: true,
                settings: { cache: false, async: false },
                callbacks: {
                    parseAjax: function (mfpResponse) {
                        mfpResponse.data = $('<div></div>').html(mfpResponse.data);
                    },
                    ajaxContentAdded: function () {
                        $('.mfp-wrap').removeAttr('tabindex');
                    }
                }
            });
        });
    </script>

    <script>
        $(document).ready(function () {
            $('#btnRefreshRelatedProducts').click(function () {
                //refresh grid
                var grid = $("#relatedproducts-grid").data('kendoGrid');
                grid.dataSource.read();

                //return false to don't reload a page
                return false;
            });
        });
    </script>
}
else
{
    <div class="note note-info">
        @Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.RelatedProducts.SaveBeforeEdit"]
    </div>
}