@model ProductModel
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}
@if (!string.IsNullOrEmpty(Model.Id))
{
    <div class="panel panel-default">
        <partial name="Partials/WidgetZone.Recommended.Top" model="Model"/>
        <div class="panel-heading">
            @Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.Recommended"]
        </div>
        <div class="panel-body">
            <admin-grid id="recommendedproducts-grid"
                        read-url="@Url.Action("RecommendedProductList", "Product", new { productId = Model.Id, area = area })"
                        destroy-url="@Url.Action("RecommendedProductDelete", "Product", new { productId = Model.Id, area = area })"
                        pager="Compact"
                        auto-bind="false">
                <grid-column field="Product2Name" title="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.Recommended.Fields.Product"]">
                    <cell-template>
                        <a class="k-link" href="@Url.Action("Edit", "Product", new { id = "", area = area })/{{ Id }}">{{ Product2Name }}</a>
                    </cell-template>
                </grid-column>
                <grid-commands destroy="true" title="@Loc[$"{Scope.ResourceKeyPrefix}.Common.Delete"]"/>
            </admin-grid>
        </div>
        <div class="panel-footer">
            <a id="btnAddNewRecommendedProduct" href="@(Url.Action("RecommendedProductAddPopup", "Product", new { productId = Model.Id, btnId = "btnRefreshRecommendedProducts", formId = "product-form", area = area }))" class="k-button"><i class="bi bi-plus-lg"></i>&nbsp;@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.Recommended.AddNew"]</a>
            <input type="submit" id="btnRefreshRecommendedProducts" style="display: none"/>
        </div>
        <partial name="Partials/WidgetZone.Recommended.Bottom" model="Model"/>
    </div>

    <script>
        $(document).ready(function () {
            $('#btnAddNewRecommendedProduct').magnificPopup({
                type: 'ajax',
                settings: { cache: false, async: false },
                midClick: true,
                callbacks: {
                    parseAjax: function (mfpResponse) {
                        mfpResponse.data = $('<div></div>').html(mfpResponse.data);
                    },
                    ajaxContentAdded: function () {
                        $('.mfp-wrap').removeAttr('tabindex');
                    }
                }
            });
        });
    </script>

    <script>
        $(document).ready(function () {
            $('#btnRefreshRecommendedProducts').click(function () {
                //refresh grid
                var grid = $("#recommendedproducts-grid").data('kendoGrid');
                grid.dataSource.read();

                //return false to don't reload a page
                return false;
            });
        });
    </script>
}
else
{
    <div class="note note-info">
        @Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.Recommended.SaveBeforeEdit"]
    </div>
}