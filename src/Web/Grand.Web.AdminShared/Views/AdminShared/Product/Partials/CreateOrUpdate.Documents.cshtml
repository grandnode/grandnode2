@model ProductModel
@inject AdminAreaSettings adminAreaSettings
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}
<div class="panel panel-default">
    <partial name="Partials/WidgetZone.Documents.Top" model="Model"/>
    <div class="panel-body">
        <div id="product-documents-grid"></div>
    </div>
    <div class="panel-footer">
        <button type="button" class="k-button" onclick="location.href='@Url.Action("CreateDocument", "Document", new { reference = (int)Reference.Product, ObjectId = Model.Id, area = area })'"><i class="fa fa-plus"></i>&nbsp;@Loc[$"{Scope.ResourceKeyPrefix}.Marketing.Document.Add"]</button>
    </div>
    <partial name="Partials/WidgetZone.Documents.Bottom" model="Model"/>
</div>

<script>
$(document).ready(function () {
    $("#product-documents-grid").kendoGrid({
        dataSource: {
            transport: {
                read: {
                    url: "@Html.Raw(Url.Action("ListDocuments", "Document", new { reference = (int)Reference.Product, ObjectId = Model.Id, StatusId = -1, area = area }))",
                    type: "POST",
                    dataType: "json",
                    data: addAntiForgeryToken
                },
            },
            schema: {
                data: "Data",
                total: "Total",
                errors: "Errors",
            },
            error: function(e) {
                display_kendoui_grid_error(e);
                // Cancel the changes
                this.cancelChanges();
            },
            pageSize: @(adminAreaSettings.DefaultGridPageSize),
            serverPaging: true,
            serverFiltering: true,
            serverSorting: true
        },
        autoBind: false,
        pageable: {
            refresh: true,
            pageSizes: [@(adminAreaSettings.GridPageSizes)]
        },
        editable: {
            confirmation: true,
            mode: "inline"
        },
        scrollable: false,
        columns: [{
                field: "Number",
                title: "@Loc[$"{Scope.ResourceKeyPrefix}.Documents.Document.Fields.Number"]",
                template: '<a class="k-link" href="@Url.Action("EditDocument", "Document", new { area = area })/#=Id#">#=kendo.htmlEncode(Number)#</a>',
            },
            {
                field: "Name",
                title: "@Loc[$"{Scope.ResourceKeyPrefix}.Documents.Document.Fields.Name"]",
                template: '<a class="k-link" href="@Url.Action("EditDocument", "Document", new { area = area })/#=Id#">#=kendo.htmlEncode(Name)#</a>',
            }, {
                field: "Published",
                title: "@Loc[$"{Scope.ResourceKeyPrefix}.Documents.Document.Fields.Published"]",
                width: 100,
                minScreenWidth: 500,
                headerAttributes: { style: "text-align:center" },
                attributes: { style: "text-align:center" },
                template: '# if(Published) {# <i class="fa fa-check" aria-hidden="true" style="color:green"></i> #} else {# <i class="fa fa-times" aria-hidden="true" style="color:red"></i> #} #'
        }]
    });
});
</script>
