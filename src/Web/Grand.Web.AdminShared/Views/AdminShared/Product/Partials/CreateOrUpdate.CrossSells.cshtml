@model ProductModel
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    //a product the store may see but not change (see BaseProductController.Edit)
    bool readOnly = ViewBag.IsReadOnly == true;
}
@if (!string.IsNullOrEmpty(Model.Id))
{
    <div class="panel panel-default">
        <partial name="Partials/WidgetZone.CrossSells.Top" model="Model"/>
        <div class="panel-heading">
            @Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.CrossSells"]
        </div>
        <div class="panel-body">
            <admin-grid id="crosssellproducts-grid"
                        read-only="@readOnly"
                        read-url="@Url.Action("CrossSellProductList", "Product", new { productId = Model.Id, area = area })"
                        destroy-url="@Url.Action("CrossSellProductDelete", "Product", new { productId = Model.Id, area = area })"
                        pager="Compact"
                        auto-bind="false">
                <grid-column field="Product2Name" title="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.CrossSells.Fields.Product"]">
                    <cell-template>
                        <a class="text-decoration-none" href="@Url.Action("Edit", "Product", new { id = "", area = area })/{{ Id }}">{{ Product2Name }}</a>
                    </cell-template>
                </grid-column>
                <grid-commands destroy="true" title="@Loc[$"{Scope.ResourceKeyPrefix}.Common.Delete"]"/>
            </admin-grid>
        </div>
        @if (!readOnly)
        {
            <div class="panel-footer">
                <a id="btnAddNewCrossSellProduct" href="@(Url.Action("CrossSellProductAddPopup", "Product", new { productId = Model.Id, btnId = "btnRefreshCrossSellProducts", formId = "product-form", area = area }))" class="btn btn-default btn-sm"><i class="bi bi-plus-lg"></i>&nbsp;@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.CrossSells.AddNew"]</a>
                <input type="submit" id="btnRefreshCrossSellProducts" style="display: none"/>
            </div>
        }
        <partial name="Partials/WidgetZone.CrossSells.Bottom" model="Model"/>
    </div>

    <script>
        $(document).ready(function () {
            $('#btnAddNewCrossSellProduct').magnificPopup({
                type: 'ajax',
                settings: { cache: false, async: false },
                midClick: true,
                callbacks: {
                    parseAjax: function (mfpResponse) {
                        mfpResponse.data = $('<div></div>').html(mfpResponse.data);
                    },
                    ajaxContentAdded: function () {
                        $('.mfp-wrap').removeAttr('tabindex');
                    }
                }
            });
        });
    </script>

    <script>
        $(document).ready(function () {
            $('#btnRefreshCrossSellProducts').click(function () {
                //refresh grid
                var grid = $("#crosssellproducts-grid").data('kendoGrid');
                grid.dataSource.read();

                //return false to don't reload a page
                return false;
            });
        });
    </script>
}
else
{
    <div class="note note-info">
        @Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.CrossSells.SaveBeforeEdit"]
    </div>
}
