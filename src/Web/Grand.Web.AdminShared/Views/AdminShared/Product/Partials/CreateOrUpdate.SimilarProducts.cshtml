@model ProductModel
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}


@if (!string.IsNullOrEmpty(Model.Id))
{
    <div class="panel panel-default">
        <div class="panel-heading">
            @Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.SimilarProducts"]
        </div>
        <div class="panel-body">
            <admin-grid id="similarproducts-grid"
                        read-url="@Url.Action("SimilarProductList", "Product", new { productId = Model.Id, area = area })"
                        update-url="@Url.Action("SimilarProductUpdate", "Product", new { area = area })"
                        destroy-url="@Url.Action("SimilarProductDelete", "Product", new { area = area })"
                        pager="Compact"
                        auto-bind="false"
                        edit-mode="Inline">
                <grid-column field="Product2Name" title="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.SimilarProducts.Fields.Product"]">
                    <cell-template>
                        <a class="text-decoration-none" href="@Url.Action("Edit", "Product", new { id = "", area = area })/{{ ProductId2 }}">{{ Product2Name }}</a>
                    </cell-template>
                </grid-column>
                <grid-column field="DisplayOrder" title="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.SimilarProducts.Fields.DisplayOrder"]" width="120" align="Center" format="{0:0}" editor="Integer"/>
                <grid-commands edit="true" destroy="true"/>
            </admin-grid>
        </div>
        <div class="panel-footer">
            <a id="btnAddNewSimilarProduct" href="@(Url.Action("SimilarProductAddPopup", "Product", new { productId = Model.Id, btnId = "btnRefreshSimilarProducts", formId = "product-form", area = area }))    " class="btn btn-default btn-sm"><i class="bi bi-plus-lg"></i>&nbsp;@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.SimilarProducts.AddNew"]</a>
            <input type="submit" id="btnRefreshSimilarProducts" style="display: none"/>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            $('#btnAddNewSimilarProduct').magnificPopup({
                type: 'ajax',
                settings: { cache: false, async: false },
                midClick: true,
                callbacks: {
                    parseAjax: function (mfpResponse) {
                        mfpResponse.data = $('<div></div>').html(mfpResponse.data);
                    },
                    ajaxContentAdded: function () {
                        $('.mfp-wrap').removeAttr('tabindex');
                    }
                }
            });
        });
    </script>

    <script>
        $(document).ready(function () {
            $('#btnRefreshSimilarProducts').click(function () {
                //refresh grid
                var grid = $("#similarproducts-grid").data('kendoGrid');
                grid.dataSource.read();

                //return false to don't reload a page
                return false;
            });
        });
    </script>
}
else
{
    <div class="note note-info">
        @Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.SimilarProducts.SaveBeforeEdit"]
    </div>
}