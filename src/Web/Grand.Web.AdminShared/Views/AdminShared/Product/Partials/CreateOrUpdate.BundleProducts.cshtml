@model ProductModel
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}

@if (!string.IsNullOrEmpty(Model.Id))
{
    <div class="panel panel-default">
        <partial name="Partials/WidgetZone.BundleProducts.Top" model="Model"/>
        <div class="panel-body">
            <admin-grid id="bundleproducts-grid"
                        read-url="@Url.Action("BundleProductList", "Product", new { productId = Model.Id, area = area })"
                        update-url="@Url.Action("BundleProductUpdate", "Product", new { area = area })"
                        destroy-url="@Url.Action("BundleProductDelete", "Product", new { area = area })"
                        pager="Compact"
                        auto-bind="false"
                        edit-mode="Inline">
                <grid-column field="ProductName" title="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.BundleProducts.Fields.Product"]">
                    <cell-template>
                        <a class="k-link" href="@Url.Action("Edit", "Product", new { id = "", area = area })/{{ ProductId }}">{{ ProductName }}</a>
                    </cell-template>
                </grid-column>
                <grid-column field="Quantity" title="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.BundleProducts.Fields.Quantity"]" format="{0:0}" editor="Integer"/>
                <grid-column field="DisplayOrder" title="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.BundleProducts.Fields.DisplayOrder"]" width="120" align="Center" format="{0:0}" min-screen-width="750" editor="Integer"/>
                <grid-commands edit="true" destroy="true"/>
            </admin-grid>
        </div>
        <div class="panel-footer">
            <a id="btnAddNewBundleProduct" href="@(Url.Action("BundleProductAddPopup", "Product", new { productId = Model.Id, btnId = "btnRefreshBundleProducts", formId = "product-form", area = area }))" class="k-button">
                @Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.BundleProducts.AddNew"]
            </a>
            <input type="submit" id="btnRefreshBundleProducts" style="display: none"/>
        </div>
        <partial name="Partials/WidgetZone.BundleProducts.Bottom" model="Model"/>
    </div>

    <script>
        $(document).ready(function () {
            $('#btnAddNewBundleProduct').magnificPopup({
                type: 'ajax',
                settings: { cache: false, async: false },
                midClick: true,
                callbacks: {
                    parseAjax: function (mfpResponse) {
                        mfpResponse.data = $('<div></div>').html(mfpResponse.data);
                    },
                    ajaxContentAdded: function () {
                        $('.mfp-wrap').removeAttr('tabindex');
                    }
                }
            });
        });
    </script>

    <script>
        $(document).ready(function () {
            $('#btnRefreshBundleProducts').click(function () {
                //refresh grid
                var grid = $("#bundleproducts-grid").data('kendoGrid');
                grid.dataSource.read();

                //return false to don't reload a page
                return false;
            });
        });
    </script>
}
else
{
    <div class="note note-info">
        @Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.BundleProducts.SaveBeforeEdit"]
    </div>
}
