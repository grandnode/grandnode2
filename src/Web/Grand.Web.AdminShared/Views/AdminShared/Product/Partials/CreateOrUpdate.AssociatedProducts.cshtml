@model ProductModel
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    //a product the store may see but not change (see BaseProductController.Edit)
    bool readOnly = ViewBag.IsReadOnly == true;
}
@if (!string.IsNullOrEmpty(Model.Id))
{
    <div class="note note-info">
        <p>@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.AssociatedProducts.Note2"]</p>
    </div>
    <div class="grand-card">
        <partial name="Partials/WidgetZone.AssociatedProducts.Top" model="Model"/>
        <div class="grand-card__body grand-card__body--flush">
            <admin-grid id="associatedproducts-grid"
                        read-only="@readOnly"
                        read-url="@Url.Action("AssociatedProductList", "Product", new { productId = Model.Id, area = area })"
                        update-url="@Url.Action("AssociatedProductUpdate", "Product", new { area = area })"
                        destroy-url="@Url.Action("AssociatedProductDelete", "Product", new { area = area })"
                        pager="Compact"
                        auto-bind="false"
                        edit-mode="Inline">
                <grid-column field="ProductName" title="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.AssociatedProducts.Fields.Product"]">
                    <cell-template>
                        <a class="text-decoration-none" href="@Url.Action("Edit", "Product", new { id = "", area = area })/{{ Id }}">{{ ProductName }}</a>
                    </cell-template>
                </grid-column>
                <grid-column field="DisplayOrder" title="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.AssociatedProducts.Fields.DisplayOrder"]" width="150" format="{0:0}" editor="Integer"/>
                <grid-commands edit="true" destroy="true" width="300"/>
            </admin-grid>
        </div>
        @if (!readOnly)
        {
            <div class="grand-card__body">
                <a id="btnAddNewAssociatedProduct" href="@(Url.Action("AssociatedProductAddPopup", "Product", new { productId = Model.Id, btnId = "btnRefreshAssociatedProducts", formId = "product-form", area = area }))" class="btn btn-outline-secondary btn-sm">
                    @Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.AssociatedProducts.AddNew"]
                </a>
                <input type="submit" id="btnRefreshAssociatedProducts" style="display: none"/>
            </div>
        }
        <partial name="Partials/WidgetZone.AssociatedProducts.Bottom" model="Model"/>
    </div>
    <script>
        $(document).ready(function () {
            $('#btnAddNewAssociatedProduct').magnificPopup({
                type: 'ajax',
                settings: { cache: false, async: false },
                midClick: true,
                callbacks: {
                    parseAjax: function (mfpResponse) {
                        mfpResponse.data = $('<div></div>').html(mfpResponse.data);
                    },
                    ajaxContentAdded: function () {
                        $('.mfp-wrap').removeAttr('tabindex');
                    }
                }
            });
        });
    </script>

    <script>
        $(document).ready(function () {
            $('#btnRefreshAssociatedProducts').click(function () {
                //refresh grid
                var grid = $("#associatedproducts-grid").data('kendoGrid');
                grid.dataSource.read();

                //return false to don't reload a page
                return false;
            });
        });
    </script>
}
else
{
    @Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.AssociatedProducts.SaveBeforeEdit"]
}
