@model ProductModel
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}

@if (!string.IsNullOrEmpty(Model.Id))
{
    <div class="panel panel-default">
        <partial name="Partials/WidgetZone.Categories.Top" model="Model"/>
        <div class="panel-heading">
            @Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.Categories.Fields.Category"]
        </div>
        <div class="panel-body">
            <admin-grid id="productcategories-grid"
                        read-url="@Url.Action("ProductCategoryList", "Product", new { productId = Model.Id, area = area })"
                        create-url="@Url.Action("ProductCategoryInsert", "Product", new { productId = Model.Id, area = area })"
                        update-url="@Url.Action("ProductCategoryUpdate", "Product", new { area = area })"
                        destroy-url="@Url.Action("ProductCategoryDelete", "Product", new { area = area })"
                        pager="Compact"
                        auto-bind="false"
                        edit-mode="Inline"
                        confirm-destroy="true">
                <grid-toolbar-create text="@Loc[$"{Scope.ResourceKeyPrefix}.Common.AddNewRecord"]"/>
                <grid-column field="CategoryId" title="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.Categories.Fields.Category"]" width="200"
                             editor="Select" options-url="@Url.Action("Category", "Search", new { area = area })" options-filter="startswith"
                             option-label="Select category..." text-field="Category" required="true" default-value="">
                    @*the link is a partial: Vendor overrides it with plain text (it cannot open categories)*@
                    <cell-template><partial name="Partials/Categories.LinkTemplate"/></cell-template>
                </grid-column>
                @if (Scope.ResourceKeyPrefix != "Vendor")
                {
                    @*Vendor has no IsFeaturedProduct column*@
                    <grid-column field="IsFeaturedProduct" title="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.Categories.Fields.IsFeaturedProduct"]" width="100" align="Center" editor="Checkbox">
                        <cell-template>
                            <i data-if="IsFeaturedProduct" class="fa fa-check" aria-hidden="true" style="color:green"></i>
                            <i data-else class="fa fa-times" aria-hidden="true" style="color:red"></i>
                        </cell-template>
                    </grid-column>
                }
                <grid-column field="DisplayOrder" title="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.Categories.Fields.DisplayOrder"]" width="100" align="Center" format="{0:0}" min-screen-width="500" editor="Integer" default-value="0"/>
                <grid-commands edit="true" destroy="true" width="200"/>
            </admin-grid>
        </div>
        <partial name="Partials/WidgetZone.Categories.Bottom" model="Model"/>
    </div>
}
else
{
    <div class="note note-info">
        @Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.Categories.SaveBeforeEdit"]
    </div>
}
