@model ProductModel
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    //a product the store may see but not change (see BaseProductController.Edit)
    bool readOnly = ViewBag.IsReadOnly == true;
}
@if (!string.IsNullOrEmpty(Model.Id))
{
    <input asp-for="AuctionEnded" type="hidden"/>

    <div class="panel panel-default">
        <partial name="Partials/WidgetZone.Bids.Top" model="Model"/>
        <div class="panel-body">
            <admin-grid id="bids-grid"
                        read-only="@readOnly"
                        read-url="@Url.Action("ListBids", "Product", new { productId = Model.Id, area = area })"
                        destroy-url="@Url.Action("BidDelete", "Product", new { area = area })"
                        auto-bind="false">
                <grid-text name="view" value="@Loc[$"{Scope.ResourceKeyPrefix}.Common.View"]"/>
                <grid-column field="Date" title="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.Bids.Date"]" width="200" format="{0:MM/dd/yyyy  h:mm tt}"/>
                <grid-column field="CustomerId" title="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.Bids.CustomerId"]" width="200">
                    <cell-template>
                        <a data-if="Email" href="@Url.Action("Edit", "Customer")/{{ CustomerId }}">{{ Email }}</a>
                    </cell-template>
                </grid-column>
                <grid-column field="Amount" title="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.Bids.Amount"]" width="200"/>
                <grid-column field="OrderId" title="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.Bids.OrderId"]" width="200">
                    <cell-template>
                        <a data-if="OrderId" class="btn btn-sm btn-default" href="@Url.Action("Edit", "Order", new { area = area })/{{ OrderId }}"><i class="bi bi-search"></i> {{ $texts.view }}</a>
                    </cell-template>
                </grid-column>
                <grid-commands destroy="true" width="100"/>
            </admin-grid>
        </div>
        <partial name="Partials/WidgetZone.Bids.Bottom" model="Model"/>
    </div>
}
else
{
    <div class="note note-info">
        @Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.Bids.SaveBeforeEdit"]
    </div>
}
