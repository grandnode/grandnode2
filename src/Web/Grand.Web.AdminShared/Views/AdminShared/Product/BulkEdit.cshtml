@model BulkEditListModel
@{
    //page title
    ViewBag.Title = Loc[$"{Scope.ResourceKeyPrefix}.Catalog.BulkEdit"];
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}
@* The product list's shape: one search field with the rest of the criteria behind the Filters
   toggle, and the batch grid in a flush card. The grid's Save changes commits the screen, so it is
   the one primary and Search is an outline button. The ids the script looks up are unchanged. *@
<form asp-area="@area" asp-controller="Product" asp-action="BulkEdit" method="post">
    <admin-page title="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.BulkEdit"]" icon="bi-boxes">
        <page-actions>
            <partial name="Partials/WidgetZone.BulkEditButtons"/>
        </page-actions>

        <admin-filters id="bulkedit-filters" submit-id="search-products" secondary-submit="true">
            <filters-search>
                <admin-input asp-for="SearchProductName"/>
            </filters-search>
            <admin-field asp-for="SearchCategoryId"/>
            <admin-field asp-for="SearchBrandId"/>
            <admin-field asp-for="SearchCollectionId"/>
            <admin-field asp-for="SearchProductTypeId" asp-items="Model.AvailableProductTypes"/>
            @if (area == "Admin")
            {
                <admin-field asp-for="SearchStoreId" asp-items="Model.AvailableStores"/>
            }
        </admin-filters>

        <admin-card flush>
            <admin-grid id="products-grid"
                        read-url="@Url.Action("BulkEditSelect", "Product", new { area = area })"
                        update-url="@Url.Action("BulkEditUpdate", "Product", new { area = area })"
                        destroy-url="@Url.Action("BulkEditDelete", "Product", new { area = area })"
                        additional-data="additionalData"
                        edit-mode="Batch"
                        batch-prefix="products"
                        confirm-destroy="true">
                <grid-toolbar-save/>
                <grid-toolbar-cancel/>
                <grid-text name="view" value="@Loc[$"{Scope.ResourceKeyPrefix}.Common.View"]"/>
                <grid-column field="Name" title="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.BulkEdit.Fields.Name"]" width="200" editor="Text"/>
                <grid-column field="ProductId" title="@Loc[$"{Scope.ResourceKeyPrefix}.Common.View"]" width="80">
                    <cell-template>
                        <a href="@Url.Action("Edit", "Product", new { area = area })/{{ Id }}">{{ $texts.view }}</a>
                    </cell-template>
                </grid-column>
                <grid-column field="Sku" title="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.BulkEdit.Fields.Sku"]" width="100" editor="Text"/>
                @*prices are posted with four decimals in the request culture, like the Kendo parameterMap*@
                <grid-column field="Price" title="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.BulkEdit.Fields.Price"]" width="100" editor="Numeric" decimals="4"/>
                <grid-column field="OldPrice" title="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.BulkEdit.Fields.OldPrice"]" width="100" editor="Numeric" decimals="4"/>
                <grid-column field="StockQuantity" title="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.BulkEdit.Fields.StockQuantity"]" width="100" format="{0:0}" editor="Integer"/>
                <grid-column field="ManageInventoryMethodId" title="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.BulkEdit.Fields.ManageInventoryMethod"]" width="150"
                             editor="Select" options="EnumTranslationService.ToSelectList(ManageInventoryMethod.DontManageStock)" text-field="ManageInventoryMethod"/>
                <grid-column field="Published" title="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.BulkEdit.Fields.Published"]" width="90" editor="Checkbox"/>
                <grid-commands destroy="true" title="@Loc[$"{Scope.ResourceKeyPrefix}.Common.Delete"]" width="100"/>
            </admin-grid>
        </admin-card>
    </admin-page>

    <script>
        $(document).ready(function () {
            $('#search-products').click(function () {
                    var grid = $('#products-grid').data('kendoGrid');
                    grid.dataSource.page(1); //new search. Set page size to 1
                                             //grid.dataSource.read(); we already loaded the grid above using "page" function
                    return false;
                });

            $("#@Html.IdFor(model => model.SearchProductName)").keydown(function (event) {
                    if (event.keyCode == 13) {
                    $("#search-products").click();
                        return false;
                    }
                });
            });

            function additionalData() {
                var data = {
                SearchProductName: $('#@Html.IdFor(model => model.SearchProductName)').val(),
                SearchCategoryId: $('#SearchCategoryId').val(),
                SearchBrandId: $('#SearchBrandId').val(),
                SearchCollectionId: $('#SearchCollectionId').val(),
                SearchProductTypeId: $('#SearchProductTypeId').val(),
                @if (area == "Admin")
                {
                    <text>SearchStoreId: $('#SearchStoreId').val(),</text>
                }
            };
            addAntiForgeryToken(data);
            return data;
        }
    </script>
</form>
