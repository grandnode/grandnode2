@model ProductModel.ProductAttributeValueModel.AssociateProductToAttributeValueModel
@{
    Layout = "";
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    //page title
    ViewBag.Title = Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.ProductAttributes.Attributes.Values.Fields.AssociatedProduct.AddNew"];
}

<form asp-area="@area" asp-controller="Product" asp-action="AssociateProductToAttributeValuePopup"
      asp-route-productIdInput="@HtmlExtensions.HtmlEncodeSafe(Context.Request.Query["productIdInput"])"
      asp-route-productNameInput="@HtmlExtensions.HtmlEncodeSafe(Context.Request.Query["productNameInput"])" id="associateproduct">
    <admin-popup title="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.ProductAttributes.Attributes.Values.Fields.AssociatedProduct.AddNew"]" icon="bi-boxes">
        <admin-filters id="product-picker-filters" submit-id="search-products">
            <filters-search>
                <admin-input asp-for="SearchProductName"/>
            </filters-search>
            <admin-field asp-for="SearchCategoryId"/>
            <admin-field asp-for="SearchBrandId"/>
            <admin-field asp-for="SearchCollectionId"/>
            @if (area == "Admin")
            {
                <admin-field asp-for="SearchStoreId" asp-items="Model.AvailableStores"/>
                <admin-field asp-for="SearchVendorId" asp-items="Model.AvailableVendors"/>
            }
            <admin-field asp-for="SearchProductTypeId" asp-items="Model.AvailableProductTypes"/>
        </admin-filters>
        <admin-card flush>
            <admin-grid id="products-grid"
                        read-url="@Url.Action("AssociateProductToAttributeValuePopupList", "Product", new { area = area })"
                        additional-data="additionalData">
                <grid-text name="select" value="@Loc[$"{Scope.ResourceKeyPrefix}.Common.Select"]"/>
                <grid-column field="Name" title="@Loc[$"{Scope.ResourceKeyPrefix}.Common.Select"]" width="50">
                    <cell-template>
                        <input type="button" value="{{ $texts.select }}" data-grid-click="selectAssociatedProductRow" class="btn btn-outline-secondary btn-sm" />
                    </cell-template>
                </grid-column>
                <grid-column field="Name" title="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.Fields.Name"]"/>
                <grid-column field="Published" title="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.Fields.Published"]" width="100" align="Center">
                    <cell-template>
                        <i data-if="Published" class="bi bi-check-lg text-success" aria-hidden="true"></i>
                        <i data-else class="bi bi-x-lg text-danger" aria-hidden="true"></i>
                    </cell-template>
                </grid-column>
            </admin-grid>
        </admin-card>
    </admin-popup>
    <input asp-for="AssociatedToProductId" type="hidden"/>
    <script>
        var mfp = $.magnificPopup.instance;
        $("#associateproduct").submit(function (e) {
            e.preventDefault();
            var form = $(this);
            var url = form.attr('action');
            $.ajax({
                type: "POST",
                url: url,
                data: form.serialize(),
                success: function (data) {
                    if (data == "") {
                        var productId = $("#@Html.IdFor(model => model.AssociatedToProductId)").val();
                        var productName = $("#@Html.IdFor(model => model.AssociatedToProductId)").data("name");
                        var id = $('.btnProductAttributeValueEditPopup.active').data("id");
                        var button = $('.btnProductAttributeValueEditPopup[data-id="' + id + '"]');
                        var mfp = $('.mfp-wrap');

                        mfp.attr("data-id", id);
                        mfp.attr("data-prodid", productId);
                        mfp.attr("data-prodname", productName);

                        $('.btnProductAttributeValueEditPopup.active').removeClass('active');

                        button.click();

                    } else {
                        $.magnificPopup.instance.currItem.src = data;
                        $.magnificPopup.instance.updateItemHTML();
                    }
                }
            });
        });

        function additionalData() {
            var data = {
                SearchProductName: $('#@Html.IdFor(model => model.SearchProductName)').val(),
                SearchCategoryId: $('#SearchCategoryId').val(),
                SearchBrandId: $('#SearchBrandId').val(),
                SearchCollectionId: $('#SearchCollectionId').val(),
                @if (area == "Admin")
                {
                    <text>SearchStoreId: $('#SearchStoreId').val(),
                SearchVendorId: $('#SearchVendorId').val(),</text>
                }
                SearchProductTypeId: $('#SearchProductTypeId').val()
            };
            addAntiForgeryToken(data);
            return data;
        }

        function selectAssociatedProductRow(product) {
            selectAssociatedProduct(product.Id, product.Name);
        }

        function selectAssociatedProduct(productid, productname) {
            $("#@Html.IdFor(model => model.AssociatedToProductId)").val(productid);
            $("#@Html.IdFor(model => model.AssociatedToProductId)").attr("data-name", productname);
            $('#associateproduct').submit();
        }


            $('#search-products').click(function () {
                var grid = GrandAdmin.grids.get('#products-grid');
                grid.dataSource.page(1); //new search. Set page size to 1
                //grid.dataSource.read(); we already loaded the grid above using "page" function
                return false;
            });

        $("#@Html.IdFor(model => model.SearchProductName)").keydown(function (event) {
            if (event.keyCode == 13) {
                $("#search-products").click();
                return false;
            }
        });

    </script>
</form>
