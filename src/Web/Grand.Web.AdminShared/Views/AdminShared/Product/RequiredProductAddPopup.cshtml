@model ProductModel.AddRequiredProductModel
@{
    Layout = "";
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    //page title
    ViewBag.Title = Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.Fields.RequiredProductIds.Choose"];
}

<admin-popup title="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.Fields.RequiredProductIds.Choose"]" icon="bi-boxes">
    <admin-filters id="product-picker-filters" submit-id="search-products">
        <filters-search>
            <admin-input asp-for="SearchProductName"/>
        </filters-search>
        <admin-field asp-for="SearchCategoryId"/>
        <admin-field asp-for="SearchBrandId"/>
        <admin-field asp-for="SearchCollectionId"/>
        @if (area == "Admin")
        {
            <admin-field asp-for="SearchStoreId" asp-items="Model.AvailableStores"/>
            <admin-field asp-for="SearchVendorId" asp-items="Model.AvailableVendors"/>
        }
        <admin-field asp-for="SearchProductTypeId" asp-items="Model.AvailableProductTypes"/>
    </admin-filters>
    <admin-card flush>
        <admin-grid id="products-grid"
                    read-url="@Url.Action("RequiredProductAddPopupList", "Product", new { area = area })"
                    additional-data="additionalData">
            <grid-text name="select" value="@Loc[$"{Scope.ResourceKeyPrefix}.Common.Select"]"/>
            <grid-column field="Name" title="@Loc[$"{Scope.ResourceKeyPrefix}.Common.Select"]" width="50">
                <cell-template>
                    <input type="button" value="{{ $texts.select }}" data-grid-click="selectRequiredProductRow" class="btn btn-outline-secondary btn-sm" />
                </cell-template>
            </grid-column>
            <grid-column field="Name" title="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.Fields.Name"]"/>
            <grid-column field="Published" title="@Loc[$"{Scope.ResourceKeyPrefix}.Catalog.Products.Fields.Published"]" width="100" align="Center">
                <cell-template>
                    <i data-if="Published" class="bi bi-check-lg text-success" aria-hidden="true"></i>
                    <i data-else class="bi bi-x-lg text-danger" aria-hidden="true"></i>
                </cell-template>
            </grid-column>
        </admin-grid>
    </admin-card>
</admin-popup>
