@model EmailAccountModel
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    ViewBag.Title = Loc["Admin.Configuration.EmailAccounts.EditEmailAccountDetails"];
}
<form asp-area="@area" asp-controller="EmailAccount" asp-action="Edit" method="post">

    @* the address as the title, Save as the one primary action, Delete in the overflow menu *@
    <admin-page sticky
                title="@Model.Email"
                icon="bi-envelope"
                meta="@Loc["Admin.Configuration.EmailAccounts.EditEmailAccountDetails"]"
                back-url="@Url.Action("List")"
                back-text="@Loc["Admin.Configuration.EmailAccounts.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <admin-action-menu>
                <admin-action id="emailAccount-delete" destructive="true" icon="bi-trash"
                              text="@Loc["Admin.Common.Delete"]"/>
            </admin-action-menu>
            <partial name="Partials/WidgetZone.DetailsButtons" model="Model"/>
        </page-actions>

        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>
<admin-delete-confirmation button-id="emailAccount-delete"/>
