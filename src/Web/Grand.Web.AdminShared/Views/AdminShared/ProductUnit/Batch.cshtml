@model Grand.Web.AdminShared.Models.Inventory.BatchModel
@{
    ViewBag.Title = Model.Number;
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}
<admin-page title="@Model.Number" icon="bi-boxes" meta="@Model.ExpiryStatus"
            back-url="@Url.Action("Batches", new { area })" back-text="@Loc["Admin.Inventory.Units.Batches"]">
    <page-actions>
        <a class="btn btn-outline-secondary" href="@Url.Action("BatchRecipientsCsv", new { area, id = Model.Id })">
            <i class="bi bi-filetype-csv"></i> @Loc["Admin.Inventory.Units.RecipientsCsv"]
        </a>
    </page-actions>
    <admin-card>
        <dl class="row mb-0">
            <dt class="col-sm-3">@Loc["Admin.Inventory.Documents.Fields.Product"]</dt>
            <dd class="col-sm-9"><a href="@Url.Action("Edit", "Product", new { area, id = Model.ProductId })">@Model.ProductName</a></dd>
            <dt class="col-sm-3">@Loc["Admin.Inventory.Documents.Fields.Warehouse"]</dt>
            <dd class="col-sm-9">@Model.Warehouse</dd>
            <dt class="col-sm-3">@Loc["Admin.Inventory.Units.Fields.ExpiryDate"]</dt>
            <dd class="col-sm-9">@Model.ExpiryDate?.ToShortDateString() @Model.ExpiryStatus</dd>
            <dt class="col-sm-3">@Loc["Admin.Inventory.Documents.Fields.Quantity"]</dt>
            <dd class="col-sm-9">@Model.Quantity</dd>
            <dt class="col-sm-3">@Loc["Admin.Inventory.Documents.Fields.UnitCost"]</dt>
            <dd class="col-sm-9">@Model.UnitCost</dd>
            <dt class="col-sm-3">@Loc["Admin.Inventory.Units.Fields.ReceivedOn"]</dt>
            <dd class="col-sm-9">
                @Model.ReceivedOn.ToShortDateString()
                @if (!string.IsNullOrEmpty(Model.ReceiptDocumentId))
                {
                    <a href="@Url.Action("Edit", "InventoryDocument", new { area, id = Model.ReceiptDocumentId })">@Loc["Admin.Inventory.Units.Receipt"]</a>
                }
            </dd>
        </dl>
    </admin-card>

    @* a recall: every shipment that kept units of the batch, a page at a time *@
    <admin-card title="@Loc["Admin.Inventory.Units.Recipients"]" flush>
        <admin-grid id="batchrecipients-grid"
                    read-url="@Url.Action("BatchRecipientList", "ProductUnit", new { area, id = Model.Id })">
            <grid-column field="ShipmentNumber" title="@Loc["Admin.Inventory.Units.Shipment"]" width="110">
                <cell-template>
                    <a class="text-decoration-none" href="@Url.Action("ShipmentDetails", "Shipment", new { area })/{{ ShipmentId }}">#{{ ShipmentNumber }}</a>
                </cell-template>
            </grid-column>
            <grid-column field="OrderNumber" title="@Loc["Admin.Inventory.Units.Order"]" width="110">
                <cell-template>
                    <a class="text-decoration-none" href="@Url.Action("Edit", "Order", new { area })/{{ OrderId }}">#{{ OrderNumber }}</a>
                </cell-template>
            </grid-column>
            <grid-column field="CustomerEmail" title="@Loc["Admin.Inventory.Units.Customer"]"/>
            <grid-column field="Quantity" title="@Loc["Admin.Inventory.Documents.Fields.Quantity"]" width="100"/>
            <grid-column field="ShippedOn" title="@Loc["Admin.Inventory.Units.ShippedOn"]" width="130" format="{0:d}"/>
        </admin-grid>
    </admin-card>
    <partial name="Partials/UnitHistory" model="@Url.Action("BatchHistoryList", "ProductUnit", new { area, id = Model.Id })"/>
</admin-page>
