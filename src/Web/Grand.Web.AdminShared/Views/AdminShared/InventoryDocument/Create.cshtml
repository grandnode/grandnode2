@model Grand.Web.AdminShared.Models.Inventory.InventoryDocumentModel
@using Grand.Domain.Catalog
@{
    ViewBag.Title = Model.DocumentType;
    var area = ViewContext.RouteData.Values["area"]?.ToString();

    string SearchOptions(string action, IEnumerable<string> values) => System.Text.Json.JsonSerializer.Serialize(new {
        mode = "multiple",
        url = Url.Action(action, "Search", new { area }),
        textField = "Name",
        valueField = "Id",
        filter = "startswith",
        values = values ?? []
    });
}
<form asp-area="@area" asp-controller="InventoryDocument" asp-action="Create" method="post">
    <input type="hidden" asp-for="DocumentTypeId"/>
    <admin-page title="@Model.DocumentType" icon="bi-box-seam"
                back-url="@Url.Action("List")" back-text="@Loc["Admin.Inventory.Documents.BackToList"]">
        <page-actions>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Inventory.Documents.CreateDraft"]
            </button>
        </page-actions>

        @if (Model.AvailableWarehouses.All(x => string.IsNullOrEmpty(x.Value)))
        {
            @* a fresh installation without sample data has no warehouse, and every document needs one *@
            <div class="alert alert-warning">
                @Loc["Admin.Inventory.Documents.NoWarehouses"]
                <a asp-area="@area" asp-controller="Warehouse" asp-action="Warehouses">@Loc["Admin.Configuration.Shipping.Warehouses"]</a>
            </div>
        }

        @if (Model.DocumentTypeId == (int)InventoryDocumentType.StockCount)
        {
            @* a count lists every product kept in the warehouse, or those of the chosen categories and brands *@
            <admin-card>
                <div class="grand-fields grand-fields--2col">
                    <admin-field asp-for="WarehouseId" asp-items="Model.AvailableWarehouses"/>
                    @* searched by name on the server, as the product list's filters are: a catalog may hold thousands *@
                    <admin-field asp-for="CategoryIds">
                        <select asp-for="CategoryIds" asp-items="Model.AvailableCategories" multiple class="form-select"
                                data-grand-select="@SearchOptions("Category", Model.CategoryIds)"></select>
                    </admin-field>
                    <admin-field asp-for="BrandIds">
                        <select asp-for="BrandIds" asp-items="Model.AvailableBrands" multiple class="form-select"
                                data-grand-select="@SearchOptions("Brand", Model.BrandIds)"></select>
                    </admin-field>
                </div>
            </admin-card>
        }
        else
        {
            <partial name="Partials/CreateOrUpdate.Header" model="Model"/>
        }
    </admin-page>
</form>
