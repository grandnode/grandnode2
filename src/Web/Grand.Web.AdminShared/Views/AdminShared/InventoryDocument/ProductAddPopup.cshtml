@model Grand.Web.AdminShared.Models.Inventory.InventoryDocumentProductAddModel
@{
    Layout = "";
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    ViewBag.Title = Loc["Admin.Inventory.Documents.AddProducts"];
}
@* the products checked are handed to the document's form, which adds them with what was typed there: this popup
   saves nothing of its own *@
<form id="InventoryDocumentProductAddPopup">
    <admin-popup title="@Loc["Admin.Inventory.Documents.AddProducts"]" icon="bi-box-seam">
        <admin-filters id="product-picker-filters" submit-id="search-products">
            <filters-search>
                <admin-input asp-for="SearchProductName"/>
            </filters-search>
            <admin-field asp-for="SearchCategoryId"/>
            <admin-field asp-for="SearchBrandId"/>
            <admin-field asp-for="SearchCollectionId"/>
            @if (area == "Admin")
            {
                <admin-field asp-for="SearchStoreId" asp-items="Model.AvailableStores"/>
                <admin-field asp-for="SearchVendorId" asp-items="Model.AvailableVendors"/>
            }
            <admin-field asp-for="SearchProductTypeId" asp-items="Model.AvailableProductTypes"/>
        </admin-filters>
        <admin-card flush>
            <admin-grid id="products-grid"
                        read-url="@Url.Action("ProductAddPopupList", "InventoryDocument", new { area })"
                        additional-data="additionalData"
                        selectable="Checkbox">
                <grid-column field="Name" title="@Loc["Admin.Catalog.Products.Fields.Name"]"/>
                <grid-column field="Sku" title="@Loc["Admin.Catalog.Products.Fields.Sku"]" width="180"/>
                <grid-column field="Published" title="@Loc["Admin.Catalog.Products.Fields.Published"]" width="100" align="Center">
                    <cell-template>
                        <i data-if="Published" class="bi bi-check-lg text-success" aria-hidden="true"></i>
                        <i data-else class="bi bi-x-lg text-danger" aria-hidden="true"></i>
                    </cell-template>
                </grid-column>
            </admin-grid>
        </admin-card>
        <p class="grand-field__hint">@Loc["Admin.Inventory.Documents.AddProducts.Hint"]</p>
        <div class="grand-popup__actions">
            <button class="btn btn-primary" type="submit">
                <i class="bi bi-plus-lg"></i> @Loc["Admin.Inventory.Documents.AddLines"]
            </button>
        </div>
    </admin-popup>
    <script>
        (function () {
            $('#InventoryDocumentProductAddPopup').submit(function (e) {
                e.preventDefault();
                //the rows checked on every page of the list
                var selected = GrandAdmin.grids.get('#products-grid').selectedIds;
                if (selected.length === 0) return;
                $.magnificPopup.instance.close();
                window.inventoryDocumentAddProducts(selected);
            });

            $('#search-products').click(function () {
                var grid = GrandAdmin.grids.get('#products-grid');
                grid.dataSource.page(1);
                return false;
            });

            $('#@Html.IdFor(model => model.SearchProductName)').keydown(function (event) {
                if (event.keyCode == 13) {
                    $('#search-products').click();
                    return false;
                }
            });
        })();

        function additionalData() {
            var data = {
                SearchProductName: $('#@Html.IdFor(model => model.SearchProductName)').val(),
                SearchCategoryId: $('#SearchCategoryId').val(),
                SearchBrandId: $('#SearchBrandId').val(),
                SearchCollectionId: $('#SearchCollectionId').val(),
                @if (area == "Admin")
                {
                    <text>SearchStoreId: $('#SearchStoreId').val(),
                SearchVendorId: $('#SearchVendorId').val(),</text>
                }
                SearchProductTypeId: $('#SearchProductTypeId').val()
            };
            addAntiForgeryToken(data);
            return data;
        }
    </script>
</form>
