@using Grand.Domain.Orders
@using Grand.Domain.Tax
@model OrderModel
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var includingTax = Model.TaxDisplayType == TaxDisplayType.IncludingTax;
    var hasDiscount = Model.Items.Sum(x => x.DiscountInclTaxValue) > 0;
    var hasCommission = Model.Items.Sum(x => x.CommissionValue) > 0;
    //the server refuses every order item edit of a canceled order (BaseOrderManagementController)
    var orderCanceled = Model.OrderStatusId == (int)OrderStatusSystem.Cancelled;
    //items whose extra actions need more than one row cell: returns, gift vouchers, downloads
    var itemsWithExtras = Model.Items
        .Where(x => x.MerchandiseReturnIds.Count > 0 || x.PurchasedGiftVoucherIds.Count > 0 ||
                    (Model.HasDownloadableProducts && x.IsDownload))
        .ToList();
}

<partial name="Partials/WidgetZone.Products.Top" model="Model"/>

<admin-grid id="orderitems-grid"
            data="@Model.Items"
            pager="Compact"
            edit-mode="Inline"
            confirm-destroy="true"
            reload-after-save="false"
            update-url="@(orderCanceled ? null : Url.Action("OrderItemUpdate", "Order", new { orderId = Model.Id, area }))"
            destroy-url="@(orderCanceled ? null : Url.Action("OrderItemDelete", "Order", new { orderId = Model.Id, area }))"
            on-request-end="orderItemsRequestEnd">
    <grid-text name="sku" value="@Loc["Admin.Orders.Products.SKU"]"/>
    <grid-text name="vendor" value="@Loc["Admin.Orders.Products.Vendor"]"/>
    <grid-text name="exclTax" value="@Loc["Admin.Orders.Products.Edit.ExclTax"]"/>
    <grid-column field="PictureThumbnailUrl" title="@Loc["Admin.Orders.Products.Picture"]" width="80" editable="false">
        <cell-template>
            <img data-if="PictureThumbnailUrl" src="{{ PictureThumbnailUrl }}" alt="" title=""/>
        </cell-template>
    </grid-column>
    <grid-column field="ProductName" title="@Loc["Admin.Orders.Products.ProductName"]" width="350" editable="false">
        <cell-template>
            <div>
                <em><a href="@Url.Action("Edit", "Product", new { area })/{{ ProductId }}">{{ ProductName }}</a></em>
                <p data-if="AttributeInfo">{{{ AttributeInfo }}}</p>
                <p data-if="RecurringInfo">{{{ RecurringInfo }}}</p>
                <p data-if="RentalInfo">{{{ RentalInfo }}}</p>
                <p data-if="Sku"><strong>{{ $texts.sku }}</strong>: {{ Sku }}</p>
                <p data-if="VendorName"><strong>{{ $texts.vendor }}</strong>: {{ VendorName }}</p>
            </div>
        </cell-template>
    </grid-column>
    @* the cell shows the amount of the order's tax display type; the editor holds the amount the
       server takes, the unit price excl. tax, which an including-tax order also lists under it *@
    <grid-column field="UnitPriceExclTaxValue" width="150" title="@Loc["Admin.Orders.Products.Price"]"
                 editor="Numeric" decimals="2" min="0">
        <cell-template>
            @if (includingTax)
            {
                <div>{{ UnitPriceInclTax }}</div>
                <div data-if="OpenQty > 0" class="text-muted">{{ $texts.exclTax }} {{ UnitPriceExclTax }}</div>
            }
            else
            {
                <span>{{ UnitPriceExclTax }}</span>
            }
        </cell-template>
    </grid-column>
    <grid-column field="Quantity" title="@Loc["Admin.Orders.Products.Quantity"]" width="120" editor="Integer" min="1">
        <cell-template>
            <div>{{ Quantity }}</div>
            <div data-if="OpenQty > 0">Open: {{ OpenQty }}</div>
            <div data-if="CancelQty > 0">Canceled: {{ CancelQty }}</div>
        </cell-template>
    </grid-column>
    @if (hasDiscount)
    {
        <grid-column field="@(includingTax ? "DiscountInclTax" : "DiscountExclTax")" width="120"
                     title="@Loc["Admin.Orders.Products.Discount"]" editable="false"/>
    }
    @if (hasCommission)
    {
        <grid-column field="Commission" title="@Loc["Admin.Orders.Products.Commission"]" width="120" editable="false"/>
    }
    <grid-column field="@(includingTax ? "SubTotalInclTax" : "SubTotalExclTax")" width="120"
                 title="@Loc["Admin.Orders.Products.Total"]" editable="false"/>
    @if (!orderCanceled)
    {
        @* the server refuses a delete unless the whole quantity is still open, and refuses an edit of
           a partly shipped item; a row that fails both keeps no button. It still re-checks everything. *@
        <grid-commands edit="true" destroy="true" width="330" title="@Loc["Admin.Common.Edit"]" visible-if="OpenQty > 0 && OpenQty == Quantity">
            <grid-command name="cancelItem" text="@Loc["Admin.Common.Cancel"]" icon="bi bi-x-lg"
                          click="orderItemCancel" visible-if="OpenQty > 0"/>
        </grid-commands>
    }
</admin-grid>

<partial name="Partials/WidgetZone.Products.Bottom" model="Model"/>

@if (itemsWithExtras.Count > 0)
{
    <div class="order-item-extras mt-3">
        @foreach (var item in itemsWithExtras)
        {
            <div class="panel panel-default mb-3">
                <div class="panel-body">
                    <strong>@item.ProductName</strong>
                    @if (item.MerchandiseReturnIds.Count > 0)
                    {
                        <p>
                            @Loc["Admin.Orders.Products.MerchandiseReturns"]<text>:</text>
                            @for (var i = 0; i < item.MerchandiseReturnIds.Count; i++)
                            {
                                <a href="@Url.Action("Edit", "MerchandiseReturn", new { id = item.MerchandiseReturnIds[i], area = area })" class="btn btn-default btn-sm"><span class="bi bi-eye"></span>&nbsp;@Loc["Admin.Orders.MerchandiseReturns.View"]</a>
                                if (i != item.MerchandiseReturnIds.Count - 1)
                                {
                                    <text>,</text>
                                }
                            }
                        </p>
                    }
                    @if (item.PurchasedGiftVoucherIds.Count > 0)
                    {
                        <p>
                            @Loc["Admin.Orders.Products.GiftVouchers"]<text>:</text>
                            @for (var i = 0; i < item.PurchasedGiftVoucherIds.Count; i++)
                            {
                                <a href="@Url.Action("Edit", "GiftVoucher", new { id = item.PurchasedGiftVoucherIds[i], area = area })" class="btn btn-default btn-sm"><span class="bi bi-eye"></span>&nbsp;@Loc["Admin.Orders.Products.GiftVoucher.View"]</a>
                                if (i != item.PurchasedGiftVoucherIds.Count - 1)
                                {
                                    <text>,</text>
                                }
                            }
                        </p>
                    }
                    @if (Model.HasDownloadableProducts && item.IsDownload)
                    {
                        <div>
                            @string.Format(Loc["Admin.Orders.Products.Download.DownloadCount"], item.DownloadCount)
                            <input type="submit" asp-action="ResetDownloadCount" asp-route-orderItemId="@(item.Id)"
                                   name="btnResetDownloadCount@(item.Id)" value="@Loc["Admin.Orders.Products.Download.ResetDownloadCount"]" title="@Loc["Admin.Orders.Products.Download.ResetDownloadCount.Title"]" id="btnResetDownloadCount@(item.Id)" class="btn btn-default btn-sm"/>
                        </div>
                        if (item.DownloadActivationType == DownloadActivationType.Manually)
                        {
                            <div class="mt-2">
                                <input type="submit" name="btnPvActivateDownload@(item.Id)"
                                       value="@(item.IsDownloadActivated ? Loc["Admin.Orders.Products.Download.Deactivate"] : Loc["Admin.Orders.Products.Download.Activate"])"
                                       id="btnPvActivateDownload@(item.Id)" class="btn btn-default btn-sm" asp-action="ActivateDownloadItem" asp-route-orderItemId="@(item.Id)"/>
                            </div>
                        }
                        <div class="mt-2">
                            <strong>@Loc["Admin.Orders.Products.License"]</strong>
                            <br/>
                            @if (item.LicenseDownloadGuid != Guid.Empty)
                            {
                                <a href="@Url.Action("DownloadFile", "Download", new { downloadGuid = item.LicenseDownloadGuid, area = area })" class="btn purple">@Loc["Admin.Orders.Products.License.DownloadLicense"]</a>
                                <br/>
                            }
                            <a href="@(Url.Action("UploadLicenseFilePopup", "Order", new { id = Model.Id, orderItemId = item.Id, btnId = "btnRefreshPage", formId = "order-form", area = area }))" class="btn btn-default btn-sm order-item-license">
                                @Loc["Admin.Orders.Products.License.UploadFile"]
                            </a>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@if (!string.IsNullOrEmpty(Model.CheckoutAttributeInfo))
{
    <div class="note note-info">
        @Html.Raw(Model.CheckoutAttributeInfo)
    </div>
}
<div class="form-actions">
    <a href="@(Url.Action("AddProductToOrder", "Order", new { orderId = Model.Id, area = area }))" id="btnAddNewProduct" class="btn btn-default btn-sm">
        <i class="bi bi-plus-lg"></i>&nbsp;@Loc["Admin.Orders.Products.AddNew"]
    </a>
</div>

<script>
    //every order item change moves the order totals and can move its status, so the page is
    //reloaded after a successful one exactly like the old form post's redirect did
    function orderItemsRequestEnd(e) {
        if (!e || e.type === 'read') return;
        if (!e.response || e.response.Errors) return;
        location.reload();
    }

    function orderItemCancel(dataItem) {
        if (!confirm('@Loc["Admin.Common.AreYouSure"]')) return;
        var postData = { orderId: '@Model.Id', orderItemId: dataItem.Id };
        addAntiForgeryToken(postData);
        $.ajax({
            cache: false,
            type: 'POST',
            url: '@Url.Action("OrderItemCancel", "Order", new { area })',
            data: postData,
            success: function (data) {
                if (data && data.Errors) {
                    display_kendoui_grid_error({ errors: data.Errors });
                    return;
                }
                location.reload();
            },
            error: function () {
                display_kendoui_grid_error({ errorThrown: 'error' });
            }
        });
    }

    $(document).ready(function () {
        $('.order-item-license').magnificPopup({
            type: 'ajax',
            settings: { cache: false, async: false },
            midClick: true,
            callbacks: {
                parseAjax: function (mfpResponse) {
                    mfpResponse.data = $('<div></div>').html(mfpResponse.data);
                },
                ajaxContentAdded: function () {
                    $('.mfp-wrap').removeAttr('tabindex');
                }
            }
        });
    });
</script>
