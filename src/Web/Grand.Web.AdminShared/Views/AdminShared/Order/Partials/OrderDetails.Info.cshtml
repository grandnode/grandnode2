@using System.Text.Encodings.Web
@using Grand.Business.Core.Interfaces.Checkout.Orders
@using Grand.Domain.Payments
@using Grand.Domain.Tax
@using Constants = Grand.SharedUIResources.Constants
@model OrderModel
@inject IOrderTagService orderTagService


<link rel="stylesheet" type="text/css" asp-src="@(Constants.WwwRoot)/administration/tagEditor/jquery.tag-editor.css"/>
<script asp-location="Footer" asp-src="@(Constants.WwwRoot)/administration/tagEditor/jquery.tag-editor.min.js"></script>
<script asp-location="Footer" asp-src="@(Constants.WwwRoot)/administration/tagEditor/jquery.caret.min.js"></script>

@{
    //tags
    var orderTags = await orderTagService.GetAllOrderTags();
    var orderTagsSB = new StringBuilder();
    orderTagsSB.Append("var initialOrderTags = [");
    for (var i = 0; i < orderTags.Count; i++)
    {
        var tag = orderTags[i];
        orderTagsSB.Append("'");
        orderTagsSB.Append(JavaScriptEncoder.Default.Encode(tag.Name));
        orderTagsSB.Append("'");
        if (i != orderTags.Count - 1)
        {
            orderTagsSB.Append(",");
        }
    }

    orderTagsSB.Append("]");
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}

<script>
        $(document).ready(function() {
            toggleChangeOrderStatus(false);
            toggleOrderTotals(false);

            //tags
            @Html.Raw(orderTagsSB.ToString())
            $("#@Html.IdFor(model => model.OrderTags)").tagEditor({
                autocomplete: {
                    delay: 0,
                    position: { collision: 'flip' },
                    source: initialOrderTags
                },
                delimiter: ',',
                placeholder: 'Enter tags...'
            });
        });

        function toggleChangeOrderStatus(editmode) {
            if (editmode) {
                $('#pnlChangeOrderStatus').show();
                $('#btnChangeOrderStatus').hide();
            } else {
                $('#pnlChangeOrderStatus').hide();
                $('#btnChangeOrderStatus').show();
            }
        }

        function toggleOrderTotals(editmode) {
            if (editmode) {
                $('#trEditOrderTotals').show();
                $('#btnEditOrderTotals').hide();
                $('#btnSaveOrderTotals').show();
                $('#btnCancelOrderTotals').show();
            } else {
                $('#trEditOrderTotals').hide();
                $('#btnEditOrderTotals').show();
                $('#btnSaveOrderTotals').hide();
                $('#btnCancelOrderTotals').hide();
            }
        }

    </script>

@* What the order states is read as facts; the few things that can be changed here - the status,
   the tags, the totals - keep their buttons and the ids the script above toggles. *@
@{
    var orderStatusChip = Model.OrderStatusId switch {
        10 => "grand-chip--amber",
        30 => "grand-chip--green",
        40 => "grand-chip--red",
        _ => ""
    };
    var paymentStatusChip = Model.PaymentStatusEnum switch {
        PaymentStatus.Paid => "grand-chip--green",
        PaymentStatus.Refunded => "grand-chip--amber",
        PaymentStatus.Voided => "grand-chip--red",
        _ => ""
    };
}
<partial name="Partials/WidgetZone.Info.Top" model="Model"/>
<admin-card>
    <div class="grand-facts">
        <div>
            <admin-label asp-for="OrderNumber" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Model.OrderNumber</div>
        </div>
        <div>
            <admin-label asp-for="OrderStatus" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value"><span class="grand-chip @orderStatusChip">@Model.OrderStatus</span></div>
        </div>
        <div>
            <admin-label asp-for="ShippingStatus" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Model.ShippingStatus</div>
        </div>
        <div>
            <admin-label asp-for="PaymentStatus" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">
                <a class="text-decoration-none" href="@Url.Action("Edit", "PaymentTransaction", new { id = Model.PaymentTransactionId, area = area })">
                    <span class="grand-chip @paymentStatusChip">@Model.PaymentStatus</span> @Loc["Admin.Common.View"]
                </a>
            </div>
        </div>
        <div>
            <admin-label asp-for="CreatedOn" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Html.DisplayFor(model => model.CreatedOn)</div>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2 mt-3">
        @if (Model.CanCancelOrder)
        {
            <input type="submit" name="cancelorder" asp-action="CancelOrder" value="@Loc["Admin.Orders.Fields.OrderStatus.Cancel"]" id="cancelorder" class="btn btn-outline-danger btn-sm"
                   data-grand-confirm="@Loc["Admin.Common.AreYouSure"]" data-confirm-title="@Loc["Admin.Orders.Fields.OrderStatus.Cancel"]"/>
        }
        <input type="submit" name="btnChangeOrderStatus" value="@Loc["Admin.Orders.Fields.OrderStatus.Change"]" onclick="toggleChangeOrderStatus(true);return false;" id="btnChangeOrderStatus" class="btn btn-outline-secondary btn-sm"/>
    </div>
    <div id="pnlChangeOrderStatus" class="mt-3" style="display: none">
        <div class="note note-info">@Loc["Admin.Orders.Fields.OrderStatus.Change.ForAdvancedUsers"]</div>
        <div class="grand-fields">
            <admin-field asp-for="OrderStatusId" asp-items="Model.OrderStatuses" size="md"/>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-3">
            <input type="submit" name="btnSaveOrderStatus" asp-action="ChangeOrderStatus" value="@Loc["Admin.Common.Save"]" id="btnSaveOrderStatus" class="btn btn-outline-secondary btn-sm"
                   data-grand-confirm="@Loc["Admin.Common.AreYouSure"]" data-confirm-title="@Loc["Admin.Orders.Fields.OrderStatus.Change"]"/>
            <input type="submit" name="btnCancelOrderStatus" value="@Loc["Admin.Common.Cancel"]" onclick="toggleChangeOrderStatus(false);return false;" id="btnCancelOrderStatus" class="btn btn-outline-secondary btn-sm"/>
        </div>
    </div>
</admin-card>

<admin-card>
    <div class="grand-facts">
        @if (!string.IsNullOrEmpty(Model.Code))
        {
            <div>
                <admin-label asp-for="Code" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.Code</div>
            </div>
        }
        <div>
            <admin-label asp-for="CustomerId" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Html.ActionLink(Model.CustomerInfo, "Edit", "Customer", new { id = Model.CustomerId }, new { })</div>
        </div>
        <div>
            <admin-label asp-for="CustomerIp" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Model.CustomerIp</div>
        </div>
        <div>
            <admin-label asp-for="StoreName" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Model.StoreName</div>
        </div>
        <div>
            <admin-label asp-for="CurrencyCode" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">
                @Model.CurrencyCode
                @if (Model.CurrencyRate != 1)
                {
                    <text>(@Model.CurrencyRate)</text>
                }
            </div>
        </div>
        <div>
            <admin-label asp-for="PaymentMethod" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Model.PaymentMethod</div>
        </div>
        @if (!string.IsNullOrEmpty(Model.VatNumber))
        {
            <div>
                <admin-label asp-for="VatNumber" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.VatNumber</div>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.AffiliateId))
        {
            <div>
                <admin-label asp-for="AffiliateId" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">
                    <a href="@Url.Action("Edit", "Affiliate", new { id = Model.AffiliateId, area = area })">@Model.AffiliateName - @Loc["Admin.Common.View"]</a>
                </div>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.SalesEmployeeId))
        {
            <div>
                <admin-label asp-for="SalesEmployeeId" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.SalesEmployeeName</div>
            </div>
        }
    </div>
    <div class="grand-facts mt-3">
        <div>
            <admin-label asp-for="OrderGuid" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Model.OrderGuid</div>
        </div>
    </div>
    @if (Model.CustomValues is { Count: > 0 })
    {
        <div class="mt-3">
            <admin-label asp-for="CustomValues" asp-display-hint="false" class="grand-fact__label"/>
            <table class="table table-sm mb-0">
                @foreach (var item in Model.CustomValues)
                {
                    <tr>
                        <td>@item.Key:</td>
                        <td>@(item.Value != null ? item.Value.ToString() : "")</td>
                    </tr>
                }
            </table>
        </div>
    }
    <div class="grand-fields mt-3" id="trEditOrderTags">
        <admin-field asp-for="OrderTags">
            <div class="input-group flex-nowrap w-100">
                <admin-input asp-for="OrderTags"/>
                <input type="submit" name="btnSaveOrderTags" asp-action="SaveOrderTags" value="@Loc["Admin.Orders.Fields.SaveOrderTags"]" id="btnSaveOrderTags" class="btn btn-outline-secondary btn-sm"
                       data-grand-confirm="@Loc["Admin.Common.AreYouSure"]" data-confirm-title="@Loc["Admin.Orders.Fields.SaveOrderTags"]"/>
            </div>
        </admin-field>
    </div>
</admin-card>

<admin-card>
    <div class="grand-facts">
        @if (Model.TaxDisplayType == TaxDisplayType.IncludingTax)
        {
            <div>
                <admin-label asp-for="OrderSubtotalInclTax" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.OrderSubtotalInclTax</div>
            </div>
        }
        @if (Model.TaxDisplayType == TaxDisplayType.ExcludingTax)
        {
            <div>
                <admin-label asp-for="OrderSubtotalExclTax" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.OrderSubtotalExclTax</div>
            </div>
        }
        @if (Model.TaxDisplayType == TaxDisplayType.IncludingTax
             && !string.IsNullOrEmpty(Model.OrderSubTotalDiscountInclTax))
        {
            <div>
                <admin-label asp-for="OrderSubTotalDiscountInclTax" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.OrderSubTotalDiscountInclTax</div>
            </div>
        }
        @if (Model.TaxDisplayType == TaxDisplayType.ExcludingTax
             && !string.IsNullOrEmpty(Model.OrderSubTotalDiscountExclTax))
        {
            <div>
                <admin-label asp-for="OrderSubTotalDiscountExclTax" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.OrderSubTotalDiscountExclTax</div>
            </div>
        }
        @if (Model.TaxDisplayType == TaxDisplayType.IncludingTax)
        {
            <div>
                <admin-label asp-for="OrderShippingInclTax" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.OrderShippingInclTax</div>
            </div>
        }
        @if (Model.TaxDisplayType == TaxDisplayType.ExcludingTax)
        {
            <div>
                <admin-label asp-for="OrderShippingExclTax" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.OrderShippingExclTax</div>
            </div>
        }
        @if (Model.TaxDisplayType == TaxDisplayType.IncludingTax
             && !string.IsNullOrEmpty(Model.PaymentMethodAdditionalFeeInclTax))
        {
            <div>
                <admin-label asp-for="PaymentMethodAdditionalFeeInclTax" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.PaymentMethodAdditionalFeeInclTax</div>
            </div>
        }
        @if (Model.TaxDisplayType == TaxDisplayType.ExcludingTax
             && !string.IsNullOrEmpty(Model.PaymentMethodAdditionalFeeExclTax))
        {
            <div>
                <admin-label asp-for="PaymentMethodAdditionalFeeExclTax" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.PaymentMethodAdditionalFeeExclTax</div>
            </div>
        }
        @if (Model.DisplayTaxRates)
        {
            foreach (var tr in Model.TaxRates)
            {
                <div>
                    <admin-label asp-for="Tax" asp-display-hint="false" class="grand-fact__label"/>
                    <div class="grand-fact__value">@tr.Rate% - @tr.Value</div>
                </div>
            }
        }
        @if (Model.DisplayTax)
        {
            <div>
                <admin-label asp-for="Tax" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.Tax</div>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.OrderTotalDiscount))
        {
            <div>
                <admin-label asp-for="OrderTotalDiscount" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.OrderTotalDiscount</div>
            </div>
        }
        @foreach (var gc in Model.GiftVouchers)
        {
            <div>
                <admin-label asp-for="GiftVouchers[0].CouponCode" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">(@(gc.CouponCode)) @gc.Amount</div>
            </div>
        }
        @if (Model.RedeemedLoyaltyPoints > 0)
        {
            <div>
                <admin-label asp-for="RedeemedLoyaltyPoints" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">
                    @Model.RedeemedLoyaltyPoints @Loc["Admin.Orders.Fields.RedeemedLoyaltyPoints.Points"]
                    <text>/</text>
                    @Model.RedeemedLoyaltyPointsAmount
                </div>
            </div>
        }
        <div>
            <admin-label asp-for="OrderTotal" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Model.OrderTotal</div>
        </div>
        @if (!string.IsNullOrEmpty(Model.RefundedAmount))
        {
            <div>
                <admin-label asp-for="RefundedAmount" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.RefundedAmount</div>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.SuggestedRefundedAmount))
        {
            <div>
                <admin-label asp-for="SuggestedRefundedAmount" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.SuggestedRefundedAmount</div>
            </div>
        }
        @if (Model.UsedDiscounts.Count > 0)
        {
            <div>
                <admin-label asp-for="UsedDiscounts" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">
                    @for (var i = 0; i < Model.UsedDiscounts.Count; i++)
                    {
                        var discount = Model.UsedDiscounts[i];
                        <a href="@Url.Action("Edit", "Discount", new { id = discount.DiscountId, area = area })">@discount.DiscountName</a>
                        @if (i != Model.UsedDiscounts.Count - 1)
                        {
                            <text>,</text>
                        }
                    }
                </div>
            </div>
        }
        <div>
            <admin-label asp-for="Profit" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Model.Profit</div>
        </div>
    </div>

    @* the totals editor: toggleOrderTotals shows it and swaps the buttons below *@
    <div id="trEditOrderTotals" class="mt-3" style="display: none">
        <div class="grand-fields grand-fields--2col">
            <admin-field asp-for="OrderSubtotalInclTaxValue" size="md" hint="@Loc["Admin.Orders.Fields.Edit.InclTax"]"/>
            <admin-field asp-for="OrderSubtotalExclTaxValue" size="md" hint="@Loc["Admin.Orders.Fields.Edit.ExclTax"]"/>
            <admin-field asp-for="OrderSubTotalDiscountInclTaxValue" size="md" hint="@Loc["Admin.Orders.Fields.Edit.InclTax"]"/>
            <admin-field asp-for="OrderSubTotalDiscountExclTaxValue" size="md" hint="@Loc["Admin.Orders.Fields.Edit.ExclTax"]"/>
            <admin-field asp-for="OrderShippingInclTaxValue" size="md" hint="@Loc["Admin.Orders.Fields.Edit.InclTax"]"/>
            <admin-field asp-for="OrderShippingExclTaxValue" size="md" hint="@Loc["Admin.Orders.Fields.Edit.ExclTax"]"/>
            <admin-field asp-for="PaymentMethodAdditionalFeeInclTaxValue" size="md" hint="@Loc["Admin.Orders.Fields.Edit.InclTax"]"/>
            <admin-field asp-for="PaymentMethodAdditionalFeeExclTaxValue" size="md" hint="@Loc["Admin.Orders.Fields.Edit.ExclTax"]"/>
            <admin-field asp-for="TaxValue" size="md"/>
            <admin-field asp-for="OrderTotalDiscountValue" size="md"/>
            <admin-field asp-for="CurrencyRate" size="md"/>
            <admin-field asp-for="OrderTotalValue" size="md"/>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2 mt-3">
        <button type="submit" id="btnEditOrderTotals" onclick=" toggleOrderTotals(true);return false; " name="btnEditOrderTotals" class="btn btn-outline-secondary btn-sm"><i class="bi bi-pencil"></i> @Loc["Admin.Orders.Fields.EditOrderTotals"]</button>
        <input type="submit" name="btnSaveOrderTotals" asp-action="EditOrderTotals" value="@Loc["Admin.Orders.Fields.SaveOrderTotals"]" id="btnSaveOrderTotals" class="btn btn-outline-secondary btn-sm"
               data-grand-confirm="@Loc["Admin.Common.AreYouSure"]" data-confirm-title="@Loc["Admin.Orders.Fields.SaveOrderTotals"]"/>
        <input type="submit" name="btnCancelOrderTotals" value="@Loc["Admin.Orders.Fields.CancelOrderTotals"]" onclick=" toggleOrderTotals(false);return false; " id="btnCancelOrderTotals" class="btn btn-outline-secondary btn-sm"/>
    </div>
</admin-card>
<partial name="Partials/WidgetZone.Info.Bottom" model="Model"/>