@model CheckoutAttributeModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Orders.CheckoutAttributes.AddNew"];
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}
<form asp-area="@area" asp-controller="CheckoutAttribute" asp-action="Create" method="post" id="checkoutattribute-form">

    @* the same shell as Edit, minus what an attribute that does not exist yet cannot offer *@
    <admin-page sticky
                title="@Loc["Admin.Orders.CheckoutAttributes.AddNew"]"
                icon="bi-card-list"
                back-url="@Url.Action("List")"
                back-text="@Loc["Admin.Orders.CheckoutAttributes.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <partial name="Partials/WidgetZone.DetailsButtons"/>
        </page-actions>

        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>