@model CheckoutAttributeModel
<partial name="Partials/WidgetZone.Values.Top" model="Model"/>
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    if (!string.IsNullOrEmpty(Model.Id))
    {
        <div class="grand-card">
            <div class="grand-card__header">
                <h2 class="grand-card__title">@Loc["Admin.Orders.CheckoutAttributes.Values"]</h2>
                <a id="btnAddNewValue" href="@(Url.Action("ValueCreatePopup", "CheckoutAttribute", new { checkoutAttributeId = Model.Id, area }))" class="btn btn-outline-secondary btn-sm"><i class="bi bi-plus-lg"></i> @Loc["Admin.Orders.CheckoutAttributes.Values.AddNew"]</a>
                <input type="submit" id="btnRefresh" style="display: none"/>
            </div>
            <div class="grand-card__body grand-card__body--flush">
                <admin-grid id="checkoutattributevalues-grid"
                            read-url="@Url.Action("ValueList", "CheckoutAttribute", new { checkoutAttributeId = Model.Id, area })"
                            destroy-url="@Url.Action("ValueDelete", "CheckoutAttribute", new { area })"
                            pager="Compact"
                            confirm-destroy="true"
                            on-data-bound="bindCheckoutAttributeValuePopups">
                    <grid-column field="Name" title="@Loc["Admin.Orders.CheckoutAttributes.Values.Fields.Name"]">
                        <cell-template>
                            <a class='text-decoration-none editvalue' href="@Url.Action("ValueEditPopup", "CheckoutAttribute", new { area })/{{ Id }}?checkoutAttributeId=@Model.Id">{{ Name }}</a>
                        </cell-template>
                    </grid-column>
                    <grid-column field="PriceAdjustment" title="@Loc["Admin.Orders.CheckoutAttributes.Values.Fields.PriceAdjustment"]" width="150" min-screen-width="750"/>
                    <grid-column field="WeightAdjustment" title="@Loc["Admin.Orders.CheckoutAttributes.Values.Fields.WeightAdjustment"]" width="150" min-screen-width="750"/>
                    <grid-column field="IsPreSelected" title="@Loc["Admin.Orders.CheckoutAttributes.Values.Fields.IsPreSelected"]" width="100" align="Center" min-screen-width="500">
                        <cell-template>
                            <i data-if="IsPreSelected" class="bi bi-check-lg text-success" aria-hidden="true"></i>
                            <i data-else class="bi bi-x-lg text-danger" aria-hidden="true"></i>
                        </cell-template>
                    </grid-column>
                    <grid-column field="DisplayOrder" title="@Loc["Admin.Orders.CheckoutAttributes.Values.Fields.DisplayOrder"]" width="100" align="Center"/>
                    <grid-commands destroy="true" title="@Loc["Admin.Common.Delete"]" width="100"/>
                </admin-grid>
            </div>
        </div>

        <script>
            $(document).ready(function () {
                $('#btnAddNewValue').magnificPopup({
                    type: 'ajax',
                    settings: { cache: false, async: false },
                    midClick: true,
                    callbacks: {
                        parseAjax: function (mfpResponse) {
                            mfpResponse.data = $('<div></div>').html(mfpResponse.data);
                        },
                        ajaxContentAdded: function () {
                            $('.mfp-wrap').removeAttr('tabindex');
                        }
                    }
                });
            });
            function bindCheckoutAttributeValuePopups() {
                $('.editvalue').magnificPopup({
                    type: 'ajax',
                    settings: { cache: false, async: false },
                    midClick: true,
                    callbacks: {
                        parseAjax: function (mfpResponse) {
                            mfpResponse.data = $('<div></div>').html(mfpResponse.data);
                        },
                        ajaxContentAdded: function () {
                            $('.mfp-wrap').removeAttr('tabindex');
                        }
                    }
                });
            }
        </script>
        <script>
            $(document).ready(function () {
                $('#btnRefresh').click(function () {
                    //refresh grid
                    var grid = $("#checkoutattributevalues-grid").data('kendoGrid');
                    grid.dataSource.read();

                    //return false to don't reload a page
                    return false;
                });
            });
        </script>
    }
    else
    {
        <div class="note note-info">
            @Loc["Admin.Orders.CheckoutAttributes.Values.SaveBeforeEdit"]
        </div>
    }
}
<partial name="Partials/WidgetZone.Values.Bottom" model="Model"/>
