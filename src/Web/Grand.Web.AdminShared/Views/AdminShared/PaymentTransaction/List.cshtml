@model PaymentTransactionListModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Orders.PaymentTransaction"];
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}
<form asp-area="@area" asp-controller="PaymentTransaction" asp-action="List" method="post">

    @* The product list's shape: the customer's email as the quick search, the order number with
       its Go beside the other criteria behind the Filters toggle, and the grid in a flush card.
       Transactions come from orders, so Search is the one primary action. *@
    <admin-page title="@Loc["Admin.Orders.PaymentTransaction"]" icon="bi-truck">
        <page-actions>
            <partial name="Partials/WidgetZone.ListButtons" model="Model"/>
        </page-actions>

        <admin-filters id="paymenttransaction-filters" submit-id="search-paymenttransaction">
            <filters-search>
                <admin-input asp-for="SearchCustomerEmail"/>
            </filters-search>
            <admin-field asp-for="OrderNumber">
                <div class="input-group">
                    <admin-input asp-for="OrderNumber"/>
                    <input type="submit" id="go-to-ordernumber" asp-action="GoToOrderNumber" name="go-to-ordernumber"
                           class="btn btn-outline-secondary" value="@Loc["Admin.Common.Go"]"/>
                </div>
            </admin-field>
            <admin-field asp-for="SearchTransactionStatus" asp-items="Model.PaymentTransactionStatus"/>
            <admin-field asp-for="StartDate"/>
            <admin-field asp-for="EndDate"/>
        </admin-filters>

        <admin-card flush>
            <admin-grid id="paymenttransactions-grid"
                        read-url="@Url.Action("List", "PaymentTransaction", new { area = area })"
                        additional-data="additionalData">
                <grid-column field="PaymentMethodSystemName" title="@Loc["Admin.Orders.PaymentTransaction.Fields.PaymentMethodSystemName"]" width="80">
                    <cell-template>
                        <a class="text-decoration-none" href="Edit/{{ Id }}">{{ PaymentMethodSystemName }}</a>
                    </cell-template>
                </grid-column>
                <grid-column field="TransactionAmount" title="@Loc["Admin.Orders.PaymentTransaction.Fields.TransactionAmount"]" width="80">
                    <cell-template>
                        <a class="text-decoration-none" href="Edit/{{ Id }}">{{ TransactionAmount | n2 }} {{ CurrencyCode }}</a>
                    </cell-template>
                </grid-column>
                <grid-column field="PaidAmount" title="@Loc["Admin.Orders.PaymentTransaction.Fields.PaidAmount"]" width="100">
                    <cell-template>
                        <a class="text-decoration-none" href="Edit/{{ Id }}">{{ PaidAmount | n2 }} {{ CurrencyCode }}</a>
                    </cell-template>
                </grid-column>
                <grid-column field="CustomerId" title="@Loc["Admin.Orders.PaymentTransaction.Fields.Customer"]" width="200">
                    <cell-template>
                        <a class="text-decoration-none" href="@Url.Action("Edit", "Customer", new { area = area })/{{ CustomerId }}">{{ CustomerEmail }}</a>
                    </cell-template>
                </grid-column>
                <grid-column field="OrderNumber" title="@Loc["Admin.Orders.PaymentTransaction.Fields.OrderNumber"]" width="80">
                    <cell-template>
                        <a class="text-decoration-none" href="@Url.Action("Edit", "Order", new { area = area })/{{ OrderId }}">{{ OrderNumber }}</a>
                    </cell-template>
                </grid-column>
                <grid-column field="Status" title="@Loc["Admin.Orders.PaymentTransaction.Fields.Status"]" width="130">
                    <cell-template>
                        <a class="text-decoration-none" href="Edit/{{ Id }}">{{ Status }}</a>
                    </cell-template>
                </grid-column>
                <grid-column field="CreatedOn" title="@Loc["Admin.Orders.PaymentTransaction.Fields.CreatedOn"]" width="100" format="{0:G}"/>
            </admin-grid>
        </admin-card>
    </admin-page>
</form>

<script>
    function additionalData() {
        var data = {
            SearchTransactionStatus: $('#@Html.IdFor(model => model.SearchTransactionStatus)').val(),
            SearchCustomerEmail: $('#@Html.IdFor(model => model.SearchCustomerEmail)').val(),
            OrderNumber: $('#@Html.IdFor(model => model.OrderNumber)').val(),
            StartDate: $('#@Html.IdFor(model => model.StartDate)').val(),
            EndDate: $('#@Html.IdFor(model => model.EndDate)').val()
        };
        addAntiForgeryToken(data);
        return data;
    }
    $(document).ready(function () {
        $('#search-paymenttransaction').click(function () {
            //search
            var grid = $('#paymenttransactions-grid').data('kendoGrid');
            grid.dataSource.page(1); //new search. Set page size to 1
            //grid.dataSource.read(); we already loaded the grid above using "page" function
            return false;
        });

        $("#@Html.IdFor(model => model.SearchCustomerEmail)").keydown(function (event) {
            if (event.keyCode == 13) {
                $("#search-paymenttransaction").click();
                return false;
            }
        });
        $("#@Html.IdFor(model => model.OrderNumber)").keydown(function (event) {
            if (event.keyCode == 13) {
                $("#go-to-ordernumber").click();
                return false;
            }
        });
    });
</script>
