@model PaymentTransactionModel

<div asp-validation-summary="All"></div>
<input asp-for="Id" type="hidden"/>

@* a transaction is read, not edited: what it is, the order it pays for and what the gateway said, as facts *@
<partial name="Partials/WidgetZone.DetailsTop" model="Model"/>
<admin-card>
    <div class="grand-facts">
        <div>
            <admin-label asp-for="PaymentMethodName" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Model.PaymentMethodName</div>
        </div>
        <div>
            <admin-label asp-for="Status" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">
                @Model.Status
                @if (Model.CheckoutNotCompleted)
                {
                    <span class="grand-chip grand-chip--amber ms-1">@Loc["Admin.PaymentTransaction.CheckoutNotCompleted"]</span>
                }
            </div>
        </div>
        <div>
            <admin-label asp-for="TransactionAmount" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Model.TransactionAmount [@Model.CurrencyCode]</div>
        </div>
        <div>
            <admin-label asp-for="PaidAmount" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Model.PaidAmount [@Model.CurrencyCode]</div>
        </div>
        @if (Model.AmountDue > 0)
        {
            <div>
                <admin-label asp-for="AmountDue" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.AmountDue [@Model.CurrencyCode]</div>
            </div>
        }
        @if (Model.RefundedAmount > 0)
        {
            <div>
                <admin-label asp-for="RefundedAmount" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.RefundedAmount [@Model.CurrencyCode]</div>
            </div>
        }
        @if (Model.AmountRefundable > 0)
        {
            <div>
                <admin-label asp-for="AmountRefundable" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.AmountRefundable [@Model.CurrencyCode]</div>
            </div>
        }
        @if (Model.CurrencyRate > 0 && Model.CurrencyRate != 1)
        {
            <div>
                <admin-label asp-for="CurrencyRate" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.CurrencyRate</div>
            </div>
        }
        <div>
            <admin-label asp-for="CustomerId" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Html.ActionLink(Model.CustomerEmail, "Edit", "Customer", new { id = Model.CustomerId }, new { })</div>
        </div>
        @if (!string.IsNullOrEmpty(Model.StoreName))
        {
            <div>
                <admin-label asp-for="StoreName" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.StoreName</div>
            </div>
        }
        <div>
            <admin-label asp-for="CreatedOn" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Html.DisplayFor(model => model.CreatedOn)</div>
        </div>
        @if (Model.UpdatedOn.HasValue)
        {
            <div>
                <admin-label asp-for="UpdatedOn" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Html.DisplayFor(model => model.UpdatedOn)</div>
            </div>
        }
        <div>
            <admin-label asp-for="IPAddress" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Model.IPAddress</div>
        </div>
    </div>
</admin-card>
@if (!string.IsNullOrEmpty(Model.OrderId))
{
    <admin-card>
        <div class="grand-facts">
            <div>
                <admin-label asp-for="OrderId" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Html.ActionLink(Model.OrderNumber.ToString(), "Edit", "Order", new { id = Model.OrderId }, new { })</div>
            </div>
            @if (!string.IsNullOrEmpty(Model.OrderStatus))
            {
                <div>
                    <admin-label asp-for="OrderStatus" asp-display-hint="false" class="grand-fact__label"/>
                    <div class="grand-fact__value">@Model.OrderStatus</div>
                </div>
            }
            <div>
                <admin-label asp-for="OrderPaymentStatus" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.OrderPaymentStatus</div>
            </div>
            @if (Model.OrderTotal.HasValue)
            {
                <div>
                    <admin-label asp-for="OrderTotal" asp-display-hint="false" class="grand-fact__label"/>
                    <div class="grand-fact__value">@Model.OrderTotal [@Model.OrderCurrencyCode]</div>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.BillingName))
            {
                <div>
                    <admin-label asp-for="BillingName" asp-display-hint="false" class="grand-fact__label"/>
                    <div class="grand-fact__value">@Model.BillingName</div>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.PurchaseOrderNumber))
            {
                <div>
                    <admin-label asp-for="PurchaseOrderNumber" asp-display-hint="false" class="grand-fact__label"/>
                    <div class="grand-fact__value">@Model.PurchaseOrderNumber</div>
                </div>
            }
            @if (Model.PaymentDueDate.HasValue)
            {
                <div>
                    <admin-label asp-for="PaymentDueDate" asp-display-hint="false" class="grand-fact__label"/>
                    <div class="grand-fact__value">
                        @Model.PaymentDueDate.Value.ToString("D")
                        @if (Model.IsPaymentOverdue)
                        {
                            <span class="grand-chip grand-chip--red ms-1">@Loc["Admin.Orders.Fields.PaymentOverdue"]</span>
                        }
                    </div>
                </div>
            }
        </div>
    </admin-card>
}
<admin-card>
    <div class="grand-facts">
        @if (!string.IsNullOrEmpty(Model.AdditionalInfo))
        {
            <div>
                <admin-label asp-for="AdditionalInfo" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.AdditionalInfo</div>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <div>
                <admin-label asp-for="Description" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.Description</div>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.CaptureTransactionId))
        {
            <div>
                <admin-label asp-for="CaptureTransactionId" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.CaptureTransactionId</div>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.CaptureTransactionResult))
        {
            <div>
                <admin-label asp-for="CaptureTransactionResult" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.CaptureTransactionResult</div>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.AuthorizationTransactionId))
        {
            <div>
                <admin-label asp-for="AuthorizationTransactionId" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.AuthorizationTransactionId</div>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.AuthorizationTransactionCode))
        {
            <div>
                <admin-label asp-for="AuthorizationTransactionCode" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.AuthorizationTransactionCode</div>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.AuthorizationTransactionResult))
        {
            <div>
                <admin-label asp-for="AuthorizationTransactionResult" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.AuthorizationTransactionResult</div>
            </div>
        }
        @if (Model.Errors.Count > 0)
        {
            <div>
                <admin-label asp-for="Errors" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">
                    @foreach (var error in Model.Errors)
                    {
                        <div>@error</div>
                    }
                </div>
            </div>
        }
    </div>
    @if (Model.CustomValues.Count > 0)
    {
        <div class="mt-3">
            <admin-label asp-for="CustomValues" asp-display-hint="false" class="grand-fact__label"/>
            <table class="table table-sm mb-0">
                @foreach (var item in Model.CustomValues)
                {
                    <tr>
                        <td>@item.Key:</td>
                        <td>@(item.Value != null ? item.Value.ToString() : "")</td>
                    </tr>
                }
            </table>
        </div>
    }
</admin-card>
