@using Grand.Web.AdminShared.Models.Pages
@model PageModel
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}
<div asp-validation-summary="All"></div>
<input asp-for="Id" type="hidden"/>
<admin-tabstrip name="page-edit">
    <items>
        <tabstrip-item text="@Loc["Admin.Content.Pages.Info"]" tab-index="0">
            <content>
                <div>
                    <partial name="Partials/CreateOrUpdate.TabInfo" model="Model"/>
                </div>
            </content>
        </tabstrip-item>
        <tabstrip-item text="@Loc["Admin.Common.SEO"]" tab-index="1">
            <content>
                <div>
                    <partial name="Partials/CreateOrUpdate.TabSeo" model="Model"/>
                </div>
            </content>
        </tabstrip-item>
        @if (area == "Admin")
        {
            <tabstrip-item text="@Loc["Admin.Common.UserFields.Tab"]" tab-index="2">
                <content>
                    <div>
                        <partial name="Partials/UserFields" model="Model"/>
                    </div>
                </content>
            </tabstrip-item>
        }
        <partial name="Partials/WidgetZone.Tabs" model="Model"/>
    </items>
</admin-tabstrip>
