@using Grand.Web.AdminShared.Models.Pages
@model PageModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Content.Pages.EditPageDetails"];
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}
<form asp-area="@area" asp-controller="Page" asp-action="Edit" method="post">

    @* the product edit screen's shell: the page's system name as the title, Save as the one
       primary action, Copy (a store owner's copy of a global page) and Delete in the overflow menu *@
    <admin-page sticky
                title="@Model.SystemName"
                icon="bi-file-earmark"
                meta="@Loc["Admin.Content.Pages.EditPageDetails"]"
                back-url="@Url.Action("List")"
                back-text="@Loc["Admin.Content.Pages.BackToList"]">
        <page-actions>
            @if (!string.IsNullOrEmpty(Model.SeName))
            {
                <button type="button" onclick="window.open('@Url.RouteUrl("Page", new { Model.SeName })','_blank');" class="btn btn-outline-secondary">
                    <i class="bi bi-eye"></i> @Loc["Admin.Common.Preview"]
                </button>
            }
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <admin-action-menu>
                @if (area == "Store" && Model.ShowCopyButton)
                {
                    <admin-action submit="true" form="page-copy-form" icon="bi-files"
                                  text="@Loc["Admin.Common.Copy"]"/>
                }
                <admin-action id="page-delete" destructive="true" icon="bi-trash"
                              text="@Loc["Admin.Common.Delete"]"/>
            </admin-action-menu>
            <partial name="Partials/WidgetZone.DetailsButtons" model="Model"/>
        </page-actions>

        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>
<admin-delete-confirmation button-id="page-delete"/>
@if (area == "Store" && Model.ShowCopyButton)
{
    <form id="page-copy-form" asp-area="@area" asp-controller="Page" asp-action="Copy" method="post">
        <input type="hidden" name="id" value="@Model.Id"/>
    </form>
}
