@{
    //page title
    ViewBag.Title = Loc["Admin.Catalog.Attributes.SpecificationAttributes"];
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}

<div class="row">
    <div class="col-md-12">
        <div class="x_panel light form-fit">
            <div class="x_title">
                <div class="caption">
                    <i class="bi bi-card-list"></i>
                    @Loc["Admin.Catalog.Attributes.SpecificationAttributes"]
                </div>
                <div class="actions btn-group btn-group-devided">
                    <a href="@Url.Action("Create", new { area })" class="btn green">
                        <i class="bi bi-plus-lg"></i><span class="d-none d-sm-inline"> @Loc["Admin.Common.AddNew"] </span>
                    </a>
                    <partial name="Partials/WidgetZone.ListButtons"/>
                </div>

            </div>
            <div class="x_content form">
                <div class="form-horizontal">
                    <div class="form-body">
                        <div class="x_content">
                            <admin-grid id="specificationattributes-grid" read-url="@Url.Action("List", "SpecificationAttribute", new { area })">
                                <grid-column field="Name" title="@Loc["Admin.Catalog.Attributes.SpecificationAttributes.Fields.Name"]" width="300">
                                    <cell-template>
                                        <a class="text-decoration-none" href="Edit/{{ Id }}">{{ Name }}</a>
                                    </cell-template>
                                </grid-column>
                                <grid-column field="DisplayOrder" title="@Loc["Admin.Catalog.Attributes.SpecificationAttributes.Fields.DisplayOrder"]" width="100" align="Center"/>
                            </admin-grid>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

