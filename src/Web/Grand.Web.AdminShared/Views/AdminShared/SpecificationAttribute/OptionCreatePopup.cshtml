@{
    Layout = "";
}
@model SpecificationAttributeOptionModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Catalog.Attributes.SpecificationAttributes.Options.AddNew"];
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}
<form asp-area="@area" asp-controller="SpecificationAttribute" asp-action="OptionCreatePopup"
      method="post" id="specificationattribute-form" asp-route-Id="@HtmlExtensions.HtmlEncodeSafe(Context.Request.Query["Id"])">
    <admin-popup title="@Loc["Admin.Catalog.Attributes.SpecificationAttributes.Options.AddNew"]" icon="bi-card-list">
        <partial name="Partials/CreateOrUpdateOption" model="Model"/>
    </admin-popup>
    <script>
        var mfp = $.magnificPopup.instance;
        $("#specificationattribute-form").submit(function (e) {
            e.preventDefault();
            var form = $(this);
            var url = form.attr('action');
            $.ajax({
                type: "POST",
                url: url,
                data: form.serialize(),
                success: function (data) {
                    if (data == "") {
                        mfp.close();
                        $('#btnRefresh').click();
                    } else {
                        $.magnificPopup.open({
                            items: {
                                src: data,
                                type: 'inline'
                            },
                            callbacks: {
                                open: function () {
                                    $('.mfp-wrap').removeAttr('tabindex');
                                }
                            }
                        });
                    }
                }
            });
        });
    </script>
</form>