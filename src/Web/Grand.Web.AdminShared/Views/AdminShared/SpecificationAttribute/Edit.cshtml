@model SpecificationAttributeModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Catalog.Attributes.SpecificationAttributes.EditAttributeDetails"];
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}
@* The product edit screen's shell: the attribute's name as the title, Save as the one primary
   action, and Delete in the overflow menu rather than beside Save. *@
<form asp-area="@area" asp-controller="SpecificationAttribute" asp-action="Edit" method="post" id="specificationattribute-form">
    <admin-page sticky
                title="@Model.Name"
                icon="bi-card-list"
                meta="@Loc["Admin.Catalog.Attributes.SpecificationAttributes.EditAttributeDetails"]"
                back-url="@Url.Action("List")"
                back-text="@Loc["Admin.Catalog.Attributes.SpecificationAttributes.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <admin-action-menu>
                <admin-action id="specificationattribute-delete" destructive="true" icon="bi-trash"
                              text="@Loc["Admin.Common.Delete"]"/>
            </admin-action-menu>
            <partial name="Partials/WidgetZone.DetailsButtons" model="Model"/>
        </page-actions>

        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>
<admin-delete-confirmation button-id="specificationattribute-delete"/>