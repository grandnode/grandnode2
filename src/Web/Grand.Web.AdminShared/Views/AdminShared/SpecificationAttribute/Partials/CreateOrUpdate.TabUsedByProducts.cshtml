@model SpecificationAttributeModel
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    <div class="panel panel-default">
        <partial name="Partials/WidgetZone.UsedByProducts.Top" model="Model"/>
        <div class="panel-body">
            <admin-grid id="used-by-products-grid"
                        read-url="@Url.Action("UsedByProducts", "SpecificationAttribute", new { specificationAttributeId = Model.Id, area })"
                        auto-bind="false">
                <grid-column field="ProductName" title="@Loc["Admin.Catalog.Attributes.SpecificationAttributes.UsedByProducts.Product"]">
                    <cell-template>
                        <a class="k-link" href="@Url.Action("Edit", "Product", new { area })/{{ Id }}">{{ ProductName }}</a>
                    </cell-template>
                </grid-column>
                <grid-column field="OptionName" title="@Loc["Admin.Catalog.Attributes.SpecificationAttributes.UsedByProducts.OptionName"]">
                    <cell-template>
                        <a class="k-link" href="@Url.Action("Edit", "Product", new { area })/{{ Id }}">{{ OptionName }}</a>
                    </cell-template>
                </grid-column>
                <grid-column field="Published" title="@Loc["Admin.Catalog.Attributes.SpecificationAttributes.UsedByProducts.Published"]" align="Center">
                    <cell-template>
                        <i data-if="Published" class="fa fa-check" aria-hidden="true" style="color:green"></i>
                        <i data-else class="fa fa-times" aria-hidden="true" style="color:red"></i>
                    </cell-template>
                </grid-column>
            </admin-grid>
        </div>
        <partial name="Partials/WidgetZone.UsedByProducts.Bottom" model="Model"/>
    </div>
}