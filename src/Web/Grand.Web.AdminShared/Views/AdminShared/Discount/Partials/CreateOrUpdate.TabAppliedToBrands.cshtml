@model DiscountModel
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    if (!string.IsNullOrEmpty(Model.Id))
    {
        <div class="panel panel-default">
            <partial name="Partials/WidgetZone.AppliedToBrands.Top" model="Model"/>
            <div class="panel-body">
                <admin-grid id="brands-grid"
                            key="BrandId"
                            read-url="@Url.Action("BrandList", "Discount", new { discountId = Model.Id, area = area })"
                            destroy-url="@Url.Action("BrandDelete", "Discount", new { discountId = Model.Id, area = area })"
                            pager="Compact">
                    <grid-column field="BrandName" title="@Loc["admin.marketing.Discounts.AppliedToBrands.Brand"]">
                        <cell-template>
                            <a class="k-link" href="@Url.Action("Edit", "Brand", new { area = area })/{{ BrandId }}">{{ BrandName }}</a>
                        </cell-template>
                    </grid-column>
                    <grid-commands destroy="true" width="150"/>
                </admin-grid>
            </div>
            <div class="panel-footer">
                <a id="btnAddNewBrand" href="@(Url.Action("BrandAddPopup", "Discount", new { discountId = Model.Id, btnId = "btnRefreshBrands", formId = "discount-form", area = area }))" class="k-button"><i class="bi bi-plus-lg"></i>&nbsp;@Loc["Admin.Marketing.Discounts.AppliedToBrands.AddNew"]</a>
                <input type="submit" id="btnRefreshBrands" style="display: none"/>
            </div>
            <partial name="Partials/WidgetZone.AppliedToBrands.Bottom" model="Model"/>
        </div>

        <script>
            $(document).ready(function () {
                $('#btnAddNewBrand').magnificPopup({
                    type: 'ajax',
                    settings: { cache: false, async: false },
                    midClick: true,
                    callbacks: {
                        parseAjax: function (mfpResponse) {
                            mfpResponse.data = $('<div></div>').html(mfpResponse.data);
                        },
                        ajaxContentAdded: function () {
                            $('.mfp-wrap').removeAttr('tabindex');
                        }
                    }
                });
            });
        </script>
        <script>
            $(document).ready(function () {
                $('#btnRefreshBrands').click(function () {
                    //refresh grid
                    var grid = $("#brands-grid").data('kendoGrid');
                    grid.dataSource.read();

                    //return false to don't reload a page
                    return false;
                });
            });
        </script>
    }
    else
    {
        <div class="note note-info">
            @Loc["admin.marketing.Discounts.AppliedToBrands.SaveBeforeEdit"]
        </div>
    }
}
