@model DiscountModel

@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    if (!string.IsNullOrEmpty(Model.Id))
    {
        <div class="panel panel-default">
            <partial name="Partials/WidgetZone.AppliedToProducts.Top" model="Model"/>
            <div class="panel-body">
                <admin-grid id="products-grid"
                            key="ProductId"
                            read-url="@Url.Action("ProductList", "Discount", new { discountId = Model.Id, area = area })"
                            destroy-url="@Url.Action("ProductDelete", "Discount", new { discountId = Model.Id, area = area })">
                    <grid-column field="ProductName" title="@Loc["admin.marketing.Discounts.AppliedToProducts.Product"]">
                        <cell-template>
                            <a class="k-link" href="@Url.Action("Edit", "Product", new { area = area })/{{ ProductId }}">{{ ProductName }}</a>
                        </cell-template>
                    </grid-column>
                    <grid-commands destroy="true" width="150"/>
                </admin-grid>
            </div>
            <div class="panel-footer">
                <a id="btnAddNewProduct" href="@(Url.Action("ProductAddPopup", "Discount", new { discountId = Model.Id, btnId = "btnRefreshProducts", formId = "discount-form", area = area }))" class="k-button"><i class="fa fa-plus"></i>&nbsp;@Loc["admin.marketing.Discounts.AppliedToProducts.AddNew"]</a>
                <input type="submit" id="btnRefreshProducts" style="display: none"/>
            </div>
            <partial name="Partials/WidgetZone.AppliedToProducts.Bottom" model="Model"/>
        </div>

        <script>
            $(document).ready(function () {
                $('#btnAddNewProduct').magnificPopup({
                    type: 'ajax',
                    settings: { cache: false, async: false },
                    midClick: true,
                    callbacks: {
                        parseAjax: function (mfpResponse) {
                            mfpResponse.data = $('<div></div>').html(mfpResponse.data);
                        },
                        ajaxContentAdded: function () {
                            $('.mfp-wrap').removeAttr('tabindex');
                        }
                    }
                });
            });
        </script>

        <script>
            $(document).ready(function () {
                $('#btnRefreshProducts').click(function () {
                    //refresh grid
                    var grid = $("#products-grid").data('kendoGrid');
                    grid.dataSource.read();

                    //return false to don't reload a page
                    return false;
                });
            });
        </script>
    }
    else
    {
        <div class="note note-info">
            @Loc["admin.marketing.Discounts.AppliedToProducts.SaveBeforeEdit"]
        </div>
    }
}