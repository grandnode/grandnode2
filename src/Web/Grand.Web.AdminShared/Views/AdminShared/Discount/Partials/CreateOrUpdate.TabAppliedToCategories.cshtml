@model DiscountModel
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    if (!string.IsNullOrEmpty(Model.Id))
    {
        <div class="panel panel-default">
            <partial name="Partials/WidgetZone.AppliedToCategories.Top" model="Model"/>
            <div class="panel-body">
                <admin-grid id="categories-grid"
                            key="CategoryId"
                            read-url="@Url.Action("CategoryList", "Discount", new { discountId = Model.Id, area = area })"
                            destroy-url="@Url.Action("CategoryDelete", "Discount", new { discountId = Model.Id, area = area })"
                            pager="Compact">
                    <grid-column field="CategoryName" title="@Loc["admin.marketing.Discounts.AppliedToCategories.Category"]">
                        <cell-template>
                            <a class="k-link" href="@Url.Action("Edit", "Category", new { area = area })/{{ CategoryId }}">{{ CategoryName }}</a>
                        </cell-template>
                    </grid-column>
                    <grid-commands destroy="true" width="150"/>
                </admin-grid>
            </div>
            <div class="panel-footer">
                <a id="btnAddNewCategory" href="@(Url.Action("CategoryAddPopup", "Discount", new { discountId = Model.Id, btnId = "btnRefreshCategories", formId = "discount-form", area = area }))" class="k-button"><i class="bi bi-plus-lg"></i>&nbsp;@Loc["admin.marketing.Discounts.AppliedToCategories.AddNew"]</a>
                <input type="submit" id="btnRefreshCategories" style="display: none"/>
            </div>
            <partial name="Partials/WidgetZone.AppliedToCategories.Bottom" model="Model"/>
        </div>
        <script>
            $(document).ready(function () {
                $('#btnAddNewCategory').magnificPopup({
                    type: 'ajax',
                    settings: { cache: false, async: false },
                    midClick: true,
                    callbacks: {
                        parseAjax: function (mfpResponse) {
                            mfpResponse.data = $('<div></div>').html(mfpResponse.data);
                        },
                        ajaxContentAdded: function () {
                            $('.mfp-wrap').removeAttr('tabindex');
                        }
                    }
                });
            });
        </script>

        <script>
            $(document).ready(function () {
                $('#btnRefreshCategories').click(function () {
                    //refresh grid
                    var grid = $("#categories-grid").data('kendoGrid');
                    grid.dataSource.read();

                    //return false to don't reload a page
                    return false;
                });
            });
        </script>
    }
    else
    {
        <div class="note note-info">
            @Loc["admin.marketing.Discounts.AppliedToCategories.SaveBeforeEdit"]
        </div>
    }
}