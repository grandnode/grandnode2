@model DiscountModel.AddCategoryToDiscountModel
@{
    Layout = "";
    //page title
    ViewBag.Title = Loc["admin.marketing.Discounts.AppliedToCategories.AddNew"];
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}

<form id="CategoryAddPopup" asp-area="@area" asp-controller="Discount" asp-action="CategoryAddPopup" method="post"
      asp-route-DiscountId="@HtmlExtensions.HtmlEncodeSafe(Context.Request.Query["DiscountId"])"
      asp-route-btnId="@HtmlExtensions.HtmlEncodeSafe(Context.Request.Query["btnId"])"
      asp-route-formId="@HtmlExtensions.HtmlEncodeSafe(Context.Request.Query["formId"])">

    <admin-popup title="@Loc["admin.marketing.Discounts.AppliedToCategories.AddNew"]" icon="bi-boxes">
        <admin-filters id="search-categories-filters" submit-id="search-categories" secondary-submit="true">
            <filters-search>
                <admin-input asp-for="SearchCategoryName"/>
            </filters-search>
        </admin-filters>
        <admin-card flush>
            <admin-grid id="categories-grid"
                        read-url="@Url.Action("CategoryAddPopupList", "Discount", new { area = area })"
                        additional-data="additionalData"
                        selectable="Checkbox"
                        selection-name="SelectedCategoryIds">
                <grid-column field="Breadcrumb" title="@Loc["Admin.Catalog.Categories.Fields.Name"]"/>
                <grid-column field="Published" title="@Loc["Admin.Catalog.Categories.Fields.Published"]" width="100" align="Center">
                    <cell-template>
                        <i data-if="Published" class="bi bi-check-lg text-success" aria-hidden="true"></i>
                        <i data-else class="bi bi-x-lg text-danger" aria-hidden="true"></i>
                    </cell-template>
                </grid-column>
            </admin-grid>
        </admin-card>
        <div class="grand-popup__actions">
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
        </div>
    </admin-popup>

    <script>
        var mfp = $.magnificPopup.instance;
        $("#CategoryAddPopup").submit(function (e) {
                e.preventDefault();
                var form = $(this);
                var url = form.attr('action');
                $.ajax({
                    type: "POST",
                    url: url,
                    data: form.serialize(),
                    success: function (data) {
                        if (data == "") {
                            mfp.close();
                            $('#btnRefreshCategories').click();
                        } else {
                            $.magnificPopup.open({
                                items: {
                                    src: data,
                                    type: 'inline'
                                },
                                callbacks: {
                                    open: function () {
                                        $('.mfp-wrap').removeAttr('tabindex');
                                    }
                                }
                            });
                        }
                    }
                });
        });

                        $('#search-categories').click(function() {
                            var grid = GrandAdmin.grids.get('#categories-grid');
                            grid.dataSource.page(1); //new search. Set page size to 1
                            //grid.dataSource.read(); we already loaded the grid above using "page" function
                            grid.clearSelection();
                            return false;
                        });

                        $("#@Html.IdFor(model => model.SearchCategoryName)").keydown(function(event) {
                            if (event.keyCode == 13) {
                                $("#search-categories").click();
                                return false;
                            }
                        });

                    function additionalData() {
                        var data = {
                            SearchCategoryName: $('#@Html.IdFor(model => model.SearchCategoryName)').val()
                        };
                        addAntiForgeryToken(data);
                        return data;
                    }

    </script>
</form>
