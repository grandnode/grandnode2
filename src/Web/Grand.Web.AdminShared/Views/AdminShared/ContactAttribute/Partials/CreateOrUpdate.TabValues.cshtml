@using Grand.Web.AdminShared.Models.Messages
@model ContactAttributeModel
<partial name="Partials/WidgetZone.Values.Top" model="Model"/>
@{
    var isReadOnly = Model.IsReadOnly;
    var area = ViewContext.RouteData.Values["area"]?.ToString();

    if (!string.IsNullOrEmpty(Model.Id))
    {
        <div class="panel panel-default">
            <div class="panel-body">
                <admin-grid id="contactattributevalues-grid"
                            read-url="@Url.Action("ValueList", "ContactAttribute", new { contactAttributeId = Model.Id, area })"
                            destroy-url="@(isReadOnly ? null : Url.Action("ValueDelete", "ContactAttribute", new { area }))"
                            pager="Compact"
                            confirm-destroy="true"
                            on-data-bound="@(isReadOnly ? null : "bindContactAttributeValuePopups")">
                    <grid-column field="Name" title="@Loc["Admin.Catalog.Attributes.ContactAttributes.Values.Fields.Name"]">
                        <cell-template>
                            @if (!isReadOnly)
                            {
                                <a class="k-link editvalue" href="@Url.Action("ValueEditPopup", "ContactAttribute", new { area })/{{ Id }}?contactAttributeId=@Model.Id">{{ Name }}</a>
                            }
                            else
                            {
                                @:{{ Name }}
                            }
                        </cell-template>
                    </grid-column>
                    <grid-column field="IsPreSelected" title="@Loc["Admin.Catalog.Attributes.ContactAttributes.Values.Fields.IsPreSelected"]" width="100" align="Center" min-screen-width="500">
                        <cell-template>
                            <i data-if="IsPreSelected" class="fa fa-check" aria-hidden="true" style="color:green"></i>
                            <i data-else class="fa fa-times" aria-hidden="true" style="color:red"></i>
                        </cell-template>
                    </grid-column>
                    <grid-column field="DisplayOrder" title="@Loc["Admin.Catalog.Attributes.ContactAttributes.Values.Fields.DisplayOrder"]" width="100" align="Center"/>
                    @if (!isReadOnly)
                    {
                        <grid-commands destroy="true" title="@Loc["Admin.Common.Delete"]" width="100"/>
                    }
                </admin-grid>
            </div>
            @if (!isReadOnly)
            {
                <div class="panel-footer">
                    <a id="btnAddNewValue" href="@(Url.Action("ValueCreatePopup", "ContactAttribute", new { contactAttributeId = Model.Id, area }))" class="k-button"><i class="fa fa-plus"></i>&nbsp;@Loc["Admin.Catalog.Attributes.ContactAttributes.Values.AddNew"]</a>
                    <input type="submit" id="btnRefresh" style="display: none"/>
                </div>
            }
            else
            {
                <input type="submit" id="btnRefresh" style="display: none"/>
            }
        </div>

        if (!isReadOnly)
        {
            <script>
                $(document).ready(function () {
                    $('#btnAddNewValue').magnificPopup({
                        type: 'ajax',
                        settings: { cache: false, async: false },
                        midClick: true,
                        callbacks: {
                            parseAjax: function (mfpResponse) {
                                mfpResponse.data = $('<div></div>').html(mfpResponse.data);
                            },
                            ajaxContentAdded: function () {
                                $('.mfp-wrap').removeAttr('tabindex');
                            }
                        }
                    });

                    $('#btnRefresh').click(function () {
                        var grid = $("#contactattributevalues-grid").data('kendoGrid');
                        grid.dataSource.read();
                        return false;
                    });
                });
                function bindContactAttributeValuePopups() {
                    $('.editvalue').magnificPopup({
                        type: 'ajax',
                        settings: { cache: false, async: false },
                        midClick: true,
                        callbacks: {
                            parseAjax: function (mfpResponse) {
                                mfpResponse.data = $('<div></div>').html(mfpResponse.data);
                            },
                            ajaxContentAdded: function () {
                                $('.mfp-wrap').removeAttr('tabindex');
                            }
                        }
                    });
                }
            </script>
        }
    }
    else
    {
        <div class="note note-info">
            @Loc["Admin.Catalog.Attributes.ContactAttributes.Values.SaveBeforeEdit"]
        </div>
    }
}
<partial name="Partials/WidgetZone.Values.Bottom" model="Model"/>
