@{
    //page title
    ViewBag.Title = Loc["Admin.Catalog.Attributes.ContactAttributes"];
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}

@* The checkout attribute list's shape: Add new as the one primary action in the page header and
   the grid in a flush card. *@
<admin-page title="@Loc["Admin.Catalog.Attributes.ContactAttributes"]" icon="bi-card-list">
    <page-actions>
        <partial name="Partials/WidgetZone.ListButtons"/>
        <a href="@Url.Action("Create", new { area })" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> @Loc["Admin.Common.AddNew"]
        </a>
    </page-actions>

    <admin-card flush>
        <admin-grid id="contactattributes-grid"
                    read-url="@Url.Action("List", "ContactAttribute", new { area })"
                    pager="Compact">
            <grid-text name="view" value="@Loc["Admin.Common.View"]"/>
            <grid-text name="edit" value="@Loc["Admin.Common.Edit"]"/>
            <grid-column field="Name" title="@Loc["Admin.Catalog.Attributes.ContactAttributes.Fields.Name"]">
                <cell-template>
                    <a class="text-decoration-none" href="Edit/{{ Id }}">{{ Name }}</a>
                </cell-template>
            </grid-column>
            <grid-column field="AttributeControlTypeName" title="@Loc["Admin.Catalog.Attributes.ContactAttributes.Fields.AttributeControlType"]" width="200" align="Center" min-screen-width="750"/>
            <grid-column field="IsRequired" title="@Loc["Admin.Catalog.Attributes.ContactAttributes.Fields.IsRequired"]" width="100" align="Center">
                <cell-template>
                    <i data-if="IsRequired" class="bi bi-check-lg text-success" aria-hidden="true"></i>
                    <i data-else class="bi bi-x-lg text-danger" aria-hidden="true"></i>
                </cell-template>
            </grid-column>
            <grid-column field="DisplayOrder" title="@Loc["Admin.Catalog.Attributes.ContactAttributes.Fields.DisplayOrder"]" width="100" min-screen-width="750"/>
            @* a store owner sees the global attributes read-only: the chip says which *@
            <grid-column field="IsReadOnly" title="@Loc["Admin.Common.View"]" width="120" align="Center">
                <cell-template>
                    <a data-if="IsReadOnly" class="text-decoration-none" href="Edit/{{ Id }}"><span class="grand-chip">{{ $texts.view }}</span></a>
                    <a data-else class="text-decoration-none" href="Edit/{{ Id }}"><span class="grand-chip grand-chip--green">{{ $texts.edit }}</span></a>
                </cell-template>
            </grid-column>
        </admin-grid>
    </admin-card>
</admin-page>
