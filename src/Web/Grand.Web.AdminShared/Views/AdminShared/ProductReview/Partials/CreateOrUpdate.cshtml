@model ProductReviewModel
<div asp-validation-summary="All"></div>
<input asp-for="Id" type="hidden"/>
<input asp-for="ProductId" type="hidden"/>
<partial name="Partials/WidgetZone.DetailsTop" model="Model"/>
@* What the customer wrote and the reply are editable; who, where, when and the rating are
   facts of the review, so they read as facts rather than as labels posing as controls. *@
<admin-card>
    <div class="grand-facts">
        <div>
            <admin-label asp-for="ProductName" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Html.ActionLink(Model.ProductName, "Edit", "Product", new { id = Model.ProductId }, new { })</div>
        </div>
        <div>
            <admin-label asp-for="StoreName" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Model.StoreName</div>
        </div>
        <div>
            <admin-label asp-for="CustomerInfo" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Html.ActionLink(Model.CustomerInfo, "Edit", "Customer", new { id = Model.CustomerId }, new { })</div>
        </div>
        <div>
            <admin-label asp-for="Rating" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Model.Rating</div>
        </div>
        <div>
            <admin-label asp-for="CreatedOn" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Model.CreatedOn</div>
        </div>
    </div>
</admin-card>
<admin-card>
    <div class="grand-fields">
        <admin-field asp-for="Title"/>
        <admin-field asp-for="ReviewText">
            <admin-textarea asp-for="ReviewText"></admin-textarea>
        </admin-field>
        <admin-field asp-for="ReplyText">
            <admin-textarea asp-for="ReplyText"></admin-textarea>
        </admin-field>
        <div class="grand-fields grand-fields--2col">
            <admin-field asp-for="Signature"/>
            <admin-field asp-for="IsApproved"/>
        </div>
    </div>
</admin-card>
<partial name="Partials/WidgetZone.DetailsBottom" model="Model"/>