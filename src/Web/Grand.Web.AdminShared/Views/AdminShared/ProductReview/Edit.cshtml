@model ProductReviewModel
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    //page title
    ViewBag.Title = Loc["Admin.Catalog.ProductReviews.EditProductReviewDetails"];
}
@* The product edit screen's shell: Save as the one primary action, and Delete in the overflow
   menu rather than beside Save. *@
<form asp-area="@area" asp-controller="ProductReview" asp-action="Edit" method="post" asp-route-ProductId="@HtmlExtensions.HtmlEncodeSafe(Context.Request.Query["ProductId"])">
    <admin-page sticky
                title="@Loc["Admin.Catalog.ProductReviews.EditProductReviewDetails"]"
                icon="bi-box"
                back-url="@Url.Action("List")"
                back-text="@Loc["Admin.Catalog.ProductReviews.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <admin-action-menu>
                <admin-action id="productreview-delete" destructive="true" icon="bi-trash"
                              text="@Loc["Admin.Common.Delete"]"/>
            </admin-action-menu>
            <partial name="Partials/WidgetZone.DetailsButtons" model="Model"/>
        </page-actions>

        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>
<admin-delete-confirmation button-id="productreview-delete"/>