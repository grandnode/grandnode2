@using Grand.Web.AdminShared.Models.News
@model NewsItemModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Content.News.NewsItems.EditNewsItemDetails"];
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}
<form asp-area="@area" asp-controller="News" asp-action="Edit" method="post">

    @* the product edit screen's shell: the item's title as the title, Save as the one primary
       action, and Delete in the overflow menu rather than beside Save *@
    <admin-page sticky
                title="@Model.Title"
                icon="bi-newspaper"
                meta="@Loc["Admin.Content.News.NewsItems.EditNewsItemDetails"]"
                back-url="@Url.Action("List")"
                back-text="@Loc["Admin.Content.News.NewsItems.BackToList"]">
        <page-actions>
            @if (!string.IsNullOrEmpty(Model.SeName))
            {
                <button type="button" onclick="window.open('@Url.RouteUrl("NewsItem", new { Model.SeName })','_blank');" class="btn btn-outline-secondary">
                    <i class="bi bi-eye"></i> @Loc["Admin.Common.Preview"]
                </button>
            }
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <admin-action-menu>
                <admin-action id="newsitem-delete" destructive="true" icon="bi-trash"
                              text="@Loc["Admin.Common.Delete"]"/>
            </admin-action-menu>
            <partial name="Partials/WidgetZone.DetailsButtons.Edit" model="Model"/>
        </page-actions>

        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>
<admin-delete-confirmation button-id="newsitem-delete"/>
