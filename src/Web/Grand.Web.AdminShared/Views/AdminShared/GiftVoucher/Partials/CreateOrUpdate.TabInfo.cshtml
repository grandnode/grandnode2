@model GiftVoucherModel
<script>
    $(document).ready(function () {
        $("#@Html.IdFor(model => model.GiftVoucherTypeId)").change(toggleGiftVoucherType);
        toggleGiftVoucherType();
    });

    function toggleGiftVoucherType() {
        var selectedGiftVoucherTypeId = $("#@Html.IdFor(model => model.GiftVoucherTypeId)").val();
        if (selectedGiftVoucherTypeId == @(((int)GiftVoucherType.Virtual).ToString())) {
            $('#pnlRecipientEmail').show();
            $('#pnlSenderEmail').show();
            $('#pnlNotifyRecipient').show();
        }
        else {
            $('#pnlRecipientEmail').hide();
            $('#pnlSenderEmail').hide();
            $('#pnlNotifyRecipient').hide();
        }
    }
</script>
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}
<partial name="Partials/WidgetZone.InfoTop" model="Model"/>

@* What an existing voucher only reports - the order it was bought with, what is left of it, when
   it was made - as facts above the fields. *@
@if (!string.IsNullOrEmpty(Model.Id))
{
    <admin-card>
        <div class="grand-facts">
            @if (!string.IsNullOrEmpty(Model.PurchasedWithOrderId))
            {
                <div>
                    <admin-label asp-for="PurchasedWithOrderId" asp-display-hint="false" class="grand-fact__label"/>
                    <div class="grand-fact__value">
                        <a href="@Url.Action("Edit", "Order", new { Id = Model.PurchasedWithOrderId, area })" class="text-decoration-none"><i class="bi bi-eye"></i> @Loc["Admin.Common.View"] #@Model.PurchasedWithOrderNumber</a>
                    </div>
                </div>
            }
            <div>
                <admin-label asp-for="RemainingAmountStr" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.RemainingAmountStr</div>
            </div>
            <div>
                <admin-label asp-for="CreatedOn" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.CreatedOn</div>
            </div>
        </div>
    </admin-card>
}

@* The e-mail addresses (and the notification) exist only for a virtual voucher, so they sit
   under the type that reveals them; each keeps the pnl* id the script above toggles. *@
<admin-card>
    <div class="grand-fields grand-fields--2col">
        <div class="grand-reveal">
            <admin-field asp-for="GiftVoucherTypeId" size="md" asp-items="EnumTranslationService.ToSelectList((GiftVoucherType)Model.GiftVoucherTypeId)"/>
            <div class="grand-reveal__body grand-fields grand-fields--2col">
                <admin-field asp-for="RecipientEmail" id="pnlRecipientEmail"/>
                <admin-field asp-for="SenderEmail" id="pnlSenderEmail"/>
                @if (!string.IsNullOrEmpty(Model.Id))
                {
                    <div class="grand-field" id="pnlNotifyRecipient">
                        <admin-label asp-for="IsRecipientNotified" asp-display-hint="false" class="grand-field__label"/>
                        <div class="grand-field__control d-flex align-items-center gap-2">
                            <span>@Model.IsRecipientNotified.ToString()</span>
                            <button type="submit" name="notifyRecipient" asp-action="NotifyRecipient" class="btn btn-outline-secondary btn-sm"><i class="bi bi-bell"></i> @Loc["Admin.GiftVouchers.Fields.IsRecipientNotified.Notify"]</button>
                        </div>
                    </div>
                }
            </div>
        </div>
        <admin-field asp-for="Amount" size="md" suffix="@(string.IsNullOrEmpty(Model.Id) ? null : Model.CurrencyCode)"/>
        @if (string.IsNullOrEmpty(Model.Id))
        {
            <admin-field asp-for="CurrencyCode" size="md" asp-items="Model.AvailableCurrencies"/>
        }
        @if (Model.AvailableStores.Count > 1)
        {
            <admin-field asp-for="StoreId" asp-items="Model.AvailableStores"/>
        }
        <admin-field asp-for="Code">
            <div class="input-group">
                <admin-input asp-for="Code"/>
                <input type="button" id="generateCouponCode" class="btn btn-outline-secondary" value="@Loc["Admin.GiftVouchers.Fields.Code.Generate"]"/>
            </div>
            <script>
                $(document).ready(function () {
                    $('#generateCouponCode').click(function () {
                        var postData = {};
                        addAntiForgeryToken(postData);

                        $.ajax({
                            cache:false,
                            type: "POST",
                            url: "@(Url.Action("GenerateCouponCode", "GiftVoucher", new { area }))",
                            data: postData,
                            success: function (data) {
                                $('#@Html.IdFor(model => model.Code)').val(data.CouponCode);
                            },
                            error:function (){
                                alert('Failed to generate code.');
                            }
                        });
                    });
                });
            </script>
        </admin-field>
        <admin-field asp-for="IsGiftVoucherActivated"/>
        <admin-field asp-for="RecipientName"/>
        <admin-field asp-for="SenderName"/>
        <admin-field asp-for="ValidTo"/>
        <admin-field asp-for="Message">
            <admin-textarea asp-for="Message"></admin-textarea>
        </admin-field>
    </div>
</admin-card>
<partial name="Partials/WidgetZone.InfoBottom" model="Model"/>
