@model GiftVoucherListModel

@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    ViewBag.Title = Loc["Admin.GiftVouchers"];
}

<div class="row">
    <div class="col-md-12">
        <div class="x_panel light form-fit">
            <div class="x_title">
                <div class="caption">
                    <i class="bi bi-gift"></i>
                    @Loc["Admin.GiftVouchers"]
                </div>
                <div class="actions btn-group btn-group-devided">
                    <a href="@Url.Action("Create", new { area })" class="btn green">
                        <i class="bi bi-plus-lg"></i><span class="d-none d-sm-inline"> @Loc["Admin.Common.AddNew"] </span>
                    </a>
                    <partial name="Partials/WidgetZone.ListButtons" model="Model"/>
                </div>
            </div>
            <div class="x_content form">
                <div class="form-horizontal">
                    <div class="form-body">
                        <div class="row align-items-end">
                            <div class="col-md-3 col-sm-12 col-12">
                                <div class="mb-0">
                                    <admin-label asp-for="ActivatedId" class="d-flex flex-column align-items-start mw-100 px-0 text-start"/>
                                    <admin-select asp-for="ActivatedId" asp-items="Model.ActivatedList"/>
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-12 col-12">
                                <div class="mb-0">
                                    <admin-label asp-for="CouponCode" class="d-flex flex-column align-items-start mw-100 px-0 text-start"/>
                                    <admin-input asp-for="CouponCode"/>
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-12 col-12">
                                <div class="mb-0">
                                    <admin-label asp-for="RecipientName" class="d-flex flex-column align-items-start mw-100 px-0 text-start"/>
                                    <admin-input asp-for="RecipientName"/>
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-12 col-12 mt-md-0 mt-3">
                                <div class="form-actions">
                                    <button class="btn btn-success filter-submit" id="search-giftvouchers">
                                        <i class="bi bi-search"></i> @Loc["Admin.Common.Search"]
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="x_content">
                <admin-grid id="giftvouchers-grid"
                            read-url="@Url.Action("GiftVoucherList", "GiftVoucher", new { area })"
                            additional-data="additionalData">
                    <grid-column field="AmountStr" title="@Loc["Admin.GiftVouchers.Fields.Amount"]" width="100">
                        <cell-template>
                            <a class="text-decoration-none" href="Edit/{{ Id }}">{{ AmountStr }}</a>
                        </cell-template>
                    </grid-column>
                    <grid-column field="RemainingAmountStr" title="@Loc["Admin.GiftVouchers.Fields.RemainingAmount"]" width="100">
                        <cell-template>
                            <a class="text-decoration-none" href="Edit/{{ Id }}">{{ RemainingAmountStr }}</a>
                        </cell-template>
                    </grid-column>
                    <grid-column field="Code" title="@Loc["Admin.GiftVouchers.Fields.Code"]" width="120">
                        <cell-template>
                            <a class="text-decoration-none" href="Edit/{{ Id }}">{{ Code }}</a>
                        </cell-template>
                    </grid-column>
                    <grid-column field="RecipientName" title="@Loc["Admin.GiftVouchers.Fields.RecipientName"]" width="150" min-screen-width="750"/>
                    <grid-column field="IsGiftVoucherActivated" title="@Loc["Admin.GiftVouchers.Fields.IsGiftVoucherActivated"]" width="100" align="Center">
                        <cell-template>
                            <i data-if="IsGiftVoucherActivated" class="bi bi-check-lg" aria-hidden="true" style="color:green"></i>
                            <i data-else class="bi bi-x-lg" aria-hidden="true" style="color:red"></i>
                        </cell-template>
                    </grid-column>
                    <grid-column field="CreatedOn" title="@Loc["Admin.GiftVouchers.Fields.CreatedOn"]" width="180" format="{0:G}"/>
                </admin-grid>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {

        $('#search-giftvouchers').click(function () {
            var grid = $('#giftvouchers-grid').data('kendoGrid');
            grid.dataSource.page(1);
            return false;
        });
    });

    $("#@Html.IdFor(model => model.CouponCode)").keydown(function (event) {
        if (event.keyCode == 13) {
            $("#search-giftvouchers").click();
            return false;
        }
    });

    function additionalData() {
        var data = {
            ActivatedId: $('#@Html.IdFor(model => model.ActivatedId)').val(),
            CouponCode: $('#@Html.IdFor(model => model.CouponCode)').val(),
            RecipientName: $('#@Html.IdFor(model => model.RecipientName)').val()
        };
        addAntiForgeryToken(data);
        return data;
    }
</script>
