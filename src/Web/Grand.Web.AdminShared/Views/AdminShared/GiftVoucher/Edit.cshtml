@model GiftVoucherModel
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    ViewBag.Title = Loc["Admin.GiftVouchers.EditGiftVoucherDetails"];
}
<form asp-area="@area" asp-controller="GiftVoucher" asp-action="Edit" method="post">
    @* the product edit screen's shell: the voucher's code as the title, Save as the one primary
       action, and Delete in the overflow menu rather than beside Save *@
    <admin-page sticky
                title="@(string.IsNullOrEmpty(Model.Code) ? Loc["Admin.GiftVouchers.EditGiftVoucherDetails"] : Model.Code)"
                icon="bi-gift"
                meta="@Loc["Admin.GiftVouchers.EditGiftVoucherDetails"]"
                back-url="@Url.Action("List")"
                back-text="@Loc["Admin.GiftVouchers.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <admin-action-menu>
                <admin-action id="giftvoucher-delete" destructive="true" icon="bi-trash"
                              text="@Loc["Admin.Common.Delete"]"/>
            </admin-action-menu>
            <partial name="Partials/WidgetZone.DetailsButtons" model="Model"/>
        </page-actions>

        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>
<admin-delete-confirmation button-id="giftvoucher-delete"/>
