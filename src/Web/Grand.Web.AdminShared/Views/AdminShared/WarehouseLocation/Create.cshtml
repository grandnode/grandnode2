@model Grand.Web.AdminShared.Models.Shipping.WarehouseLocationModel
@{
    ViewBag.Title = Loc["Admin.Configuration.Shipping.WarehouseLocations.AddNew"];
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}
<form asp-area="@area" asp-controller="WarehouseLocation" asp-action="Create" method="post">
    <admin-page sticky title="@Loc["Admin.Configuration.Shipping.WarehouseLocations.AddNew"]" icon="bi-grid-3x3-gap"
                back-url="@Url.Action("List", new { area })"
                back-text="@Loc["Admin.Configuration.Shipping.WarehouseLocations.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
        </page-actions>
        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>
