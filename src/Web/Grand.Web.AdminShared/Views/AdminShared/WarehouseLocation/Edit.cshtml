@model Grand.Web.AdminShared.Models.Shipping.WarehouseLocationModel
@{
    ViewBag.Title = Model.Code;
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}
<form asp-area="@area" asp-controller="WarehouseLocation" asp-action="Edit" method="post">
    <admin-page sticky title="@Model.Code" icon="bi-grid-3x3-gap"
                meta="@Loc["Admin.Configuration.Shipping.WarehouseLocations.EditDetails"]"
                back-url="@Url.Action("List", new { area })"
                back-text="@Loc["Admin.Configuration.Shipping.WarehouseLocations.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <admin-action-menu>
                <admin-action id="location-delete" destructive="true" icon="bi-trash"
                              text="@Loc["Admin.Common.Delete"]"/>
            </admin-action-menu>
        </page-actions>
        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>
<admin-delete-confirmation button-id="location-delete" action-name="Delete"/>
