@{
    //page title
    ViewBag.Title = Loc["Admin.Content.Blog.BlogPosts"];
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}

<div class="row">
    <div class="col-md-12">
        <div class="x_panel light form-fit">
            <div class="x_title">
                <div class="caption">
                    <i class="fa fa-comment"></i>
                    @Loc["Admin.Content.Blog.BlogPosts"]
                </div>
                <div class="actions btn-group btn-group-devided">
                    <a href="@Url.Action("Create", new { area })" class="btn green">
                        <i class="fa fa-plus"></i><span class="d-none d-sm-inline"> @Loc["Admin.Common.AddNew"] </span>
                    </a>
                </div>
            </div>
            <div class="x_content form">
                <div class="form-horizontal">
                    <div class="form-body">
                        <div class="x_content">
                            <admin-grid id="blogpost-grid" read-url="@Url.Action("List", "Blog", new { area })">
                                <grid-text name="comments" value="@Loc["Admin.Content.Blog.BlogPosts.Fields.Comments"]"/>
                                <grid-column field="Title" title="@Loc["Admin.Content.Blog.BlogPosts.Fields.Title"]" width="400">
                                    <cell-template>
                                        <a class="k-link" href="Edit/{{ Id }}">{{ Title }}</a>
                                    </cell-template>
                                </grid-column>
                                <grid-column field="Comments" title="@Loc["Admin.Content.Blog.BlogPosts.Fields.Comments"]" width="200">
                                    <cell-template>
                                        <a class="k-link" href="Comments?filterByBlogPostId={{ Id }}">{{ $texts.comments }} - {{ Comments }} </a>
                                    </cell-template>
                                </grid-column>
                                <grid-column field="StartDate" title="@Loc["Admin.Content.Blog.BlogPosts.Fields.StartDate"]" width="150" format="{0:G}"/>
                                <grid-column field="EndDate" title="@Loc["Admin.Content.Blog.BlogPosts.Fields.EndDate"]" width="150" format="{0:G}"/>
                                <grid-column field="CreatedOn" title="@Loc["Admin.Content.Blog.BlogPosts.Fields.CreatedOn"]" width="200" format="{0:G}"/>
                            </admin-grid>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

