@model BlogPostModel
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}
@if (!string.IsNullOrEmpty(Model.Id))
{
    <partial name="Partials/WidgetZone.Products.Top" model="Model"/>
    <div class="grand-card">
        <div class="grand-card__header">
            <h2 class="grand-card__title">@Loc["Admin.Content.Blog.BlogPosts.Products"]</h2>
            <a id="btnAddNewProduct" href="@(Url.Action("ProductAddPopup", "Blog", new { blogPostId = Model.Id, btnId = "btnRefreshProducts", formId = "blog-edit", area }))" class="btn btn-outline-secondary btn-sm"><i class="bi bi-plus-lg"></i> @Loc["Admin.Content.Blog.BlogPosts.Products.AddNew"]</a>
            <input type="button" id="btnRefreshProducts" style="display: none"/>
        </div>
        <div class="grand-card__body grand-card__body--flush">
            <admin-grid id="product-grid"
                        read-url="@Url.Action("Products", "Blog", new { blogPostId = Model.Id, area })"
                        update-url="@Url.Action("UpdateProduct", "Blog", new { blogPostId = Model.Id, area })"
                        destroy-url="@Url.Action("DeleteProduct", "Blog", new { area })"
                        edit-mode="Inline"
                        reload-after-save="false">
                <grid-column field="ProductName" title="@Loc["Admin.Content.Blog.Product.Fields.ProductName"]" width="300">
                    <cell-template>
                        <a href="@Url.Action("Edit", "Product", new { area })/{{ ProductId }}" target="_blank">{{ ProductName }}</a>
                    </cell-template>
                </grid-column>
                <grid-column field="DisplayOrder" title="@Loc["Admin.Content.Blog.Product.Fields.DisplayOrder"]" width="100" editor="Integer"/>
                <grid-commands edit="true" destroy="true" width="200"/>
            </admin-grid>
        </div>
    </div>
    <partial name="Partials/WidgetZone.Products.Bottom" model="Model"/>
    <script>
        $(document).ready(function () {
            $('#btnAddNewProduct').magnificPopup({
                type: 'ajax',
                settings: { cache: false, async: false },
                midClick: true,
                callbacks: {
                    parseAjax: function (mfpResponse) {
                        mfpResponse.data = $('<div></div>').html(mfpResponse.data);
                    },
                    ajaxContentAdded: function () {
                        $('.mfp-wrap').removeAttr('tabindex');
                    }
                }
            });
        });
    </script>
    <script>
        $(document).ready(function () {
            $('#btnRefreshProducts').click(function () {
                //refresh grid
                var grid = $("#product-grid").data('kendoGrid');
                grid.dataSource.read();

                //return false to don't reload a page
                return false;
            });
        });
    </script>
}
else
{
    <div class="note note-info">
        @Loc["Admin.Content.Blog.BlogPosts.SaveBeforeEdit"]
    </div>
}
