@model BlogCategoryModel

@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}
@if (!string.IsNullOrEmpty(Model.Id))
{
    <div class="grand-card">
        <div class="grand-card__header">
            <h2 class="grand-card__title">@Loc["Admin.Content.Blog.BlogCategory.Posts"]</h2>
            <a id="btnAddNewPost" href="@(Url.Action("BlogPostAddPopup", "Blog", new { categoryId = Model.Id, btnId = "btnRefreshPosts", formId = "category-form", area }))" class="btn btn-outline-secondary btn-sm"><i class="bi bi-plus-lg"></i> @Loc["Admin.Content.Blog.BlogCategory.AddNewPost"]</a>
            <input type="submit" id="btnRefreshPosts" style="display: none"/>
        </div>
        <div class="grand-card__body grand-card__body--flush">
            <admin-grid id="posts-grid"
                        read-url="@Url.Action("CategoryPostList", "Blog", new { categoryId = Model.Id, area })"
                        destroy-url="@Url.Action("CategoryPostDelete", "Blog", new { categoryId = Model.Id, area })">
                <grid-column field="Name" title="@Loc["Admin.Content.Blog.BlogCategory.Fields.Post"]">
                    <cell-template>
                        <a class="text-decoration-none" href="@Url.Action("Edit", "Blog", new { area })/{{ BlogPostId }}">{{ Name }}</a>
                    </cell-template>
                </grid-column>
                <grid-commands destroy="true"/>
            </admin-grid>
        </div>
    </div>
    <script>
        $(document).ready(function () {
            $('#btnAddNewPost').magnificPopup({
                type: 'ajax',
                settings: { cache: false, async: false },
                midClick: true,
                callbacks: {
                    parseAjax: function (mfpResponse) {
                        mfpResponse.data = $('<div></div>').html(mfpResponse.data);
                    },
                    ajaxContentAdded: function () {
                        $('.mfp-wrap').removeAttr('tabindex');
                    }
                }
            });
        });
    </script>
    <script>
        $(document).ready(function () {
            $('#btnRefreshPosts').click(function () {
                //refresh grid
                var grid = $("#posts-grid").data('kendoGrid');
                grid.dataSource.read();
                //return false to don't reload a page
                return false;
            });
        });
    </script>
}
else
{
    <div class="note note-info">
        @Loc["Admin.Content.Blog.BlogCategory.SaveBeforeEdit"]
    </div>
}
