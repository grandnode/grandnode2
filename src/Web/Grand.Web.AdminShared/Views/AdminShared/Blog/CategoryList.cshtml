@{
    //page title
    ViewBag.Title = Loc["Admin.Content.Blog.BlogCategories"];
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}

<admin-page title="@Loc["Admin.Content.Blog.BlogCategories"]" icon="bi-chat">
    <page-actions>
        <a href="@Url.Action("CategoryCreate", new { area })" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> @Loc["Admin.Common.AddNew"]
        </a>
    </page-actions>

    <admin-card flush>
        <admin-grid id="blogcategory-grid" read-url="@Url.Action("CategoryList", "Blog", new { area })">
            <grid-column field="Name" title="@Loc["Admin.Content.Blog.BlogCategory.Fields.Name"]" width="600">
                <cell-template>
                    <a class="text-decoration-none" href="CategoryEdit/{{ Id }}">{{ Name }}</a>
                </cell-template>
            </grid-column>
            <grid-column field="DisplayOrder" title="@Loc["Admin.Content.Blog.BlogCategory.Fields.DisplayOrder"]" width="100" align="Center"/>
        </admin-grid>
    </admin-card>
</admin-page>
