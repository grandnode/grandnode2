@{
    //page title
    ViewBag.Title = Loc["Admin.Content.Blog.Comments"];
    string filterByBlogPostId = ViewBag.FilterByBlogPostId;
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var readUrl = !string.IsNullOrEmpty(filterByBlogPostId) ? Url.Action("Comments", "Blog", new { filterByBlogPostId, area }) : Url.Action("Comments", "Blog", new { area });
}

<div class="row">
    <div class="col-md-12">
        <div class="x_panel light form-fit">
            <div class="x_title">
                <div class="caption level-caption">
                    <i class="bi bi-chat"></i>
                    @Loc["Admin.Content.Blog.Comments"]
                </div>
            </div>
            <div class="x_content form">
                <div class="form-horizontal">
                    <div class="form-body">
                        <div class="x_content">
                            <admin-grid id="comments-grid"
                                        read-url="@readUrl"
                                        destroy-url="@Url.Action("CommentDelete", "Blog", new { area })"
                                        confirm-destroy="true">
                                <grid-column field="BlogPostTitle" title="@Loc["Admin.Content.Blog.Comments.Fields.BlogPost"]" width="200">
                                    <cell-template>
                                        <a class="k-link" href="@Url.Action("Edit", "Blog", new { area })/{{ BlogPostId }}">{{ BlogPostTitle }}</a>
                                    </cell-template>
                                </grid-column>
                                <grid-column field="CustomerId" title="@Loc["Admin.Content.Blog.Comments.Fields.Customer"]" width="200">
                                    <cell-template>
                                        <a class="k-link" href="@Url.Action("Edit", "Customer", new { area })/{{ CustomerId }}">{{ CustomerInfo }}</a>
                                    </cell-template>
                                </grid-column>
                                @*Comment is encoded and has its line breaks turned into <br /> by the server (FormatText)*@
                                <grid-column field="Comment" title="@Loc["Admin.Content.Blog.Comments.Fields.Comment"]" encoded="false"/>
                                <grid-column field="CreatedOn" title="@Loc["Admin.Content.Blog.Comments.Fields.CreatedOn"]" width="200" format="{0:G}"/>
                                <grid-commands destroy="true" title="@Loc["Admin.Common.Delete"]" width="100"/>
                            </admin-grid>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

