@model BlogPostModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Content.Blog.BlogPosts.AddNew"];
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}
<form asp-area="@area" asp-controller="Blog" asp-action="Create" method="post">

    @* the same shell as Edit, minus what a post that does not exist yet cannot offer *@
    <admin-page sticky
                title="@Loc["Admin.Content.Blog.BlogPosts.AddNew"]"
                icon="bi-chat"
                back-url="@Url.Action("List")"
                back-text="@Loc["Admin.Content.Blog.BlogPosts.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <partial name="Partials/WidgetZone.DetailsButtonsCreate"/>
        </page-actions>

        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>
