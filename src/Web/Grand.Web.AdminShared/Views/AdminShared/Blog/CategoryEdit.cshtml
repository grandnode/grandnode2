@model BlogCategoryModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Content.Blog.BlogCategory.EditBlogCategoryDetails"];
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}

<form asp-area="@area" asp-controller="Blog" asp-action="CategoryEdit" method="post" id="category-form">

    <admin-page sticky
                title="@Model.Name"
                icon="bi-chat"
                meta="@Loc["Admin.Content.Blog.BlogCategory.EditBlogCategoryDetails"]"
                back-url="@Url.Action("CategoryList")"
                back-text="@Loc["Admin.Content.Blog.BlogCategory.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <admin-action-menu>
                <admin-action id="blogcategory-delete" destructive="true" icon="bi-trash"
                              text="@Loc["Admin.Common.Delete"]"/>
            </admin-action-menu>
            <partial name="Partials/WidgetZone.CategoryButtons" model="Model"/>
        </page-actions>

        <partial name="Partials/CreateOrUpdateCategory" model="Model"/>
    </admin-page>
</form>
<admin-delete-confirmation button-id="blogcategory-delete" action-name="CategoryDelete"/>
