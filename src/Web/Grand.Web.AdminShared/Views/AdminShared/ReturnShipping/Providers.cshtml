@model Grand.Web.AdminShared.Models.Shipping.ReturnShippingSettingsModel
@{
    ViewBag.Title = Loc["Admin.Configuration.Shipping.ReturnMethods"];
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}

@* the store's return settings first, saved from the header; the methods grid below edits inline and sits
   outside the form, so its editors never post with the settings *@
<admin-page title="@Loc["Admin.Configuration.Shipping.ReturnMethods"]" icon="bi-arrow-return-left">
    <page-actions>
        <button class="btn btn-primary" type="submit" name="save" form="returnshipping-settings-form">
            <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
        </button>
    </page-actions>

    @if (area == "Admin")
    {
        @await Component.InvokeAsync("StoreScope")
    }

    <form id="returnshipping-settings-form" asp-area="@area" asp-controller="ReturnShipping" asp-action="Settings" method="post">
        <div asp-validation-summary="All"></div>
        <admin-card>
            <div class="grand-fields">
                <admin-field asp-for="SendYourselfCost" size="md"/>
            </div>
        </admin-card>
        <admin-card title="@Loc["Admin.Configuration.Shipping.ReturnMethods.ReturnAddress"]">
            <div class="note note-info">@Loc["Admin.Configuration.Shipping.ReturnMethods.ReturnAddress.Hint"]</div>
            <admin-input asp-for="ReturnAddress" asp-template="Address"/>
        </admin-card>
    </form>

    <admin-card flush>
        <admin-grid id="returnshippingproviders-grid"
                    key="SystemName"
                    read-url="@Url.Action("Providers", "ReturnShipping", new { area })"
                    update-url="@Url.Action("ProviderUpdate", "ReturnShipping", new { area })"
                    pager="Compact"
                    edit-mode="Inline">
            <grid-column field="FriendlyName" title="@Loc["Admin.Configuration.Shipping.ReturnMethods.Fields.FriendlyName"]" width="250">
                <cell-template>
                    <a data-if="ConfigurationUrl" class="text-decoration-none" href="{{ ConfigurationUrl }}">{{ FriendlyName }}</a>
                    <span data-else>{{ FriendlyName }}</span>
                </cell-template>
            </grid-column>
            <grid-column field="SystemName" title="@Loc["Admin.Configuration.Shipping.ReturnMethods.Fields.SystemName"]" width="250">
                <cell-template>
                    <a data-if="ConfigurationUrl" class="text-decoration-none" href="{{ ConfigurationUrl }}">{{ SystemName }}</a>
                    <span data-else>{{ SystemName }}</span>
                </cell-template>
            </grid-column>
            <grid-column field="DisplayOrder" title="@Loc["Admin.Configuration.Shipping.ReturnMethods.Fields.DisplayOrder"]" width="100" format="{0:0}"/>
            <grid-column field="IsActive" title="@Loc["Admin.Configuration.Shipping.ReturnMethods.Fields.IsActive"]" width="100" align="Center" editor="Checkbox">
                <cell-template>
                    <i data-if="IsActive" class="bi bi-check-lg text-success" aria-hidden="true"></i>
                    <i data-else class="bi bi-x-lg text-danger" aria-hidden="true"></i>
                </cell-template>
            </grid-column>
            <grid-commands edit="true" title="@Loc["Admin.Common.Edit"]" width="150"/>
        </admin-grid>
    </admin-card>
</admin-page>
