@{
    //page title
    ViewBag.Title = Loc["Admin.Customers.CustomerAttributes"];
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}
<div class="row">
    <div class="col-md-12">
        <div class="x_panel light form-fit">
            <div class="x_title">
                <div class="caption">
                    <i class="fa fa-list-alt"></i>
                    @Loc["Admin.Customers.CustomerAttributes"]
                </div>
                <div class="actions btn-group btn-group-devided">
                    <a href="@Url.Action("Create", "CustomerAttribute", new { area })" class="btn green">
                        <i class="fa fa-plus"></i><span class="d-none d-sm-inline"> @Loc["Admin.Common.AddNew"] </span>
                    </a>
                    <partial name="Partials/WidgetZone.ListButtons"/>
                </div>
            </div>
            <div class="x_content form">
                <div class="form-horizontal">
                    <div class="form-body">
                        <div class="x_content">
                            <div id="customerattributes-grid"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $("#customerattributes-grid").kendoGrid({
            dataSource: {
                transport: {
                    read: {
                        url: "@Html.Raw(Url.Action("List", "CustomerAttribute", new { area }))",
                        type: "POST",
                        dataType: "json",
                        data: addAntiForgeryToken
                    }
                },
                schema: {
                    data: "Data",
                    total: "Total",
                    errors: "Errors"
                },
                error: function(e) {
                    display_kendoui_grid_error(e);
                    this.cancelChanges();
                },
                serverPaging: true,
                serverFiltering: true,
                serverSorting: true
            },
            pageable: {
                refresh: true,
                numeric: false,
                previousNext: false,
                info: false
            },
            scrollable: false,
            columns: [{
                field: "Name",
                title: "@Loc["Admin.Customers.CustomerAttributes.Fields.Name"]",
                template: '<a class="k-link" href="Edit/#=Id#">#=kendo.htmlEncode(Name)#</a>'
            }, {
                field: "AttributeControlTypeName",
                title: "@Loc["Admin.Customers.CustomerAttributes.Fields.AttributeControlType"]",
                headerAttributes: { style: "text-align:center" },
                attributes: { style: "text-align:center" },
                width: 200,
                minScreenWidth: 750
            }, {
                field: "IsRequired",
                title: "@Loc["Admin.Customers.CustomerAttributes.Fields.IsRequired"]",
                width: 100,
                headerAttributes: { style: "text-align:center" },
                attributes: { style: "text-align:center" },
                template: '# if(IsRequired) {# <i class="fa fa-check" aria-hidden="true" style="color:green"></i> #} else {# <i class="fa fa-times" aria-hidden="true" style="color:red"></i> #} #'
            }, {
                field: "DisplayOrder",
                title: "@Loc["Admin.Customers.CustomerAttributes.Fields.DisplayOrder"]",
                width: 100,
                minScreenWidth: 750
            }, {
                field: "IsGlobalAttribute",
                title: "@Loc["Admin.Common.View"]",
                width: 120,
                headerAttributes: { style: "text-align:center" },
                attributes: { style: "text-align:center" },
                template: '# if(IsGlobalAttribute) {# <a class="k-link" href="Edit/#=Id#"><span class="badge badge-secondary">@Loc["Admin.Common.View"]</span></a> #} else {# <a class="k-link" href="Edit/#=Id#"><span class="badge badge-success">@Loc["Admin.Common.Edit"]</span></a> #} #'
            }]
        });
    });
</script>
