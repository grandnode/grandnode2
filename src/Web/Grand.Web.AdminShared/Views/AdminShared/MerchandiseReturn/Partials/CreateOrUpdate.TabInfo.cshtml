@using Grand.Domain.Orders
@model MerchandiseReturnModel
@inject OrderSettings orderSettings
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}

@* who and what the return is about reads as facts, the status too: it changes only through the
   status buttons; the comments and the pickup date are the fields *@
<partial name="Partials/WidgetZone.TabInfo.Top" model="Model"/>
<admin-card>
    <div class="grand-facts">
        <div>
            <admin-label asp-for="ReturnNumber" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Model.ReturnNumber</div>
        </div>
        <div>
            <admin-label asp-for="OrderId" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Html.ActionLink(Loc["Admin.Common.View"], "Edit", "Order", new { id = Model.OrderId }, new { })</div>
        </div>
        <div>
            <admin-label asp-for="CustomerId" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Html.ActionLink(Model.CustomerInfo, "Edit", "Customer", new { id = Model.CustomerId }, new { })</div>
        </div>
        <div>
            <admin-label asp-for="CreatedOn" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Html.DisplayFor(model => model.CreatedOn)</div>
        </div>
        <div>
            <admin-label asp-for="MerchandiseReturnStatusId" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Model.MerchandiseReturnStatusStr</div>
        </div>
    </div>
</admin-card>
<admin-card>
    <div class="grand-fields grand-fields--2col">
        <admin-field asp-for="ExternalId"/>
        <admin-field asp-for="CustomerComments">
            <admin-textarea asp-for="CustomerComments"></admin-textarea>
        </admin-field>
        <admin-field asp-for="StaffNotes">
            <admin-textarea asp-for="StaffNotes"></admin-textarea>
        </admin-field>
        @if (orderSettings.MerchandiseReturns_AllowToSpecifyPickupDate)
        {
            <admin-field asp-for="PickupDate"/>
        }
    </div>
</admin-card>
@if (Model.ReturnShipping != null)
{
    <partial name="Partials/CreateOrUpdate.ReturnShipping" model="Model"/>
}
@if (Model.Refund != null)
{
    <partial name="Partials/CreateOrUpdate.Refund" model="Model"/>
}
@* the receipts the goods come back to stock on; one the panel cannot open is only named *@
@if (Model.ReturnReceipts.Count > 0)
{
    <admin-card title="@Loc["Admin.Orders.MerchandiseReturns.ReturnReceipts"]">
        <ul class="list-unstyled mb-0">
            @foreach (var receipt in Model.ReturnReceipts)
            {
                <li>
                    @if (receipt.CanOpen)
                    {
                        <a class="text-decoration-none" href="@Url.Action("Edit", "InventoryDocument", new { area, id = receipt.Id })">@receipt.Number</a>
                    }
                    else
                    {
                        <span>@receipt.Number</span>
                    }
                    <span class="text-muted">(@receipt.Status)</span>
                </li>
            }
        </ul>
    </admin-card>
}
<admin-card flush>
    <admin-grid id="products-grid"
                read-url="@Url.Action("ProductsForMerchandiseReturn", "MerchandiseReturn", new { merchandiseReturnId = Model.Id, area = area })"
                pager="None">
        <grid-column field="ProductName" title="@Loc["Admin.Orders.MerchandiseReturns.Fields.Item"]" width="200">
            <cell-template>
                <a class="text-decoration-none" href="@Url.Action("Edit", "Product", new { area = area })/{{ ProductId }}">{{ ProductName }}</a>
            </cell-template>
        </grid-column>
        <grid-column field="ProductSku" title="@Loc["Admin.Catalog.Products.Fields.Sku"]" width="200">
            <cell-template>
                <a class="text-decoration-none" href="@Url.Action("Edit", "Product", new { area = area })/{{ ProductId }}">{{ ProductSku }}</a>
            </cell-template>
        </grid-column>
        <grid-column field="Quantity" title="@Loc["Admin.Orders.MerchandiseReturns.Fields.Quantity"]" width="80"/>
        <grid-column field="UnitPrice" title="@Loc["Admin.Orders.MerchandiseReturns.Fields.UnitPrice"]" width="100"/>
        <grid-column field="ReasonForReturn" title="@Loc["Admin.Orders.MerchandiseReturns.Fields.ReturnReason"]" width="200"/>
        <grid-column field="RequestedAction" title="@Loc["Admin.Orders.MerchandiseReturns.Fields.ReturnAction"]" width="200"/>
    </admin-grid>
</admin-card>
<partial name="Partials/WidgetZone.TabInfo.Bottom" model="Model"/>
