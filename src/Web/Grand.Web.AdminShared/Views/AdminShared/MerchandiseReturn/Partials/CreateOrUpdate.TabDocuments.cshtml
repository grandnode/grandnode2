@model MerchandiseReturnModel
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}
<div class="grand-card">
    <div class="grand-card__header">
        <h2 class="grand-card__title"></h2>
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="location.href='@Url.Action("CreateDocument", "Document", new { ObjectId = Model.Id, Reference = (int)Reference.MerchandiseReturn, area = area })'"><i class="bi bi-plus-lg"></i> @Loc["Admin.Common.AddNew"]</button>
    </div>
    <partial name="Partials/WidgetZone.Documents.Top" model="Model"/>
    <div class="grand-card__body grand-card__body--flush">
        <admin-grid id="merchandisereturn-documents-grid" read-url="@Url.Action("ListDocuments", "Document", new { reference = (int)Reference.MerchandiseReturn, ObjectId = Model.Id, StatusId = -1, area = area })">
            <grid-column field="Number" title="@Loc["Admin.Documents.Document.Fields.Number"]">
                <cell-template>
                    <a class="text-decoration-none" href="@Url.Action("EditDocument", "Document", new { area = area })/{{ Id }}">{{ Number }}</a>
                </cell-template>
            </grid-column>
            <grid-column field="Name" title="@Loc["Admin.Documents.Document.Fields.Name"]">
                <cell-template>
                    <a class="text-decoration-none" href="@Url.Action("EditDocument", "Document", new { area = area })/{{ Id }}">{{ Name }}</a>
                </cell-template>
            </grid-column>
            <grid-column field="Published" title="@Loc["Admin.Documents.Document.Fields.Published"]" width="100" align="Center" min-screen-width="500">
                <cell-template>
                    <i data-if="Published" class="bi bi-check-lg text-success" aria-hidden="true"></i>
                    <i data-else class="bi bi-x-lg text-danger" aria-hidden="true"></i>
                </cell-template>
            </grid-column>
        </admin-grid>
    </div>
    <partial name="Partials/WidgetZone.Documents.Bottom" model="Model"/>
</div>

