@model MerchandiseReturnModel
@{
    var refund = Model.Refund;
    var prefix = Scope.ResourceKeyPrefix;
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}
@* the money given back reads as facts; a received return not refunded yet shows what it comes to, with the
   amount to refund and one button per way the order's payment can give it back. A refund button posts the
   form to its own action: what was typed and not saved yet is not saved by it *@
<admin-card title="@Loc[$"{prefix}.Orders.MerchandiseReturns.Refund.Title"]">
    <div class="grand-facts">
        <div>
            <div class="grand-fact__label">@Loc[$"{prefix}.Orders.MerchandiseReturns.Refund.ItemsAmount"]</div>
            <div class="grand-fact__value">@refund.ItemsAmount</div>
        </div>
        <div>
            <div class="grand-fact__label">@Loc[$"{prefix}.Orders.MerchandiseReturns.Refund.ReturnShippingCost"]</div>
            <div class="grand-fact__value">@refund.ReturnShippingCost</div>
        </div>
        <div>
            <div class="grand-fact__label">@Loc[$"{prefix}.Orders.MerchandiseReturns.Refund.Amount"]</div>
            <div class="grand-fact__value">@refund.Amount</div>
        </div>
        @if (refund.Started)
        {
            <div>
                <div class="grand-fact__label">@Loc[$"{prefix}.Orders.MerchandiseReturns.Refund.Method"]</div>
                <div class="grand-fact__value">
                    @(refund.Offline
                        ? Loc[$"{prefix}.Orders.MerchandiseReturns.Refund.Offline"]
                        : Loc[$"{prefix}.Orders.MerchandiseReturns.Refund.Online"])
                </div>
            </div>
            <div>
                <div class="grand-fact__label">@Loc[$"{prefix}.Orders.MerchandiseReturns.Refund.RefundedOn"]</div>
                <div class="grand-fact__value">
                    @(refund.RefundedOn.HasValue
                        ? refund.RefundedOn.Value.ToString()
                        : Loc[$"{prefix}.Orders.MerchandiseReturns.Refund.UnderWay"])
                </div>
            </div>
            @if (!string.IsNullOrEmpty(refund.RefundedBy))
            {
                <div>
                    <div class="grand-fact__label">@Loc[$"{prefix}.Orders.MerchandiseReturns.Refund.RefundedBy"]</div>
                    <div class="grand-fact__value">@refund.RefundedBy</div>
                </div>
            }
        }
    </div>
    @if (!refund.Started)
    {
        if (!string.IsNullOrEmpty(refund.Error))
        {
            <div class="mt-3 text-danger">@refund.Error</div>
        }
        else
        {
            <div class="grand-fields grand-fields--2col mt-3">
                <admin-field asp-for="RefundAmount" size="md" suffix="@refund.CurrencyCode"
                             hint="@string.Format(Loc[$"{prefix}.Orders.MerchandiseReturns.Refund.AmountToRefund.Hint"], refund.MaxAmount.ToString("G29"), refund.CurrencyCode)"/>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-3">
                @if (refund.CanRefundOnline)
                {
                    <button class="btn btn-outline-primary" type="submit"
                            formaction="@Url.Action("Refund", "MerchandiseReturn", new { id = Model.Id, area, offline = false })"
                            data-grand-confirm="@Loc[$"{prefix}.Orders.MerchandiseReturns.Refund.ConfirmOnline"]">
                        <i class="bi bi-arrow-counterclockwise"></i> @Loc[$"{prefix}.Orders.MerchandiseReturns.Refund.RefundOnline"]
                    </button>
                }
                @if (refund.CanRefundOffline)
                {
                    <button class="btn btn-outline-secondary" type="submit"
                            formaction="@Url.Action("Refund", "MerchandiseReturn", new { id = Model.Id, area, offline = true })"
                            data-grand-confirm="@Loc[$"{prefix}.Orders.MerchandiseReturns.Refund.ConfirmOffline"]">
                        <i class="bi bi-cash-coin"></i> @Loc[$"{prefix}.Orders.MerchandiseReturns.Refund.RefundOffline"]
                    </button>
                }
            </div>
        }
    }
</admin-card>
