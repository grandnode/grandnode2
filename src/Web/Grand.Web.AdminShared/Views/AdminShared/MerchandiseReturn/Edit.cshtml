@using Grand.Domain.Orders
@model MerchandiseReturnModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Orders.MerchandiseReturns.EditMerchandiseReturnDetails"];
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}
<form asp-area="@area" asp-controller="MerchandiseReturn" asp-action="Edit" method="post">
    @* Enter in a field submits through the form's first button: it saves, it never changes the status *@
    <button type="submit" name="save-continue" hidden aria-hidden="true" tabindex="-1"></button>

    @* the product edit screen's shell: Save as the one primary action, Delete in the overflow
       menu rather than beside Save *@
    <admin-page sticky
                title="@Model.ReturnNumber.ToString()"
                icon="bi-truck"
                meta="@Loc["Admin.Orders.MerchandiseReturns.EditMerchandiseReturnDetails"]"
                back-url="@Url.Action("List")"
                back-text="@Loc["Admin.Orders.MerchandiseReturns.BackToList"]">
        <page-actions>
            <audit-history entity-type="MerchandiseReturn" entity-id="@Model.Id"/>
            @* one button per status the return may change to; each saves the form first and tells the customer *@
            @foreach (var status in Model.NextStatuses)
            {
                if (status == (int)MerchandiseReturnStatus.Rejected)
                {
                    <button class="btn btn-outline-secondary" type="button" data-bs-toggle="collapse"
                            data-bs-target="#merchandisereturn-reject" aria-expanded="false" aria-controls="merchandisereturn-reject">
                        <i class="bi bi-x-circle"></i> @Loc["Admin.Orders.MerchandiseReturns.ChangeStatus.Rejected"]
                    </button>
                    continue;
                }
                @* Razor writes a data- attribute even when its value is null, and an empty
                   data-grand-confirm still asks: only cancelling asks *@
                if (status == (int)MerchandiseReturnStatus.Cancelled)
                {
                    <button class="btn btn-outline-secondary" type="submit" name="ChangeStatusTo" value="@status"
                            data-grand-confirm="@Loc["Admin.Orders.MerchandiseReturns.ConfirmCancel"]">
                        @Loc["Admin.Orders.MerchandiseReturns.ChangeStatus.Cancelled"]
                    </button>
                    continue;
                }
                <button class="btn btn-outline-secondary" type="submit" name="ChangeStatusTo" value="@status">
                    @Loc[$"Admin.Orders.MerchandiseReturns.ChangeStatus.{(MerchandiseReturnStatus)status}"]
                </button>
            }
            @* what the customer sent back goes on stock through a return receipt *@
            <button class="btn btn-outline-secondary" type="submit"
                    formaction="@Url.Action("CreateReturnReceipt", "InventoryDocument", new { area, merchandiseReturnId = Model.Id })">
                <i class="bi bi-box-arrow-in-down"></i> @Loc["Admin.Inventory.Documents.ReceiveToStock"]
            </button>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <admin-action-menu>
                <admin-action id="merchandisereturn-delete" destructive="true" icon="bi-trash"
                              text="@Loc["Admin.Common.Delete"]"/>
            </admin-action-menu>
            <partial name="Partials/WidgetZone.DetailsButtons" model="Model"/>
        </page-actions>

        @if (Model.NextStatuses.Contains((int)MerchandiseReturnStatus.Rejected))
        {
            @* rejecting asks why: the reason is shown to the customer with the return *@
            <div class="collapse" id="merchandisereturn-reject">
                <admin-card>
                    <div class="grand-fields">
                        <admin-field asp-for="ChangeStatusNote">
                            <admin-textarea asp-for="ChangeStatusNote"></admin-textarea>
                        </admin-field>
                    </div>
                    <button class="btn btn-outline-danger" type="submit" name="ChangeStatusTo"
                            value="@((int)MerchandiseReturnStatus.Rejected)">
                        <i class="bi bi-x-circle"></i> @Loc["Admin.Orders.MerchandiseReturns.ChangeStatus.Rejected"]
                    </button>
                </admin-card>
            </div>
        }

        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>
<admin-delete-confirmation button-id="merchandisereturn-delete"/>
