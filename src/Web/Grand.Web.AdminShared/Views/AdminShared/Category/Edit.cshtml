@model CategoryModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Catalog.Categories.EditCategoryDetails"];
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}
@* The product edit screen's shell: the category's name as the title, Save as the one primary
   action, and Delete in the overflow menu rather than beside Save. *@
<form asp-area="@area" asp-controller="Category" asp-action="Edit" method="post" id="category-form">
    <admin-page sticky
                title="@Model.Name"
                icon="bi-diagram-3"
                meta="@Loc["Admin.Catalog.Categories.EditCategoryDetails"]"
                back-url="@Url.Action("List")"
                back-text="@Loc["Admin.Catalog.Categories.BackToList"]">
        <page-actions>
            @if (!string.IsNullOrEmpty(Model.SeName))
            {
                <button type="button" onclick="window.open('@Url.RouteUrl("Category", new { Model.SeName })','_blank');" class="btn btn-outline-secondary">
                    <i class="bi bi-eye"></i> @Loc["Admin.Common.Preview"]
                </button>
            }
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <admin-action-menu>
                <admin-action id="category-delete" destructive="true" icon="bi-trash"
                              text="@Loc["Admin.Common.Delete"]"/>
            </admin-action-menu>
            <partial name="Partials/WidgetZone.DetailsButtons" model="Model"/>
        </page-actions>

        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>
<admin-delete-confirmation button-id="category-delete"/>
