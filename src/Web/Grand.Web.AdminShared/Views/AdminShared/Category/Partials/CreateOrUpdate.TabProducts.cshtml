@model CategoryModel
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}
<partial name="Partials/WidgetZone.Products.Top" model="Model"/>
@if (!string.IsNullOrEmpty(Model.Id))
{
    <div class="panel panel-default">
        <div class="panel-body">
            <admin-grid id="products-grid"
                        read-url="@Url.Action("ProductList", "Category", new { categoryId = Model.Id, area = area })"
                        update-url="@Url.Action("ProductUpdate", "Category", new { area = area })"
                        destroy-url="@Url.Action("ProductDelete", "Category", new { area = area })"
                        auto-bind="false"
                        edit-mode="Inline">
                <grid-column field="ProductName" title="@Loc["Admin.Catalog.Categories.Products.Fields.Product"]">
                    <cell-template>
                        <a class="k-link" href="@Url.Action("Edit", "Product", new { area = area })/{{ ProductId }}">{{ ProductName }}</a>
                    </cell-template>
                </grid-column>
                <grid-column field="IsFeaturedProduct" title="@Loc["Admin.Catalog.Categories.Products.Fields.IsFeaturedProduct"]" width="175" align="Center" min-screen-width="750" editor="Checkbox">
                    <cell-template>
                        <i data-if="IsFeaturedProduct" class="fa fa-check" aria-hidden="true" style="color:green"></i>
                        <i data-else class="fa fa-times" aria-hidden="true" style="color:red"></i>
                    </cell-template>
                </grid-column>
                <grid-column field="DisplayOrder" title="@Loc["Admin.Catalog.Categories.Products.Fields.DisplayOrder"]" width="125" align="Center" format="{0:0}" min-screen-width="750" editor="Integer"/>
                <grid-commands edit="true" destroy="true"/>
            </admin-grid>
        </div>
        <div class="panel-footer">
            <a id="btnAddNewProduct" href="@(Url.Action("ProductAddPopup", "Category", new { categoryId = Model.Id, btnId = "btnRefreshProducts", formId = "category-form", area = area }))" class="k-button"><i class="fa fa-plus"></i>&nbsp;@Loc["Admin.Catalog.Categories.Products.AddNew"]</a>
            <input type="submit" id="btnRefreshProducts" style="display: none"/>
        </div>
    </div>
    <script>
        $(document).ready(function () {
            $('#btnAddNewProduct').magnificPopup({
                type: 'ajax',
                settings: { cache: false, async: false },
                midClick: true,
                callbacks: {
                    parseAjax: function (mfpResponse) {
                        mfpResponse.data = $('<div></div>').html(mfpResponse.data);
                    },
                    ajaxContentAdded: function () {
                        $('.mfp-wrap').removeAttr('tabindex');
                    }
                }
            });
        });
    </script>
    <script>
        $(document).ready(function () {
            $('#btnRefreshProducts').click(function () {
                //refresh grid
                var grid = $("#products-grid").data('kendoGrid');
                grid.dataSource.read();

                //return false to don't reload a page
                return false;
            });
        });
    </script>
}
else
{
    <div class="note note-info">
        @Loc["Admin.Catalog.Categories.Products.SaveBeforeEdit"]
    </div>
}
<partial name="Partials/WidgetZone.Products.Bottom" model="Model"/>
