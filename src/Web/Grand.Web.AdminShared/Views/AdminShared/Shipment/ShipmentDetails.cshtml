@using Grand.Business.Core.Interfaces.Common.Security
@using Grand.Domain.Permissions
@model ShipmentModel
@inject IPermissionService permissionService
@{
    //page title
    ViewBag.Title = Loc["Admin.Orders.Shipments.ViewDetails"];
    var canManageDocuments = await permissionService.Authorize(StandardPermission.ManageDocuments);
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}
<form asp-area="@area" asp-controller="Shipment" asp-action="ShipmentDetails" method="post">
    <input type="hidden" asp-for="Id"/>
    <div asp-validation-summary="All"></div>
    @* The order screen's shell: the shipment number as the title. Shipping and delivering
       notify the customer and cannot be undone, so they ask first and stay outline buttons
       beside the packaging slip; the Info tab's Save is the screen's one primary action, and
       Delete is in the overflow menu. *@
    <admin-page sticky
                title="@Model.ShipmentNumber.ToString()"
                icon="bi-truck"
                meta="@Loc["Admin.Orders.Shipments.ViewDetails"]"
                back-url="@Url.Action("List")"
                back-text="@Loc["Admin.Orders.Shipments.BackToList"]">
        <page-actions>
            @if (Model.CanShip)
            {
                <input type="submit" name="setasshipped" asp-action="SetAsShipped" id="setasshipped"
                       value="@Loc["Admin.Orders.Shipments.ShippedDate.Button"]" class="btn btn-outline-secondary"
                       data-grand-confirm="@Loc["Admin.Common.AreYouSure"]" data-confirm-title="@Loc["Admin.Orders.Shipments.ShippedDate.Button"]"/>
            }
            @if (Model.CanDeliver)
            {
                <input type="submit" name="setasdelivered" asp-action="SetAsDelivered" id="setasdelivered"
                       value="@Loc["Admin.Orders.Shipments.DeliveryDate.Button"]" class="btn btn-outline-secondary"
                       data-grand-confirm="@Loc["Admin.Common.AreYouSure"]" data-confirm-title="@Loc["Admin.Orders.Shipments.DeliveryDate.Button"]"/>
            }
            <a href="@Url.Action("PdfPackagingSlip", new { shipmentId = Model.Id, area = area })" class="btn btn-outline-secondary">
                <i class="bi bi-file-earmark-pdf"></i> @Loc["Admin.Orders.Shipments.PrintPackagingSlip"]
            </a>
            <admin-action-menu>
                <admin-action id="shipment-delete" destructive="true" icon="bi-trash"
                              text="@Loc["Admin.Common.Delete"]"/>
            </admin-action-menu>
            <partial name="Partials/WidgetZone.DetailsButtons" model="Model"/>
        </page-actions>

        <admin-tabstrip name="shipment-edit" SetTabPos="true">
            <items>
                <tabstrip-item text="@Loc["Admin.Orders.Shipments.ViewDetails.Info"]" tab-index="0">
                    <content>
                        <div>
                            <partial name="Partials/Info" model="Model"/>
                        </div>
                    </content>
                </tabstrip-item>
                @if (canManageDocuments)
                {
                    <tabstrip-item text="@Loc["Admin.Orders.Shipments.Documents"]" tab-index="1">
                        <content>
                            <div>
                                <partial name="Partials/Documents" model="Model"/>
                            </div>
                        </content>
                    </tabstrip-item>
                }
                <tabstrip-item text="@Loc["Admin.Orders.Shipments.ShipmentNotes"]" tab-index="2">
                    <content>
                        <div>
                            <partial name="Partials/ShipmentNotes" model="Model"/>
                        </div>
                    </content>
                </tabstrip-item>
                <tabstrip-item text="@Loc["Admin.Common.UserFields.Tab"]" tab-index="3">
                    <content>
                        <admin-card>
                            <card-actions>
                                <input type="submit" asp-action="EditUserFields" value="@Loc["Admin.Common.Save"]" id="btnSaveUserFields" name="save-generic-attributes" class="btn btn-outline-secondary btn-sm"/>
                            </card-actions>
                            <partial name="Partials/UserFields" model="Model"/>
                        </admin-card>
                    </content>
                </tabstrip-item>
                <partial name="Partials/WidgetZone.DetailsTabs" model="Model"/>
            </items>
        </admin-tabstrip>
    </admin-page>
</form>
<admin-delete-confirmation button-id="shipment-delete" action-name="DeleteShipment"/>
