@using Grand.Domain.Media
@model ShipmentModel
@{
    ViewData["DownloadType"] = DownloadType.Shipment;
    ViewData["ReferenceId"] = Model.Id;
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}
<div class="panel panel-default">
    <partial name="Partials/WidgetZone.Notes.Top" model="Model"/>
    <div class="panel-body">
        <admin-grid id="shipmentnotes-grid"
                    read-url="@Url.Action("ShipmentNotesSelect", "Shipment", new { shipmentId = Model.Id, area = area })"
                    destroy-url="@Url.Action("ShipmentNoteDelete", "Shipment", new { shipmentId = Model.Id, area = area })"
                    pager="Compact">
            <grid-text name="link" value="@Loc["Admin.Orders.OrderNotes.Fields.Download.Link"]"/>
            <grid-text name="no" value="@Loc["Admin.Orders.OrderNotes.Fields.Download.Link.No"]"/>
            <grid-column field="CreatedOn" title="@Loc["Admin.Orders.Shipments.ShipmentNotes.CreatedOn"]" width="180" format="{0:G}"/>
            <grid-column field="Note" title="@Loc["Admin.Orders.Shipments.ShipmentNotes.Note"]" width="350"/>
            <grid-column field="DownloadId" title="@Loc["Admin.Orders.Shipments.ShipmentNotes.Download"]" width="100">
                <cell-template>
                    <a data-if="DownloadId != ''" href="@Url.Action("DownloadFile", "Download", new { area = area })/?downloadGuid={{ DownloadGuid }}">{{ $texts.link }}</a>
                    <span data-else>{{ $texts.no }}</span>
                </cell-template>
            </grid-column>
            <grid-column field="CreatedByCustomer" title="@Loc["Admin.Orders.Shipments.ShipmentNotes.CreatedByCustomer"]" width="100" align="Center">
                <cell-template>
                    <i data-if="CreatedByCustomer" class="fa fa-check" aria-hidden="true" style="color:green"></i>
                    <i data-else class="fa fa-times" aria-hidden="true" style="color:red"></i>
                </cell-template>
            </grid-column>
            <grid-column field="DisplayToCustomer" title="@Loc["Admin.Orders.Shipments.ShipmentNotes.Fields.DisplayToCustomer"]" width="100" align="Center">
                <cell-template>
                    <i data-if="DisplayToCustomer" class="fa fa-check" aria-hidden="true" style="color:green"></i>
                    <i data-else class="fa fa-times" aria-hidden="true" style="color:red"></i>
                </cell-template>
            </grid-column>
            <grid-commands destroy="true" title="@Loc["Admin.Common.Delete"]" width="100"/>
        </admin-grid>
    </div>
    <partial name="Partials/WidgetZone.Notes.Bottom" model="Model"/>
</div>
<p>
    <strong>
        @Loc["Admin.Orders.Shipments.ShipmentNotes.AddTitle"]
    </strong>
</p>
<script>
    $(document).ready(function () {
        $("#@Html.IdFor(model => model.AddShipmentNoteHasDownload)").change(toggleAddShipmentNoteHasDownload);
        toggleAddShipmentNoteHasDownload();
    });
    function toggleAddShipmentNoteHasDownload() {
        if ($('#@Html.IdFor(model => model.AddShipmentNoteHasDownload)').is(':checked')) {
            $('#pnlAddShipmentNoteDownloadId').show();
        }
        else {
            $('#pnlAddShipmentNoteDownloadId').hide();
        }
    }

</script>

<div class="form-horizontal">
    <div class="form-body">
        <div class="form-group">
            <admin-label asp-for="AddShipmentNoteMessage"/>
            <div class="col-md-9 col-sm-9">
                <admin-textarea asp-for="AddShipmentNoteMessage"></admin-textarea>
                <span asp-validation-for="AddShipmentNoteMessage"></span>
            </div>
        </div>
        <div class="form-group">
            <admin-label asp-for="AddShipmentNoteDownloadId"/>
            <div class="col-md-9 col-sm-9">
                <label class="mt-checkbox mt-checkbox-outline control control-checkbox">
                    <admin-input asp-for="AddShipmentNoteHasDownload"/>
                    <div class="control__indicator"></div>
                </label>
                <div id="pnlAddShipmentNoteDownloadId">
                    <admin-input asp-for="AddShipmentNoteDownloadId"/>
                    <span asp-validation-for="AddShipmentNoteDownloadId"></span>
                </div>
            </div>
        </div>
        <div class="form-group">
            <admin-label asp-for="AddShipmentNoteDisplayToCustomer"/>
            <div class="col-md-9 col-sm-9">
                <label class="mt-checkbox mt-checkbox-outline control control-checkbox">
                    <admin-input asp-for="AddShipmentNoteDisplayToCustomer"/>
                    <div class="control__indicator"></div>
                </label>
                <span asp-validation-for="AddShipmentNoteDisplayToCustomer"></span>
            </div>
        </div>
        <div class="form-actions">
            <div class="offset-md-3 col-md-9 col-sm-9">
                <button type="button" id="addShipmentNote" class="k-button"><i class="fa fa-plus"></i>&nbsp;@Loc["Admin.Orders.Shipments.ShipmentNotes.AddButton"]</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('#addShipmentNote').click(function () {
            var shipmentNoteMessage = $("#@Html.IdFor(model => model.AddShipmentNoteMessage)").val();
            if (shipmentNoteMessage.length == 0) {
                alert('Message text is required');
                return;
            }
            var shipmentNoteDownloadId = '';
            if ($('#@Html.IdFor(model => model.AddShipmentNoteHasDownload)').is(':checked')) {
                shipmentNoteDownloadId = $("#@Html.IdFor(model => model.AddShipmentNoteDownloadId)").val();
            }
            var shipmentNoteDisplayToCustomer = $("#@Html.IdFor(model => model.AddShipmentNoteDisplayToCustomer)").is(':checked');
            $('#addShipmentNote').attr('disabled', true);
            var postData = {
                DisplayToCustomer: shipmentNoteDisplayToCustomer,
                message: shipmentNoteMessage,
                downloadId: shipmentNoteDownloadId,
                shipmentId: '@Model.Id'
            };
            addAntiForgeryToken(postData);

            $.ajax({
                cache:false,
                type: "POST",
                url: "@(Url.Action("ShipmentNoteAdd", "Shipment", new { area = area }))",
                data: postData,
                success: function (data) {
                    var grid = $("#shipmentnotes-grid").data('kendoGrid');
                    grid.dataSource.read();
                    $('#addShipmentNote').attr('disabled', false);
                },
                error:function (xhr, ajaxOptions, thrownError){
                    alert('Failed to add shipment note.');
                    $('#addShipmentNote').attr('disabled', false);
                }
            });
        });
    });
</script>
