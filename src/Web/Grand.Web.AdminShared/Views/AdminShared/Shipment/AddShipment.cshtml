@using Grand.Domain.Shipping
@using Grand.Domain.Catalog
@model ShipmentModel
@inject IAdminDataScope<Shipment> Scope
@{
    //page title
    var prefix = Scope.ResourceKeyPrefix;
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    ViewBag.Title = string.Format(Loc[$"{prefix}.Orders.Shipments.AddNew.Title"], Model.OrderId);
}
<form asp-area="@area" asp-controller="Shipment" asp-action="AddShipment" method="post"
      asp-route-orderId="@HtmlExtensions.HtmlEncodeSafe(Context.Request.Query["orderId"])">

    <div asp-validation-summary="All"></div>
    <input type="hidden" asp-for="@Model.OrderId"/>
    @* the order screen's shell: Save as the one primary action, the shipment's fields in a card
       and the items to ship in a flush card below *@
    <admin-page sticky
                title="@string.Format(Loc[$"{prefix}.Orders.Shipments.AddNew.Title"], Model.OrderNumber)"
                icon="bi-truck"
                back-url="@Url.Action("Edit", "Order", new { Id = Model.OrderId })"
                back-text="@Loc[$"{prefix}.Orders.Shipments.BackToOrder"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" id="shipment-save-continue" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc[$"{prefix}.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" id="shipment-save" name="save">
                <i class="bi bi-check-lg"></i> @Loc[$"{prefix}.Common.Save"]
            </button>
            <partial name="Partials/WidgetZone.AddButtons" model="Model"/>
        </page-actions>

        <admin-card>
            <div class="grand-fields grand-fields--2col">
                <admin-field asp-for="TrackingNumber"/>
                <admin-field asp-for="AdminComment"/>
            </div>
        </admin-card>

        <admin-card title="@Loc[$"{prefix}.Orders.Shipments.Products"]" flush>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                    <tr>
                        <th>
                            @Loc[$"{prefix}.Orders.Shipments.Products.ProductName"]
                        </th>
                        <th>
                            @Loc[$"{prefix}.Orders.Shipments.Products.SKU"]
                        </th>
                        <th>
                            @Loc[$"{prefix}.Orders.Shipments.Products.Warehouse"]
                        </th>
                        <th>
                            @Loc[$"{prefix}.Orders.Shipments.Products.ItemWeight"]
                        </th>
                        <th>
                            @Loc[$"{prefix}.Orders.Shipments.Products.ItemDimensions"]
                        </th>
                        <th>
                            @Loc[$"{prefix}.Orders.Shipments.Products.QtyOrdered"]
                        </th>
                        <th>
                            @Loc[$"{prefix}.Orders.Shipments.Products.QtyShipped"]
                        </th>
                        <th>
                            @Loc[$"{prefix}.Orders.Shipments.Products.QtyToShip"]
                        </th>
                    </tr>
                    </thead>
                    <tbody>
                    @for (var j = 0; j < Model.Items.Count; j++)
                    {
                        var item = Model.Items[j];
                        <input asp-for="@Model.Items[j].OrderItemId" type="hidden"/>
                        <tr>
                            <td>
                                <div>
                                    <em>
                                        <a href="@Url.Action("Edit", "Product", new { id = item.ProductId, area = area })">@item.ProductName</a>
                                    </em>
                                    @if (!string.IsNullOrEmpty(item.AttributeInfo))
                                    {
                                        <p>
                                            @Html.Raw(item.AttributeInfo)
                                        </p>
                                    }
                                    @if (item.ShipSeparately)
                                    {
                                        <p>
                                            <strong>@Loc[$"{prefix}.Orders.Shipments.Products.ShipSeparately.Warning"]</strong>
                                            @Loc[$"{prefix}.Orders.Shipments.Products.ShipSeparately"]
                                        </p>
                                    }
                                </div>
                            </td>
                            <td>
                                <div>
                                    @item.Sku
                                </div>
                            </td>
                            <td>
                                <div>
                                    @if (item.AllowToChooseWarehouse)
                                    {
                                        if (item.AvailableWarehouses.Count > 0)
                                        {
                                            <select asp-for="@Model.Items[j].WarehouseId" class="form-select">
                                                @foreach (var warehouse in item.AvailableWarehouses)
                                                {
                                                    var selected = warehouse.WarehouseId == item.WarehouseId;
                                                    <option value="@(warehouse.WarehouseId)" data-stock-qty="@(warehouse.StockQuantity)"
                                                            data-reserved-qty="@(warehouse.ReservedQuantity)"
                                                            selected="@selected">
                                                        @Loc[$"{prefix}.Orders.Shipments.Products.Warehouse.ChooseQty", warehouse.WarehouseName, warehouse.StockQuantity, warehouse.ReservedQuantity]
                                                    </option>
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            <div>@Loc[$"{prefix}.Orders.Shipments.Products.Warehouse.NotAvailabe"]</div>
                                        }
                                    }
                                    else
                                    {
                                        //display warehouses
                                        for (var i = 0; i < item.AvailableWarehouses.Count; i++)
                                        {
                                            var warehouse = item.AvailableWarehouses[i];
                                            @warehouse.WarehouseName
                                            if (i != item.AvailableWarehouses.Count - 1)
                                            {
                                                <br/>
                                            }
                                        }
                                    }
                                </div>
                            </td>
                            <td>
                                @item.ItemWeight
                            </td>
                            <td>
                                @item.ItemDimensions
                            </td>
                            <td>
                                @item.QuantityOrdered
                            </td>
                            <td>
                                @item.QuantityInAllShipments
                            </td>
                            <td>
                                <div class="grand-field grand-field--sm">
                                    <div class="grand-field__control">
                                        <input asp-for="@Model.Items[j].QuantityToAdd" type="number" value="@item.QuantityToAdd"
                                               class="form-control" max="@item.QuantityToAdd"/>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        @if (item.TrackingMode == InventoryTrackingMode.SerialNumber)
                        {
                            <tr>
                                <td colspan="8">
                                    @* a serial-tracked unit ships with its number: one a line, a scanner sends Enter *@
                                    <textarea name="Items[@j].SerialNumbersText" class="form-control" rows="2" data-grand-scan
                                              placeholder="@Loc["Admin.Inventory.Units.Fields.SerialNumbers"]"></textarea>
                                    <div class="grand-cell-sub" data-grand-scan-count></div>
                                </td>
                            </tr>
                        }
                        @if (item.TrackingMode == InventoryTrackingMode.Batch)
                        {
                            <tr>
                                <td colspan="8">
                                    <table class="table table-sm mb-0" data-grand-batches="Items_@(j)__WarehouseId">
                                        @for (var k = 0; k < item.BatchProposals.Count; k++)
                                        {
                                            var proposal = item.BatchProposals[k];
                                            <tr data-warehouse="@proposal.WarehouseId">
                                                <td>
                                                    <input type="hidden" name="Items[@j].Batches[@k].WarehouseId" value="@proposal.WarehouseId"/>
                                                    <input type="hidden" name="Items[@j].Batches[@k].Number" value="@proposal.Number"/>
                                                    @if (string.IsNullOrEmpty(proposal.Number))
                                                    {
                                                        <span class="badge bg-warning text-dark">@Loc["Admin.Inventory.Units.WithoutBatch"]</span>
                                                    }
                                                    else
                                                    {
                                                        @proposal.Number
                                                    }
                                                </td>
                                                <td>
                                                    @proposal.ExpiryDate?.ToShortDateString()
                                                    @if (proposal.ExpiryStatus == BatchExpiryStatus.Expired)
                                                    {
                                                        <span class="badge bg-danger">@Loc["Enums.Grand.Domain.Catalog.BatchExpiryStatus.Expired"]</span>
                                                    }
                                                    else if (proposal.ExpiryStatus == BatchExpiryStatus.Expiring)
                                                    {
                                                        <span class="badge bg-warning text-dark">@Loc["Enums.Grand.Domain.Catalog.BatchExpiryStatus.Expiring"]</span>
                                                    }
                                                </td>
                                                <td class="text-end">@proposal.Available</td>
                                                <td style="width: 8rem">
                                                    <input name="Items[@j].Batches[@k].Quantity" type="number" min="0" value="@proposal.Quantity"
                                                           class="form-control form-control-sm"/>
                                                </td>
                                            </tr>
                                        }
                                    </table>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </admin-card>
    </admin-page>
</form>
<script>
    //counts the serial numbers scanned and marks a number scanned twice; the server refuses duplicates anyway
    document.querySelectorAll('[data-grand-scan]').forEach(function (box) {
        var count = box.parentElement.querySelector('[data-grand-scan-count]');
        function update() {
            var numbers = box.value.split(/[\r\n,;]+/).map(function (x) { return x.trim(); })
                .filter(function (x) { return x.length > 0; });
            var keys = numbers.map(function (x) { return x.toUpperCase(); });
            var duplicate = keys.some(function (x, i) { return keys.indexOf(x) !== i; });
            box.classList.toggle('is-invalid', duplicate);
            count.textContent = numbers.length + (duplicate ? ' Â· @Loc["Admin.Inventory.Units.DuplicateScanned"]' : '');
        }
        box.addEventListener('input', update);
        update();
    });
    //the batches shown are those of the warehouse chosen; the others are not booked
    document.querySelectorAll('[data-grand-batches]').forEach(function (table) {
        var select = document.getElementById(table.getAttribute('data-grand-batches'));
        function show() {
            table.querySelectorAll('tr[data-warehouse]').forEach(function (row) {
                row.hidden = !!select && row.getAttribute('data-warehouse') !== select.value;
            });
        }
        if (select) select.addEventListener('change', show);
        show();
    });
</script>
