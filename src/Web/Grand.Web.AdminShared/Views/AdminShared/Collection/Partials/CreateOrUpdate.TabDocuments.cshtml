@model CollectionModel
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}
@if (!string.IsNullOrEmpty(Model.Id))
{
    <div class="panel panel-default">
        <partial name="Partials/WidgetZone.Documents.Top" model="Model"/>
        <div class="panel-body">
            <admin-grid id="collection-documents-grid"
                        read-url="@Url.Action("ListDocuments", "Document", new { reference = (int)Reference.Collection, ObjectId = Model.Id, StatusId = -1, area = area })"
                        auto-bind="false">
                <grid-column field="Number" title="@Loc["Admin.Documents.Document.Fields.Number"]">
                    <cell-template>
                        <a class="k-link" href="@Url.Action("EditDocument", "Document", new { area = area })/{{ Id }}">{{ Number }}</a>
                    </cell-template>
                </grid-column>
                <grid-column field="Name" title="@Loc["Admin.Documents.Document.Fields.Name"]">
                    <cell-template>
                        <a class="k-link" href="@Url.Action("EditDocument", "Document", new { area = area })/{{ Id }}">{{ Name }}</a>
                    </cell-template>
                </grid-column>
                <grid-column field="Published" title="@Loc["Admin.Documents.Document.Fields.Published"]" width="100" align="Center" min-screen-width="500">
                    <cell-template>
                        <i data-if="Published" class="fa fa-check" aria-hidden="true" style="color:green"></i>
                        <i data-else class="fa fa-times" aria-hidden="true" style="color:red"></i>
                    </cell-template>
                </grid-column>
            </admin-grid>
        </div>
        <div class="panel-footer">
            <button type="button" class="k-button" onclick="location.href='@Url.Action("CreateDocument", "Document", new { ObjectId = Model.Id, Reference = (int)Reference.Collection, area = area })'"><i class="fa fa-plus"></i>&nbsp;@Loc["Admin.Marketing.Document.Add"]</button>
        </div>
        <partial name="Partials/WidgetZone.Documents.Bottom" model="Model"/>
    </div>

}
else
{
    <div class="note note-info">
        @Loc["Admin.Catalog.SaveBeforeEdit"]
    </div>
}