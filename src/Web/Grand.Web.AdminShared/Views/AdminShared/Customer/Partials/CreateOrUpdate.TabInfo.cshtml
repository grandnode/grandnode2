@using Grand.Domain.Customers
@model CustomerModel
@inject IAdminDataScope<Customer> Scope

@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}
@if (Model.CountryEnabled && Model.StateProvinceEnabled)
{
    <script>
        $(document).ready(function() {
            $("#@Html.IdFor(model => model.CountryId)").change(function() {
                var selectedItem = $(this).val();
                var ddlStates = $("#@Html.IdFor(model => model.StateProvinceId)");

                var postData = {
                    countryId: selectedItem,
                    addSelectStateItem: "true"
                };

                $.ajax({
                    cache: false,
                    type: "GET",
                    url: "@(Url.Action("GetStatesByCountryId", "Home", new { area = area }))",
                    data: postData,
                    success: function(data) {
                        ddlStates.html('');
                        $.each(data, function(id, option) {
                            ddlStates.append($('<option></option>').val(option.id).html(option.name));
                        });
                    },
                    error: function(xhr, ajaxOptions, thrownError) {
                        alert('Failed to retrieve states.');
                    }
                });
            });
        });
    </script>
}
@* Cards instead of one column of 3/9 rows: the account, where the customer belongs (the main
   panel only), who the customer is, how orders are treated, and the read-only history. The
   country select keeps the CountryId / StateProvinceId ids the script above looks up. *@
<partial name="Partials/WidgetZone.InfoTop" model="Model"/>
<admin-card>
    <div class="grand-fields grand-fields--2col">
        @if (Model.UsernamesEnabled)
        {
            if (string.IsNullOrEmpty(Model.Id) || Model.AllowUsersToChangeUsernames)
            {
                <admin-field asp-for="Username"/>
            }
            else
            {
                <admin-field asp-for="Username">
                    <div class="grand-fact__value">@Model.Username</div>
                    <input asp-for="Username" type="hidden"/>
                </admin-field>
            }
        }
        <admin-field asp-for="Email"/>
        <admin-field asp-for="Password">
            <admin-input asp-for="Password" autocomplete="off"/>
        </admin-field>
        @if (Scope.DefaultStoreId is null)
        {
            ViewData["DisableIgnoreAclWarnings"] = true;
            <admin-field asp-for="CustomerGroups"/>
            <admin-field asp-for="CustomerTags"/>
        }
        <admin-field asp-for="Active"/>
        <admin-field asp-for="TwoFactorEnabled"/>
    </div>
    @if (!string.IsNullOrEmpty(Model.Id) && Model.AssociatedExternalAuthRecords.Count > 0)
    {
        <div class="grand-fields mt-3">
            <admin-field asp-for="AssociatedExternalAuthRecords">
                <admin-grid id="externalauthrecords-grid" pager="Compact"
                            data="Model.AssociatedExternalAuthRecords.Select(x => new { x.AuthMethodName, x.Email, x.ExternalIdentifier })">
                    <grid-column field="AuthMethodName" title="@Loc["Admin.Customers.Customers.AssociatedExternalAuth.Fields.AuthMethodName"]" width="100"/>
                    <grid-column field="Email" title="@Loc["Admin.Customers.Customers.AssociatedExternalAuth.Fields.Email"]" width="100"/>
                    <grid-column field="ExternalIdentifier" title="@Loc["Admin.Customers.Customers.AssociatedExternalAuth.Fields.ExternalIdentifier"]" width="300"/>
                </admin-grid>
            </admin-field>
        </div>
    }
</admin-card>
@if (Scope.DefaultStoreId is null)
{
    <admin-card>
        <div class="grand-fields grand-fields--2col">
            <admin-field asp-for="VendorId" hint="@Loc["Admin.Customers.Customers.VendorShouldBeInVendorsGroup"]"/>
            <admin-field asp-for="StaffStoreId" asp-items="Model.AvailableStores"/>
            <admin-field asp-for="StoreId" asp-items="Model.AvailableStores"/>
            <admin-field asp-for="Owner"/>
            <admin-field asp-for="SeId" asp-items="Model.AvailableSalesEmployees"/>
        </div>
    </admin-card>
}
<admin-card>
    <div class="grand-fields grand-fields--2col">
        @if (Model.GenderEnabled)
        {
            <admin-field asp-for="Gender">
                <div class="d-flex flex-wrap gap-3">
                    <div class="form-check">
                        @Html.RadioButton("Gender", "M", Model.Gender == "M", new { id = "Gender_Male", @class = "form-check-input" })
                        <label class="form-check-label" for="Gender_Male">@Loc["Admin.Customers.Customers.Fields.Gender.Male"]</label>
                    </div>
                    <div class="form-check">
                        @Html.RadioButton("Gender", "F", Model.Gender == "F", new { id = "Gender_Female", @class = "form-check-input" })
                        <label class="form-check-label" for="Gender_Female">@Loc["Admin.Customers.Customers.Fields.Gender.Female"]</label>
                    </div>
                </div>
            </admin-field>
        }
        <admin-field asp-for="FirstName"/>
        <admin-field asp-for="LastName"/>
        @if (Model.DateOfBirthEnabled)
        {
            <admin-field asp-for="DateOfBirth"/>
        }
        @if (Model.CompanyEnabled)
        {
            <admin-field asp-for="Company"/>
        }
        @if (Model.StreetAddressEnabled)
        {
            <admin-field asp-for="StreetAddress"/>
        }
        @if (Model.StreetAddress2Enabled)
        {
            <admin-field asp-for="StreetAddress2"/>
        }
        @if (Model.ZipPostalCodeEnabled)
        {
            <admin-field asp-for="ZipPostalCode" size="md"/>
        }
        @if (Model.CityEnabled)
        {
            <admin-field asp-for="City"/>
        }
        @if (Model.CountryEnabled)
        {
            <admin-field asp-for="CountryId" asp-items="Model.AvailableCountries"/>
        }
        @if (Model.CountryEnabled && Model.StateProvinceEnabled)
        {
            <admin-field asp-for="StateProvinceId" asp-items="Model.AvailableStates"/>
        }
        @if (Model.PhoneEnabled)
        {
            <admin-field asp-for="Phone"/>
        }
        @if (Model.FaxEnabled)
        {
            <admin-field asp-for="Fax"/>
        }
        @if (Model.CustomerAttributes.Count > 0)
        {
            <partial name="Partials/CustomerAttributes" model="Model.CustomerAttributes"/>
        }
    </div>
</admin-card>
<admin-card>
    <div class="grand-fields grand-fields--2col">
        <admin-field asp-for="IsTaxExempt"/>
        <admin-field asp-for="FreeShipping"/>
        @if (Model.DisplayVatNumber)
        {
            <admin-field asp-for="VatNumber" hint="@string.Format(Loc["Admin.Customers.Customers.Fields.VatNumberStatus"], Model.VatNumberStatusNote)">
                <div class="input-group">
                    <admin-input asp-for="VatNumber"/>
                    <input type="submit" name="markVatNumberAsValid" asp-action="MarkVatNumberAsValid" class="btn btn-outline-secondary" value="@Loc["Admin.Customers.Customers.Fields.VatNumber.MarkAsValid"]"/>
                    <input type="submit" name="markVatNumberAsInvalid" asp-action="MarkVatNumberAsInvalid" class="btn btn-outline-danger" value="@Loc["Admin.Customers.Customers.Fields.VatNumber.MarkAsInvalid"]"/>
                </div>
            </admin-field>
        }
        @if (Scope.DefaultStoreId is null && !string.IsNullOrEmpty(Model.AffiliateId))
        {
            <admin-field asp-for="AffiliateId">
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Edit", "Affiliate", new { id = Model.AffiliateId, area = area })"><span class="bi bi-eye"></span> @Model.AffiliateName - @Loc["Admin.Common.View"]</a>
                    <button type="submit" name="remove-affiliate" asp-action="RemoveAffiliate" class="btn btn-outline-danger btn-sm"><span class="bi bi-trash"></span> @Loc["Admin.Customers.Customers.Fields.Affiliate.Remove"]</button>
                </div>
            </admin-field>
        }
        @if (Model.AvailableNewsletterSubscriptionStores is { Count: > 0 })
        {
            <admin-field asp-for="SelectedNewsletterSubscriptionStoreIds">
                @foreach (var store in Model.AvailableNewsletterSubscriptionStores)
                {
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="newsletter-@store.Id" name="SelectedNewsletterSubscriptionStoreIds" value="@store.Id" checked="@(Model.SelectedNewsletterSubscriptionStoreIds != null && Model.SelectedNewsletterSubscriptionStoreIds.Contains(store.Id))"/>
                        <label class="form-check-label" for="newsletter-@store.Id">@store.Name</label>
                    </div>
                }
            </admin-field>
        }
    </div>
    @if (Model.AvailableNewsletterSubscriptionStores is not { Count: > 0 })
    {
        <div class="note note-info mt-3">
            @Loc["Admin.Customers.Customers.Fields.CustomerGroups.NoGroups"]
        </div>
    }
    <div class="grand-fields mt-3">
        <admin-field asp-for="AdminComment">
            <admin-textarea asp-for="AdminComment"></admin-textarea>
        </admin-field>
    </div>
</admin-card>
@if (!string.IsNullOrEmpty(Model.Id))
{
    <admin-card>
        <div class="grand-facts">
            <div>
                <admin-label asp-for="LastIpAddress" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.LastIpAddress</div>
            </div>
            <div>
                <admin-label asp-for="CreatedOn" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.CreatedOn</div>
            </div>
            <div>
                <admin-label asp-for="LastActivityDate" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.LastActivityDate</div>
            </div>
            @if (!string.IsNullOrEmpty(Model.LastVisitedPage))
            {
                <div>
                    <admin-label asp-for="LastVisitedPage" asp-display-hint="false" class="grand-fact__label"/>
                    <div class="grand-fact__value">@Model.LastVisitedPage</div>
                </div>
            }
            @if (Model.LastPurchaseDate.HasValue)
            {
                <div>
                    <admin-label asp-for="LastPurchaseDate" asp-display-hint="false" class="grand-fact__label"/>
                    <div class="grand-fact__value">@Model.LastPurchaseDate</div>
                </div>
            }
        </div>
    </admin-card>
}
<partial name="Partials/WidgetZone.InfoBottom" model="Model"/>
