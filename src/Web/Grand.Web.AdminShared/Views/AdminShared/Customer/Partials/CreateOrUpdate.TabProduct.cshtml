@model CustomerModel
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    <strong>@Html.Raw(Loc["Admin.Customers.Customers.PersonalizedProduct"])</strong>
    <div class="panel panel-default">
        <partial name="Partials/WidgetZone.ProductTop" model="Model"/>
        <div class="panel-body">
            <admin-grid id="personalizedproduct-grid"
                        read-url="@Url.Action("PersonalizedProducts", "Customer", new { customerId = Model.Id, area = area })"
                        update-url="@Url.Action("UpdatePersonalizedProduct", "Customer", new { area = area })"
                        destroy-url="@Url.Action("DeletePersonalizedProduct", "Customer", new { area = area })"
                        auto-bind="false"
                        edit-mode="Inline"
                        reload-after-save="false">
                <grid-column field="ProductName" title="@Loc["Admin.Customers.Customers.PersonalizedProduct.ProductName"]" width="300">
                    <cell-template>
                        <a href="@Url.Action("Edit", "Product", new { area = area })/{{ ProductId }}" target="_blank">{{ ProductName }}</a>
                    </cell-template>
                </grid-column>
                <grid-column field="DisplayOrder" title="@Loc["Admin.Customers.Customers.PersonalizedProduct.DisplayOrder"]" width="100" editor="Integer"/>
                <grid-commands edit="true" destroy="true" width="200"/>
            </admin-grid>
        </div>
        <div class="panel-footer">
            <a id="btnAddNewPersonalizedProduct" href="@(Url.Action("ProductAddPopup", "Customer", new { customerId = Model.Id, btnId = "btnRefreshPersonalizedProducts", formId = "customer-form", personalized = "true", area = area }))" class="k-button"><i class="fa fa-plus"></i>&nbsp;@Loc["Admin.Customers.Customers.PersonalizedProduct.AddNew"]</a>
            <input type="submit" id="btnRefreshPersonalizedProducts" style="display: none"/>
        </div>
        <partial name="Partials/WidgetZone.ProductBottom" model="Model"/>
    </div>
    <script>
    $(document).ready(function () {
             $('#btnAddNewPersonalizedProduct').magnificPopup({
                    type: 'ajax',
                    settings: { cache: false, async: false },
                    midClick: true,
                    callbacks: {
                        parseAjax: function (mfpResponse) {
                            mfpResponse.data = $('<div></div>').html(mfpResponse.data);
                        },
                        ajaxContentAdded: function () {
                            $('.mfp-wrap').removeAttr('tabindex');
                        }
                    }
             });
        });
</script>
    <script>
            $(document).ready(function () {
                $('#btnRefreshPersonalizedProducts').click(function () {
                    //refresh grid
                    var grid = $("#personalizedproduct-grid").data('kendoGrid');
                    grid.dataSource.read();

                    //return false to don't reload a page
                    return false;
                });
            });
    </script>
}
