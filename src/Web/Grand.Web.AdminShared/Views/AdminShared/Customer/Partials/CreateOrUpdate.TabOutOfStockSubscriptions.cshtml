@model CustomerModel
@inject AdminAreaSettings adminAreaSettings
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    <div class="panel panel-default">
        <partial name="Partials/WidgetZone.BackInStockTop" model="Model"/>
        <div class="panel-body">
            <admin-grid id="outofstock-subscriptions-grid"
                        read-url="@Url.Action("OutOfStockSubscriptionList", "Customer", new { customerId = Model.Id, area = area })"
                        auto-bind="false">
                @if (area == "Admin" && !adminAreaSettings.HideStoreColumn)
                {
                    <grid-column field="StoreName" title="@Loc["Admin.Customers.Customers.OutOfStockSubscriptions.Store"]" width="200"/>
                }
                <grid-column field="ProductId" title="@Loc["Admin.Customers.Customers.OutOfStockSubscriptions.Product"]" width="300">
                    <cell-template>
                        <a href="@Url.Action("Edit", "Product", new { area = area })/{{ ProductId }}">{{ ProductName }}</a>
                    </cell-template>
                </grid-column>
                <grid-column field="CreatedOn" title="@Loc["Admin.Customers.Customers.OutOfStockSubscriptions.CreatedOn"]" width="200" format="{0:G}"/>
            </admin-grid>
        </div>
        <partial name="Partials/WidgetZone.BackInStockBottom" model="Model"/>
    </div>
}
