@model ProductAttributeModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Catalog.Attributes.ProductAttributes.EditAttributeDetails"];
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}
<form asp-area="@area" asp-controller="ProductAttribute" asp-action="Edit" method="post" id="productattribute-form">

    <div class="row">
        <div class="col-md-12">
            <div class="x_panel light form-fit">
                <div class="x_title">
                    <div class="caption">
                        <i class="bi bi-card-list"></i>
                        @Loc["Admin.Catalog.Attributes.ProductAttributes.EditAttributeDetails"] - @Model.Name
                        <small>
                            <i class="bi bi-arrow-left-circle"></i>@Html.ActionLink(Loc["Admin.Catalog.Attributes.ProductAttributes.BackToList"], "List")
                        </small>
                    </div>
                    <div class="actions">
                        <div class="btn-group btn-group-devided util-btn-margin-bottom-5">
                            <button class="btn btn-success" type="submit" name="save">
                                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
                            </button>
                            <button class="btn btn-success" type="submit" name="save-continue">
                                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
                            </button>
                            <span id="productattribute-delete" class="btn red">
                                <i class="bi bi-trash"></i> @Loc["Admin.Common.Delete"]
                            </span>
                            <partial name="Partials/WidgetZone.DetailsButtons" model="Model"/>
                        </div>
                    </div>
                </div>
                <div class="x_content form">
                    <partial name="Partials/CreateOrUpdate" model="Model"/>
                </div>
            </div>
        </div>
    </div>
</form>
<admin-delete-confirmation button-id="productattribute-delete"/>