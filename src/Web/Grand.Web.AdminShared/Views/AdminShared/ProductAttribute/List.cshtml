@{
    //page title
    ViewBag.Title = Loc["Admin.Catalog.Attributes.ProductAttributes"];
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}

<div class="row">
    <div class="col-md-12">
        <div class="x_panel light form-fit">
            <div class="x_title">
                <div class="caption">
                    <i class="fa fa-list-alt"></i>
                    @Loc["Admin.Catalog.Attributes.ProductAttributes"]
                </div>
                <div class="actions btn-group btn-group-devided">
                    <a href="@Url.Action("Create", new { area })" class="btn green">
                        <i class="fa fa-plus"></i><span class="d-none d-sm-inline"> @Loc["Admin.Common.AddNew"] </span>
                    </a>
                    <partial name="Partials/WidgetZone.ListButtons"/>
                </div>
            </div>
            <div class="x_content form">
                <div class="form-horizontal">
                    <div class="form-body">
                        <div class="x_content">
                            <admin-grid id="productattributes-grid" read-url="@Url.Action("List", "ProductAttribute", new { area })">
                                <grid-column field="Name" title="@Loc["Admin.Catalog.Attributes.ProductAttributes.Fields.Name"]">
                                    <cell-template>
                                        <a class="k-link" href="Edit/{{ Id }}">{{ Name }}</a>
                                    </cell-template>
                                </grid-column>
                            </admin-grid>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
