@using Microsoft.AspNetCore.Mvc.Razor
@model PredefinedProductAttributeValueModel

<div asp-validation-summary="All"></div>
<input asp-for="Id" type="hidden"/>
<input asp-for="ProductAttributeId" type="hidden"/>

<partial name="Partials/WidgetZone.Value.Top" model="Model"/>

@{
    Func<int, HelperResult>
        template = @<div class="grand-fields">
                       <admin-field asp-for="@Model.Locales[item].Name"/>
                       <input asp-for="@Model.Locales[item].LanguageId" type="hidden"/>
                   </div>;
}

@* the product's attribute value popup, minus what a predefined value does not know about yet *@
<localized-editor localized-template="@template" name="productattributevalue-localized" language-ids="@Model.Locales.Select(c => c.LanguageId).ToList()">
    <div class="grand-fields">
        <admin-field asp-for="Name"/>
    </div>
</localized-editor>

<div class="grand-fields grand-fields--2col">
    <admin-field asp-for="PriceAdjustment" size="md"/>
    <admin-field asp-for="WeightAdjustment" size="md"/>
    <admin-field asp-for="Cost" size="md"/>
    <admin-field asp-for="DisplayOrder" size="sm"/>
    <admin-field asp-for="IsPreSelected"/>
</div>
<partial name="Partials/WidgetZone.Value.Bottom" model="Model"/>
<div class="grand-popup__actions">
    <partial name="Partials/WidgetZone.ValueButtons"/>
    <button class="btn btn-primary" type="submit" name="save">
        <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
    </button>
</div>
