@model ProductAttributeModel
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    if (!string.IsNullOrEmpty(Model.Id))
    {
        <div class="panel panel-default">
            <partial name="Partials/WidgetZone.PredefinedValues.Top" model="Model"/>
            <div class="panel-body">
                <admin-grid id="productattributevalues-grid"
                            read-url="@Url.Action("PredefinedProductAttributeValueList", "ProductAttribute", new { productAttributeId = Model.Id, area })"
                            destroy-url="@Url.Action("PredefinedProductAttributeValueDelete", "ProductAttribute", new { area })"
                            pager="Compact"
                            confirm-destroy="true"
                            on-data-bound="bindPredefinedValuePopups">
                    <grid-column field="Name" title="@Loc["Admin.Catalog.Attributes.ProductAttributes.PredefinedValues.Fields.Name"]" width="200">
                        <cell-template>
                            <a class='k-link editvalue' href="@Url.Action("PredefinedProductAttributeValueEditPopup", "ProductAttribute", new { area })/{{ Id }}?productAttributeId=@Model.Id">{{ Name }}</a>
                        </cell-template>
                    </grid-column>
                    <grid-column field="PriceAdjustmentStr" title="@Loc["Admin.Catalog.Attributes.ProductAttributes.PredefinedValues.Fields.PriceAdjustment"]" width="150"/>
                    <grid-column field="WeightAdjustmentStr" title="@Loc["Admin.Catalog.Attributes.ProductAttributes.PredefinedValues.Fields.WeightAdjustment"]" width="150"/>
                    <grid-column field="IsPreSelected" title="@Loc["Admin.Catalog.Attributes.ProductAttributes.PredefinedValues.Fields.IsPreSelected"]" width="100" align="Center">
                        <cell-template>
                            <i data-if="IsPreSelected" class="fa fa-check" aria-hidden="true" style="color:green"></i>
                            <i data-else class="fa fa-times" aria-hidden="true" style="color:red"></i>
                        </cell-template>
                    </grid-column>
                    <grid-column field="DisplayOrder" title="@Loc["Admin.Catalog.Attributes.ProductAttributes.PredefinedValues.Fields.DisplayOrder"]" width="100"/>
                    <grid-commands destroy="true" title="@Loc["Admin.Common.Delete"]" width="200"/>
                </admin-grid>
            </div>
            <div class="panel-footer">
                <a id="btnAddNewValue" href="@(Url.Action("PredefinedProductAttributeValueCreatePopup", "ProductAttribute", new { productAttributeId = Model.Id, area }))" class="k-button"><i class="fa fa-plus"></i>&nbsp;@Loc["Admin.Catalog.Attributes.ProductAttributes.PredefinedValues.AddNew"]</a>
                <input type="submit" id="btnRefresh" style="display:none"/>
            </div>
            <partial name="Partials/WidgetZone.PredefinedValues.Bottom" model="Model"/>
        </div>
        <script>
            $(document).ready(function() {
                $('#btnAddNewValue').magnificPopup({
                        type: 'ajax',
                        settings: { cache: false, async: false },
                        midClick: true,
                        callbacks: {
                            parseAjax: function (mfpResponse) {
                                mfpResponse.data = $('<div></div>').html(mfpResponse.data);
                            },
                            ajaxContentAdded: function () {
                                $('.mfp-wrap').removeAttr('tabindex');
                            }
                        }
                });

                $('#btnRefresh').click(function () {
                    //refresh grid
                    var grid = $("#productattributevalues-grid").data('kendoGrid');
                    grid.dataSource.read();

                    //return false to don't reload a page
                    return false;
                });
            });
            function bindPredefinedValuePopups() {
                $('.editvalue').magnificPopup({
                    type: 'ajax',
                    settings: { cache: false, async: false },
                    midClick: true,
                    callbacks: {
                        parseAjax: function (mfpResponse) {
                            mfpResponse.data = $('<div></div>').html(mfpResponse.data);
                        },
                        ajaxContentAdded: function () {
                            $('.mfp-wrap').removeAttr('tabindex');
                        }
                    }
                });
            }
        </script>
    }
    else
    {
        <div class="note note-info">
            @Loc["Admin.Catalog.Attributes.ProductAttributes.PredefinedValues.SaveBeforeEdit"]
        </div>
    }
}