@model ProductAttributeModel
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    <div class="grand-card">
        <partial name="Partials/WidgetZone.UsedByProducts.Top" model="Model"/>
        <div class="grand-card__body grand-card__body--flush">
            <admin-grid id="used-by-products-grid" read-url="@Url.Action("UsedByProducts", "ProductAttribute", new { productAttributeId = Model.Id, area })">
                <grid-column field="ProductName" title="@Loc["Admin.Catalog.Attributes.ProductAttributes.UsedByProducts.Product"]" width="400">
                    <cell-template>
                        <a class="text-decoration-none" href="@Url.Action("Edit", "Product", new { area })/{{ Id }}">{{ ProductName }}</a>
                    </cell-template>
                </grid-column>
                <grid-column field="Published" title="@Loc["Admin.Catalog.Attributes.ProductAttributes.UsedByProducts.Published"]" width="100" align="Center">
                    <cell-template>
                        <i data-if="Published" class="bi bi-check-lg text-success" aria-hidden="true"></i>
                        <i data-else class="bi bi-x-lg text-danger" aria-hidden="true"></i>
                    </cell-template>
                </grid-column>
            </admin-grid>
        </div>
        <partial name="Partials/WidgetZone.UsedByProducts.Bottom" model="Model"/>
    </div>
}