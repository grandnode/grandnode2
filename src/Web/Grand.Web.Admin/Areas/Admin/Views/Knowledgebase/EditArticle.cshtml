@model KnowledgebaseArticleModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Content.Knowledgebase.KnowgledgebaseArticle.EditKnowgledgebaseArticle"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Knowledgebase" asp-action="EditArticle" method="post" id="article-form">

    <div class="row">
        <div class="col-md-12">
            <div class="x_panel light form-fit">
                <div class="x_title">
                    <div class="caption">
                        <i class="bi bi-chat-square-text"></i>
                        @Loc["Admin.Content.Knowledgebase.KnowgledgebaseArticle.EditKnowgledgebaseArticle"]
                        <small>
                            <i class="bi bi-arrow-left-circle"></i> @Html.ActionLink(Loc["Admin.Content.Knowledgebase.KnowgledgebaseArticle.BackToList"], "List")
                        </small>
                    </div>
                    <div class="actions">
                        <div class="btn-group btn-group-devided">
                            <button type="button" onclick="window.open('@Url.RouteUrl("KnowledgebaseArticle", new { Model.SeName })','_blank');" class="btn purple">
                                <i class="bi bi-eye"></i>
                                @Loc["Admin.Common.Preview"]
                            </button>
                            <button class="btn btn-success" type="submit" name="save">
                                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
                            </button>
                            <button class="btn btn-success" type="submit" name="save-continue">
                                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
                            </button>
                            <span id="knowledgebasearticle-delete" class="btn red">
                                <i class="bi bi-trash"></i> @Loc["Admin.Common.Delete"]
                            </span>
                        </div>
                    </div>
                </div>
                <div class="x_content form">
                    <partial name="Partials/CreateOrUpdateArticle" model="Model"/>
                </div>
            </div>
        </div>
    </div>
</form>
<admin-delete-confirmation button-id="knowledgebasearticle-delete" action-name="DeleteArticle"/>