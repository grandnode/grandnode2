@model KnowledgebaseCategoryModel
@if (!string.IsNullOrEmpty(Model.Id))
{
    <div class="panel panel-default">
        <div class="panel-body">
            <admin-grid id="articles-grid" read-url="@Url.Action("ArticleList", "Knowledgebase", new { parentCategoryId = Model.Id, area = Constants.AreaAdmin })">
                <grid-column field="Name" title="@Loc["Admin.Content.Knowledgebase.KnowledgebaseArticle.Fields.Name"]" width="400">
                    <cell-template>
                        <a class="k-link" href="@Url.Action("EditArticle", "Knowledgebase", new { area = Constants.AreaAdmin })/{{ ArticleId }}">{{ Name }}</a>
                    </cell-template>
                </grid-column>
                <grid-column field="Published" title="@Loc["Admin.Content.Knowledgebase.KnowledgebaseArticle.Fields.Published"]" width="50" align="Center">
                    <cell-template>
                        <i data-if="Published" class="fa fa-check" aria-hidden="true" style="color:green"></i>
                        <i data-else class="fa fa-times" aria-hidden="true" style="color:red"></i>
                    </cell-template>
                </grid-column>
                <grid-column field="DisplayOrder" title="@Loc["Admin.Content.Knowledgebase.KnowledgebaseArticle.Fields.DisplayOrder"]" width="50" format="{0:0}"/>
            </admin-grid>
        </div>
        <div class="panel-footer">
            <button type="button" id="btnAddNewArticle" onclick="window.location.href='@(Url.Action("CreateArticle", "Knowledgebase", new { parentCategoryId = Model.Id, area = Constants.AreaAdmin }))'" class="k-button"><i class="fa fa-plus"></i>&nbsp;@Loc["Admin.Content.Knowledgebase.CreateKnowledgebaseArticle"]</button>
            <input type="submit" id="btnRefreshArticles" style="display: none"/>
        </div>
    </div>
    <script>
        $(document).ready(function () {
            $('#btnRefreshArticles').click(function () {
                //refresh grid
                var grid = $("#articles-grid").data('kendoGrid');
                grid.dataSource.read();

                //return false to don't reload a page
                return false;
            });
        });
    </script>
}
else
{
    <div class="note note-info">
        @Loc["Admin.Content.Knowledgebase.KnowledgebaseCategory.SaveBeforeEdit"]
    </div>
}