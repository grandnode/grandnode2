@model KnowledgebaseCategoryModel
@if (!string.IsNullOrEmpty(Model.Id))
{
    <div class="grand-card">
        <div class="grand-card__header">
            <h2 class="grand-card__title">@Loc["Admin.Content.Knowledgebase.KnowledgebaseCategory.Articles"]</h2>
            <button type="button" id="btnAddNewArticle" onclick="window.location.href='@(Url.Action("CreateArticle", "Knowledgebase", new { parentCategoryId = Model.Id, area = Constants.AreaAdmin }))'" class="btn btn-outline-secondary btn-sm"><i class="bi bi-plus-lg"></i> @Loc["Admin.Content.Knowledgebase.CreateKnowledgebaseArticle"]</button>
            <input type="submit" id="btnRefreshArticles" style="display: none"/>
        </div>
        <div class="grand-card__body grand-card__body--flush">
            <admin-grid id="articles-grid" read-url="@Url.Action("ArticleList", "Knowledgebase", new { parentCategoryId = Model.Id, area = Constants.AreaAdmin })">
                <grid-column field="Name" title="@Loc["Admin.Content.Knowledgebase.KnowledgebaseArticle.Fields.Name"]" width="400">
                    <cell-template>
                        <a class="text-decoration-none" href="@Url.Action("EditArticle", "Knowledgebase", new { area = Constants.AreaAdmin })/{{ ArticleId }}">{{ Name }}</a>
                    </cell-template>
                </grid-column>
                <grid-column field="Published" title="@Loc["Admin.Content.Knowledgebase.KnowledgebaseArticle.Fields.Published"]" width="50" align="Center">
                    <cell-template>
                        <i data-if="Published" class="bi bi-check-lg text-success" aria-hidden="true"></i>
                        <i data-else class="bi bi-x-lg text-danger" aria-hidden="true"></i>
                    </cell-template>
                </grid-column>
                <grid-column field="DisplayOrder" title="@Loc["Admin.Content.Knowledgebase.KnowledgebaseArticle.Fields.DisplayOrder"]" width="50" format="{0:0}"/>
            </admin-grid>
        </div>
    </div>
    <script>
        $(document).ready(function () {
            $('#btnRefreshArticles').click(function () {
                //refresh grid
                var grid = $("#articles-grid").data('kendoGrid');
                grid.dataSource.read();

                //return false to don't reload a page
                return false;
            });
        });
    </script>
}
else
{
    <div class="note note-info">
        @Loc["Admin.Content.Knowledgebase.KnowledgebaseCategory.SaveBeforeEdit"]
    </div>
}
