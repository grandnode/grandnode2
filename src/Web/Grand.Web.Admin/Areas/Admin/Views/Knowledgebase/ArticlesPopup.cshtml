@model KnowledgebaseArticleModel.AddRelatedArticleModel
@{
    ViewBag.Title = Loc["Admin.Content.Knowledgebase.KnowledgebaseArticle.Related.AddNew"];
    Layout = "";
}
<form id="ArticlesPopup" asp-area="@Constants.AreaAdmin" asp-controller="Knowledgebase" asp-action="ArticlesPopup" method="post"
      asp-route-KnowledgebaseId="@HtmlExtensions.HtmlEncodeSafe(Context.Request.Query["KnowledgebaseId"])"
      asp-route-btnId="@HtmlExtensions.HtmlEncodeSafe(Context.Request.Query["btnId"])"
      asp-route-formId="@HtmlExtensions.HtmlEncodeSafe(Context.Request.Query["formId"])">

    <input asp-for="ArticleId" type="hidden"/>
    <div class="row">
        <div class="col-md-12">
            <div class="x_panel light form-fit">
                <div class="x_title">
                    <div class="caption">
                        <i class="fa fa-cubes"></i>
                        @Loc["Admin.Content.Knowledgebase.KnowledgebaseArticle.Related.AddNew"]
                    </div>
                </div>
                <div class="x_content form">
                    <div class="form-horizontal">
                        <div class="form-body">
                            <div class="main-header col-12 px-0 mb-3">
                                <div class="row align-items-end">
                                    <div class="col-md-8 col-sm-12 col-12">
                                        <div class="mb-0">
                                            <admin-label asp-for="SearchArticleName" class="control-label"/>
                                            <admin-input asp-for="SearchArticleName"/>
                                        </div>
                                    </div>
                                    <div class="col-md-4 col-sm-12 col-12">
                                        <div class="form-actions">
                                            <div class="btn-group btn-group-sm btn-group-devided">
                                                <button class="btn btn-success filter-submit" id="search-articles">
                                                    <i class="fa fa-search"></i> @Loc["Admin.Common.Search"]
                                                </button>
                                                <button class="btn btn-success" type="submit" name="save">
                                                    <i class="fa fa-check"></i> @Loc["Admin.Common.Save"]
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <admin-grid id="articles-grid"
                                        read-url="@Url.Action("RelatedArticlesAddPopupList", "Knowledgebase", new { area = Constants.AreaAdmin })"
                                        additional-data="additionalData"
                                        selectable="Checkbox"
                                        selection-name="SelectedArticlesIds">
                                <grid-column field="Name" title="@Loc["Admin.Content.Knowledgebase.KnowledgebaseArticle.Fields.Name"]"/>
                                <grid-column field="Published" title="@Loc["Admin.Content.Knowledgebase.KnowledgebaseArticle.Fields.Published"]" width="100" align="Center">
                                    <cell-template>
                                        <i data-if="Published" class="fa fa-check" aria-hidden="true" style="color:green"></i>
                                        <i data-else class="fa fa-times" aria-hidden="true" style="color:red"></i>
                                    </cell-template>
                                </grid-column>
                            </admin-grid>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script>
        var mfp = $.magnificPopup.instance;
        $("#ArticlesPopup").submit(function (e) {
            e.preventDefault();
            var form = $(this);
            var url = form.attr('action');
            $.ajax({
                type: "POST",
                url: url,
                data: form.serialize(),
                success: function (data) {
                    if (data == "") {
                        mfp.close();
                        $('#btnRefreshRelatedArticles').click();
                    } else {
                        $.magnificPopup.open({
                            items: {
                                src: data,
                                type: 'inline'
                            },
                            callbacks: {
                                open: function () {
                                    $('.mfp-wrap').removeAttr('tabindex');
                                }
                            }
                        });
                    }
                }
            });
        });


            $('#search-articles').click(function () {
                var grid = $('#articles-grid').data('kendoGrid');
                grid.dataSource.page(1); //new search. Set page size to 1
                //grid.dataSource.read(); we already loaded the grid above using "page" function
                grid.clearSelection();
                return false;
            });

            $("#@Html.IdFor(model => model.SearchArticleName)").keydown(function (event) {
                if (event.keyCode == 13) {
                    $("#search-articles").click();
                    return false;
                }
            });


        function additionalData() {
            var data = {
                SearchArticleName: $('#@Html.IdFor(model => model.SearchArticleName)').val(),
            };

            addAntiForgeryToken(data);
            return data;
        }

    </script>
</form>