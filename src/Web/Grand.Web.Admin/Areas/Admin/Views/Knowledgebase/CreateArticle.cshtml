@model KnowledgebaseArticleModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Content.Knowledgebase.KnowgledgebaseArticle.CreateKnowgledgebaseArticle"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Knowledgebase" asp-action="CreateArticle" method="post">

    @* the same shell as EditArticle, minus what an article that does not exist yet cannot offer *@
    <admin-page sticky
                title="@Loc["Admin.Content.Knowledgebase.KnowgledgebaseArticle.CreateKnowgledgebaseArticle"]"
                icon="bi-chat-square-text"
                back-url="@Url.Action("List")"
                back-text="@Loc["Admin.Content.Knowledgebase.KnowgledgebaseArticle.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
        </page-actions>

        <partial name="Partials/CreateOrUpdateArticle" model="Model"/>
    </admin-page>
</form>
