@model KnowledgebaseCategoryModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Content.Knowledgebase.KnowgledgebaseCategory.EditKnowgledgebaseCategory"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Knowledgebase" asp-action="EditCategory" method="post">

    @* the product edit screen's shell: the category name as the title, Save as the one primary
       action, and Delete in the overflow menu rather than beside Save *@
    <admin-page sticky
                title="@Model.Name"
                icon="bi-chat-square-text"
                meta="@Loc["Admin.Content.Knowledgebase.KnowgledgebaseCategory.EditKnowgledgebaseCategory"]"
                back-url="@Url.Action("List")"
                back-text="@Loc["Admin.Content.Knowledgebase.KnowgledgebaseCategory.BackToList"]">
        <page-actions>
            <button type="button" onclick="window.open('@Url.RouteUrl("KnowledgebaseCategory", new { Model.SeName })','_blank');" class="btn btn-outline-secondary">
                <i class="bi bi-eye"></i> @Loc["Admin.Common.Preview"]
            </button>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <admin-action-menu>
                <admin-action id="knowledgebasecategory-delete" destructive="true" icon="bi-trash"
                              text="@Loc["Admin.Common.Delete"]"/>
            </admin-action-menu>
        </page-actions>

        <partial name="Partials/CreateOrUpdateCategory" model="Model"/>
    </admin-page>
</form>
<admin-delete-confirmation button-id="knowledgebasecategory-delete" action-name="DeleteCategory"/>
