@{
    //page title
    ViewBag.Title = Loc["Admin.Configuration.Payment.Methods"];
}

<div class="row">
    <div class="col-md-12">
        <div class="x_panel light form-fit">
            <div class="x_title">
                <div class="caption level-caption">
                    <i class="fa fa-money"></i>
                    @Loc["Admin.Configuration.Payment.Methods"]
                </div>
            </div>
            <div class="x_content">
                <div class="form-horizontal">
                    <div class="form-body">
                        @await Component.InvokeAsync("StoreScope")
                    </div>
                </div>
            </div>
            <div class="x_content form">
                <vc:admin-widget widget-zone="payment_method_list_top" additional-data="Model"/>
                <admin-grid id="paymentmethods-grid"
                            key="SystemName"
                            read-url="@Url.Action("Methods", "Payment", new { area = Constants.AreaAdmin })"
                            update-url="@Url.Action("MethodUpdate", "Payment", new { area = Constants.AreaAdmin })"
                            pager="Compact"
                            edit-mode="Inline">
                    <grid-column field="FriendlyName" title="@Loc["Admin.Configuration.Payment.Methods.Fields.FriendlyName"]">
                        <cell-template>
                            <a class="k-link" href="{{ ConfigurationUrl }}">{{ FriendlyName }}</a>
                        </cell-template>
                    </grid-column>
                    <grid-column field="SystemName" title="@Loc["Admin.Configuration.Payment.Methods.Fields.SystemName"]">
                        <cell-template>
                            <a class="k-link" href="{{ ConfigurationUrl }}">{{ SystemName }}</a>
                        </cell-template>
                    </grid-column>
                    <grid-column field="SupportCapture" title="@Loc["Admin.Configuration.Payment.Methods.Fields.SupportCapture"]" align="Center">
                        <cell-template>
                            <i data-if="SupportCapture" class="fa fa-check" aria-hidden="true" style="color:green"></i>
                            <i data-else class="fa fa-times" aria-hidden="true" style="color:red"></i>
                        </cell-template>
                    </grid-column>
                    <grid-column field="SupportRefund" title="@Loc["Admin.Configuration.Payment.Methods.Fields.SupportRefund"]" align="Center">
                        <cell-template>
                            <i data-if="SupportRefund" class="fa fa-check" aria-hidden="true" style="color:green"></i>
                            <i data-else class="fa fa-times" aria-hidden="true" style="color:red"></i>
                        </cell-template>
                    </grid-column>
                    <grid-column field="SupportPartiallyRefund" title="@Loc["Admin.Configuration.Payment.Methods.Fields.SupportPartiallyRefund"]" align="Center">
                        <cell-template>
                            <i data-if="SupportPartiallyRefund" class="fa fa-check" aria-hidden="true" style="color:green"></i>
                            <i data-else class="fa fa-times" aria-hidden="true" style="color:red"></i>
                        </cell-template>
                    </grid-column>
                    <grid-column field="SupportVoid" title="@Loc["Admin.Configuration.Payment.Methods.Fields.SupportVoid"]" align="Center">
                        <cell-template>
                            <i data-if="SupportVoid" class="fa fa-check" aria-hidden="true" style="color:green"></i>
                            <i data-else class="fa fa-times" aria-hidden="true" style="color:red"></i>
                        </cell-template>
                    </grid-column>
                    <grid-column field="DisplayOrder" title="@Loc["Admin.Configuration.Payment.Methods.Fields.DisplayOrder"]" format="{0:0}"/>
                    <grid-column field="IsActive" title="@Loc["Admin.Configuration.Payment.Methods.Fields.IsActive"]" align="Center" editor="Checkbox">
                        <cell-template>
                            <i data-if="IsActive" class="fa fa-check" aria-hidden="true" style="color:green"></i>
                            <i data-else class="fa fa-times" aria-hidden="true" style="color:red"></i>
                        </cell-template>
                    </grid-column>
                    <grid-commands edit="true" title="@Loc["Admin.Common.Edit"]" width="150"/>
                </admin-grid>
                <vc:admin-widget widget-zone="payment_method_list_bottom" additional-data="Model"/>
            </div>
        </div>
    </div>
</div>
