@model ContactFormModel
@{
    //page title
    ViewBag.Title = Loc["Admin.System.ContactForm.Details"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="ContactForm" asp-action="Details" method="post">

    @* a read-only record: who wrote and when as facts, the subject and the message in a card of their own,
       and Delete - the only action - in the overflow menu *@
    <input asp-for="Id" type="hidden"/>
    <admin-page title="@Loc["Admin.System.ContactForm.Details"]"
                icon="bi-envelope"
                back-url="@Url.Action("List")"
                back-text="@Loc["Admin.System.ContactForm.BackToList"]">
        <page-actions>
            <admin-action-menu>
                <admin-action id="contactform-delete" destructive="true" icon="bi-trash"
                              text="@Loc["Admin.Common.Delete"]"/>
            </admin-action-menu>
        </page-actions>

        <vc:admin-widget widget-zone="contact_form_details_top" additional-data="Model"/>
        <admin-card>
            <div class="grand-facts">
                <div>
                    <admin-label asp-for="CreatedOn" asp-display-hint="false" class="grand-fact__label"/>
                    <div class="grand-fact__value">@Model.CreatedOn</div>
                </div>
                <div>
                    <admin-label asp-for="Email" asp-display-hint="false" class="grand-fact__label"/>
                    <div class="grand-fact__value">@Model.FullName - @Model.Email</div>
                </div>
                <div>
                    <admin-label asp-for="IpAddress" asp-display-hint="false" class="grand-fact__label"/>
                    <div class="grand-fact__value">@Model.IpAddress</div>
                </div>
                <div>
                    <admin-label asp-for="Store" asp-display-hint="false" class="grand-fact__label"/>
                    <div class="grand-fact__value">@Model.Store</div>
                </div>
                <div>
                    <admin-label asp-for="EmailAccountName" asp-display-hint="false" class="grand-fact__label"/>
                    <div class="grand-fact__value">@Model.EmailAccountName</div>
                </div>
            </div>
        </admin-card>
        <admin-card>
            <div class="grand-facts">
                <div>
                    <admin-label asp-for="Subject" asp-display-hint="false" class="grand-fact__label"/>
                    <div class="grand-fact__value">@Model.Subject</div>
                </div>
                <div>
                    <admin-label asp-for="Enquiry" asp-display-hint="false" class="grand-fact__label"/>
                    <div class="grand-fact__value">@Html.Raw(Model.Enquiry)</div>
                </div>
                <div>
                    <admin-label asp-for="ContactAttributeDescription" asp-display-hint="false" class="grand-fact__label"/>
                    <div class="grand-fact__value">@Html.Raw(Model.ContactAttributeDescription)</div>
                </div>
            </div>
        </admin-card>
        <vc:admin-widget widget-zone="contact_form_details_bottom" additional-data="Model"/>
    </admin-page>
</form>
<admin-delete-confirmation button-id="contactform-delete"/>