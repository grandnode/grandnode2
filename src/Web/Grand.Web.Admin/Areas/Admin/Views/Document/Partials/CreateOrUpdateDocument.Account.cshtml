@model DocumentModel
<vc:admin-widget widget-zone="document_details_account_top" additional-data="Model"/>
@* the account side of the document: who it is for, the amounts in its currency, its dates *@
<admin-card>
    <div class="grand-fields grand-fields--2col">
        <admin-field asp-for="CustomerEmail"/>
        <admin-field asp-for="Username"/>
        <admin-field asp-for="CurrencyCode" size="sm"/>
        <admin-field asp-for="Quantity" size="sm"/>
        <admin-field asp-for="TotalAmount" size="md"/>
        <admin-field asp-for="OutstandAmount" size="md"/>
        <admin-field asp-for="DocDate"/>
        <admin-field asp-for="DueDate"/>
    </div>
</admin-card>
<vc:admin-widget widget-zone="document_details_account_bottom" additional-data="Model"/>
