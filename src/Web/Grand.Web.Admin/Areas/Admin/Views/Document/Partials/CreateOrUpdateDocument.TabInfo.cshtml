@using Grand.Domain.Media
@model DocumentModel
@{
    ViewData["DownloadType"] = DownloadType.Document;
    ViewData["ReferenceId"] = Model.Id;
}
<vc:admin-widget widget-zone="document_details_info_top" additional-data="Model"/>
@* What the document is, then where it belongs and who sees it, then its files. The object id
   sits under the reference it is revealed by; its .object-reference class is what the script in
   CreateOrUpdateDocument toggles. *@
<admin-card>
    <div class="grand-fields grand-fields--2col">
        <admin-field asp-for="Number"/>
        <admin-field asp-for="Name"/>
        <admin-field asp-for="DocumentTypeId" asp-items="Model.AvailableDocumentTypes"/>
        <admin-field asp-for="StatusId" size="md" asp-items="EnumTranslationService.ToSelectList((DocumentStatus)Model.StatusId)"/>
        <admin-field asp-for="SeId" asp-items="Model.AvailableSelesEmployees"/>
        <admin-field asp-for="Link"/>
    </div>
    <div class="grand-fields mt-3">
        <admin-field asp-for="Description">
            <admin-input asp-for="Description" asp-template="Editor"/>
        </admin-field>
    </div>
</admin-card>
<admin-card>
    <div class="grand-fields grand-fields--2col">
        <div class="grand-reveal">
            <admin-field asp-for="ReferenceId" size="md" asp-items="EnumTranslationService.ToSelectList((Reference)Model.ReferenceId)"/>
            <div class="grand-reveal__body grand-fields grand-fields--2col">
                <admin-field asp-for="ObjectId" class="object-reference"/>
            </div>
        </div>
        <admin-field asp-for="Published"/>
        <admin-field asp-for="DisplayOrder" size="sm"/>
        <admin-field asp-for="CustomerGroups"/>
        <admin-field asp-for="Stores"/>
        <admin-field asp-for="Flag"/>
    </div>
</admin-card>
<admin-card>
    <div class="grand-fields grand-fields--2col">
        <admin-field asp-for="DownloadId">
            <admin-input asp-for="DownloadId"/>
        </admin-field>
        @{
            ViewData["Reference"] = "Document";
            ViewData["ObjectId"] = Model.Id;
        }
        <admin-field asp-for="PictureId">
            <admin-input asp-for="PictureId"/>
        </admin-field>
    </div>
</admin-card>
<vc:admin-widget widget-zone="document_details_info_bottom" additional-data="Model"/>
