@model DocumentTypeModel

<div asp-validation-summary="All"></div>
<input asp-for="Id" type="hidden"/>

<admin-card>
    <div class="grand-fields grand-fields--2col">
        <admin-field asp-for="Name"/>
        <admin-field asp-for="DisplayOrder" size="sm"/>
    </div>
    <div class="grand-fields mt-3">
        <admin-field asp-for="Description">
            <admin-input asp-for="Description" asp-template="Editor"/>
        </admin-field>
    </div>
</admin-card>
