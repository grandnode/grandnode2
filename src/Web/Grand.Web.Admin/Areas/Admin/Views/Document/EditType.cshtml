@model DocumentTypeModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Documents.Type.Edit"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Document" asp-action="EditType" method="post">

    @* the product edit screen's shell: the type's name as the title, Save as the one primary
       action, and Delete in the overflow menu rather than beside Save *@
    <admin-page sticky
                title="@Model.Name"
                icon="bi-tag"
                meta="@Loc["Admin.Documents.Type.Edit"]"
                back-url="@Url.Action("Types")"
                back-text="@Loc["Admin.Documents.Type.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <admin-action-menu>
                <admin-action id="documentType-delete" destructive="true" icon="bi-trash"
                              text="@Loc["Admin.Common.Delete"]"/>
            </admin-action-menu>
            <vc:admin-widget widget-zone="document_type_details_buttons" additional-data="Model"/>
        </page-actions>

        <partial name="Partials/CreateOrUpdateType" model="Model"/>
    </admin-page>
</form>

<admin-delete-confirmation button-id="documentType-delete" action-name="DeleteType"/>
