@{
    //page title
    ViewBag.Title = Loc["Admin.Documents.Type"];
}

@* The product list's shape without filters: Add new as the one primary action in the page header
   and the grid in a flush card. *@
<admin-page title="@Loc["Admin.Documents.Type"]" icon="bi-tags">
    <page-actions>
        <a href="@Url.Action("CreateType", new { area = Constants.AreaAdmin })" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> @Loc["Admin.Common.AddNew"]
        </a>
    </page-actions>

    <admin-card flush>
        <admin-grid id="types-grid"
                    read-url="@Url.Action("ListType", "Document", new { area = Constants.AreaAdmin })"
                    pager="Compact">
            <grid-column field="Name" title="@Loc["Admin.Documents.Type.Fields.Name"]">
                <cell-template>
                    <a class="text-decoration-none" href="EditType/{{ Id }}">{{ Name }}</a>
                </cell-template>
            </grid-column>
        </admin-grid>
    </admin-card>
</admin-page>
