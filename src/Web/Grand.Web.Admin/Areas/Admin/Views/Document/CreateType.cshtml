@model DocumentTypeModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Documents.Type.AddNew"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Document" asp-action="CreateType" method="post">
    @* the same shell as EditType, minus what a type that does not exist yet cannot offer - the
       Delete this screen used to show had no confirmation behind it and nothing to delete *@
    <admin-page sticky
                title="@Loc["Admin.Documents.Type.AddNew"]"
                icon="bi-tag"
                back-url="@Url.Action("Types")"
                back-text="@Loc["Admin.Documents.Type.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <vc:admin-widget widget-zone="document_type_details_buttons" additional-data="Model"/>
        </page-actions>

        <partial name="Partials/CreateOrUpdateType" model="Model"/>
    </admin-page>
</form>
