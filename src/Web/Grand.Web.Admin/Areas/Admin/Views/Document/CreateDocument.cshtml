@model DocumentModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Documents.Document.AddNew"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Document" asp-action="CreateDocument" method="post" id="document-form">

    <div class="row">
        <div class="col-md-12">
            <div class="x_panel light form-fit">
                <div class="x_title">
                    <div class="caption">
                        <i class="bi bi-diagram-3"></i>
                        @Loc["Admin.Documents.Document.AddNew"]
                        <small>
                            <i class="bi bi-arrow-left-circle"></i>@Html.ActionLink(Loc["Admin.Documents.Document.BackToList"], "List")
                        </small>
                        @if (!string.IsNullOrEmpty(Model.CustomerId))
                        {
                            <small>
                                <i class="bi bi-person"></i>@Html.ActionLink(Loc["Admin.Documents.Document.GoToCustomer"], "Edit", "Customer", new { id = Model.CustomerId })
                            </small>
                        }
                    </div>
                    <div class="actions">
                        <div class="btn-group btn-group-devided util-btn-margin-bottom-5">
                            <button class="btn btn-success" type="submit" name="save">
                                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
                            </button>
                            <button class="btn btn-success" type="submit" name="save-continue">
                                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
                            </button>
                        </div>
                    </div>
                </div>
                <vc:admin-widget widget-zone="document_details_buttons" additional-data="null"/>
                <div class="x_content form">
                    <partial name="Partials/CreateOrUpdateDocument" model="Model"/>
                </div>
            </div>
        </div>
    </div>
</form>