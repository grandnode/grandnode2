@model DocumentModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Documents.Document.AddNew"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Document" asp-action="CreateDocument" method="post" id="document-form">

    @* the same shell as EditDocument, minus what a document that does not exist yet cannot offer;
       the customer it is being made for stays one click away *@
    <admin-page sticky
                title="@Loc["Admin.Documents.Document.AddNew"]"
                icon="bi-diagram-3"
                back-url="@Url.Action("List")"
                back-text="@Loc["Admin.Documents.Document.BackToList"]">
        <page-actions>
            @if (!string.IsNullOrEmpty(Model.CustomerId))
            {
                <a href="@Url.Action("Edit", "Customer", new { id = Model.CustomerId })" class="btn btn-outline-secondary">
                    <i class="bi bi-person"></i> @Loc["Admin.Documents.Document.GoToCustomer"]
                </a>
            }
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <vc:admin-widget widget-zone="document_details_buttons" additional-data="null"/>
        </page-actions>

        <partial name="Partials/CreateOrUpdateDocument" model="Model"/>
    </admin-page>
</form>
