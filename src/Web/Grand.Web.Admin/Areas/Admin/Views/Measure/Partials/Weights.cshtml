<div class="note note-info">
    @Loc["Admin.Configuration.Measures.Weights.Description"]
</div>
@* the grid edits inline; its Add new moves into the card header (grid.js) *@
<admin-card flush>
    <admin-grid id="measureweight-grid"
                read-url="@Url.Action("Weights", "Measure", new { area = Constants.AreaAdmin })"
                create-url="@Url.Action("WeightAdd", "Measure", new { area = Constants.AreaAdmin })"
                update-url="@Url.Action("WeightUpdate", "Measure", new { area = Constants.AreaAdmin })"
                destroy-url="@Url.Action("WeightDelete", "Measure", new { area = Constants.AreaAdmin })"
                pager="Compact"
                edit-mode="Inline">
        <grid-toolbar-create/>
        <grid-text name="markAsPrimary" value="@Loc["Admin.Configuration.Measures.Weights.Fields.MarkAsPrimaryWeight"]"/>
        <grid-column field="Name" title="@Loc["Admin.Configuration.Measures.Weights.Fields.Name"]" width="300" editor="Text"/>
        <grid-column field="SystemKeyword" title="@Loc["Admin.Configuration.Measures.Weights.Fields.SystemKeyword"]" width="200" editor="Text"/>
        <grid-column field="Ratio" title="@Loc["Admin.Configuration.Measures.Weights.Fields.Ratio"]" width="200" editor="Numeric" decimals="8"/>
        <grid-column field="DisplayOrder" title="@Loc["Admin.Configuration.Measures.Weights.Fields.DisplayOrder"]" width="100" format="{0:0}" editor="Integer"/>
        <grid-column field="Id" title="@Loc["Admin.Configuration.Measures.Weights.Fields.IsPrimaryWeight"]" width="150" editable="false">
            <cell-template>
                <button type="button" class="btn btn-outline-secondary btn-sm" data-grid-click="markAsPrimaryWeight">
                    <i data-if="IsPrimaryWeight" class="bi bi-check-lg text-success" aria-hidden="true"></i>
                    <i data-else class="bi bi-x-lg text-danger" aria-hidden="true"></i>
                    {{ $texts.markAsPrimary }}
                </button>
            </cell-template>
        </grid-column>
        <grid-commands edit="true" destroy="true" width="200"/>
    </admin-grid>
</admin-card>
<script>
    function markAsPrimaryWeight(weight) {
        GrandAdmin.modal.confirm('@Loc["Admin.Common.AreYouSure"]', {
            confirmText: '@Loc["Admin.Common.Yes"]',
            cancelText: '@Loc["Admin.Common.No"]'
        }).then(function (confirmed) {
            if (!confirmed) return;
            var postData = {
                id: weight.Id
            };
            addAntiForgeryToken(postData);
            $.ajax({
                cache: false,
                type: "POST",
                url: "@(Url.Action("MarkAsPrimaryWeight", "Measure", new { area = Constants.AreaAdmin }))",
                data: postData,
                success: function(data) {
                    var grid = $("#measureweight-grid").data('kendoGrid');
                    grid.dataSource.read();
                },
                error: function(xhr, ajaxOptions, thrownError) {
                    alert('Failed to update weight');
                }
            });
        });
    }
</script>
