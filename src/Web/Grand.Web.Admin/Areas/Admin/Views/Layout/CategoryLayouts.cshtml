@{
    //page title
    ViewBag.Title = Loc["Admin.Configuration.Layouts.Category"];
}

@* the grid edits inline; its Add new moves into the card header (grid.js) *@
<admin-page title="@Loc["Admin.Configuration.Layouts.Category"]" icon="bi-list-task">
    <page-actions>
        <vc:admin-widget widget-zone="category_template_list_buttons" additional-data="null"/>
    </page-actions>

    <admin-card flush>
        <admin-grid id="templates-grid"
                    read-url="@Url.Action("CategoryLayouts", "Layout", new { area = Constants.AreaAdmin })"
                    create-url="@Url.Action("CategoryLayoutAdd", "Layout", new { area = Constants.AreaAdmin })"
                    update-url="@Url.Action("CategoryLayoutUpdate", "Layout", new { area = Constants.AreaAdmin })"
                    destroy-url="@Url.Action("CategoryLayoutDelete", "Layout", new { area = Constants.AreaAdmin })"
                    pager="Compact"
                    edit-mode="Inline">
            <grid-toolbar-create/>
            <grid-column field="Name" title="@Loc["Admin.Configuration.Layouts.Category.Name"]" width="300" editor="Text"/>
            <grid-column field="ViewPath" title="@Loc["Admin.Configuration.Layouts.Category.ViewPath"]" width="300" editor="Text"/>
            <grid-column field="DisplayOrder" title="@Loc["Admin.Configuration.Layouts.Category.DisplayOrder"]" width="100" format="{0:0}" editor="Integer" default-value="0"/>
            <grid-commands edit="true" destroy="true" width="200"/>
        </admin-grid>
    </admin-card>
</admin-page>
