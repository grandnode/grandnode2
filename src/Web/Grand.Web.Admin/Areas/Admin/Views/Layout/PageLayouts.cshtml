@{
    //page title
    ViewBag.Title = Loc["Admin.Configuration.Layouts.Page"];
}

<div class="row">
    <div class="col-md-12">
        <div class="x_panel light form-fit">
            <div class="x_title">
                <div class="caption level-caption">
                    <i class="fa fa-tasks"></i>
                    @Loc["Admin.Configuration.Layouts.Page"]
                </div>
                <vc:admin-widget widget-zone="page_layout_list_buttons" additional-data="null"/>
            </div>
            <div class="x_content form">
                <div class="form-horizontal">
                    <div class="form-body">
                        <div class="x_content">
                            <admin-grid id="layout-grid"
                                        read-url="@Url.Action("PageLayouts", "Layout", new { area = Constants.AreaAdmin })"
                                        create-url="@Url.Action("PageLayoutAdd", "Layout", new { area = Constants.AreaAdmin })"
                                        update-url="@Url.Action("PageLayoutUpdate", "Layout", new { area = Constants.AreaAdmin })"
                                        destroy-url="@Url.Action("PageLayoutDelete", "Layout", new { area = Constants.AreaAdmin })"
                                        pager="Compact"
                                        edit-mode="Inline">
                                <grid-toolbar-create/>
                                <grid-column field="Name" title="@Loc["Admin.Configuration.Layouts.Page.Name"]" width="300" editor="Text"/>
                                <grid-column field="ViewPath" title="@Loc["Admin.Configuration.Layouts.Page.ViewPath"]" width="300" editor="Text"/>
                                <grid-column field="DisplayOrder" title="@Loc["Admin.Configuration.Layouts.Page.DisplayOrder"]" width="100" format="{0:0}" editor="Integer" default-value="0"/>
                                <grid-commands edit="true" destroy="true" width="200"/>
                            </admin-grid>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

