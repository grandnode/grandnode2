@{
    //page title
    ViewBag.Title = Loc["Admin.Configuration.Layouts.Collection"];
}

@* the grid edits inline; its Add new moves into the card header (grid.js) *@
<admin-page title="@Loc["Admin.Configuration.Layouts.Collection"]" icon="bi-list-task">
    <page-actions>
        <vc:admin-widget widget-zone="collection_layout_list_buttons" additional-data="null"/>
    </page-actions>

    <admin-card flush>
        <admin-grid id="layout-grid"
                    read-url="@Url.Action("CollectionLayouts", "Layout", new { area = Constants.AreaAdmin })"
                    create-url="@Url.Action("CollectionLayoutAdd", "Layout", new { area = Constants.AreaAdmin })"
                    update-url="@Url.Action("CollectionLayoutUpdate", "Layout", new { area = Constants.AreaAdmin })"
                    destroy-url="@Url.Action("CollectionLayoutDelete", "Layout", new { area = Constants.AreaAdmin })"
                    pager="Compact"
                    edit-mode="Inline">
            <grid-toolbar-create/>
            <grid-column field="Name" title="@Loc["Admin.Configuration.Layouts.Collection.Name"]" width="300" editor="Text"/>
            <grid-column field="ViewPath" title="@Loc["Admin.Configuration.Layouts.Collection.ViewPath"]" width="300" editor="Text"/>
            <grid-column field="DisplayOrder" title="@Loc["Admin.Configuration.Layouts.Collection.DisplayOrder"]" width="100" format="{0:0}" editor="Integer" default-value="0"/>
            <grid-commands edit="true" destroy="true" width="200"/>
        </admin-grid>
    </admin-card>
</admin-page>
