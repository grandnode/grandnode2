@{
    //page title
    ViewBag.Title = Loc["Admin.Configuration.Shipping.DeliveryDates"];
}

<admin-page title="@Loc["Admin.Configuration.Shipping.DeliveryDates"]" icon="bi-card-list">
    <page-actions>
        <a href="@Url.Action("CreateDeliveryDate", new { area = Constants.AreaAdmin })" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> @Loc["Admin.Common.AddNew"]
        </a>
        <vc:admin-widget widget-zone="delivery_date_buttons" additional-data="null"/>
    </page-actions>

    <admin-card flush>
        <admin-grid id="deliverydate-grid"
                    read-url="@Url.Action("DeliveryDates", "Shipping", new { area = Constants.AreaAdmin })"
                    pager="Compact">
            <grid-column field="Name" title="@Loc["Admin.Configuration.Shipping.DeliveryDates.Fields.Name"]" width="300">
                <cell-template>
                    <a class="text-decoration-none" href="EditDeliveryDate/{{ Id }}">{{ Name }}</a>
                </cell-template>
            </grid-column>
            <grid-column field="StoreName" title="@Loc["Admin.Configuration.Shipping.DeliveryDates.Fields.Store"]" width="200"/>
            <grid-column field="DisplayOrder" title="@Loc["Admin.Configuration.Shipping.DeliveryDates.Fields.DisplayOrder"]" width="100"/>
        </admin-grid>
    </admin-card>
</admin-page>
