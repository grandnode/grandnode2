@model WarehouseModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Configuration.Shipping.Warehouses.EditWarehouseDetails"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Shipping" asp-action="EditWarehouse" method="post">

    @* the record name as the title, Save as the one primary action, Delete in the overflow menu *@
    <admin-page sticky
                title="@Model.Name (@Model.Code)"
                icon="bi-card-list"
                meta="@Loc["Admin.Configuration.Shipping.Warehouses.EditWarehouseDetails"]"
                back-url="@Url.Action("Warehouses", "Shipping", new { area = Constants.AreaAdmin })"
                back-text="@Loc["Admin.Configuration.Shipping.Warehouses.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <admin-action-menu>
                <admin-action id="warehouse-delete" destructive="true" icon="bi-trash"
                              text="@Loc["Admin.Common.Delete"]"/>
            </admin-action-menu>
            <vc:admin-widget widget-zone="warehouse_details_buttons" additional-data="Model"/>
        </page-actions>

        <partial name="Partials/CreateOrUpdateWarehouse" model="Model"/>
    </admin-page>
</form>
<admin-delete-confirmation button-id="warehouse-delete" action-name="DeleteWarehouse"/>
