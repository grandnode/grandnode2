@model WarehouseModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Configuration.Shipping.Warehouses.AddNew"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Shipping" asp-action="CreateWarehouse" method="post">

    @* the same shell as Edit, minus what a record that does not exist yet cannot offer *@
    <admin-page sticky
                title="@Loc["Admin.Configuration.Shipping.Warehouses.AddNew"]"
                icon="bi-card-list"
                back-url="@Url.Action("Warehouses", "Shipping", new { area = Constants.AreaAdmin })"
                back-text="@Loc["Admin.Configuration.Shipping.Warehouses.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <vc:admin-widget widget-zone="warehouse_details_buttons" additional-data="null"/>
        </page-actions>

        <partial name="Partials/CreateOrUpdateWarehouse" model="Model"/>
    </admin-page>
</form>
