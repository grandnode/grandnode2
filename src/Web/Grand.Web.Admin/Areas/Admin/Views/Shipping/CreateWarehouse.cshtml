@model WarehouseModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Configuration.Shipping.Warehouses.AddNew"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Shipping" asp-action="CreateWarehouse" method="post">

    <div class="row">
        <div class="col-md-12">
            <div class="x_panel light form-fit">
                <div class="x_title">
                    <div class="caption">
                        <i class="bi bi-card-list"></i>
                        @Loc["Admin.Configuration.Shipping.Warehouses.AddNew"]
                        <small>
                            <i class="bi bi-arrow-left-circle"></i>@Html.ActionLink(Loc["Admin.Configuration.Shipping.Warehouses.BackToList"], "Warehouses")
                        </small>
                    </div>
                    <div class="actions">
                        <div class="btn-group btn-group-devided">
                            <button class="btn btn-success" type="submit" name="save">
                                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
                            </button>
                            <button class="btn btn-success" type="submit" name="save-continue">
                                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
                            </button>
                            <vc:admin-widget widget-zone="warehouse_details_buttons" additional-data="null"/>
                        </div>
                    </div>
                </div>
                <div class="x_content form">
                    <partial name="Partials/CreateOrUpdateWarehouse" model="Model"/>
                </div>
            </div>
        </div>
    </div>
</form>