@model WarehouseModel
<div asp-validation-summary="All"></div>
<input asp-for="Id" type="hidden"/>
<input id="active-menu-item" type="hidden" value="/@Constants.AreaAdmin/Shipping/Warehouses"/>
<vc:admin-widget widget-zone="warehouse_details_top" additional-data="Model"/>
@* the warehouse itself, then its address with the shared Address editor template *@
<admin-card>
    <div class="grand-fields grand-fields--2col">
        <admin-field asp-for="Code"/>
        <admin-field asp-for="Name"/>
        <admin-field asp-for="AdminComment">
            <admin-textarea asp-for="AdminComment"></admin-textarea>
        </admin-field>
        <admin-field asp-for="StoreId" asp-items="Model.AvailableStores"/>
        <admin-field asp-for="Latitude" size="md"/>
        <admin-field asp-for="Longitude" size="md"/>
        <admin-field asp-for="DisplayOrder" size="sm"/>
    </div>
</admin-card>
<admin-card>
    <admin-input asp-for="Address" asp-template="Address"/>
</admin-card>
<vc:admin-widget widget-zone="warehouse_details_bottom" additional-data="Model"/>
