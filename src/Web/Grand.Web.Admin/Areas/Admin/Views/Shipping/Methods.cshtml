@{
    //page title
    ViewBag.Title = Loc["Admin.Configuration.Shipping.Methods"];
}

<admin-page title="@Loc["Admin.Configuration.Shipping.Methods"]" icon="bi-card-list">
    <page-actions>
        <a href="@Url.Action("CreateMethod", new { area = Constants.AreaAdmin })" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> @Loc["Admin.Common.AddNew"]
        </a>
        <vc:admin-widget widget-zone="shipping_method_list_buttons" additional-data="null"/>
    </page-actions>

    <admin-card flush>
        <admin-grid id="shippingmethod-grid"
                    read-url="@Url.Action("Methods", "Shipping", new { area = Constants.AreaAdmin })"
                    pager="Compact">
            <grid-column field="Name" title="@Loc["Admin.Configuration.Shipping.Methods.Fields.Name"]" width="200">
                <cell-template>
                    <a class="text-decoration-none" href="EditMethod/{{ Id }}">{{ Name }}</a>
                </cell-template>
            </grid-column>
            <grid-column field="Description" title="@Loc["Admin.Configuration.Shipping.Methods.Fields.Description"]" width="400"/>
            <grid-column field="StoreName" title="@Loc["Admin.Configuration.Shipping.Methods.Fields.Store"]" width="200"/>
            <grid-column field="DisplayOrder" title="@Loc["Admin.Configuration.Shipping.Methods.Fields.DisplayOrder"]" width="100"/>
        </admin-grid>
    </admin-card>
</admin-page>
