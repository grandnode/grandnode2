@{
    //page title
    ViewBag.Title = Loc["Admin.Configuration.Shipping.PickupPoints"];
}

<div class="row">
    <div class="col-md-12">
        <div class="x_panel light form-fit">
            <div class="x_title">
                <div class="caption">
                    <i class="bi bi-card-list"></i>
                    @Loc["Admin.Configuration.Shipping.PickupPoints"]
                </div>
                <div class="actions btn-group btn-group-devided">
                    <a href="@Url.Action("CreatePickupPoint", new { area = Constants.AreaAdmin })" class="btn green">
                        <i class="bi bi-plus-lg"></i><span class="d-none d-sm-inline"> @Loc["Admin.Common.AddNew"] </span>
                    </a>
                    <vc:admin-widget widget-zone="pickup_point_list_buttons" additional-data="null"/>
                </div>
            </div>
            <div class="x_content form">
                <div class="form-horizontal">
                    <div class="form-body">
                        <div class="x_content">
                            <admin-grid id="pickupPoints-grid"
                                        read-url="@Url.Action("PickupPoints", "Shipping", new { area = Constants.AreaAdmin })"
                                        pager="Compact">
                                <grid-column field="Name" title="@Loc["Admin.Configuration.Shipping.PickupPoint.Fields.Name"]">
                                    <cell-template>
                                        <a class="text-decoration-none" href="EditPickupPoint/{{ Id }}">{{ Name }}</a>
                                    </cell-template>
                                </grid-column>
                                <grid-column field="StoreName" title="@Loc["Admin.Configuration.Shipping.PickupPoint.Fields.Stores"]"/>
                                <grid-column field="Description" title="@Loc["Admin.Configuration.Shipping.PickupPoint.Fields.Description"]"/>
                                <grid-column field="DisplayOrder" title="@Loc["Admin.Configuration.Shipping.PickupPoint.Fields.DisplayOrder"]" width="120"/>
                            </admin-grid>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

