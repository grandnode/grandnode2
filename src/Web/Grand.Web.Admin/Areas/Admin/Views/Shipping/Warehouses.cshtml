@{
    //page title
    ViewBag.Title = Loc["Admin.Configuration.Shipping.Warehouses"];
}

<admin-page title="@Loc["Admin.Configuration.Shipping.Warehouses"]" icon="bi-card-list">
    <page-actions>
        <a href="@Url.Action("CreateWarehouse", new { area = Constants.AreaAdmin })" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> @Loc["Admin.Common.AddNew"]
        </a>
        <vc:admin-widget widget-zone="warehouse_list_buttons" additional-data="null"/>
    </page-actions>

    <admin-card flush>
        <admin-grid id="warehouse-grid"
                    read-url="@Url.Action("Warehouses", "Shipping", new { area = Constants.AreaAdmin })"
                    pager="Compact">
            <grid-column field="Code" title="@Loc["Admin.Configuration.Shipping.Warehouses.Fields.Code"]">
                <cell-template>
                    <a class="text-decoration-none" href="EditWarehouse/{{ Id }}">{{ Code }}</a>
                </cell-template>
            </grid-column>
            <grid-column field="Name" title="@Loc["Admin.Configuration.Shipping.Warehouses.Fields.Name"]">
                <cell-template>
                    <a class="text-decoration-none" href="EditWarehouse/{{ Id }}">{{ Name }}</a>
                </cell-template>
            </grid-column>
            <grid-column field="StoreName" title="@Loc["Admin.Configuration.Shipping.Warehouses.Fields.Store"]"/>
            <grid-column field="DisplayOrder" title="@Loc["Admin.Configuration.Shipping.Warehouses.Fields.DisplayOrder"]"/>
        </admin-grid>
    </admin-card>
</admin-page>
