@model AffiliateModel

<vc:admin-widget widget-zone="affiliate_details_info_top" additional-data="Model"/>
@* the affiliate's own fields, its address, then the notes; the address keeps the shared Address
   editor template the other panels' address forms use *@
<admin-card>
    @if (!string.IsNullOrEmpty(Model.Id))
    {
        <div class="grand-facts mb-3">
            <div>
                <admin-label asp-for="Id" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.Id</div>
            </div>
            <div>
                <admin-label asp-for="Url" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">@Model.Url</div>
            </div>
        </div>
    }
    <div class="grand-fields grand-fields--2col">
        <admin-field asp-for="Name"/>
        <admin-field asp-for="Active"/>
    </div>
</admin-card>
<admin-card>
    <admin-input asp-for="Address" asp-template="Address"/>
</admin-card>
<admin-card>
    <div class="grand-fields grand-fields--2col">
        <admin-field asp-for="AdminComment">
            <admin-textarea asp-for="AdminComment"></admin-textarea>
        </admin-field>
        <admin-field asp-for="FriendlyUrlName"/>
    </div>
</admin-card>
<vc:admin-widget widget-zone="affiliate_details_info_bottom" additional-data="Model"/>
