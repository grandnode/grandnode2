@model AffiliateModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Affiliates.AddNew"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Affiliate" asp-action="Create" method="post">

    @* the same shell as Edit, minus what an affiliate that does not exist yet cannot offer *@
    <admin-page sticky
                title="@Loc["Admin.Affiliates.AddNew"]"
                icon="bi-box"
                back-url="@Url.Action("List")"
                back-text="@Loc["Admin.Affiliates.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <vc:admin-widget widget-zone="affiliate_details_buttons" additional-data="null"/>
        </page-actions>

        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>