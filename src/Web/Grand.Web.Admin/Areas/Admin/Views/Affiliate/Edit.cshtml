@model AffiliateModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Affiliates.EditAffiliateDetails"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Affiliate" asp-action="Edit" method="post">

    @* the affiliate's first name as the title, Save as the one primary action, Delete in the overflow menu *@
    <admin-page sticky
                title="@Model.Address.FirstName"
                icon="bi-box"
                meta="@Loc["Admin.Affiliates.EditAffiliateDetails"]"
                back-url="@Url.Action("List")"
                back-text="@Loc["Admin.Affiliates.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <admin-action-menu>
                <admin-action id="affiliate-delete" destructive="true" icon="bi-trash"
                              text="@Loc["Admin.Common.Delete"]"/>
            </admin-action-menu>
            <vc:admin-widget widget-zone="affiliate_details_buttons" additional-data="Model"/>
        </page-actions>

        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>
<admin-delete-confirmation button-id="affiliate-delete"/>