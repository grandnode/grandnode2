@model AffiliateModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Affiliates.EditAffiliateDetails"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Affiliate" asp-action="Edit" method="post">

    <div class="row">
        <div class="col-md-12">
            <div class="x_panel light form-fit">
                <div class="x_title">
                    <div class="caption">
                        <i class="bi bi-box"></i>
                        @Loc["Admin.Affiliates.EditAffiliateDetails"] - @Model.Address.FirstName
                        <small>
                            <i class="bi bi-arrow-left-circle"></i>@Html.ActionLink(Loc["Admin.Affiliates.BackToList"], "List")
                        </small>
                    </div>
                    <div class="actions">
                        <div class="btn-group btn-group-devided">
                            <button class="btn btn-success" type="submit" name="save">
                                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
                            </button>
                            <button class="btn btn-success" type="submit" name="save-continue">
                                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
                            </button>
                            <span id="affiliate-delete" class="btn red">
                                <i class="bi bi-trash"></i> @Loc["Admin.Common.Delete"]
                            </span>
                        </div>
                    </div>
                </div>
                <vc:admin-widget widget-zone="affiliate_details_buttons" additional-data="Model"/>
                <div class="x_content form">
                    <partial name="Partials/CreateOrUpdate" model="Model"/>
                </div>
            </div>
        </div>
    </div>
</form>
<admin-delete-confirmation button-id="affiliate-delete"/>