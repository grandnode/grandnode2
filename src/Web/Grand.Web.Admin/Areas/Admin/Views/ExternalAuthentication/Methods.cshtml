@model OidcLinksModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Plugins.ExternalAuthenticationMethods"];
}

@* the methods in a flush card; the grid edits inline, so there is no primary action on this screen *@
<admin-page title="@Loc["Admin.Plugins.ExternalAuthenticationMethods"]" icon="bi-facebook">
    <page-actions>
        <vc:admin-widget widget-zone="external_authentication_list_buttons" additional-data="null"/>
    </page-actions>

    <admin-card flush>
        <admin-grid id="authenticationmethods-grid"
                    key="SystemName"
                    read-url="@Url.Action("Methods", "ExternalAuthentication", new { area = Constants.AreaAdmin })"
                    update-url="@Url.Action("MethodUpdate", "ExternalAuthentication", new { area = Constants.AreaAdmin })"
                    pager="Compact"
                    edit-mode="Inline">
            <grid-column field="FriendlyName" title="@Loc["Admin.Plugins.ExternalAuthenticationMethods.Fields.FriendlyName"]" width="250">
                <cell-template>
                    <a class="text-decoration-none" href="{{ ConfigurationUrl }}">{{ FriendlyName }}</a>
                </cell-template>
            </grid-column>
            <grid-column field="SystemName" title="@Loc["Admin.Plugins.ExternalAuthenticationMethods.Fields.SystemName"]" width="250">
                <cell-template>
                    <a class="text-decoration-none" href="{{ ConfigurationUrl }}">{{ SystemName }}</a>
                </cell-template>
            </grid-column>
            <grid-column field="DisplayOrder" title="@Loc["Admin.Plugins.ExternalAuthenticationMethods.Fields.DisplayOrder"]" width="100" format="{0:0}"/>
            <grid-column field="IsActive" title="@Loc["Admin.Plugins.ExternalAuthenticationMethods.Fields.IsActive"]" width="100" align="Center" editor="Checkbox">
                <cell-template>
                    <i data-if="IsActive" class="bi bi-check-lg text-success" aria-hidden="true"></i>
                    <i data-else class="bi bi-x-lg text-danger" aria-hidden="true"></i>
                </cell-template>
            </grid-column>
            <grid-commands edit="true" title="@Loc["Admin.Common.Edit"]" width="150"/>
        </admin-grid>
    </admin-card>

    @* the identity provider and the client come from appsettings and are shown read-only; the secret is never shown *@
    @if (Model != null)
    {
        @* target of the grid's configure link of the OpenID Connect row (OidcLoginDefaults.ConfigurationUrl) *@
        <span id="oidc-sign-in"></span>
        <admin-card title="OpenID Connect">
            <div class="note note-info">
                @Html.Raw(Loc["Admin.Plugins.ExternalAuthenticationMethods.Oidc.Description"])
            </div>
            <div class="grand-fields grand-fields--2col">
                <div class="form-group">
                    <label class="col-form-label" for="oidc-authority">@Loc["Admin.Plugins.ExternalAuthenticationMethods.Oidc.Authority"]</label>
                    <input id="oidc-authority" type="text" disabled class="form-control" value="@Model.ConfiguredAuthority"/>
                </div>
                <div class="form-group">
                    <label class="col-form-label" for="oidc-clientid">@Loc["Admin.Plugins.ExternalAuthenticationMethods.Oidc.ClientId"]</label>
                    <input id="oidc-clientid" type="text" disabled class="form-control" value="@Model.ClientId"/>
                </div>
                <div class="form-group">
                    <label class="col-form-label" for="oidc-clientsecret">@Loc["Admin.Plugins.ExternalAuthenticationMethods.Oidc.ClientSecret"]</label>
                    <input id="oidc-clientsecret" type="text" disabled class="form-control"
                           value="@(Model.ClientSecretSet ? Loc["Admin.Plugins.ExternalAuthenticationMethods.Oidc.ClientSecret.Set"] : Loc["Admin.Plugins.ExternalAuthenticationMethods.Oidc.ClientSecret.NotSet"])"/>
                </div>
            </div>
        </admin-card>
    }

    @* the OpenID Connect account links belong to one identity provider: a subject is unique only there *@
    @if (Model != null)
    {
        <admin-card title="@Loc["Admin.Plugins.ExternalAuthenticationMethods.OidcLinks"]">
            @if (Model.ProviderUnknown)
            {
                <div class="alert alert-danger">
                    @string.Format(Loc["Admin.Plugins.ExternalAuthenticationMethods.OidcLinks.ProviderUnknown"].Value,
                        Model.ConfiguredAuthority)
                </div>
            }
            else if (Model.ProviderChanged)
            {
                <div class="alert alert-danger">
                    @string.Format(Loc["Admin.Plugins.ExternalAuthenticationMethods.OidcLinks.ProviderChanged"].Value,
                        Model.LinkedAuthority, Model.ConfiguredAuthority)
                </div>
            }
            <p>
                @string.Format(Loc["Admin.Plugins.ExternalAuthenticationMethods.OidcLinks.Info"].Value,
                    Model.ConfiguredAuthority, Model.LinkCount)
            </p>
            <form method="post" class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-outline-danger"
                        formaction="@Url.Action("RemoveOidcLinks", "ExternalAuthentication", new { area = Constants.AreaAdmin })"
                        data-grand-confirm="@Loc["Admin.Plugins.ExternalAuthenticationMethods.OidcLinks.Remove.Confirm"]"
                        data-confirm-title="@Loc["Admin.Plugins.ExternalAuthenticationMethods.OidcLinks.Remove"]">
                    <i class="bi bi-trash" aria-hidden="true"></i> @Loc["Admin.Plugins.ExternalAuthenticationMethods.OidcLinks.Remove"]
                </button>
                @if (Model.ProviderChanged)
                {
                    <button type="submit" class="btn btn-outline-secondary"
                            formaction="@Url.Action("KeepOidcLinks", "ExternalAuthentication", new { area = Constants.AreaAdmin })"
                            data-grand-confirm="@Loc["Admin.Plugins.ExternalAuthenticationMethods.OidcLinks.Keep.Confirm"]"
                            data-confirm-title="@Loc["Admin.Plugins.ExternalAuthenticationMethods.OidcLinks.Keep"]">
                        @Loc["Admin.Plugins.ExternalAuthenticationMethods.OidcLinks.Keep"]
                    </button>
                }
            </form>
        </admin-card>
    }
</admin-page>
