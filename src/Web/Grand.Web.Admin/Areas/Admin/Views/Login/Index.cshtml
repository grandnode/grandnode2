@using Grand.Web.AdminShared.Models.Common
@model LoginModel
@{
    //page title
    Layout = Constants.Layout_AdminLogin;
}

<form asp-route="AdminLogin" asp-area="@Constants.AreaAdmin" method="post">
    <div class="card col-xl-6 col-lg-8 col-md-10 col-12">
        <h5 class="card-header">
            <strong>@Loc["Admin.Login.Title"]</strong>
        </h5>
        <div class="card-body">
            <div class="row">
                <div asp-validation-summary="All" class="message-error text-center"></div>
                <div class="col-12 mb-0">
                    @if (Model.UsernamesEnabled)
                    {
                        <div class="mb-3 row">
                            <div class="col-lg-3 col-12 d-flex align-items-start justify-content-sm-start">
                                <label asp-for="Username" class="h5 m-0">@Loc["Admin.Login.UserName"]:</label>
                            </div>
                            <div class="col-lg-9 col-12">
                                <input asp-for="Username" class="form-control username" autofocus="autofocus"/>
                                <span asp-validation-for="Username"></span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3 row">
                            <div class="col-lg-3 col-12 d-flex align-items-start justify-content-start">
                                <label asp-for="Email" class="h5 m-0">@Loc["Admin.Login.Email"]:</label>
                            </div>
                            <div class="col-lg-9 col-12">
                                <input asp-for="Email" class="form-control email" autofocus="autofocus"/>
                                <span asp-validation-for="Email"></span>
                            </div>
                        </div>
                    }
                    <div class="mb-3 row">
                        <div class="col-lg-3 col-12 d-flex align-items-center justify-content-start">
                            <label asp-for="Password" class="h5 m-0">@Loc["Admin.Login.Password"]:</label>
                        </div>
                        <div class="col-lg-9 col-12">
                            <input asp-for="Password" class="form-control password" autocomplete="off"/>
                            <span asp-validation-for="Password"></span>
                        </div>
                    </div>
                    <div class="inputs d-flex flex-sm-row flex-column justify-content-center">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="RememberMe"/>
                            <input name="RememberMe" type="hidden" value="false">
                            <label class="form-check-label" asp-for="RememberMe">@Loc["Admin.Login.RememberMe"]</label>
                        </div>
                        <span class="ms-3 forgot-password">
                            <a asp-route="PasswordRecovery">@Loc["Admin.Login.ForgotPassword"]</a>
                        </span>
                    </div>
                    @if (Model.DisplayCaptcha)
                    {
                        <div class="captcha-box">
                            <captcha/>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="card-footer px-0">
            <div class="buttons">
                <input class="btn btn-info login-button px-5" type="submit" value="@Loc["Admin.Login.LoginButton"]"/>
            </div>
        </div>
    </div>
</form>