@using Grand.Web.AdminShared.Models.Common
@model PasswordRecoveryConfirmModel
@{
    Layout = Constants.Layout_AdminLogin;
    ViewBag.Title = Loc["Account.PasswordRecovery"];
}

<form asp-route="AdminPasswordRecoveryConfirm" method="post" class="grand-page grand-login__panel">
    <input type="hidden" asp-for="Email"/>
    <input type="hidden" asp-for="Token"/>
    <div class="grand-login__brand">
        <img src="@(Grand.SharedUIResources.Constants.WwwRoot)/administration/build/images/grandLogo.png" width="40" height="40" alt=""/>
        <span>GrandNode</span>
    </div>
    <div class="grand-card">
        <div class="grand-card__body">
            <div class="grand-login__heading">
                <span class="grand-login__icon"><i class="bi bi-key" aria-hidden="true"></i></span>
                <h1 class="grand-login__title">@Loc["Account.PasswordRecovery"]</h1>
            </div>
            @if (!string.IsNullOrEmpty(Model.Result))
            {
                <div class="grand-login__notice @(Model.PasswordChanged ? "" : "grand-login__notice--error")" role="status">
                    <i class="bi @(Model.PasswordChanged ? "bi-check-circle" : "bi-exclamation-circle")" aria-hidden="true"></i>
                    <span>@Model.Result</span>
                </div>
            }
            @if (!Model.DisablePasswordChanging)
            {
                <div asp-validation-summary="ModelOnly"></div>
                <div class="grand-fields">
                    <div class="grand-field">
                        <label asp-for="NewPassword" class="grand-field__label">@Loc["Account.PasswordRecovery.NewPassword"]</label>
                        <div class="grand-field__control">
                            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" autofocus="autofocus"/>
                        </div>
                        <span asp-validation-for="NewPassword"></span>
                    </div>
                    <div class="grand-field">
                        <label asp-for="ConfirmNewPassword" class="grand-field__label">@Loc["Account.PasswordRecovery.ConfirmNewPassword"]</label>
                        <div class="grand-field__control">
                            <input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password"/>
                        </div>
                        <span asp-validation-for="ConfirmNewPassword"></span>
                    </div>
                </div>
                <input class="btn btn-primary grand-login__submit" type="submit" value="@Loc["Account.PasswordRecovery.ChangePasswordButton"]"/>
            }
            @if (Model.PasswordChanged)
            {
                <a class="btn btn-primary grand-login__submit" asp-route="AdminLogin">@Loc["Admin.Login.LoginButton"]</a>
            }
            else
            {
                <a class="grand-login__link grand-login__back" asp-route="AdminLogin">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i> @Loc["Admin.Login.LoginButton"]
                </a>
            }
        </div>
    </div>
</form>