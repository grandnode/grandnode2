@{
    //page title
    ViewBag.Title = Loc["Admin.Customers.CustomerTags"];
}

@* Add new as the one primary action in the page header, the grid in a flush card *@
<admin-page title="@Loc["Admin.Customers.CustomerTags"]" icon="bi-tags">
    <page-actions>
        <a href="@Url.Action("Create", new { area = Constants.AreaAdmin })" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> @Loc["Admin.Common.AddNew"]
        </a>
    </page-actions>

    <admin-card flush>
        <admin-grid id="customertags-grid"
                    read-url="@Url.Action("List", "CustomerTag", new { area = Constants.AreaAdmin })"
                    pager="Compact">
            <grid-column field="Name" title="@Loc["Admin.Customers.CustomerTags.Fields.Name"]" width="300">
                <cell-template>
                    <a class="text-decoration-none" href="Edit/{{ Id }}">{{ Name }}</a>
                </cell-template>
            </grid-column>
            <grid-column field="Count" title="@Loc["Admin.Customers.CustomerTags.Fields.Count"]" width="50"/>
        </admin-grid>
    </admin-card>
</admin-page>
