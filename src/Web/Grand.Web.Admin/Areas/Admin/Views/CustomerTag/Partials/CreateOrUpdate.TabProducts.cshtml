@model CustomerTagModel
@{
    if (string.IsNullOrEmpty(Model.Id))
    {
        <div class="note note-info">
            @Loc["Admin.Customers.CustomerTags.Products.SaveBeforeEdit"]
        </div>
    }

    if (!string.IsNullOrEmpty(Model.Id))
    {
        <div class="note note-info">
            @Html.Raw(Loc["Admin.Customers.CustomerTags.Products.Info"])
        </div>

        <div class="grand-card">
            <div class="grand-card__header">
                <h2 class="grand-card__title">@Loc["Admin.Customers.CustomerTags.Products"]</h2>
                <a id="btnAddNewProduct" href="@(Url.Action("ProductAddPopup", "CustomerTag", new { customerTagId = Model.Id, btnId = "btnRefreshProducts", formId = "customertag-form", area = Constants.AreaAdmin }))" class="btn btn-outline-secondary btn-sm"><i class="bi bi-plus-lg"></i> @Loc["Admin.Customers.CustomerTags.Products.Fields.AddNew"]</a>
                <input type="submit" id="btnRefreshProducts" style="display: none"/>
            </div>
            <div class="grand-card__body grand-card__body--flush">
                <admin-grid id="products-grid"
                            read-url="@Url.Action("Products", "CustomerTag", new { customerTagId = Model.Id, area = Constants.AreaAdmin })"
                            update-url="@Url.Action("ProductUpdate", "CustomerTag", new { area = Constants.AreaAdmin })"
                            destroy-url="@Url.Action("ProductDelete", "CustomerTag", new { area = Constants.AreaAdmin })"
                            pager="Compact"
                            edit-mode="Inline"
                            reload-after-save="false">
                    <grid-column field="Name" title="@Loc["Admin.Customers.CustomerTags.Products.Fields.Name"]" width="300">
                        <cell-template>
                            <a class="text-decoration-none" href="@Url.Action("Edit", "Product", new { area = Constants.AreaAdmin })/{{ ProductId }}">{{ Name }}</a>
                        </cell-template>
                    </grid-column>
                    <grid-column field="DisplayOrder" title="@Loc["Admin.Customers.CustomerTags.Products.Fields.DisplayOrder"]" width="100" editor="Integer"/>
                    <grid-commands edit="true" destroy="true" width="200"/>
                </admin-grid>
            </div>
        </div>
        <script>
                $(document).ready(function () {
                    $('#btnAddNewProduct').magnificPopup({
                        type: 'ajax',
                        settings: { cache: false, async: false },
                        midClick: true,
                        callbacks: {
                            parseAjax: function (mfpResponse) {
                                mfpResponse.data = $('<div></div>').html(mfpResponse.data);
                            },
                            ajaxContentAdded: function () {
                                $('.mfp-wrap').removeAttr('tabindex');
                            }
                        }
                    });
                });
        </script>

        <script>
            $(document).ready(function () {
                $('#btnRefreshProducts').click(function () {
                    var grid = GrandAdmin.grids.get("#products-grid");
                    grid.dataSource.read();
                    return false;
                });
            });
        </script>
    }
}