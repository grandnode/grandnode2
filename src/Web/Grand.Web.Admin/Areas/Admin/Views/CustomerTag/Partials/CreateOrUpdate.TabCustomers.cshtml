@model CustomerTagModel
@{
    if (string.IsNullOrEmpty(Model.Id))
    {
        <div class="note note-info">
            @Loc["Admin.Customers.CustomerTags.Customers.SaveBeforeEdit"]
        </div>
    }

    if (!string.IsNullOrEmpty(Model.Id))
    {
        <div class="panel panel-default">
            <div class="panel-body">
                <admin-grid id="customers-grid"
                            read-url="@Url.Action("Customers", "CustomerTag", new { customerTagId = Model.Id, area = Constants.AreaAdmin })"
                            destroy-url="@Url.Action("CustomerDelete", "CustomerTag", new { customerTagId = Model.Id, area = Constants.AreaAdmin })">
                    <grid-column field="Email" title="@Loc["Admin.Customers.CustomerTags.Fields.Email"]" width="300">
                        <cell-template>
                            <a class="k-link" href="@Url.Action("Edit", "Customer", new { area = Constants.AreaAdmin })/{{ Id }}">{{ Email }}</a>
                        </cell-template>
                    </grid-column>
                    <grid-commands destroy="true" title="@Loc["Admin.Common.Delete"]" width="100"/>
                </admin-grid>
            </div>
        </div>
    }
}