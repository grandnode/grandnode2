@model CustomerTagModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Customers.CustomerTags.AddNew"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="CustomerTag" asp-action="Create" method="post" id="customertag-form">

    @* the same shell as Edit, minus what a tag that does not exist yet cannot offer *@
    <admin-page sticky
                title="@Loc["Admin.Customers.CustomerTags.AddNew"]"
                icon="bi-tag"
                back-url="@Url.Action("List")"
                back-text="@Loc["Admin.Customers.CustomerTags.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
        </page-actions>

        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>
