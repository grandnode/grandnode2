@model CustomerTagModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Customers.CustomerTags.EditCustomerTagDetails"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="CustomerTag" asp-action="Edit" method="post" id="customertag-form">

    @* the tag's name as the title, Save as the one primary action, Delete in the overflow menu *@
    <admin-page sticky
                title="@Model.Name"
                icon="bi-tag"
                meta="@Loc["Admin.Customers.CustomerTags.EditCustomerTagDetails"]"
                back-url="@Url.Action("List")"
                back-text="@Loc["Admin.Customers.CustomerTags.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <admin-action-menu>
                <admin-action id="customertag-delete" destructive="true" icon="bi-trash"
                              text="@Loc["Admin.Common.Delete"]"/>
            </admin-action-menu>
        </page-actions>

        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>
<admin-delete-confirmation button-id="customertag-delete"/>
