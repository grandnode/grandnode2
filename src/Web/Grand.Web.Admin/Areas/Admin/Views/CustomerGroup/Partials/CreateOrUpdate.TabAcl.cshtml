@model CustomerGroupModel

@if (string.IsNullOrEmpty(Model.Id))
{
    <div class="note note-info">
        @Loc["Admin.Customers.CustomerGroups.Acl.SaveBeforeEdit"]
    </div>
}
@if (!string.IsNullOrEmpty(Model.Id))
{
    <div class="panel panel-default">
        <div class="panel-body">
            <admin-grid id="acl-grid"
                        read-url="@Url.Action("Acl", "CustomerGroup", new { customerGroupId = Model.Id, area = Constants.AreaAdmin })"
                        update-url="@Url.Action("AclUpdate", "CustomerGroup", new { customerGroupId = Model.Id, area = Constants.AreaAdmin })"
                        pager="Compact"
                        edit-mode="Inline"
                        reload-after-save="false"
                        on-data-bound="onAclGridDataBound">
                <grid-column field="Name" title="@Loc["Admin.Customers.CustomerGroups.Acl.Fields.Name"]" width="300"/>
                <grid-column field="Access" title="@Loc["Admin.Customers.CustomerGroups.Acl.Fields.Access"]" width="100" align="Center" editor="Checkbox">
                    <cell-template>
                        <i data-if="Access" class="fa fa-check" aria-hidden="true" style="color:green"></i>
                        <i data-else class="fa fa-times" aria-hidden="true" style="color:red"></i>
                    </cell-template>
                </grid-column>
                <grid-column field="Actions" title="@Loc["Admin.Customers.CustomerGroups.Acl.Fields.Actions"]" width="10" align="Center">
                    <cell-template>
                        <a data-if="Actions.length > 0" class="k-link permissionlink" href="@Url.Action("PermissionsAction", "Permission", new { area = Constants.AreaAdmin })/?systemname={{ SystemName }}&customeGroupId=@Model.Id"><i class="icon-settings"></i></a>
                    </cell-template>
                </grid-column>
                <grid-commands edit="true" width="200"/>
            </admin-grid>
        </div>
    </div>

    <script>
                function onAclGridDataBound() {
                    $('.permissionlink').magnificPopup({
                        type: 'ajax',
                        settings: { cache: false, async: false },
                        midClick: true,
                        callbacks: {
                            parseAjax: function (mfpResponse) {
                                mfpResponse.data = $('<div></div>').html(mfpResponse.data);
                            },
                            ajaxContentAdded: function () {
                                $('.mfp-wrap').removeAttr('tabindex');
                            }
                        }
                    });
                }
    </script>
}