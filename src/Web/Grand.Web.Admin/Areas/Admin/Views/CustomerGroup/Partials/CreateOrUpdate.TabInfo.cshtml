@model CustomerGroupModel
@* one card of two-column fields; IsSystem is not editable, so it reads as a fact and posts back
   through its hidden input *@
<admin-card>
    <div class="grand-fields grand-fields--2col">
        <admin-field asp-for="Name"/>
        <admin-field asp-for="SystemName"/>
        <admin-field asp-for="FreeShipping"/>
        <admin-field asp-for="TaxExempt"/>
        <admin-field asp-for="Active"/>
        <admin-field asp-for="EnablePasswordLifetime"/>
        <admin-field asp-for="MinOrderAmount" size="md"/>
        <admin-field asp-for="MaxOrderAmount" size="md"/>
    </div>
    <div class="grand-facts mt-3">
        <div>
            <admin-label asp-for="IsSystem" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Model.IsSystem.ToString()</div>
        </div>
    </div>
    <input asp-for="IsSystem" type="hidden"/>
</admin-card>
