@model CustomerGroupModel

@if (string.IsNullOrEmpty(Model.Id))
{
    <div class="note note-info">
        @Loc["Admin.Customers.CustomerGroups.Products.SaveBeforeEdit"]
    </div>
}
@if (!string.IsNullOrEmpty(Model.Id))
{
    <div class="note note-info">
        @Html.Raw(Loc["Admin.Customers.CustomerGroups.Products.Info"])
    </div>

    <div class="panel panel-default">
        <div class="panel-body">
            <admin-grid id="products-grid"
                        read-url="@Url.Action("Products", "CustomerGroup", new { customerGroupId = Model.Id, area = Constants.AreaAdmin })"
                        update-url="@Url.Action("ProductUpdate", "CustomerGroup", new { area = Constants.AreaAdmin })"
                        destroy-url="@Url.Action("ProductDelete", "CustomerGroup", new { area = Constants.AreaAdmin })"
                        pager="Compact"
                        edit-mode="Inline"
                        reload-after-save="false">
                <grid-column field="Name" title="@Loc["Admin.Customers.CustomerGroups.Products.Fields.Name"]" width="300">
                    <cell-template>
                        <a class="text-decoration-none" href="@Url.Action("Edit", "Product", new { area = Constants.AreaAdmin })/{{ ProductId }}">{{ Name }}</a>
                    </cell-template>
                </grid-column>
                <grid-column field="DisplayOrder" title="@Loc["Admin.Customers.CustomerGroups.Products.Fields.DisplayOrder"]" width="100" editor="Integer"/>
                <grid-commands edit="true" destroy="true" width="200"/>
            </admin-grid>
        </div>
        <div class="panel-footer">
            <a id="btnAddNewProduct" href="@(Url.Action("ProductAddPopup", "CustomerGroup", new { customerGroupId = Model.Id, btnId = "btnRefreshProducts", formId = "customergroup-form", area = Constants.AreaAdmin }))" class="btn btn-default btn-sm"><i class="bi bi-plus-lg"></i>&nbsp;@Loc["Admin.Customers.CustomerGroups.Products.Fields.AddNew"]</a>
            <input type="submit" id="btnRefreshProducts" style="display: none"/>
        </div>
    </div>

    <script>
                $(document).ready(function () {
                    $('#btnAddNewProduct').magnificPopup({
                        type: 'ajax',
                        settings: { cache: false, async: false },
                        midClick: true,
                        callbacks: {
                            parseAjax: function (mfpResponse) {
                                mfpResponse.data = $('<div></div>').html(mfpResponse.data);
                            },
                            ajaxContentAdded: function () {
                                $('.mfp-wrap').removeAttr('tabindex');
                            }
                        }
                    });
                });
        </script>

    <script>
            $(document).ready(function () {
                $('#btnRefreshProducts').click(function () {
                    var grid = $("#products-grid").data('kendoGrid');
                    grid.dataSource.read();
                    return false;
                });
            });
        </script>
}