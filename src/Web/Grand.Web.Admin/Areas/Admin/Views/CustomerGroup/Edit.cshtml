@model CustomerGroupModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Customers.CustomerGroups.EditCustomerGroupDetails"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="CustomerGroup" asp-action="Edit" method="post" id="customergroup-form">

    @* the group's name as the title, Save as the one primary action, Delete in the overflow menu *@
    <admin-page sticky
                title="@Model.Name"
                icon="bi-people"
                meta="@Loc["Admin.Customers.CustomerGroups.EditCustomerGroupDetails"]"
                back-url="@Url.Action("List")"
                back-text="@Loc["Admin.Customers.CustomerGroups.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <admin-action-menu>
                <admin-action id="customergroup-delete" destructive="true" icon="bi-trash"
                              text="@Loc["Admin.Common.Delete"]"/>
            </admin-action-menu>
            <vc:admin-widget widget-zone="customer_group_details_buttons" additional-data="Model"/>
        </page-actions>

        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>
<admin-delete-confirmation button-id="customergroup-delete"/>
