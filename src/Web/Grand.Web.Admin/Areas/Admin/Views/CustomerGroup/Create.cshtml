@model CustomerGroupModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Customers.CustomerGroups.AddNew"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="CustomerGroup" asp-action="Create" method="post" id="customergroup-form">

    <div class="row">
        <div class="col-md-12">
            <div class="x_panel light form-fit">
                <div class="x_title">
                    <div class="caption">
                        <i class="bi bi-people"></i>
                        @Loc["Admin.Customers.CustomerGroups.AddNew"]
                        <small>
                            <i class="bi bi-arrow-left-circle"></i>@Html.ActionLink(Loc["Admin.Customers.CustomerGroups.BackToList"], "List")
                        </small>
                    </div>
                    <div class="actions">
                        <button class="btn btn-success" type="submit" name="save">
                            <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
                        </button>
                        <button class="btn btn-success" type="submit" name="save-continue">
                            <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
                        </button>
                        <vc:admin-widget widget-zone="customer_group_details_buttons" additional-data="null"/>
                    </div>
                </div>
                <div class="x_content form">
                    <partial name="Partials/CreateOrUpdate" model="Model"/>
                </div>
            </div>
        </div>
    </div>
</form>