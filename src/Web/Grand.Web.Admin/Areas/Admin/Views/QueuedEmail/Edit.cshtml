@model QueuedEmailModel
@{
    //page title
    ViewBag.Title = Loc["Admin.System.QueuedEmails.EditQueuedEmailDetails"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="QueuedEmail" asp-action="Edit" method="post">

    @* the e-mail's subject as the title and Save as the one primary action; Requeue beside it as
       a secondary one, and Delete in the overflow menu *@
    <admin-page sticky
                title="@(string.IsNullOrEmpty(Model.Subject) ? Loc["Admin.System.QueuedEmails.EditQueuedEmailDetails"] : Model.Subject)"
                icon="bi-envelope"
                meta="@Loc["Admin.System.QueuedEmails.EditQueuedEmailDetails"]"
                back-url="@Url.Action("List")"
                back-text="@Loc["Admin.System.QueuedEmails.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="requeue" asp-action="Requeue">
                <i class="bi bi-arrow-clockwise"></i> @Loc["Admin.System.QueuedEmails.Requeue"]
            </button>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <admin-action-menu>
                <admin-action id="queuedEmail-delete" destructive="true" icon="bi-trash"
                              text="@Loc["Admin.Common.Delete"]"/>
            </admin-action-menu>
            <vc:admin-widget widget-zone="queued_email_details_buttons" additional-data="Model"/>
        </page-actions>

        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>
<admin-delete-confirmation button-id="queuedEmail-delete"/>