@model CourseModel
<vc:admin-widget widget-zone="course_details_lesson_top" additional-data="Model"/>
@if (!string.IsNullOrEmpty(Model.Id))
{
    <div class="grand-card">
        <div class="grand-card__header">
            <h2 class="grand-card__title">@Loc["Admin.Courses.Course.Lessons"]</h2>
            <button type="submit" id="btnAddNewLesson" name="btnAddNewLesson" onclick="javascript:setLocation('@(Url.Action("CreateLesson", "Course", new { courseId = Model.Id, area = Constants.AreaAdmin }))'); return false;" class="btn btn-outline-secondary btn-sm"><i class="bi bi-plus-lg"></i> @Loc["Admin.Courses.Course.Lesson.AddNew"]</button>
        </div>
        <div class="grand-card__body grand-card__body--flush">
            <admin-grid id="lessons-grid"
                        read-url="@Url.Action("Lessons", "Course", new { courseId = Model.Id, area = Constants.AreaAdmin })"
                        pager="Compact">
                <grid-column field="Name" title="@Loc["Admin.Courses.Course.Lesson.Fields.Name"]">
                    <cell-template>
                        <a class="text-decoration-none" href="@Url.Action("EditLesson", "Course", new { area = Constants.AreaAdmin })/{{ Id }}">{{ Name }}</a>
                    </cell-template>
                </grid-column>
                <grid-column field="DisplayOrder" title="@Loc["Admin.Courses.Course.Lesson.Fields.DisplayOrder"]" width="80" align="Center" format="{0:0}"/>
            </admin-grid>
        </div>
    </div>
}
else
{
    <div class="note note-info">
        @Loc["Admin.Courses.Course.Lesson.SaveBeforeEdit"]
    </div>
}
<vc:admin-widget widget-zone="course_details_lesson_bottom" additional-data="Model"/>
