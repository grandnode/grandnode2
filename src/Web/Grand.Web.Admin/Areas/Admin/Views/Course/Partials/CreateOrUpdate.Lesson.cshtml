@model CourseModel
<vc:admin-widget widget-zone="course_details_lesson_top" additional-data="Model"/>
@if (!string.IsNullOrEmpty(Model.Id))
{
    <div class="panel panel-default">
        <div class="panel-heading">
            @Loc["Admin.Courses.Course.Lessons"]
        </div>
        <div class="panel-body">
            <admin-grid id="lessons-grid"
                        read-url="@Url.Action("Lessons", "Course", new { courseId = Model.Id, area = Constants.AreaAdmin })"
                        pager="Compact">
                <grid-column field="Name" title="@Loc["Admin.Courses.Course.Lesson.Fields.Name"]">
                    <cell-template>
                        <a class="k-link" href="@Url.Action("EditLesson", "Course", new { area = Constants.AreaAdmin })/{{ Id }}">{{ Name }}</a>
                    </cell-template>
                </grid-column>
                <grid-column field="DisplayOrder" title="@Loc["Admin.Courses.Course.Lesson.Fields.DisplayOrder"]" width="80" align="Center" format="{0:0}"/>
            </admin-grid>
        </div>
        <div class="panel-footer">
            <button type="submit" id="btnAddNewLesson" name="btnAddNewLesson" onclick="javascript:setLocation('@(Url.Action("CreateLesson", "Course", new { courseId = Model.Id, area = Constants.AreaAdmin }))'); return false;" class="k-button"><i class="bi bi-plus-lg"></i>&nbsp;@Loc["Admin.Courses.Course.Lesson.AddNew"]</button>
        </div>
    </div>

}
else
{
    <div class="note note-info">
        @Loc["Admin.Courses.Course.Lesson.SaveBeforeEdit"]
    </div>
}
<vc:admin-widget widget-zone="course_details_lesson_bottom" additional-data="Model"/>