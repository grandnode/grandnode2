@using Grand.Domain.Media
@model CourseLessonModel
@{
    ViewData["DownloadType"] = DownloadType.Course;
    ViewData["ReferenceId"] = Model.Id;
}
<vc:admin-widget widget-zone="course_details_lesson_info_top" additional-data="Model"/>
@* Two cards instead of one column of 3/9 rows: what the lesson says, then its media and place in
   the course. *@
<admin-card>
    <div class="grand-fields">
        <admin-field asp-for="Name"/>
        <admin-field asp-for="ShortDescription">
            <admin-textarea asp-for="ShortDescription"></admin-textarea>
        </admin-field>
        <admin-field asp-for="Description" asp-template="Editor"/>
    </div>
</admin-card>
@{
    ViewData["Reference"] = "Course";
    ViewData["ObjectId"] = Model.CourseId;
}
<admin-card>
    <div class="grand-fields grand-fields--2col">
        <admin-field asp-for="SubjectId" asp-items="Model.AvailableSubjects"/>
        <admin-field asp-for="Published"/>
        <admin-field asp-for="DisplayOrder" size="sm"/>
        <admin-field asp-for="VideoFile"/>
        <admin-field asp-for="AttachmentId"/>
        <admin-field asp-for="PictureId"/>
    </div>
</admin-card>

<vc:admin-widget widget-zone="course_details_lesson_info_bottom" additional-data="Model"/>
