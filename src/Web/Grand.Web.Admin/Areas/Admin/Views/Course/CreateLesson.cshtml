@model CourseLessonModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Courses.Course.Lesson.AddNew"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Course" asp-action="CreateLesson" method="post" id="course-lesson-form">
    <input asp-for="CourseId" type="hidden"/>

    @* the same shell as EditLesson, minus what a lesson that does not exist yet cannot offer *@
    <admin-page sticky
                title="@Loc["Admin.Courses.Course.Lesson.AddNew"]"
                icon="bi-diagram-3"
                back-url="@Url.Action("Edit", "Course", new { Id = Model.CourseId })"
                back-text="@Loc["Admin.Courses.Course.BackToCourse"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <vc:admin-widget widget-zone="course_lesson_details_buttons" additional-data="null"/>
        </page-actions>

        <partial name="Partials/Lesson" model="Model"/>
    </admin-page>
</form>
