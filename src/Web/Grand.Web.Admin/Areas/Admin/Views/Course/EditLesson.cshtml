@model CourseLessonModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Courses.Course.Lesson.Edit"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Course" asp-action="EditLesson" method="post" id="course-lesson-form">
    <input asp-for="CourseId" type="hidden"/>

    @* the product edit screen's shell: the lesson name as the title, back to its course, Save as
       the one primary action, and Delete in the overflow menu rather than beside Save *@
    <admin-page sticky
                title="@Model.Name"
                icon="bi-diagram-3"
                meta="@Loc["Admin.Courses.Course.Lesson.Edit"]"
                back-url="@Url.Action("Edit", "Course", new { Id = Model.CourseId })"
                back-text="@Loc["Admin.Courses.Course.BackToCourse"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <admin-action-menu>
                <admin-action id="course-lesson-delete" destructive="true" icon="bi-trash"
                              text="@Loc["Admin.Common.Delete"]"/>
            </admin-action-menu>
            <vc:admin-widget widget-zone="course_lesson_details_buttons" additional-data="Model"/>
        </page-actions>

        <partial name="Partials/Lesson" model="Model"/>
    </admin-page>
</form>
<admin-delete-confirmation button-id="course-lesson-delete" action-name="DeleteLesson"/>
