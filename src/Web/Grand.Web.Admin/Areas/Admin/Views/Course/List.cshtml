@model CategoryListModel

@{
    //page title
    ViewBag.Title = Loc["Admin.Courses.Course.Manage"];
}

@* The product list's shape without filters: Add new as the one primary action in the page header
   and the grid in a flush card. *@
<admin-page title="@Loc["Admin.Courses.Course.Manage"]" icon="bi-diagram-3">
    <page-actions>
        <vc:admin-widget widget-zone="course_list_buttons" additional-data="null"/>
        <a href="@Url.Action("Create", new { area = Constants.AreaAdmin })" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> @Loc["Admin.Common.AddNew"]
        </a>
    </page-actions>

    <admin-card flush>
        <admin-grid id="courses-grid" read-url="@Url.Action("List", "Course", new { area = Constants.AreaAdmin })">
            <grid-column field="Name" title="@Loc["Admin.Courses.Course.Fields.Name"]">
                <cell-template>
                    <a class="text-decoration-none" href="Edit/{{ Id }}">{{ Name }}</a>
                </cell-template>
            </grid-column>
            <grid-column field="Published" title="@Loc["Admin.Courses.Course.Fields.Published"]" width="100" align="Center" min-screen-width="500">
                <cell-template>
                    <i data-if="Published" class="bi bi-check-lg text-success" aria-hidden="true"></i>
                    <i data-else class="bi bi-x-lg text-danger" aria-hidden="true"></i>
                </cell-template>
            </grid-column>
            <grid-column field="DisplayOrder" title="@Loc["Admin.Courses.Course.Fields.DisplayOrder"]" width="100" align="Center" min-screen-width="750"/>
        </admin-grid>
    </admin-card>
</admin-page>
