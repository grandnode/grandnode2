@model CategoryListModel

@{
    //page title
    ViewBag.Title = Loc["Admin.Courses.Course.Manage"];
}

<div class="row">
    <div class="col-md-12">
        <div class="x_panel light form-fit">
            <div class="x_title">
                <div class="caption">
                    <i class="fa fa-sitemap"></i>
                    @Loc["Admin.Courses.Course.Manage"]
                </div>
                <div class="actions btn-group btn-group-devided util-btn-margin-bottom-5">
                    <a href="@Url.Action("Create", new { area = Constants.AreaAdmin })" class="btn green">
                        <i class="fa fa-plus"></i><span class="d-none d-sm-inline"> @Loc["Admin.Common.AddNew"] </span>
                    </a>
                    <vc:admin-widget widget-zone="course_list_buttons" additional-data="null"/>
                </div>
            </div>
            <div class="x_content">
                <admin-grid id="courses-grid" read-url="@Url.Action("List", "Course", new { area = Constants.AreaAdmin })">
                    <grid-column field="Name" title="@Loc["Admin.Courses.Course.Fields.Name"]">
                        <cell-template>
                            <a class="k-link" href="Edit/{{ Id }}">{{ Name }}</a>
                        </cell-template>
                    </grid-column>
                    <grid-column field="Published" title="@Loc["Admin.Courses.Course.Fields.Published"]" width="100" align="Center" min-screen-width="500">
                        <cell-template>
                            <i data-if="Published" class="fa fa-check" aria-hidden="true" style="color:green"></i>
                            <i data-else class="fa fa-times" aria-hidden="true" style="color:red"></i>
                        </cell-template>
                    </grid-column>
                    <grid-column field="DisplayOrder" title="@Loc["Admin.Courses.Course.Fields.DisplayOrder"]" width="100" align="Center" min-screen-width="750"/>
                </admin-grid>
            </div>
        </div>
    </div>
</div>
