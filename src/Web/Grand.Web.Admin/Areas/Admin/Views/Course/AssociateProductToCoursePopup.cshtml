@model CourseModel.AssociateProductToCourseModel
@{
    Layout = "";
    //page title
    ViewBag.Title = Loc["Admin.Courses.Course.Fields.PurchasedWithProduct.Choose"];
}

<form asp-area="@Constants.AreaAdmin" asp-controller="Course" asp-action="AssociateProductToCoursePopup" method="post"
      asp-route-CustomerGroupId="@HtmlExtensions.HtmlEncodeSafe(Context.Request.Query["CourseId"])"
      asp-route-btnId="@HtmlExtensions.HtmlEncodeSafe(Context.Request.Query["btnId"])"
      asp-route-productIdInput="@HtmlExtensions.HtmlEncodeSafe(Context.Request.Query["productIdInput"])"
      asp-route-productNameInput="@HtmlExtensions.HtmlEncodeSafe(Context.Request.Query["productNameInput"])"
      id="associateproduct">

    @* the product attribute value's associated-product picker: a row's Select picks it, so
       Search is the popup's one primary action *@
    <admin-popup title="@Loc["Admin.Courses.Course.Fields.PurchasedWithProduct.Choose"]" icon="bi-boxes">
        <admin-filters id="product-picker-filters" submit-id="search-products">
            <filters-search>
                <admin-input asp-for="SearchProductName"/>
            </filters-search>
            <admin-field asp-for="SearchCategoryId"/>
            <admin-field asp-for="SearchBrandId"/>
            <admin-field asp-for="SearchCollectionId"/>
            <admin-field asp-for="SearchStoreId" asp-items="Model.AvailableStores"/>
            <admin-field asp-for="SearchVendorId" asp-items="Model.AvailableVendors"/>
            <admin-field asp-for="SearchProductTypeId" asp-items="Model.AvailableProductTypes"/>
        </admin-filters>
        <admin-card flush>
            <admin-grid id="products-grid"
                        read-url="@Url.Action("AssociateProductToCoursePopupList", "Course", new { area = Constants.AreaAdmin })"
                        additional-data="additionalData">
                <grid-text name="select" value="@Loc["Admin.Common.Select"]"/>
                <grid-column field="Name" title="@Loc["Admin.Common.Select"]" width="50">
                    <cell-template>
                        <input type="button" value="{{ $texts.select }}" data-grid-click="selectAssociatedProduct" class="btn btn-outline-secondary btn-sm" />
                    </cell-template>
                </grid-column>
                <grid-column field="Name" title="@Loc["Admin.Catalog.Products.Fields.Name"]"/>
                <grid-column field="Published" title="@Loc["Admin.Catalog.Products.Fields.Published"]" width="100" align="Center">
                    <cell-template>
                        <i data-if="Published" class="bi bi-check-lg text-success" aria-hidden="true"></i>
                        <i data-else class="bi bi-x-lg text-danger" aria-hidden="true"></i>
                    </cell-template>
                </grid-column>
            </admin-grid>
        </admin-card>
    </admin-popup>

    @if (ViewBag.RefreshPage == true)
    {
        <script>
            try {
                    document.getElementById('@(Context.Request.Query["productIdInput"])').value = '@(ViewBag.productId)';
                    document.getElementById('@(Context.Request.Query["productNameInput"])').innerHTML = '@(ViewBag.productName)';
                    document.getElementById('@(Context.Request.Query["btnId"])').click();
            }
            catch (e){}
            $.magnificPopup.instance.close();
        </script>
    }

    <input asp-for="AssociatedToProductId" type="hidden"/>
    <script>
            var mfp = $.magnificPopup.instance;
            $("#associateproduct").submit(function (e) {
                e.preventDefault();
                var form = $(this);
                var url = form.attr('action');
                $.ajax({
                    type: "POST",
                    url: url,
                    data: form.serialize(),
                    success: function (data) {
                        $.magnificPopup.open({
                            items: {
                                src: data,
                                type: 'inline'
                            },
                            callbacks: {
                                open: function () {
                                    $('.mfp-wrap').removeAttr('tabindex');
                                }
                            }
                        });                 
                    }
                });
            });

            $('.extend-collapse').hide();
            $('.filter-extend-button').click(function () {
                $('.extend-collapse').toggle("slow");
                $('.filter-text-close').toggle();
            });


            $('#search-products').click(function () {
                var grid = $('#products-grid').data('kendoGrid');
                grid.dataSource.page(1); //new search. Set page size to 1
                //grid.dataSource.read(); we already loaded the grid above using "page" function
                return false;
            });


        $("#@Html.IdFor(model => model.SearchProductName)").keydown(function (event) {
            if (event.keyCode == 13) {
                $("#search-products").click();
                return false;
            }
        });

        function additionalData() {
            var data = {
                SearchProductName: $('#@Html.IdFor(model => model.SearchProductName)').val(),
                SearchCategoryId: $('#SearchCategoryId').val(),
                SearchBrandId: $('#SearchBrandId').val(),
                SearchCollectionId: $('#SearchCollectionId').val(),
                SearchStoreId: $('#SearchStoreId').val(),
                SearchVendorId: $('#SearchVendorId').val(),
                SearchProductTypeId: $('#SearchProductTypeId').val()
            };
            addAntiForgeryToken(data);
            return data;
        }

        function selectAssociatedProduct(product) {
            $("#@Html.IdFor(model => model.AssociatedToProductId)").val(product.Id);
            $('#associateproduct').submit();
        }
    </script>
</form>
