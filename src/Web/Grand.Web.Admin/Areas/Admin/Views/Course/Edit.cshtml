@model CourseModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Courses.Course.Edit"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Course" asp-action="Edit" method="post" id="course-form">

    @* the product edit screen's shell: the course name as the title, Save as the one primary
       action, and Delete in the overflow menu rather than beside Save *@
    <admin-page sticky
                title="@Model.Name"
                icon="bi-diagram-3"
                meta="@Loc["Admin.Courses.Course.Edit"]"
                back-url="@Url.Action("List")"
                back-text="@Loc["Admin.Courses.Course.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <admin-action-menu>
                <admin-action id="course-delete" destructive="true" icon="bi-trash"
                              text="@Loc["Admin.Common.Delete"]"/>
            </admin-action-menu>
            <vc:admin-widget widget-zone="course_details_buttons" additional-data="Model"/>
        </page-actions>

        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>
<admin-delete-confirmation button-id="course-delete"/>
