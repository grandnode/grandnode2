@model Grand.Web.Common.Models.DeleteConfirmationModel
<form asp-area="@Constants.AreaAdmin" asp-controller="@Model.ControllerName" asp-action="@Model.ActionName" method="post" asp-route-id="@Model.Id">
    <div>
        <p>
            @Loc["Admin.Common.DeleteConfirmation"]
        </p>
        <div class="form-actions">
            <span id="" class="btn btn-default btn-sm" onclick="GrandAdmin.modal.close('#@Model.WindowId');">@Loc["Admin.Common.NoCancel"]</span>
            <input type="submit" class="btn btn-default btn-sm" value="@Loc["Admin.Common.Delete"]"/>
        </div>
    </div>
</form>