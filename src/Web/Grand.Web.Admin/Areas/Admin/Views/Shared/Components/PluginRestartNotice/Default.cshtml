@using Grand.Infrastructure.Plugins
@model IReadOnlyList<PluginPendingChange>
@* the restart button is handled in _AdminLayout ([data-plugin-restart]), like the header's restart link *@
<div class="alert alert-warning" role="status" id="plugin-restart-notice">
    <div class="d-flex flex-wrap align-items-center gap-2">
        <strong class="me-auto">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @Loc["Admin.Plugins.RestartRequired"]
        </strong>
        <button type="button" class="btn btn-outline-secondary btn-sm" data-plugin-restart
                data-url="@Url.Action("ReloadList", "Plugin", new { area = Constants.AreaAdmin })">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> @Loc["Admin.Plugins.RestartNow"]
        </button>
    </div>
    <ul class="mb-0 mt-2">
        @foreach (var change in Model)
        {
            <li><strong>@change.SystemName</strong> - @Loc[$"Admin.Plugins.RestartRequired.{change.Kind}"]</li>
        }
    </ul>
    @if (Model.Any(x => x.Kind == PluginPendingChangeKind.Uninstalled))
    {
        <p class="mb-0 mt-2">@Loc["Admin.Plugins.RestartRequired.UninstallWarning"]</p>
    }
</div>
