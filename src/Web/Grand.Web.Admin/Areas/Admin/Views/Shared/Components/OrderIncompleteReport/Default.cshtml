<admin-grid id="incomplete-order-report-grid"
            read-url="@Url.Action("OrderIncompleteReportList", "Reports", new { area = Constants.AreaAdmin })"
            pager="Compact">
    <grid-column field="Item" title="@Loc["Admin.Reports.Incomplete.Item"]">
        <cell-template>
            <a class="text-decoration-none" href="{{ ViewLink }}">{{ Item }}</a>
        </cell-template>
    </grid-column>
    <grid-column field="Total" title="@Loc["Admin.Reports.Incomplete.Total"]"/>
    <grid-column field="Count" title="@Loc["Admin.Reports.Incomplete.Count"]"/>
</admin-grid>
