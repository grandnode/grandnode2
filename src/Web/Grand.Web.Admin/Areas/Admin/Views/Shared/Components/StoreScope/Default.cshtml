@model StoreScopeModel
@{
    var rawUrl = Context.Request.GetEncodedPathAndQuery();
    var stores = Model.Stores.Select(store => new SelectListItem
        {
            Text = store.Name,
            Value = Url.Action("ChangeStore", "Home", new { storeid = store.Id, returnurl = rawUrl, area = Constants.AreaAdmin }),
            Selected = store.Id.Equals(Model.StoreId)
        })
        .ToList();
}
@* the component owns its card: it renders nothing on a single-store installation, and a card
   written around it in the view would stay behind empty. The same card reads as a block of its
   own on the legacy settings pages that still render it inside their x_panel *@
<div class="grand-card">
    <div class="grand-card__body">
        <div class="grand-field grand-field--md">
            <label class="grand-field__label" for="store-scope-configuration">@Loc["Admin.Settings.StoreScope"]</label>
            <div class="grand-field__control">
                @Html.DropDownList("store-scope-configuration", stores, new { onchange = "setLocation(this.value);", @class = "form-select" })
            </div>
        </div>
    </div>
</div>
