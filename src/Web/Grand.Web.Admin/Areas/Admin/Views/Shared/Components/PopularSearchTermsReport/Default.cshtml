@{
    var gridPageSize = 4;
}
<admin-grid id="search-term-report-grid"
            read-url="@Url.Action("PopularSearchTermsReport", "Reports", new { area = Constants.AreaAdmin })"
            page-size="@(gridPageSize)"
            page-sizes="">
    <grid-column field="Keyword" title="@Loc["Admin.SearchTermReport.Keyword"]"/>
    <grid-column field="Count" title="@Loc["Admin.SearchTermReport.Count"]" width="50"/>
</admin-grid>
