@model ProductTagModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Catalog.ProductTags.EditTagDetails"];
}
@* The product edit screen's shell: the tag's name as the title and Save as the one primary
   action. A tag is deleted from the list, so there is no overflow menu. *@
<form asp-area="@Constants.AreaAdmin" asp-controller="ProductTags" asp-action="Edit" method="post">
    <admin-page sticky
                title="@Model.Name"
                icon="bi-box"
                meta="@Loc["Admin.Catalog.ProductTags.EditTagDetails"]"
                back-url="@Url.Action("List")"
                back-text="@Loc["Admin.Catalog.ProductTags.BackToList"]">
        <page-actions>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <vc:admin-widget widget-zone="product_tag_details_buttons" additional-data="Model"/>
        </page-actions>

        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>