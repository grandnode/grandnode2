@using Constants = Grand.SharedUIResources.Constants
@model RobotsTxtModel
@{
    //page title
    ViewBag.Title = Loc["Admin.System.RobotsTxt"];
}
<link rel="stylesheet" type="text/css" asp-src="@(Constants.WwwRoot)/administration/codemirror/codemirror.css"/>
<script asp-location="Head" asp-src="@(Constants.WwwRoot)/administration/codemirror/codemirror.js"></script>

<style>
    .CodeMirror {
        background: #f8f8f8;
        border: 1px solid #eee;
        height: 600px;
    }
</style>

<form asp-area="@Grand.Web.Admin.Extensions.Constants.AreaAdmin" asp-controller="Maintenance" asp-action="RobotsTxt" method="post">
    @* The store scope owns its card, so it goes straight into the page; the name and the file's
       text share the one card below it. *@
    <admin-page title="@Loc["Admin.System.RobotsTxt"]" icon="bi-sliders">
        <page-actions>
            <vc:admin-widget widget-zone="robots_txt_buttons" additional-data="null"/>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
        </page-actions>

        @await Component.InvokeAsync("StoreScope")

        <admin-card>
            <div class="grand-fields">
                <admin-field asp-for="Name" size="lg"/>
            </div>
            <div class="mt-3">
                <textarea id="Text" name="Text">@Model.Text</textarea>
                <span asp-validation-for="Text"></span>
            </div>
        </admin-card>
    </admin-page>
    <script>
        $(document).ready(function () {
            CodeMirror.fromTextArea(document.getElementById('Text'), {
                lineNumbers: true
            });

        });
    </script>
</form>