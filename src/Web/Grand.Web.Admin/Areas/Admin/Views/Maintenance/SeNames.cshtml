@model UrlEntityListModel
@{
    //page title
    ViewBag.Title = Loc["admin.configuration.senames"];
}


@* The country list's shape: the name as the quick search with the active state behind the
   Filters toggle, Delete selected in the bulk bar that appears while rows are ticked, and the grid
   in a flush card. There is no Add new, so Search is the screen's one primary button. The ids the
   script below looks up are unchanged. *@
<admin-page title="@Loc["admin.configuration.senames"]" icon="bi-diagram-3">
    <page-actions>
        <vc:admin-widget widget-zone="senames_buttons" additional-data="null"/>
    </page-actions>

    <vc:admin-widget widget-zone="senames_top" additional-data="null"/>

    <admin-filters id="senames-filters" submit-id="search-senames">
        <filters-search>
            <admin-input asp-for="SeName"/>
        </filters-search>
        <admin-field asp-for="SearchActiveId" asp-items="Model.AvailableActiveOptions"/>
    </admin-filters>

    <vc:admin-widget widget-zone="senames_bottom" additional-data="null"/>

    <admin-card flush>
        <admin-bulkbar grid-id="sename-grid">
            <button type="button" id="delete-selected" class="btn btn-outline-danger btn-sm">
                <i class="bi bi-trash"></i> @Loc["admin.configuration.senames.DeleteSelected"]
            </button>
        </admin-bulkbar>
        <admin-grid id="sename-grid"
                    read-url="@Url.Action("SeNames", "Maintenance", new { area = Constants.AreaAdmin })"
                    additional-data="additionalData"
                    selectable="Checkbox"
                    on-change="onSeNameSelectionChange">
            <grid-column field="Name" title="@Loc["admin.configuration.senames.Name"]" width="300">
                <cell-template>
                    <a data-if="DetailsUrl && DetailsUrl.length > 0" class="text-decoration-none" href="{{ DetailsUrl }}">{{ Name }}</a>
                </cell-template>
            </grid-column>
            <grid-column field="EntityName" title="@Loc["admin.configuration.senames.EntityName"]" width="100"/>
            <grid-column field="IsActive" title="@Loc["admin.configuration.senames.IsActive"]" width="50" align="Center">
                <cell-template>
                    <i data-if="IsActive" class="bi bi-check-lg text-success" aria-hidden="true"></i>
                    <i data-else class="bi bi-x-lg text-danger" aria-hidden="true"></i>
                </cell-template>
            </grid-column>
            <grid-column field="Language" title="@Loc["admin.configuration.senames.Language"]" width="100"/>
        </admin-grid>
    </admin-card>
</admin-page>


<script>
    var selectedIds = [];

    function onSeNameSelectionChange(e) {
        selectedIds = e.selectedIds;
    }

    $(document).ready(function() {

        //search button
        $('#search-senames').click(function() {
            //search
            var grid = GrandAdmin.grids.get('#sename-grid');
            grid.dataSource.page(1); //new search. Set page size to 1
            //grid.dataSource.read(); we already loaded the grid above using "page" function
            GrandAdmin.grids.get('#sename-grid').clearSelection();
            return false;
        });

        $("#@Html.IdFor(model => model.SeName)").keydown(function(event) {
            if (event.keyCode == 13) {
                $("#search-senames").click();
                return false;
            }
        });

        //"delete selected" button
        $('#delete-selected').click(function(e) {
            e.preventDefault();

            var postData = {
                selectedIds: selectedIds
            };
            addAntiForgeryToken(postData);

            $.ajax({
                cache: false,
                type: "POST",
                url: "@(Url.Action("DeleteSelectedSeNames", "Maintenance", new { area = Constants.AreaAdmin }))",
                data: postData,
                complete: function(data) {
                    //reload grid
                    var grid = GrandAdmin.grids.get('#sename-grid');
                    grid.dataSource.page(1); //new search. Set page size to 1
                    //grid.dataSource.read(); we already loaded the grid above using "page" function
                    GrandAdmin.grids.get('#sename-grid').clearSelection();
                },
                error: function(xhr, ajaxOptions, thrownError) {
                    alert(thrownError);
                },
                traditional: true
            });
            return false;
        });


    });

    function additionalData() {
        var data = {
            SeName: $('#@Html.IdFor(model => model.SeName)').val(),
            SearchActiveId: $('#@Html.IdFor(model => model.SearchActiveId)').val()
        };
        addAntiForgeryToken(data);
        return data;
    }


</script>