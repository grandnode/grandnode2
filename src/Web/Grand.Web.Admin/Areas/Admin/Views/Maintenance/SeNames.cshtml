@model UrlEntityListModel
@{
    //page title
    ViewBag.Title = Loc["admin.configuration.senames"];
}


<div class="row">
    <div class="col-md-12">
        <div class="x_panel light form-fit">
            <div class="x_title">
                <div class="caption">
                    <i class="bi bi-diagram-3"></i>
                    @Loc["admin.configuration.senames"]
                </div>
                <vc:admin-widget widget-zone="senames_buttons" additional-data="null"/>
                <div class="actions btn-group btn-group-devided">
                    <span id="delete-selected" class="btn red">
                        <i class="bi bi-trash"></i> @Loc["admin.configuration.senames.DeleteSelected"]
                    </span>
                </div>
            </div>
            <div class="x_content form">
                <vc:admin-widget widget-zone="senames_top" additional-data="null"/>
                <div class="form-horizontal">
                    <div class="form-body">
                        <div class="row align-items-end mb-3">
                            <div class="col-md-6 col-sm-12 col-12">
                                <div class="mb-0">
                                    <admin-label asp-for="SeName" class="d-flex flex-column align-items-start mw-100 px-0 text-start"/>
                                    <admin-input asp-for="SeName"/>
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-12 col-12">
                                <div class="mb-0">
                                    <admin-label asp-for="SearchActiveId" class="d-flex flex-column align-items-start mw-100 px-0 text-start"/>
                                    <admin-select asp-for="SearchActiveId" asp-items="Model.AvailableActiveOptions"/>
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-12 col-12 mt-md-0 mt-3">
                                <div class="form-actions">
                                    <button class="btn btn-success filter-submit" id="search-senames">
                                        <i class="bi bi-search"></i> @Loc["Admin.Common.Search"]
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <vc:admin-widget widget-zone="senames_bottom" additional-data="null"/>
            </div>
            <div class="x_content">
                <admin-grid id="sename-grid"
                            read-url="@Url.Action("SeNames", "Maintenance", new { area = Constants.AreaAdmin })"
                            additional-data="additionalData"
                            selectable="Checkbox"
                            on-change="onSeNameSelectionChange">
                    <grid-column field="Name" title="@Loc["admin.configuration.senames.Name"]" width="300">
                        <cell-template>
                            <a data-if="DetailsUrl && DetailsUrl.length > 0" class="k-link" href="{{ DetailsUrl }}">{{ Name }}</a>
                        </cell-template>
                    </grid-column>
                    <grid-column field="EntityName" title="@Loc["admin.configuration.senames.EntityName"]" width="100"/>
                    <grid-column field="IsActive" title="@Loc["admin.configuration.senames.IsActive"]" width="50" align="Center">
                        <cell-template>
                            <i data-if="IsActive" class="bi bi-check-lg" aria-hidden="true" style="color:green"></i>
                            <i data-else class="bi bi-x-lg" aria-hidden="true" style="color:red"></i>
                        </cell-template>
                    </grid-column>
                    <grid-column field="Language" title="@Loc["admin.configuration.senames.Language"]" width="100"/>
                </admin-grid>
            </div>
        </div>
    </div>
</div>


<script>
    var selectedIds = [];

    function onSeNameSelectionChange(e) {
        selectedIds = e.selectedIds;
    }

    $(document).ready(function() {

        //search button
        $('#search-senames').click(function() {
            //search
            var grid = $('#sename-grid').data('kendoGrid');
            grid.dataSource.page(1); //new search. Set page size to 1
            //grid.dataSource.read(); we already loaded the grid above using "page" function
            $('#sename-grid').data('kendoGrid').clearSelection();
            return false;
        });

        $("#@Html.IdFor(model => model.SeName)").keydown(function(event) {
            if (event.keyCode == 13) {
                $("#search-senames").click();
                return false;
            }
        });

        //"delete selected" button
        $('#delete-selected').click(function(e) {
            e.preventDefault();

            var postData = {
                selectedIds: selectedIds
            };
            addAntiForgeryToken(postData);

            $.ajax({
                cache: false,
                type: "POST",
                url: "@(Url.Action("DeleteSelectedSeNames", "Maintenance", new { area = Constants.AreaAdmin }))",
                data: postData,
                complete: function(data) {
                    //reload grid
                    var grid = $('#sename-grid').data('kendoGrid');
                    grid.dataSource.page(1); //new search. Set page size to 1
                    //grid.dataSource.read(); we already loaded the grid above using "page" function
                    $('#sename-grid').data('kendoGrid').clearSelection();
                },
                error: function(xhr, ajaxOptions, thrownError) {
                    alert(thrownError);
                },
                traditional: true
            });
            return false;
        });


    });

    function additionalData() {
        var data = {
            SeName: $('#@Html.IdFor(model => model.SeName)').val(),
            SearchActiveId: $('#@Html.IdFor(model => model.SearchActiveId)').val()
        };
        addAntiForgeryToken(data);
        return data;
    }


</script>