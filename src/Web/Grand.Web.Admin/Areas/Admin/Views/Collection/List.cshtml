@model CollectionListModel
@{
    ViewBag.Title = Loc["Admin.Catalog.Collections"];
}

<div class="row">
    <div class="col-md-12">
        <div class="x_panel light form-fit">
            <div class="x_title">
                <div class="caption">
                    <i class="bi bi-building"></i>
                    @Loc["Admin.Catalog.Collections"]
                </div>
                <div class="actions btn-group btn-group-devided util-btn-margin-bottom-5">
                    <a href="@Url.Action("Create", new { area = Constants.AreaAdmin })" class="btn green">
                        <i class="bi bi-plus-lg"></i><span class="d-none d-sm-inline"> @Loc["Admin.Common.AddNew"] </span>
                    </a>
                    <a href="@Url.Action("ExportXlsx", new { area = Constants.AreaAdmin })" class="btn default">
                        <i class="bi bi-file-earmark-excel"></i> @Loc["Admin.Common.ExportToExcel"]
                    </a>
                    <button type="button" id="importexcel" name="importexcel" class="btn blue">
                        <i class="bi bi-upload"></i>
                        @Loc["Admin.Common.ImportFromExcel"]
                    </button>
                    <vc:admin-widget widget-zone="collection_list_buttons" additional-data="null"/>
                </div>
            </div>
            <div class="x_content form">
                <div class="form-horizontal">
                    <div class="form-body">
                        <div class="row align-items-end">
                            <div class="col-md-6 col-sm-12 col-12">
                                <div class="mb-0">
                                    <admin-label asp-for="SearchCollectionName" class="d-flex flex-column align-items-start mw-100 px-0 text-start"/>
                                    <admin-input asp-for="SearchCollectionName"/>
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-12 col-12">
                                <div class="mb-0">
                                    <admin-label asp-for="SearchStoreId" class="d-flex flex-column align-items-start mw-100 px-0 text-start"/>
                                    <admin-select asp-for="SearchStoreId" asp-items="Model.AvailableStores"/>
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-12 col-12 mt-md-0 mt-3">
                                <div class="form-actions">
                                    <button class="btn btn-success filter-submit" id="search-collections">
                                        <i class="bi bi-search"></i> @Loc["Admin.Common.Search"]
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="x_content">
                <admin-grid id="collections-grid"
                            read-url="@Url.Action("List", "Collection", new { area = Constants.AreaAdmin })"
                            additional-data="additionalData">
                    <grid-column field="Name" title="@Loc["Admin.Catalog.Collections.Fields.Name"]">
                        <cell-template>
                            <a class="k-link" href="Edit/{{ Id }}">{{ Name }}</a>
                        </cell-template>
                    </grid-column>
                    <grid-column field="ShowOnHomePage" title="@Loc["Admin.Catalog.Collections.Fields.ShowOnHomePage"]" width="175" align="Center" min-screen-width="750">
                        <cell-template>
                            <i data-if="ShowOnHomePage" class="bi bi-check-lg" aria-hidden="true" style="color:green"></i>
                            <i data-else class="bi bi-x-lg" aria-hidden="true" style="color:red"></i>
                        </cell-template>
                    </grid-column>
                    <grid-column field="IncludeInMenu" title="@Loc["Admin.Catalog.Collections.Fields.IncludeInMenu"]" width="175" align="Center" min-screen-width="750">
                        <cell-template>
                            <i data-if="IncludeInMenu" class="bi bi-check-lg" aria-hidden="true" style="color:green"></i>
                            <i data-else class="bi bi-x-lg" aria-hidden="true" style="color:red"></i>
                        </cell-template>
                    </grid-column>
                    <grid-column field="Published" title="@Loc["Admin.Catalog.Collections.Fields.Published"]" width="100" align="Center" min-screen-width="500">
                        <cell-template>
                            <i data-if="Published" class="bi bi-check-lg" aria-hidden="true" style="color:green"></i>
                            <i data-else class="bi bi-x-lg" aria-hidden="true" style="color:red"></i>
                        </cell-template>
                    </grid-column>
                    <grid-column field="DisplayOrder" title="@Loc["Admin.Catalog.Collections.Fields.DisplayOrder"]" width="125" align="Center" min-screen-width="750"/>
                </admin-grid>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        //search button
        $('#search-collections').click(function () {
            //search
            var grid = $('#collections-grid').data('kendoGrid');
            grid.dataSource.page(1);
            return false;
        });

        $("#@Html.IdFor(model => model.SearchCollectionName)").keydown(function (event) {
            if (event.keyCode == 13) {
                $("#search-collections").click();
                return false;
            }
        });
    });

    function additionalData() {
        var data = {
            SearchCollectionName: $('#@Html.IdFor(model => model.SearchCollectionName)').val(),
            SearchStoreId: $('#SearchStoreId').val()
        };
        addAntiForgeryToken(data);
        return data;
    }
</script>
<div class="modal-dialog" id="importexcel-window" style="display:none; padding: 0 10px;">
    <form asp-area="@Constants.AreaAdmin" asp-controller="Collection" asp-action="ImportFromXlsx" method="post" enctype="multipart/form-data">

        <em>@Loc["Admin.Catalog.Collection.List.ImportFromExcelTip"]</em>
        <div class="mb-3">
            &nbsp;
        </div>
        <div class="mb-3">
            <div class="col-md-3" style="margin-top: 2px; height: 34px; padding-left: 25px;">
                <label class="control-label">
                    @Loc["Admin.Common.ExcelFile"]:
                </label>
            </div>
            <div class="col-md-9">
                <input type="file" id="importexcelfile" name="importexcelfile"/>
            </div>
        </div>
        <div class="mb-3">
            &nbsp;
        </div>
        <div class="mb-3">
            <div class="col-md-2">
                &nbsp;
            </div>
            <div class="col-md-10 text-end mt-10">
                <input type="submit" class="k-button" value="@Loc["Admin.Common.ImportFromExcel"]"/>
            </div>
        </div>
    </form>
</div>
<script>
    $(document).ready(function () {
        $("#importexcel").click(function (e) {
            e.preventDefault();
            GrandAdmin.modal.open("#importexcel-window", { title: "@Loc["Admin.Common.ImportFromExcel"]", actions: ["Close"] });
        });
    });
</script>