@model LanguageModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Configuration.Languages.EditLanguageDetails"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Language" asp-action="Edit" method="post">

    @* the record name as the title, Save as the one primary action, export, import and Delete in the overflow menu *@
    <admin-page sticky
                title="@Model.Name"
                icon="bi-translate"
                meta="@Loc["Admin.Configuration.Languages.EditLanguageDetails"]"
                back-url="@Url.Action("List", "Language", new { area = Constants.AreaAdmin })"
                back-text="@Loc["Admin.Configuration.Languages.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <admin-action-menu>
                <admin-action url="@Url.Action("ExportXml", new { id = Model.Id, area = Constants.AreaAdmin })"
                              icon="bi-download" text="@Loc["Admin.Configuration.Languages.Export"]"/>
                <admin-action id="importxml" icon="bi-upload" text="@Loc["Admin.Configuration.Languages.Import"]"/>
                <admin-action id="language-delete" destructive="true" icon="bi-trash"
                              text="@Loc["Admin.Common.Delete"]"/>
            </admin-action-menu>
            <vc:admin-widget widget-zone="language_details_buttons" additional-data="Model"/>
        </page-actions>

        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>
<admin-delete-confirmation button-id="language-delete"/>
<admin-import-window id="importxml-window" button-id="importxml"
                     title="@Loc["Admin.Configuration.Languages.Import"]"
                     controller="Language" action="ImportXml" route-id="@Model.Id"
                     file-name="importxmlfile" file-label="@Loc["Admin.Configuration.Languages.XmlFile"]"
                     accept=".xml"
                     submit-id="importxmlsubmit"
                     submit-text="@Loc["Admin.Configuration.Languages.Import"]">
    <ul class="common-list">
        <li>
            <strong>@Loc["Admin.Configuration.Languages.XmlFile.Note1"]</strong>
        </li>
        <li>
            <strong>@Loc["Admin.Configuration.Languages.XmlFile.Note2"]</strong>
        </li>
    </ul>
</admin-import-window>
