@model LanguageModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Configuration.Languages.EditLanguageDetails"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Language" asp-action="Edit" method="post">

    <div class="row">
        <div class="col-md-12">
            <div class="x_panel light form-fit">
                <div class="x_title">
                    <div class="caption">
                        <i class="bi bi-translate"></i>
                        @Loc["Admin.Configuration.Languages.EditLanguageDetails"] - @Model.Name
                        <small>
                            <i class="bi bi-arrow-left-circle"></i>@Html.ActionLink(Loc["Admin.Configuration.Languages.BackToList"], "List")
                        </small>
                    </div>
                    <div class="actions">
                        <div class="btn-group btn-group-devided">
                            <button class="btn btn-success" type="submit" name="save">
                                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
                            </button>
                            <button class="btn btn-success" type="submit" name="save-continue">
                                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
                            </button>
                            <a href="@Url.Action("ExportXml", new { id = Model.Id, area = Constants.AreaAdmin })" class="btn blue">@Loc["Admin.Configuration.Languages.Export"]</a>
                            <input type="button" id="importxml" class="btn yellow" value="@Loc["Admin.Configuration.Languages.Import"]"/>
                            <span id="language-delete" class="btn red">
                                <i class="bi bi-trash"></i> @Loc["Admin.Common.Delete"]
                            </span>
                            <vc:admin-widget widget-zone="language_details_buttons" additional-data="Model"/>
                        </div>
                    </div>
                </div>
                <div class="x_content form">
                    <partial name="Partials/CreateOrUpdate" model="Model"/>
                </div>
            </div>
        </div>
    </div>
</form>
<admin-delete-confirmation button-id="language-delete"/>
<admin-import-window id="importxml-window" button-id="importxml"
                     title="@Loc["Admin.Configuration.Languages.Import"]"
                     controller="Language" action="ImportXml" route-id="@Model.Id"
                     file-name="importxmlfile" file-label="@Loc["Admin.Configuration.Languages.XmlFile"]"
                     accept=".xml"
                     submit-id="importxmlsubmit"
                     submit-text="@Loc["Admin.Configuration.Languages.Import"]">
    <ul class="common-list">
        <li>
            <strong>@Loc["Admin.Configuration.Languages.XmlFile.Note1"]</strong>
        </li>
        <li>
            <strong>@Loc["Admin.Configuration.Languages.XmlFile.Note2"]</strong>
        </li>
    </ul>
</admin-import-window>