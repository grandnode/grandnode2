@{
    //page title
    ViewBag.Title = Loc["Admin.Configuration.Languages"];
}

<div class="row">
    <div class="col-md-12">
        <div class="x_panel light form-fit">
            <div class="x_title">
                <div class="caption">
                    <i class="bi bi-translate"></i>
                    @Loc["Admin.Configuration.Languages"]
                </div>
                <div class="actions btn-group btn-group-devided">
                    <a href="@Url.Action("Create", new { area = Constants.AreaAdmin })" class="btn green">
                        <i class="bi bi-plus-lg"></i><span class="d-none d-sm-inline"> @Loc["Admin.Common.AddNew"] </span>
                    </a>
                    <vc:admin-widget widget-zone="language_list_buttons" additional-data="null"/>
                </div>
            </div>
            <div class="x_content form">
                <div class="form-horizontal">
                    <div class="form-body">
                        <div class="x_content">
                            <admin-grid id="languages-grid"
                                        read-url="@Url.Action("List", "Language", new { area = Constants.AreaAdmin })"
                                        pager="Compact">
                                <grid-column field="Name" title="@Loc["Admin.Configuration.Languages.Fields.Name"]">
                                    <cell-template>
                                        <a class="k-link" href="Edit/{{ Id }}">{{ Name }}</a>
                                    </cell-template>
                                </grid-column>
                                <grid-column field="FlagImageFileName" title="@Loc["Admin.Configuration.Languages.Fields.FlagImage"]" width="22" align="Center">
                                    <cell-template>
                                        <img src="@Url.Content("~/assets/images/flags/"){{ FlagImageFileName }}" />
                                    </cell-template>
                                </grid-column>
                                <grid-column field="LanguageCulture" title="@Loc["Admin.Configuration.Languages.Fields.LanguageCulture"]" width="200"/>
                                <grid-column field="DisplayOrder" title="@Loc["Admin.Configuration.Languages.Fields.DisplayOrder"]" width="100"/>
                                <grid-column field="Published" title="@Loc["Admin.Configuration.Languages.Fields.Published"]" width="100" align="Center">
                                    <cell-template>
                                        <i data-if="Published" class="bi bi-check-lg" aria-hidden="true" style="color:green"></i>
                                        <i data-else class="bi bi-x-lg" aria-hidden="true" style="color:red"></i>
                                    </cell-template>
                                </grid-column>
                            </admin-grid>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


