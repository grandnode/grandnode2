@{
    //page title
    ViewBag.Title = Loc["Admin.Configuration.Languages"];
}

<admin-page title="@Loc["Admin.Configuration.Languages"]" icon="bi-translate">
    <page-actions>
        <a href="@Url.Action("Create", new { area = Constants.AreaAdmin })" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> @Loc["Admin.Common.AddNew"]
        </a>
        <vc:admin-widget widget-zone="language_list_buttons" additional-data="null"/>
    </page-actions>

    <admin-card flush>
        <admin-grid id="languages-grid"
                    read-url="@Url.Action("List", "Language", new { area = Constants.AreaAdmin })"
                    pager="Compact">
            <grid-column field="Name" title="@Loc["Admin.Configuration.Languages.Fields.Name"]">
                <cell-template>
                    <a class="text-decoration-none" href="Edit/{{ Id }}">{{ Name }}</a>
                </cell-template>
            </grid-column>
            <grid-column field="FlagImageFileName" title="@Loc["Admin.Configuration.Languages.Fields.FlagImage"]" width="22" align="Center">
                <cell-template>
                    <img src="@Url.Content("~/assets/images/flags/"){{ FlagImageFileName }}" />
                </cell-template>
            </grid-column>
            <grid-column field="LanguageCulture" title="@Loc["Admin.Configuration.Languages.Fields.LanguageCulture"]" width="200"/>
            <grid-column field="DisplayOrder" title="@Loc["Admin.Configuration.Languages.Fields.DisplayOrder"]" width="100"/>
            <grid-column field="Published" title="@Loc["Admin.Configuration.Languages.Fields.Published"]" width="100" align="Center">
                <cell-template>
                    <i data-if="Published" class="bi bi-check-lg text-success" aria-hidden="true"></i>
                    <i data-else class="bi bi-x-lg text-danger" aria-hidden="true"></i>
                </cell-template>
            </grid-column>
        </admin-grid>
    </admin-card>
</admin-page>
