@model ProductModel
@inject AdminAreaSettings adminAreaSettings
<vc:admin-widget widget-zone="product_details_prices_top" additional-data="Model"/>

@* Three cards instead of one column of 3/9 rows: what the product costs, how it may be bought,
   and what it is taxed as. The field order is the one this tab always had. Every id the script
   in CreateOrUpdate.Info.cshtml shows and hides - group-prices, pnlStartPrice,
   pnlPreOrderDateTime, pnlMinEnteredPrice, pnlMaxEnteredPrice, pnlBaseprice*, pnlTaxCategory,
   pnlIsTelecommunicationsOrBroadcastingOrElectronicServices - sits on the same field as before. *@
<admin-card id="group-prices">
    <div class="grand-fields grand-fields--2col">
        <admin-field asp-for="Price" suffix="@Model.PrimaryStoreCurrencyCode"/>
        <admin-field asp-for="OldPrice" suffix="@Model.PrimaryStoreCurrencyCode"/>
        <admin-field asp-for="CatalogPrice" suffix="@Model.PrimaryStoreCurrencyCode"/>
        <admin-field asp-for="StartPrice" id="pnlStartPrice" suffix="@Model.PrimaryStoreCurrencyCode"/>
        <admin-field asp-for="ProductCost" suffix="@Model.PrimaryStoreCurrencyCode"/>
    </div>
</admin-card>

@* the per-currency prices of the product: a grid of its own, so it keeps its own card *@
<partial name="Partials/CreateOrUpdate.ProductPrices" model="Model"/>

<admin-card>
    <div class="grand-fields grand-fields--2col">
        <admin-field asp-for="DisableBuyButton"/>
        <admin-field asp-for="DisableWishlistButton"/>
        <admin-field asp-for="AvailableForPreOrder"/>
        <admin-field asp-for="PreOrderDateTime" id="pnlPreOrderDateTime"/>
        <admin-field asp-for="CallForPrice"/>
        <admin-field asp-for="EnteredPrice"/>
        <admin-field asp-for="MinEnteredPrice" id="pnlMinEnteredPrice" suffix="@Model.PrimaryStoreCurrencyCode"/>
        <admin-field asp-for="MaxEnteredPrice" id="pnlMaxEnteredPrice" suffix="@Model.PrimaryStoreCurrencyCode"/>
        <admin-field asp-for="BasepriceEnabled"/>
        <admin-field asp-for="BasepriceAmount" id="pnlBasepriceAmount"/>
        <admin-field asp-for="BasepriceUnitId" id="pnlBasepriceUnit" asp-items="Model.AvailableBasepriceUnits"/>
        <admin-field asp-for="BasepriceBaseAmount" id="pnlBasepriceBaseAmount"/>
        <admin-field asp-for="BasepriceBaseUnitId" id="pnlBasepriceBaseUnit" asp-items="Model.AvailableBasepriceBaseUnits"/>
    </div>
</admin-card>

<admin-card>
    <div class="grand-fields grand-fields--2col">
        <admin-field asp-for="IsTaxExempt"/>
        <admin-field asp-for="TaxCategoryId" id="pnlTaxCategory" asp-items="Model.AvailableTaxCategories"/>
        <admin-field asp-for="IsTele" id="pnlIsTelecommunicationsOrBroadcastingOrElectronicServices"/>
    </div>
</admin-card>

@if (!string.IsNullOrEmpty(Model.Id))
{
    <admin-card title="@Loc["Admin.Catalog.Products.TierPrices"]" flush>
        <card-actions>
            <a id="btnAddNewTierPrice" href="@(Url.Action("TierPriceCreatePopup", "Product", new { productId = Model.Id, btnId = "btnRefreshTierPrices", formId = "product-form", area = Constants.AreaAdmin }))" class="btn btn-outline-secondary btn-sm"><i class="bi bi-plus-lg"></i> @Loc["Admin.Catalog.Products.TierPrices.AddNew"]</a>
            <input type="submit" id="btnRefreshTierPrices" style="display: none"/>
        </card-actions>
        @* Delete posts the whole row; the Kendo parameterMap posted only Id and ProductId, which are the
           fields TierPriceDeleteModel binds *@
        <admin-grid id="tierprices-grid"
                    read-url="@Url.Action("TierPriceList", "Product", new { productId = Model.Id, area = Constants.AreaAdmin })"
                    destroy-url="@Url.Action("TierPriceDelete", "Product", new { area = Constants.AreaAdmin })"
                    pager="Compact"
                    auto-bind="false"
                    on-data-bound="onTierPricesGridDataBound">
            <grid-text name="edit" value="@Loc["Admin.Common.Edit"]"/>
            @if (!adminAreaSettings.HideStoreColumn)
            {
                <grid-column field="StoreId" title="@Loc["Admin.Catalog.Products.TierPrices.Fields.Store"]">
                    <cell-template>{{ Store }}</cell-template>
                </grid-column>
            }
            <grid-column field="CustomerGroupId" title="@Loc["Admin.Catalog.Products.TierPrices.Fields.CustomerGroup"]">
                <cell-template>{{ CustomerGroup }}</cell-template>
            </grid-column>
            <grid-column field="Quantity" title="@Loc["Admin.Catalog.Products.TierPrices.Fields.Quantity"]" format="{0:0}"/>
            <grid-column field="Price" title="@Loc["Admin.Catalog.Products.TierPrices.Fields.Price"]">
                <cell-template>{{ Price }} [{{ CurrencyCode }}]</cell-template>
            </grid-column>
            <grid-column field="StartDateTime" title="@Loc["Admin.Catalog.Products.TierPrices.Fields.StartDateTime"]" format="{0:G}"/>
            <grid-column field="EndDateTime" title="@Loc["Admin.Catalog.Products.TierPrices.Fields.EndDateTime"]" format="{0:G}"/>
            <grid-column field="Id" title="@Loc["Admin.Common.Edit"]">
                <cell-template>
                    <a class="tierpriceedit" href="@Url.Action("TierPriceEditPopup", "Product", new { area = Constants.AreaAdmin })/{{ Id }}?productId=@(Model.Id)&btnId=btnRefreshTierPrices&formId=product-form"><span class="bi bi-pencil"></span>&nbsp;{{ $texts.edit }}</a>
                </cell-template>
            </grid-column>
            <grid-commands destroy="true" title="@Loc["Admin.Common.Delete"]"/>
        </admin-grid>
    </admin-card>

    <script>
        $(document).ready(function () {
            $('#btnAddNewTierPrice').magnificPopup({
                type: 'ajax',
                settings: { cache: false, async: false },
                midClick: true,
                callbacks: {
                    parseAjax: function (mfpResponse) {
                        mfpResponse.data = $('<div></div>').html(mfpResponse.data);
                    },
                    ajaxContentAdded: function () {
                        $('.mfp-wrap').removeAttr('tabindex');
                    }
                }
            });
        });

        function onTierPricesGridDataBound() {
            $('.tierpriceedit').magnificPopup({
                type: 'ajax',
                settings: { cache: false, async: false },
                midClick: true,
                callbacks: {
                    parseAjax: function (mfpResponse) {
                        mfpResponse.data = $('<div></div>').html(mfpResponse.data);
                    },
                    ajaxContentAdded: function () {
                        $('.mfp-wrap').removeAttr('tabindex');
                    }
                }
            });
        }

        $(document).ready(function () {
            $('#btnRefreshTierPrices').click(function () {
                $("#tierprices-grid").data('kendoGrid').dataSource.read();
                return false;
            });
        });
    </script>
}
else
{
    <div class="note note-info">
        @Loc["Admin.Catalog.Products.TierPrices.SaveBeforeEdit"]
    </div>
}

@if (Model.AvailableDiscounts is { Count: > 0 })
{
    <admin-card title="@Loc["Admin.Catalog.Products.AvailableDiscounts"]">
        <div class="grand-fields grand-fields--2col">
            @foreach (var discount in Model.AvailableDiscounts)
            {
                <div class="grand-field grand-field--check form-check">
                    <div class="grand-field__control">
                        <input type="checkbox" class="form-check-input" id="discount-@discount.Id" name="SelectedDiscountIds" value="@discount.Id"
                               checked="@(Model.SelectedDiscountIds != null && Model.SelectedDiscountIds.Contains(discount.Id))"/>
                    </div>
                    <label class="grand-field__label" for="discount-@discount.Id">@discount.Name</label>
                </div>
            }
        </div>
    </admin-card>
}
else
{
    <div class="note note-info">
        @Html.Raw(Loc["Admin.Catalog.Collections.Discounts.NoDiscounts"])
    </div>
}
<vc:admin-widget widget-zone="product_details_prices_bottom" additional-data="Model"/>
