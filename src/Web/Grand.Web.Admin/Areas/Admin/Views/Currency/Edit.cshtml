@model CurrencyModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Configuration.Currencies.EditCurrencyDetails"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Currency" asp-action="Edit" method="post">

    @* the record name as the title, Save as the one primary action, Delete in the overflow menu *@
    <admin-page sticky
                title="@Model.Name"
                icon="bi-globe"
                meta="@Loc["Admin.Configuration.Currencies.EditCurrencyDetails"]"
                back-url="@Url.Action("List", "Currency", new { area = Constants.AreaAdmin })"
                back-text="@Loc["Admin.Configuration.Currencies.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <admin-action-menu>
                <admin-action id="currency-delete" destructive="true" icon="bi-trash"
                              text="@Loc["Admin.Common.Delete"]"/>
            </admin-action-menu>
            <vc:admin-widget widget-zone="currency_details_buttons" additional-data="Model"/>
        </page-actions>

        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>
<admin-delete-confirmation button-id="currency-delete"/>
