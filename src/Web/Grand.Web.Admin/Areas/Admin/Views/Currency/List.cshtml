@{
    List<ExchangeRate> rates = ViewBag.Rates;
    bool autoUpdateEnabled = ViewBag.AutoUpdateEnabled ?? false;
    //page title
    ViewBag.Title = Loc["Admin.Configuration.Currencies"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Currency" asp-action="List">

    @* Save commits the exchange rate settings above the grid, so it is the one primary action and
       Add new moves into the header of the grid's card *@
    <admin-page title="@Loc["Admin.Configuration.Currencies"]" icon="bi-globe">
        <page-actions>
            <a href="@Url.Action("List", "Currency", new { liveRates = true, area = Constants.AreaAdmin })" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-repeat"></i> @Loc["Admin.Configuration.Currencies.GetLiveRates"]
            </a>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <vc:admin-widget widget-zone="currency_list_buttons" additional-data="null"/>
        </page-actions>

        <admin-card>
            <div class="grand-fields grand-fields--2col">
                <div class="grand-field grand-field--md">
                    <label class="grand-field__label" for="exchangeRateProvider">@Loc["Admin.Configuration.Currencies.Fields.ExchangeRateProvider"]</label>
                    <div class="grand-field__control">
                        @(Html.DropDownList("exchangeRateProvider", ViewBag.ExchangeRateProviders as IEnumerable<SelectListItem>, new Dictionary<string, object> { { "class", "form-select" } }))
                    </div>
                </div>
                <div class="grand-field grand-field--check form-check form-switch">
                    <label class="grand-field__label" for="autoUpdateEnabled">@Loc["Admin.Configuration.Currencies.Fields.CurrencyRateAutoUpdateEnabled"]</label>
                    <div class="grand-field__control">
                        @Html.CheckBox("autoUpdateEnabled", autoUpdateEnabled, new { @class = "form-check-input", role = "switch" })
                    </div>
                </div>
            </div>
        </admin-card>

        <admin-card flush>
            <card-actions>
                <a href="@Url.Action("Create", new { area = Constants.AreaAdmin })" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-plus-lg"></i> @Loc["Admin.Common.AddNew"]
                </a>
            </card-actions>
            <admin-grid id="currencies-grid"
                        read-url="@Url.Action("ListGrid", "Currency", new { area = Constants.AreaAdmin })"
                        pager="Compact">
                <grid-text name="markAsPrimaryExchangeRateCurrency" value="@Loc["Admin.Configuration.Currencies.Fields.MarkAsPrimaryExchangeRateCurrency"]"/>
                <grid-text name="markAsPrimaryStoreCurrency" value="@Loc["Admin.Configuration.Currencies.Fields.MarkAsPrimaryStoreCurrency"]"/>
                <grid-column field="Name" title="@Loc["Admin.Configuration.Currencies.Fields.Name"]">
                    <cell-template>
                        <a class="text-decoration-none" href="Edit/{{ Id }}">{{ Name }}</a>
                    </cell-template>
                </grid-column>
                <grid-column field="CurrencyCode" title="@Loc["Admin.Configuration.Currencies.Fields.CurrencyCode"]" width="50"/>
                <grid-column field="Rate" title="@Loc["Admin.Configuration.Currencies.Fields.Rate"]" width="80"/>
                <grid-column field="Id" title="@Loc["Admin.Configuration.Currencies.Fields.IsPrimaryExchangeRateCurrency"]">
                    <cell-template>
                        <a class="btn btn-outline-secondary btn-sm" data-grid-click="markAsPrimaryExchangeRateCurrency">
                        <i data-if="IsPrimaryExchangeRateCurrency" class="bi bi-check-lg text-success" aria-hidden="true"></i>
                        <i data-else class="bi bi-x-lg text-danger" aria-hidden="true"></i>
                        {{ $texts.markAsPrimaryExchangeRateCurrency }}</a>
                    </cell-template>
                </grid-column>
                <grid-column field="Id" title="@Loc["Admin.Configuration.Currencies.Fields.IsPrimaryStoreCurrency"]">
                    <cell-template>
                        <a class="btn btn-outline-secondary btn-sm" data-grid-click="markAsPrimaryStoreCurrency">
                        <i data-if="IsPrimaryStoreCurrency" class="bi bi-check-lg text-success" aria-hidden="true"></i>
                        <i data-else class="bi bi-x-lg text-danger" aria-hidden="true"></i>
                        {{ $texts.markAsPrimaryStoreCurrency }}</a>
                    </cell-template>
                </grid-column>
                <grid-column field="Published" title="@Loc["Admin.Configuration.Currencies.Fields.Published"]" width="100" align="Center">
                    <cell-template>
                        <i data-if="Published" class="bi bi-check-lg text-success" aria-hidden="true"></i>
                        <i data-else class="bi bi-x-lg text-danger" aria-hidden="true"></i>
                    </cell-template>
                </grid-column>
                <grid-column field="DisplayOrder" title="@Loc["Admin.Orders.CheckoutAttributes.Values.Fields.DisplayOrder"]" width="50"/>
            </admin-grid>
        </admin-card>

        @if (rates != null)
        {
            <admin-card title="@Loc["Admin.Configuration.Currencies.LiveRates"]" flush>
                @* the rates as the Kendo local data source had them: invariant strings, posted back as shown *@
                <admin-grid id="rate-grid"
                            data="@rates.Select(rate => new { CurrencyCode = rate.CurrencyCode ?? "", Rate = rate.Rate.ToString(CultureInfo.InvariantCulture) })"
                            pager="Compact">
                    <grid-text name="applyRate" value="@Loc["Admin.Configuration.Currencies.ApplyRate"]"/>
                    <grid-column field="CurrencyCode" title="@Loc["Admin.Configuration.Currencies.Fields.CurrencyCode"]" width="100"/>
                    <grid-column field="Rate" title="@Loc["Admin.Configuration.Currencies.Fields.Rate"]" width="100"/>
                    <grid-column field="CurrencyCode" title="@Loc["Admin.Configuration.Currencies.ApplyRate"]">
                        <cell-template>
                            <a class="btn btn-outline-secondary btn-sm" data-grid-click="applyCurrencyRate">{{ $texts.applyRate }}</a>
                        </cell-template>
                    </grid-column>
                </admin-grid>
            </admin-card>
        }
    </admin-page>
</form>
<script>
    function markAsPrimaryExchangeRateCurrency(currency) {
        GrandAdmin.modal.confirm('@Loc["Admin.Common.AreYouSure"]', {
            confirmText: '@Loc["Admin.Common.Yes"]',
            cancelText: '@Loc["Admin.Common.No"]'
        }).then(function (confirmed) {
            if (!confirmed) return;
            var postData = {
                id: currency.Id
            };
            addAntiForgeryToken(postData);
            $.ajax({
                cache: false,
                type: "POST",
                url: "@(Url.Action("MarkAsPrimaryExchangeRateCurrency", "Currency", new { area = Constants.AreaAdmin }))",
                data: postData,
            success: function(data) {
                var grid = $("#currencies-grid").data('kendoGrid');
                grid.dataSource.read();
            },
            error: function(xhr, ajaxOptions, thrownError) {
                alert('Failed to update currency');
            }
        });
        });
    };
    function markAsPrimaryStoreCurrency(currency) {
        GrandAdmin.modal.confirm('@Loc["Admin.Common.AreYouSure"]', {
            confirmText: '@Loc["Admin.Common.Yes"]',
            cancelText: '@Loc["Admin.Common.No"]'
        }).then(function (confirmed) {
            if (!confirmed) return;
            var postData = {
                id: currency.Id
            };
            addAntiForgeryToken(postData);
            $.ajax({
                cache: false,
                type: "POST",
                url: "@(Url.Action("MarkAsPrimaryStoreCurrency", "Currency", new { area = Constants.AreaAdmin }))",
                data: postData,
            success: function(data) {
                var grid = $("#currencies-grid").data('kendoGrid');
                grid.dataSource.read();
            },
            error: function(xhr, ajaxOptions, thrownError) {
                alert('Failed to update currency');
            }
        });
        });
    };
</script>

@if (rates != null)
{
    <script>
        function applyCurrencyRate(exchangeRate) {
            var postData = {
                rate: exchangeRate.Rate,
                currencyCode: exchangeRate.CurrencyCode
            };
            addAntiForgeryToken(postData);
            $.ajax({
                cache: false,
                type: "POST",
                url: "@(Url.Action("ApplyRate", new { area = Constants.AreaAdmin }))",
                data: postData,
                success: function(data) {
                    var grid = $("#currencies-grid").data('kendoGrid');
                    grid.dataSource.read();
                },
                error: function(xhr, ajaxOptions, thrownError) {
                    alert('Failed to update currency');
                }
            });
        };
    </script>
}
