@{
    List<ExchangeRate> rates = ViewBag.Rates;
    bool autoUpdateEnabled = ViewBag.AutoUpdateEnabled ?? false;
    //page title
    ViewBag.Title = Loc["Admin.Configuration.Currencies"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Currency" asp-action="List">

    <div class="row">
        <div class="col-md-12">
            <div class="x_panel light form-fit">
                <div class="x_title">
                    <div class="caption">
                        <i class="bi bi-globe"></i>
                        @Loc["Admin.Configuration.Currencies"]
                    </div>
                    <div class="actions btn-group btn-group-devided">
                        <button class="btn btn-success" type="submit" name="save">
                            <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
                        </button>
                        <a href="@Url.Action("List", "Currency", new { liveRates = true, area = Constants.AreaAdmin })" class="btn blue">@Loc["Admin.Configuration.Currencies.GetLiveRates"]</a>
                        <a href="@Url.Action("Create", new { area = Constants.AreaAdmin })" class="btn green">
                            <i class="bi bi-plus-lg"></i><span class="d-none d-sm-inline"> @Loc["Admin.Common.AddNew"] </span>
                        </a>
                        <vc:admin-widget widget-zone="currency_list_buttons" additional-data="null"/>
                    </div>
                </div>
                <div class="x_content form">
                    <div class="form-horizontal">
                        <div class="form-body">
                            <div class="mb-3">
                                <label class="control-label col-md-3 col-sm-3">
                                    @Loc["Admin.Configuration.Currencies.Fields.ExchangeRateProvider"]
                                </label>
                                <div class="col-md-9 col-sm-9">
                                    @(Html.DropDownList("exchangeRateProvider", ViewBag.ExchangeRateProviders as IEnumerable<SelectListItem>, new Dictionary<string, object> { { "class", "control-label" } }))
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="control-label col-md-3 col-sm-3">
                                    @Loc["Admin.Configuration.Currencies.Fields.CurrencyRateAutoUpdateEnabled"]
                                </label>
                                <div class="col-md-9 col-sm-9">
                                    <label class="mt-checkbox mt-checkbox-outline control control-checkbox">
                                        <admin-input asp-for="@autoUpdateEnabled"/>
                                        <div class="control__indicator"></div>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-horizontal">
                        <div class="form-body">
                            <div class="x_content">
                                <admin-grid id="currencies-grid"
                                            read-url="@Url.Action("ListGrid", "Currency", new { area = Constants.AreaAdmin })"
                                            pager="Compact">
                                    <grid-text name="markAsPrimaryExchangeRateCurrency" value="@Loc["Admin.Configuration.Currencies.Fields.MarkAsPrimaryExchangeRateCurrency"]"/>
                                    <grid-text name="markAsPrimaryStoreCurrency" value="@Loc["Admin.Configuration.Currencies.Fields.MarkAsPrimaryStoreCurrency"]"/>
                                    <grid-column field="Name" title="@Loc["Admin.Configuration.Currencies.Fields.Name"]">
                                        <cell-template>
                                            <a class="text-decoration-none" href="Edit/{{ Id }}">{{ Name }}</a>
                                        </cell-template>
                                    </grid-column>
                                    <grid-column field="CurrencyCode" title="@Loc["Admin.Configuration.Currencies.Fields.CurrencyCode"]" width="50"/>
                                    <grid-column field="Rate" title="@Loc["Admin.Configuration.Currencies.Fields.Rate"]" width="80"/>
                                    <grid-column field="Id" title="@Loc["Admin.Configuration.Currencies.Fields.IsPrimaryExchangeRateCurrency"]">
                                        <cell-template>
                                            <a class="btn btn-default btn-sm" data-grid-click="markAsPrimaryExchangeRateCurrency">
                                            <i data-if="IsPrimaryExchangeRateCurrency" class="bi bi-check-lg" aria-hidden="true" style="color:green;margin-right:5px;"></i>
                                            <i data-else class="bi bi-x-lg" aria-hidden="true" style="color:red;margin-right:5px;"></i>
                                            {{ $texts.markAsPrimaryExchangeRateCurrency }}</a>
                                        </cell-template>
                                    </grid-column>
                                    <grid-column field="Id" title="@Loc["Admin.Configuration.Currencies.Fields.IsPrimaryStoreCurrency"]">
                                        <cell-template>
                                            <a class="btn btn-default btn-sm" data-grid-click="markAsPrimaryStoreCurrency">
                                            <i data-if="IsPrimaryStoreCurrency" class="bi bi-check-lg" aria-hidden="true" style="color:green;margin-right:5px;"></i>
                                            <i data-else class="bi bi-x-lg" aria-hidden="true" style="color:red;margin-right:5px;"></i>
                                            {{ $texts.markAsPrimaryStoreCurrency }}</a>
                                        </cell-template>
                                    </grid-column>
                                    <grid-column field="Published" title="@Loc["Admin.Configuration.Currencies.Fields.Published"]" width="100" align="Center">
                                        <cell-template>
                                            <i data-if="Published" class="bi bi-check-lg" aria-hidden="true" style="color:green"></i>
                                            <i data-else class="bi bi-x-lg" aria-hidden="true" style="color:red"></i>
                                        </cell-template>
                                    </grid-column>
                                    <grid-column field="DisplayOrder" title="@Loc["Admin.Orders.CheckoutAttributes.Values.Fields.DisplayOrder"]" width="50"/>
                                </admin-grid>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
<script>
    function markAsPrimaryExchangeRateCurrency(currency) {
        if (confirm('@Loc["Admin.Common.AreYouSure"]')) {
            var postData = {
                id: currency.Id
            };
            addAntiForgeryToken(postData);
            $.ajax({
                cache: false,
                type: "POST",
                url: "@(Url.Action("MarkAsPrimaryExchangeRateCurrency", "Currency", new { area = Constants.AreaAdmin }))",
                data: postData,
            success: function(data) {
                var grid = $("#currencies-grid").data('kendoGrid');
                grid.dataSource.read();
            },
            error: function(xhr, ajaxOptions, thrownError) {
                alert('Failed to update currency');
            }
        });
        }
    };
    function markAsPrimaryStoreCurrency(currency) {
        if (confirm('@Loc["Admin.Common.AreYouSure"]')) {
            var postData = {
                id: currency.Id
            };
            addAntiForgeryToken(postData);
            $.ajax({
                cache: false,
                type: "POST",
                url: "@(Url.Action("MarkAsPrimaryStoreCurrency", "Currency", new { area = Constants.AreaAdmin }))",
                data: postData,
            success: function(data) {
                var grid = $("#currencies-grid").data('kendoGrid');
                grid.dataSource.read();
            },
            error: function(xhr, ajaxOptions, thrownError) {
                alert('Failed to update currency');
            }
        });
    }
    };
</script>

@if (rates != null)
{
    <h4>@Loc["Admin.Configuration.Currencies.LiveRates"]</h4>
    <div class="form-horizontal">
        <div class="form-body">
            @* the rates as the Kendo local data source had them: invariant strings, posted back as shown *@
            <admin-grid id="rate-grid"
                        data="@rates.Select(rate => new { CurrencyCode = rate.CurrencyCode ?? "", Rate = rate.Rate.ToString(CultureInfo.InvariantCulture) })"
                        pager="Compact">
                <grid-text name="applyRate" value="@Loc["Admin.Configuration.Currencies.ApplyRate"]"/>
                <grid-column field="CurrencyCode" title="@Loc["Admin.Configuration.Currencies.Fields.CurrencyCode"]" width="100"/>
                <grid-column field="Rate" title="@Loc["Admin.Configuration.Currencies.Fields.Rate"]" width="100"/>
                <grid-column field="CurrencyCode" title="@Loc["Admin.Configuration.Currencies.ApplyRate"]">
                    <cell-template>
                        <a class="btn btn-default btn-sm" data-grid-click="applyCurrencyRate">{{ $texts.applyRate }}</a>
                    </cell-template>
                </grid-column>
            </admin-grid>
        </div>
    </div>
    <script>
        function applyCurrencyRate(exchangeRate) {
            var postData = {
                rate: exchangeRate.Rate,
                currencyCode: exchangeRate.CurrencyCode
            };
            addAntiForgeryToken(postData);
            $.ajax({
                cache: false,
                type: "POST",
                url: "@(Url.Action("ApplyRate", new { area = Constants.AreaAdmin }))",
                data: postData,
                success: function(data) {
                    var grid = $("#currencies-grid").data('kendoGrid');
                    grid.dataSource.read();
                },
                error: function(xhr, ajaxOptions, thrownError) {
                    alert('Failed to update currency');
                }
            });
        };
    </script>
}