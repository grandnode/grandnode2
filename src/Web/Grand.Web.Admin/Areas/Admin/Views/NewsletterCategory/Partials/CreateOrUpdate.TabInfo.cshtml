@using Microsoft.AspNetCore.Mvc.Razor
@model NewsletterCategoryModel

@{
    Func<int, HelperResult>
        template = @<div class="grand-fields">
            <admin-field asp-for="@Model.Locales[item].Name"/>
            <admin-field asp-for="@Model.Locales[item].Description">
                <admin-input asp-for="@Model.Locales[item].Description" asp-template="Editor"/>
            </admin-field>
            <input asp-for="@Model.Locales[item].LanguageId" type="hidden"/>
        </div>;
}

@* The name and the rich-text description in the localized editor, each a full row, then the
   remaining fields two to a row. *@
<admin-card>
    <localized-editor localized-template="@template" name="newslettercategory-localized" language-ids="@Model.Locales.Select(c => c.LanguageId).ToList()">
        <div class="grand-fields">
            <admin-field asp-for="Name"/>
            <admin-field asp-for="Description">
                <admin-input asp-for="Description" asp-template="Editor"/>
            </admin-field>
        </div>
    </localized-editor>
    <div class="grand-fields grand-fields--2col mt-3">
        <admin-field asp-for="Selected"/>
        <admin-field asp-for="DisplayOrder" size="sm"/>
        <admin-field asp-for="Stores"/>
    </div>
</admin-card>
