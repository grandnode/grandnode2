@model NewsletterCategoryModel
@{
    //page title
    ViewBag.Title = Loc["admin.marketing.NewsletterCategory.Edit"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="NewsletterCategory" asp-action="Edit" method="post">

    @* the product edit screen's shell: the category's name as the title, Save as the one primary
       action, and Delete in the overflow menu rather than beside Save *@
    <admin-page sticky
                title="@Model.Name"
                icon="bi-tag"
                meta="@Loc["admin.marketing.NewsletterCategory.Edit"]"
                back-url="@Url.Action("List")"
                back-text="@Loc["admin.marketing.NewsletterCategory.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <admin-action-menu>
                <admin-action id="newslettercategory-delete" destructive="true" icon="bi-trash"
                              text="@Loc["Admin.Common.Delete"]"/>
            </admin-action-menu>
        </page-actions>

        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>
<admin-delete-confirmation button-id="newslettercategory-delete"/>
