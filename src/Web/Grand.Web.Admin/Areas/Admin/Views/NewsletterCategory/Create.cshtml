@model NewsletterCategoryModel
@{
    //page title
    ViewBag.Title = Loc["admin.marketing.NewsletterCategory.AddNew"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="NewsletterCategory" asp-action="Create" method="post">

    @* the same shell as Edit, minus what a category that does not exist yet cannot offer - the
       Delete this screen used to show had no confirmation behind it and nothing to delete *@
    <admin-page sticky
                title="@Loc["admin.marketing.NewsletterCategory.AddNew"]"
                icon="bi-tag"
                back-url="@Url.Action("List")"
                back-text="@Loc["admin.marketing.NewsletterCategory.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
        </page-actions>

        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>
