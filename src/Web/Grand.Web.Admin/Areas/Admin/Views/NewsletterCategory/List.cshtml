@{
    //page title
    ViewBag.Title = Loc["admin.marketing.NewsletterCategory"];
}

<div class="row">
    <div class="col-md-12">
        <div class="x_panel light form-fit">
            <div class="x_title">
                <div class="caption">
                    <i class="fa fa-tags"></i>
                    @Loc["admin.marketing.NewsletterCategory"]
                </div>
                <div class="actions btn-group btn-group-devided">
                    <a href="@Url.Action("Create", new { area = Constants.AreaAdmin })" class="btn green">
                        <i class="fa fa-plus"></i><span class="d-none d-sm-inline"> @Loc["Admin.Common.AddNew"] </span>
                    </a>
                </div>
            </div>
            <div class="x_content form">
                <div class="form-horizontal">
                    <div class="form-body">
                        <div class="x_content">
                            <admin-grid id="newslettercategory-grid"
                                        read-url="@Url.Action("List", "NewsletterCategory", new { area = Constants.AreaAdmin })"
                                        pager="Compact">
                                <grid-column field="Name" title="@Loc["admin.marketing.NewsletterCategory.Fields.Name"]">
                                    <cell-template>
                                        <a class="k-link" href="Edit/{{ Id }}">{{ Name }}</a>
                                    </cell-template>
                                </grid-column>
                                <grid-column field="Selected" title="@Loc["admin.marketing.NewsletterCategory.Fields.Selected"]" width="100" align="Center">
                                    <cell-template>
                                        <i data-if="Selected" class="fa fa-check" aria-hidden="true" style="color:green"></i>
                                        <i data-else class="fa fa-times" aria-hidden="true" style="color:red"></i>
                                    </cell-template>
                                </grid-column>
                                <grid-column field="DisplayOrder" title="@Loc["admin.marketing.NewsletterCategory.Fields.DisplayOrder"]" width="120"/>
                            </admin-grid>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
