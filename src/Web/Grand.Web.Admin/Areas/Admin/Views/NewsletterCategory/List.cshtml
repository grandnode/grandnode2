@{
    //page title
    ViewBag.Title = Loc["admin.marketing.NewsletterCategory"];
}

@* The product list's shape without filters: Add new as the one primary action in the page header
   and the grid in a flush card. *@
<admin-page title="@Loc["admin.marketing.NewsletterCategory"]" icon="bi-tags">
    <page-actions>
        <a href="@Url.Action("Create", new { area = Constants.AreaAdmin })" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> @Loc["Admin.Common.AddNew"]
        </a>
    </page-actions>

    <admin-card flush>
        <admin-grid id="newslettercategory-grid"
                    read-url="@Url.Action("List", "NewsletterCategory", new { area = Constants.AreaAdmin })"
                    pager="Compact">
            <grid-column field="Name" title="@Loc["admin.marketing.NewsletterCategory.Fields.Name"]">
                <cell-template>
                    <a class="text-decoration-none" href="Edit/{{ Id }}">{{ Name }}</a>
                </cell-template>
            </grid-column>
            <grid-column field="Selected" title="@Loc["admin.marketing.NewsletterCategory.Fields.Selected"]" width="100" align="Center">
                <cell-template>
                    <i data-if="Selected" class="bi bi-check-lg text-success" aria-hidden="true"></i>
                    <i data-else class="bi bi-x-lg text-danger" aria-hidden="true"></i>
                </cell-template>
            </grid-column>
            <grid-column field="DisplayOrder" title="@Loc["admin.marketing.NewsletterCategory.Fields.DisplayOrder"]" width="120"/>
        </admin-grid>
    </admin-card>
</admin-page>
