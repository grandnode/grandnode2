@{
    //page title
    ViewBag.Title = Loc["admin.marketing.Campaigns"];
}

<div class="row">
    <div class="col-md-12">
        <div class="x_panel light form-fit">
            <div class="x_title">
                <div class="caption">
                    <i class="fa fa-envelope"></i>
                    @Loc["admin.marketing.Campaigns"]
                </div>
                <div class="actions btn-group btn-group-devided">
                    <a href="@Url.Action("Create", new { area = Constants.AreaAdmin })" class="btn green">
                        <i class="fa fa-plus"></i><span class="d-none d-sm-inline"> @Loc["Admin.Common.AddNew"] </span>
                    </a>
                </div>
                <vc:admin-widget widget-zone="campaign_list_buttons" additional-data="null"/>
            </div>
            <div class="x_content form">
                <div class="form-horizontal">
                    <div class="form-body">
                        <div class="x_content">
                            <admin-grid id="campaigns-grid"
                                        read-url="@Url.Action("List", "Campaign", new { area = Constants.AreaAdmin })"
                                        pager="Compact">
                                <grid-column field="Name" title="@Loc["admin.marketing.Campaigns.Fields.Name"]">
                                    <cell-template>
                                        <a class="k-link" href="Edit/{{ Id }}">{{ Name }}</a>
                                    </cell-template>
                                </grid-column>
                                <grid-column field="CreatedOn" title="@Loc["admin.marketing.Campaigns.Fields.CreatedOn"]" width="200" format="{0:G}"/>
                            </admin-grid>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

