@{
    //page title
    ViewBag.Title = Loc["admin.marketing.Campaigns"];
}

@* The product list's shape without filters: Add new as the one primary action in the page header
   and the grid in a flush card. *@
<admin-page title="@Loc["admin.marketing.Campaigns"]" icon="bi-envelope">
    <page-actions>
        <vc:admin-widget widget-zone="campaign_list_buttons" additional-data="null"/>
        <a href="@Url.Action("Create", new { area = Constants.AreaAdmin })" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> @Loc["Admin.Common.AddNew"]
        </a>
    </page-actions>

    <admin-card flush>
        <admin-grid id="campaigns-grid"
                    read-url="@Url.Action("List", "Campaign", new { area = Constants.AreaAdmin })"
                    pager="Compact">
            <grid-column field="Name" title="@Loc["admin.marketing.Campaigns.Fields.Name"]">
                <cell-template>
                    <a class="text-decoration-none" href="Edit/{{ Id }}">{{ Name }}</a>
                </cell-template>
            </grid-column>
            <grid-column field="CreatedOn" title="@Loc["admin.marketing.Campaigns.Fields.CreatedOn"]" width="200" format="{0:G}"/>
        </admin-grid>
    </admin-card>
</admin-page>
