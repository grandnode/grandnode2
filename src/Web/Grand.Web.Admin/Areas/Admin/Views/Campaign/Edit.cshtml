@model CampaignModel
@{
    //page title
    ViewBag.Title = Loc["admin.marketing.Campaigns.EditCampaignDetails"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Campaign" asp-action="Edit" method="post" id="campaign-form">

    @* the product edit screen's shell: the campaign's name as the title, Save as the one primary
       action, sending beside it as a secondary one, and Delete in the overflow menu *@
    <admin-page sticky
                title="@Model.Name"
                icon="bi-envelope"
                meta="@Loc["admin.marketing.Campaigns.EditCampaignDetails"]"
                back-url="@Url.Action("List")"
                back-text="@Loc["admin.marketing.Campaigns.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="send-mass-email" asp-action="SendMassEmail">
                <i class="bi bi-send"></i> @Loc["admin.marketing.Campaigns.SendMassEmail"]
            </button>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <admin-action-menu>
                <admin-action id="campaign-delete" destructive="true" icon="bi-trash"
                              text="@Loc["Admin.Common.Delete"]"/>
            </admin-action-menu>
            <vc:admin-widget widget-zone="campaign_details_buttons" additional-data="Model"/>
        </page-actions>

        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>
<admin-delete-confirmation button-id="campaign-delete"/>
