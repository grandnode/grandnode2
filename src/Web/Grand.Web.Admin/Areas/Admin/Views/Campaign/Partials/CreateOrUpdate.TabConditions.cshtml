@using Grand.Domain.Messages
@model CampaignModel

@* Who receives the campaign: each from/to pair of dates side by side in one cell, then the
   selects and the tag, group and category pickers two to a row. *@
<admin-card>
    <div class="grand-fields grand-fields--2col">
        <div class="grand-range">
            <admin-field asp-for="CustomerCreatedDateFrom"/>
            <admin-field asp-for="CustomerCreatedDateTo"/>
        </div>
        <div class="grand-range">
            <admin-field asp-for="CustomerLastActivityDateFrom"/>
            <admin-field asp-for="CustomerLastActivityDateTo"/>
        </div>
        <div class="grand-range">
            <admin-field asp-for="CustomerLastPurchaseDateFrom"/>
            <admin-field asp-for="CustomerLastPurchaseDateTo"/>
        </div>
        <admin-field asp-for="StoreId" asp-items="Model.AvailableStores"/>
        <admin-field asp-for="CustomerHasOrders" asp-items="EnumTranslationService.ToSelectList((CampaignCondition)Model.CustomerHasOrders)"/>
        <admin-field asp-for="CustomerHasShoppingCart" asp-items="EnumTranslationService.ToSelectList((CampaignCondition)Model.CustomerHasShoppingCart)"/>
        <admin-field asp-for="CustomerTags">
            <admin-input asp-for="CustomerTags" asp-template="MultiSelect" asp-selectitem="Model.AvailableCustomerTags"/>
        </admin-field>
        <admin-field asp-for="CustomerGroups">
            <admin-input asp-for="CustomerGroups" asp-template="MultiSelect" asp-selectitem="Model.AvailableCustomerGroups"/>
        </admin-field>
        <admin-field asp-for="NewsletterCategories">
            <admin-input asp-for="NewsletterCategories" asp-template="MultiSelect" asp-selectitem="Model.AvailableNewsletterCategories"/>
        </admin-field>
    </div>
</admin-card>
