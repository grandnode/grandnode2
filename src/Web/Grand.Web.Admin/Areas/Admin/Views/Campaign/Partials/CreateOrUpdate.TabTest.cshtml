@model CampaignModel
@{
    if (!string.IsNullOrEmpty(Model.Id))
    {
        @* the warning is a genuine message, so it stays a note; the test address and its send
           button form one input group *@
        <div class="note note-danger">
            <strong>
                @Loc["admin.marketing.Campaigns.Warning"]
            </strong>
        </div>
        <admin-card>
            <div class="grand-fields grand-fields--2col">
                <admin-field asp-for="TestEmail">
                    <div class="input-group">
                        <admin-input asp-for="TestEmail"/>
                        <input type="submit" name="send-test-email" asp-action="SendTestEmail" class="btn btn-outline-secondary" value="@Loc["admin.marketing.Campaigns.SendTestEmail"]"/>
                    </div>
                </admin-field>
            </div>
        </admin-card>
    }
    else
    {
        <div class="note note-info">
            @Loc["admin.marketing.Campaigns.SaveBeforeEdit"]
        </div>
    }
}
