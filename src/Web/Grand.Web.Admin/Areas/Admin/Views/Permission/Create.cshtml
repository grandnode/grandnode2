@model PermissionCreateModel
@{
    Layout = "";
    //page title
    ViewBag.Title = Loc["Admin.Configuration.Permissions.AddNew"];
}
<form id="PermissionPopup" asp-area="@Constants.AreaAdmin" asp-controller="Permission" asp-action="Create" method="post">
    <admin-popup title="@Loc["Admin.Configuration.Permissions.AddNew"]" icon="bi-boxes">
        <div asp-validation-summary="All"></div>
        <div class="grand-fields grand-fields--2col">
            <admin-field asp-for="Name"/>
            <admin-field asp-for="SystemName"/>
            <admin-field asp-for="Area"/>
            <admin-field asp-for="Category"/>
        </div>
        <div class="grand-popup__actions">
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
        </div>
    </admin-popup>
    <script>
        var mfp = $.magnificPopup.instance;
        $("#PermissionPopup").submit(function (e) {
            e.preventDefault();
            var form = $(this);
            var url = form.attr('action');
            $.ajax({
                type: "POST",
                url: url,
                data: form.serialize(),
                success: function (data) {
                    if (data == "") {
                        mfp.close();
                        location.reload();
                    } else {
                        $.magnificPopup.open({
                            items: {
                                src: data,
                                type: 'inline'
                            },
                            callbacks: {
                                open: function () {
                                    $('.mfp-wrap').removeAttr('tabindex');
                                }
                            }
                        });
                    }
                }
            });
        });
    </script>
</form>
