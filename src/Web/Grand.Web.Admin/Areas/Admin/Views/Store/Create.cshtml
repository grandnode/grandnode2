@model StoreModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Configuration.Stores.AddNew"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Store" asp-action="Create" method="post" id="store-form">

    @* the same shell as Edit, minus what a record that does not exist yet cannot offer *@
    <admin-page sticky
                title="@Loc["Admin.Configuration.Stores.AddNew"]"
                icon="bi-cart"
                back-url="@Url.Action("List", "Store", new { area = Constants.AreaAdmin })"
                back-text="@Loc["Admin.Configuration.Stores.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <vc:admin-widget widget-zone="store_details_buttons" additional-data="null"/>
        </page-actions>

        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>
