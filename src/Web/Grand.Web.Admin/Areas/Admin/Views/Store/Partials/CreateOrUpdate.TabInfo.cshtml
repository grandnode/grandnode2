@using Microsoft.AspNetCore.Mvc.Razor
@model StoreModel

@{
    Func<int, HelperResult>
        template = @<div class="grand-fields grand-fields--2col">
            <admin-field asp-for="@Model.Locales[item].Name"/>
            <admin-field asp-for="@Model.Locales[item].Shortcut" size="md"/>
            <input asp-for="@Model.Locales[item].LanguageId" type="hidden"/>
        </div>;
}

@* the store and its defaults, then the company its documents are issued by *@
<admin-card>
    <localized-editor localized-template="@template" name="store-localized" language-ids="@Model.Locales.Select(c => c.LanguageId).ToList()">
        <div class="grand-fields grand-fields--2col">
            <admin-field asp-for="Name"/>
            <admin-field asp-for="Shortcut" size="md"/>
        </div>
    </localized-editor>
    <div class="grand-fields grand-fields--2col mt-3">
        <admin-field asp-for="Url" size="lg"/>
        <admin-field asp-for="DisplayOrder" size="sm"/>
        <admin-field asp-for="DefaultLanguageId" asp-items="Model.AvailableLanguages" size="md"/>
        <admin-field asp-for="DefaultWarehouseId" asp-items="Model.AvailableWarehouses" size="md"/>
        <admin-field asp-for="DefaultCountryId" asp-items="Model.AvailableCountries" size="md"/>
        <admin-field asp-for="DefaultCurrencyId" asp-items="Model.AvailableCurrencies" size="md"/>
    </div>
</admin-card>
<admin-card>
    <div class="grand-fields grand-fields--2col">
        <admin-field asp-for="CompanyName"/>
        <admin-field asp-for="CompanyRegNo" size="md"/>
        <admin-field asp-for="CompanyVat" size="md"/>
        <admin-field asp-for="CompanyAddress"/>
        <admin-field asp-for="CompanyPhoneNumber" size="md"/>
        <admin-field asp-for="CompanyEmail"/>
        <admin-field asp-for="CompanyHours"/>
    </div>
</admin-card>
