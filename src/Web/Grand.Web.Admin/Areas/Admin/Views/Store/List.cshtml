@{
    //page title
    ViewBag.Title = Loc["Admin.Configuration.Stores"];
}

<div class="row">
    <div class="col-md-12">
        <div class="x_panel light form-fit">
            <div class="x_title">
                <div class="caption">
                    <i class="bi bi-cart"></i>
                    @Loc["Admin.Configuration.Stores"]
                </div>
                <div class="actions btn-group btn-group-devided">
                    <a href="@Url.Action("Create", new { area = Constants.AreaAdmin })" class="btn green">
                        <i class="bi bi-plus-lg"></i><span class="d-none d-sm-inline"> @Loc["Admin.Common.AddNew"] </span>
                    </a>
                    <vc:admin-widget widget-zone="store_list_buttons" additional-data="null"/>
                </div>
            </div>
            <div class="x_content form">
                <div class="form-horizontal">
                    <div class="form-body">
                        <div class="x_content">
                            <admin-grid id="stores-grid"
                                        read-url="@Url.Action("List", "Store", new { area = Constants.AreaAdmin })"
                                        pager="Compact">
                                <grid-column field="Name" title="@Loc["Admin.Configuration.Stores.Fields.Name"]">
                                    <cell-template>
                                        <a class="text-decoration-none" href="Edit/{{ Id }}">{{ Name }}</a>
                                    </cell-template>
                                </grid-column>
                                <grid-column field="Url" title="@Loc["Admin.Configuration.Stores.Fields.Url"]"/>
                                <grid-column field="DisplayOrder" title="@Loc["Admin.Configuration.Stores.Fields.DisplayOrder"]"/>
                            </admin-grid>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

