@model PageListModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Content.Pages"];
}

<div class="row">
    <div class="col-md-12">
        <div class="x_panel light form-fit">
            <div class="x_title">
                <div class="caption">
                    <i class="bi bi-fw bi-file-earmark"></i>
                    @Loc["Admin.Content.Pages"]
                </div>
                <div class="actions btn-group btn-group-devided">
                    <a href="@Url.Action("Create", new { area = Constants.AreaAdmin })" class="btn green">
                        <i class="bi bi-plus-lg"></i><span class="d-none d-sm-inline"> @Loc["Admin.Common.AddNew"] </span>
                    </a>
                    <partial name="Partials/WidgetZone.ListButtons"/>
                </div>

            </div>
            <div class="x_content form">
                <div class="form-horizontal">
                    <div class="form-body">
                        <div class="row align-items-end mb-1">
                            <div class="col-md-3 col-sm-12 col-12">
                                <div class="mb-0">
                                    <admin-label asp-for="SearchStoreId" class="d-flex flex-column align-items-start mw-100 px-0 text-start"/>
                                    <admin-select asp-for="SearchStoreId" asp-items="Model.AvailableStores"/>
                                </div>
                            </div>
                            <div class="col-md-6 col-sm-12 col-12">
                                <div class="mb-0">
                                    <admin-label asp-for="Name" class="d-flex flex-column align-items-start mw-100 px-0 text-start"/>
                                    <admin-input asp-for="Name"/>
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-12 col-12 mt-md-0 mt-3">
                                <div class="form-actions">
                                    <button class="btn btn-success filter-submit" id="search-pages">
                                        <i class="bi bi-search"></i> @Loc["Admin.Common.Search"]
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="x_content">
                        <admin-grid id="pages-grid"
                                    read-url="@Url.Action("List", "Page", new { area = Constants.AreaAdmin })"
                                    additional-data="additionalData">
                            <grid-column field="SystemName" title="@Loc["Admin.Content.Pages.Fields.SystemName"]">
                                <cell-template>
                                    <a class="k-link" href="Edit/{{ Id }}">{{ SystemName }}</a>
                                </cell-template>
                            </grid-column>
                            <grid-column field="Title" title="@Loc["Admin.Content.Pages.Fields.Title"]">
                                <cell-template>
                                    {{ Title }}
                                </cell-template>
                            </grid-column>
                            <grid-column field="IncludeInMenu" title="@Loc["Admin.Content.Pages.Fields.IncludeInMenu"]" width="100" align="Center">
                                <cell-template>
                                    <i data-if="IncludeInMenu" class="bi bi-check-lg" aria-hidden="true" style="color:green"></i>
                                    <i data-else class="bi bi-x-lg" aria-hidden="true" style="color:red"></i>
                                </cell-template>
                            </grid-column>
                            <grid-column field="Published" title="@Loc["Admin.Content.Pages.Fields.Published"]" width="100" align="Center">
                                <cell-template>
                                    <i data-if="Published" class="bi bi-check-lg" aria-hidden="true" style="color:green"></i>
                                    <i data-else class="bi bi-x-lg" aria-hidden="true" style="color:red"></i>
                                </cell-template>
                            </grid-column>
                            <grid-column field="DisplayOrder" title="@Loc["Admin.Content.Pages.Fields.DisplayOrder"]" width="100"/>
                        </admin-grid>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<script>

    $(document).ready(function () {
        //search button
        $('#search-pages').click(function () {
            //search
            var grid = $('#pages-grid').data('kendoGrid');
            grid.dataSource.read();
            return false;
        });

        $("#@Html.IdFor(model => model.Name)").keydown(function (event) {
            if (event.keyCode == 13) {
                $("#search-pages").click();
                return false;
            }
        });

    });

    function additionalData() {
        var data = {
            SearchStoreId: $('#SearchStoreId').val(),
            Name: $('#@Html.IdFor(model => model.Name)').val()
        };
        addAntiForgeryToken(data);
        return data;
    }
</script>