@model VendorReviewModel
@inject IContextAccessor contextAccessor
@Html.ValidationSummary(false)
<input asp-for="Id" type="hidden"/>
@* the product review screen's shape: who, the rating and when are facts of the review; what the
   customer wrote and whether it is approved are editable *@
<admin-card>
    <div class="grand-facts">
        <div>
            <admin-label asp-for="VendorName" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Html.ActionLink(Model.VendorName, "Edit", "Vendor", new { id = Model.VendorId }, new { })</div>
        </div>
        <div>
            <admin-label asp-for="CustomerInfo" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Html.ActionLink(Model.CustomerInfo, "Edit", "Customer", new { id = Model.CustomerId }, new { })</div>
        </div>
        <div>
            <admin-label asp-for="Rating" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Model.Rating</div>
        </div>
        <div>
            <admin-label asp-for="CreatedOn" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Model.CreatedOn</div>
        </div>
    </div>
</admin-card>
<admin-card>
    <div class="grand-fields">
        <admin-field asp-for="Title"/>
        <admin-field asp-for="ReviewText">
            <admin-textarea asp-for="ReviewText"></admin-textarea>
        </admin-field>
        <admin-field asp-for="IsApproved"/>
    </div>
</admin-card>
