@{
    //page title
    ViewBag.Title = Loc["Admin.Dashboards.OnlineCustomers"];
}

<admin-page title="@Loc["Admin.Dashboards.OnlineCustomers"]" icon="bi-people">
    <page-actions>
        <vc:admin-widget widget-zone="online_customer_list" additional-data="null"/>
    </page-actions>
    <admin-card flush>
        <admin-grid id="onlinecustomers-grid" read-url="@Url.Action("List", "OnlineCustomer")">
            <grid-column field="Id" title="@Loc["Admin.Dashboards.OnlineCustomers.Fields.CustomerInfo"]" width="220">
                <cell-template>
                    <a class="text-decoration-none" href="@Url.Action("Edit", "Customer", new { area = Constants.AreaAdmin })/{{ Id }}">{{ CustomerInfo }}</a>
                </cell-template>
            </grid-column>
            <grid-column field="LastIpAddress" title="@Loc["Admin.Dashboards.OnlineCustomers.Fields.IPAddress"]" width="100"/>
            <grid-column field="LastActivityDate" title="@Loc["Admin.Dashboards.OnlineCustomers.Fields.LastActivityDate"]" width="200" format="{0:G}"/>
            <grid-column field="LastVisitedPage" title="@Loc["Admin.Dashboards.OnlineCustomers.Fields.LastVisitedPage"]" width="400"/>
        </admin-grid>
    </admin-card>
</admin-page>
