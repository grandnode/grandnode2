@model CountryModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Configuration.Countries.EditCountryDetails"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Country" asp-action="Edit" method="post" id="country-form">

    @* the record name as the title, Save as the one primary action, Delete in the overflow menu *@
    <admin-page sticky
                title="@Model.Name"
                icon="bi-globe"
                meta="@Loc["Admin.Configuration.Countries.EditCountryDetails"]"
                back-url="@Url.Action("List", "Country", new { area = Constants.AreaAdmin })"
                back-text="@Loc["Admin.Configuration.Countries.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <admin-action-menu>
                <admin-action id="country-delete" destructive="true" icon="bi-trash"
                              text="@Loc["Admin.Common.Delete"]"/>
            </admin-action-menu>
            <vc:admin-widget widget-zone="country_details_buttons" additional-data="Model"/>
        </page-actions>

        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>
<admin-delete-confirmation button-id="country-delete"/>
