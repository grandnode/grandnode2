@model CountriesListModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Configuration.Countries"];
}

@* The brand list's shape: Add new as the one primary action, the states export/import in the
   overflow menu, the name search as the filter bar, and publish/unpublish in the bulk bar that
   appears while rows are ticked. The ids the scripts below look up are unchanged. *@
<admin-page title="@Loc["Admin.Configuration.Countries"]" icon="bi-globe">
    <page-actions>
        <admin-action-menu text="@Loc["Admin.Common.Export"]">
            <admin-action url="@Url.Action("ExportExcel", new { area = Constants.AreaAdmin })"
                          icon="bi-file-earmark-excel" text="@Loc["Admin.Configuration.Countries.ExportStatesToExcel"]"/>
            <admin-action id="importexcel" name="importexcel" icon="bi-upload" text="@Loc["Admin.Configuration.Countries.ImportStatesFromExcel"]"/>
        </admin-action-menu>
        <vc:admin-widget widget-zone="country_list_buttons" additional-data="null"/>
        <a href="@Url.Action("Create", new { area = Constants.AreaAdmin })" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> @Loc["Admin.Common.AddNew"]
        </a>
    </page-actions>

    <admin-filters id="country-filters" submit-id="search-countries" secondary-submit="true">
        <filters-search>
            <admin-input asp-for="CountryName"/>
        </filters-search>
    </admin-filters>

    <admin-card flush>
        <admin-bulkbar grid-id="countries-grid">
            <button type="button" id="publish-selected" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-eye"></i> @Loc["Admin.Configuration.Countries.PublishSelected"]
            </button>
            <button type="button" id="unpublish-selected" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-eye-slash"></i> @Loc["Admin.Configuration.Countries.UnpublishSelected"]
            </button>
        </admin-bulkbar>
        <admin-grid id="countries-grid"
                    read-url="@Url.Action("CountryList", "Country", new { area = Constants.AreaAdmin })"
                    additional-data="additionalData"
                    pager="Compact"
                    selectable="Checkbox"
                    on-change="onCountriesSelectionChange">
            <grid-column field="Name" title="@Loc["Admin.Configuration.Countries.Fields.Name"]" width="300">
                <cell-template>
                    <a class="text-decoration-none" href="Edit/{{ Id }}">{{ Name }}</a>
                </cell-template>
            </grid-column>
            <grid-column field="AllowsBilling" title="@Loc["Admin.Configuration.Countries.Fields.AllowsBilling"]" width="100" align="Center">
                <cell-template>
                    <i data-if="AllowsBilling" class="bi bi-check-lg text-success" aria-hidden="true"></i>
                    <i data-else class="bi bi-x-lg text-danger" aria-hidden="true"></i>
                </cell-template>
            </grid-column>
            <grid-column field="AllowsShipping" title="@Loc["Admin.Configuration.Countries.Fields.AllowsShipping"]" width="100" align="Center">
                <cell-template>
                    <i data-if="AllowsShipping" class="bi bi-check-lg text-success" aria-hidden="true"></i>
                    <i data-else class="bi bi-x-lg text-danger" aria-hidden="true"></i>
                </cell-template>
            </grid-column>
            <grid-column field="TwoLetterIsoCode" title="@Loc["Admin.Configuration.Countries.Fields.TwoLetterIsoCode"]" width="100"/>
            <grid-column field="ThreeLetterIsoCode" title="@Loc["Admin.Configuration.Countries.Fields.ThreeLetterIsoCode"]" width="100"/>
            <grid-column field="NumericIsoCode" title="@Loc["Admin.Configuration.Countries.Fields.NumericIsoCode"]" width="100"/>
            <grid-column field="SubjectToVat" title="@Loc["Admin.Configuration.Countries.Fields.SubjectToVat"]" width="100" align="Center">
                <cell-template>
                    <i data-if="SubjectToVat" class="bi bi-check-lg text-success" aria-hidden="true"></i>
                    <i data-else class="bi bi-x-lg text-danger" aria-hidden="true"></i>
                </cell-template>
            </grid-column>
            <grid-column field="DisplayOrder" title="@Loc["Admin.Configuration.Countries.Fields.DisplayOrder"]" width="100"/>
            <grid-column field="Published" title="@Loc["Admin.Configuration.Countries.Fields.Published"]" width="100" align="Center">
                <cell-template>
                    <i data-if="Published" class="bi bi-check-lg text-success" aria-hidden="true"></i>
                    <i data-else class="bi bi-x-lg text-danger" aria-hidden="true"></i>
                </cell-template>
            </grid-column>
        </admin-grid>
    </admin-card>
</admin-page>

<script>
        var selectedIds = [];

        function onCountriesSelectionChange(e) {
            selectedIds = e.selectedIds;
        }

        $(document).ready(function () {

            //"publish selected" button
            $('#publish-selected').click(function (e) {
                e.preventDefault();

                var postData = {
                    selectedIds: selectedIds
                };
                addAntiForgeryToken(postData);

                $.ajax({
                    cache:false,
                    type: "POST",
                    url: "@(Url.Action("PublishSelected", "Country", new { area = Constants.AreaAdmin }))",
                    data: postData,
                    complete: function (data) {
                        //reload grid
                        var grid = $('#countries-grid').data('kendoGrid');
                        grid.dataSource.read();
                    },
                    error:function (xhr, ajaxOptions, thrownError){
                        alert(thrownError);
                    },
                    traditional: true
                });
                return false;
            });
            
            //"unpublish selected" button
            $('#unpublish-selected').click(function (e) {
                e.preventDefault();

                var postData = {
                    selectedIds: selectedIds
                };
                addAntiForgeryToken(postData);

                $.ajax({
                    cache:false,
                    type: "POST",
                    url: "@(Url.Action("UnpublishSelected", "Country", new { area = Constants.AreaAdmin }))",
                    data: postData,
                    complete: function (data) {
                        //reload grid
                        var grid = $('#countries-grid').data('kendoGrid');
                        grid.dataSource.read();
                    },
                    error:function (xhr, ajaxOptions, thrownError){
                        alert(thrownError);
                    },
                    traditional: true
                });
                return false;
            });
            

        });


</script>

<admin-import-window id="importexcel-window" button-id="importexcel"
                     title="@Loc["Admin.Common.ImportFromExcel"]"
                     controller="Country" action="ImportExcel"
                     file-name="importexcelfile" file-label="@Loc["Admin.Common.ExcelFile"]"
                     accept=".xlsx,.xls"
                     submit-text="@Loc["Admin.Common.ImportFromExcel"]"/>

<script>

    $(document).ready(function () {
        //search button
        $('#search-countries').click(function () {
            //search
            var grid = $('#countries-grid').data('kendoGrid');
            grid.dataSource.read();
        });

        $("#@Html.IdFor(model => model.CountryName)").keydown(function (event) {
            if (event.keyCode == 13) {
                $("#search-countries").click();
                return false;
            }
        });

    });

    function additionalData() {
        var data = {
            CountryName: $('#@Html.IdFor(model => model.CountryName)').val()
        };
        addAntiForgeryToken(data);
        return data;
    }
</script>