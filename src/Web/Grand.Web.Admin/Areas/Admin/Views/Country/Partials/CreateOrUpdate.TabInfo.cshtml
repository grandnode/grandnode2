@using Microsoft.AspNetCore.Mvc.Razor
@model CountryModel

<vc:admin-widget widget-zone="country_details_info_top" additional-data="Model"/>

@{
    Func<int, HelperResult>
        template = @<div class="grand-fields">
            <admin-field asp-for="@Model.Locales[item].Name"/>
            <input type="hidden" asp-for="@Model.Locales[item].LanguageId"/>
        </div>;
}

@* the name, the ISO codes, then what the country allows *@
<admin-card>
    <localized-editor localized-template="@template" name="country-info-localized" language-ids="@Model.Locales.Select(c => c.LanguageId).ToList()">
        <div class="grand-fields">
            <admin-field asp-for="Name"/>
        </div>
    </localized-editor>
    <div class="grand-fields grand-fields--2col mt-3">
        <admin-field asp-for="TwoLetterIsoCode" size="sm"/>
        <admin-field asp-for="ThreeLetterIsoCode" size="sm"/>
        <admin-field asp-for="NumericIsoCode" size="sm"/>
        <admin-field asp-for="DisplayOrder" size="sm"/>
        <admin-field asp-for="AllowsBilling"/>
        <admin-field asp-for="AllowsShipping"/>
        <admin-field asp-for="SubjectToVat"/>
        <admin-field asp-for="Published"/>
        <admin-field asp-for="Stores"/>
    </div>
</admin-card>
<vc:admin-widget widget-zone="country_details_info_bottom" additional-data="Model"/>
