@using Microsoft.AspNetCore.Mvc.Razor
@model StateProvinceModel

<div asp-validation-summary="All"></div>
<input asp-for="Id" type="hidden"/>
<input asp-for="CountryId" type="hidden"/>
<vc:admin-widget widget-zone="country_state_details_top" additional-data="Model"/>

@{
    Func<int, HelperResult>
        template = @<div class="grand-fields">
            <admin-field asp-for="@Model.Locales[item].Name"/>
            <input type="hidden" asp-for="@Model.Locales[item].LanguageId"/>
        </div>;
}

<localized-editor localized-template="@template" name="state-localized" language-ids="@Model.Locales.Select(c => c.LanguageId).ToList()">
    <div class="grand-fields">
        <admin-field asp-for="Name"/>
    </div>
</localized-editor>
<div class="grand-fields grand-fields--2col mt-3">
    <admin-field asp-for="Abbreviation" size="sm"/>
    <admin-field asp-for="DisplayOrder" size="sm"/>
    <admin-field asp-for="Published"/>
</div>
<vc:admin-widget widget-zone="country_state_details_bottom" additional-data="Model"/>
<div class="grand-popup__actions">
    <vc:admin-widget widget-zone="country_state_details_buttons" additional-data="null"/>
    <button class="btn btn-primary" type="submit" name="save">
        <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
    </button>
</div>
