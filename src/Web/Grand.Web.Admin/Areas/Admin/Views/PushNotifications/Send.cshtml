@model Grand.Web.AdminShared.Models.PushNotifications.PushModel
@{
    Layout = "_AdminLayout";
    //page title
    ViewBag.Title = Loc["Admin.PushNotifications.Send"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="PushNotifications" asp-action="Send" method="post">

    @* a form of four fields; Send is the page's one primary action *@
    <admin-page title="@Loc["Admin.PushNotifications"]" icon="bi-boxes">
        <page-actions>
            <input type="submit" name="generatekey" class="btn btn-primary" value="@Loc["Admin.PushNotifications.Send"]"/>
        </page-actions>
        <admin-card>
            <div class="grand-fields grand-fields--2col">
                <admin-field asp-for="Title"/>
                <admin-field asp-for="ClickUrl"/>
                <admin-field asp-for="MessageText">
                    <admin-textarea asp-for="MessageText"/>
                </admin-field>
                <admin-field asp-for="PictureId">
                    <admin-input asp-for="PictureId"/>
                </admin-field>
            </div>
        </admin-card>
    </admin-page>
</form>