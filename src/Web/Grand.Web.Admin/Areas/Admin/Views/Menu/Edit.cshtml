@using Grand.Web.Admin.Components
@using Grand.Web.Common.TagHelpers.Admin
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model MenuModel
@inject IMenuViewModelService MenuViewModelService
@{
    //page title
    ViewBag.Title = Loc["Admin.Configuration.Menu.Edit"];
    var parent = await MenuViewModelService.FindParentNodeById(Model.Id);
    //a child item goes back to its parent, a top-level one to the list
    var hasParent = parent != null && parent.Id != Model.Id;
    var backUrl = hasParent ? Url.Action("Edit", new { parent.Id, area = Constants.AreaAdmin }) : Url.Action("Index");
    var backText = hasParent ? Loc[parent.ResourceName].Value : Loc["Admin.Configuration.Menu.BackToList"].Value;
}

<form asp-area="@Constants.AreaAdmin" asp-controller="Menu" asp-action="Edit" method="post" id="menu-edit">

    @* the product edit screen's shell: the item's system name as the title, Save as the one
       primary action, and Delete in the overflow menu rather than beside Save *@
    <admin-page sticky
                title="@Model.SystemName"
                icon="bi-diagram-3"
                meta="@Loc["Admin.Configuration.Menu.Edit"]"
                back-url="@backUrl"
                back-text="@backText">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <admin-action-menu>
                <admin-action id="menu-delete" destructive="true" icon="bi-trash"
                              text="@Loc["Admin.Common.Delete"]"/>
            </admin-action-menu>
            <vc:admin-widget widget-zone="menu_details_buttons" additional-data="Model"/>
        </page-actions>

        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>
<admin-delete-confirmation button-id="menu-delete"/>
