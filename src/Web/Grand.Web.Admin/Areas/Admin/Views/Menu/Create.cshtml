@model MenuModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Configuration.Menu.AddNew"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Menu" asp-action="Create" method="post" asp-route-parentId="@HtmlExtensions.HtmlEncodeSafe(Context.Request.Query["parentId"])">
    @* the same shell as Edit, minus what a menu item that does not exist yet cannot offer *@
    <admin-page sticky
                title="@Loc["Admin.Configuration.Menu.AddNew"]"
                icon="bi-diagram-3"
                back-url="@Url.Action("Index")"
                back-text="@Loc["Admin.Configuration.Menu.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <vc:admin-widget widget-zone="menu_details_buttons" additional-data="null"/>
        </page-actions>

        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>
