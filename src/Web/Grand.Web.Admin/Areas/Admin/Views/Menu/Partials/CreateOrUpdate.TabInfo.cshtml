@model MenuModel

<vc:admin-widget widget-zone="menu_details_info_top" additional-data="Model"/>
<admin-card>
    <div class="grand-fields grand-fields--2col">
        <admin-field asp-for="SystemName"/>
        <admin-field asp-for="ResourceName"/>
        <admin-field asp-for="ControllerName"/>
        <admin-field asp-for="ActionName"/>
        <admin-field asp-for="Url"/>
        <admin-field asp-for="IconClass"/>
        <admin-field asp-for="DisplayOrder" size="sm"/>
        <admin-field asp-for="OpenUrlInNewTab"/>
        <admin-field asp-for="AllPermissions"/>
    </div>
</admin-card>
<vc:admin-widget widget-zone="menu_details_info_bottom" additional-data="Model"/>
