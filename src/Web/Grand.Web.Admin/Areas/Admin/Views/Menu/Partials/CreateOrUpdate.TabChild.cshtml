@model MenuModel

@if (!string.IsNullOrEmpty(Model.Id))
{
    <div class="panel panel-default">
        <vc:admin-widget widget-zone="menu_details_documents_top" additional-data="Model"/>
        <div class="panel-body">
            <admin-grid id="menu-grid"
                        read-url="@Url.Action("ChildItem", "Menu", new { ParentId = Model.Id, area = Constants.AreaAdmin })"
                        pager="None">
                <grid-column field="SystemName" title="@Loc["Admin.Configuration.Menu.Fields.SystemName"]" width="400">
                    <cell-template>
                        <a class="text-decoration-none" href="../Edit/{{ Id }}">{{ SystemName }}</a>
                    </cell-template>
                </grid-column>
                <grid-column field="DisplayOrder" title="@Loc["Admin.Configuration.Menu.Fields.DisplayOrder"]" width="125" align="Center"/>
            </admin-grid>
        </div>
        <div class="panel-footer">
            <button type="button" class="btn btn-default btn-sm" onclick="location.href='@Url.Action("Create", "Menu", new { parentId = Model.Id, area = Constants.AreaAdmin })'"><i class="bi bi-plus-lg"></i>&nbsp;@Loc["Admin.Common.AddNew"]</button>
        </div>
        <vc:admin-widget widget-zone="menu_details_documents_bottom" additional-data="Model"/>
    </div>
}
else
{
    <div class="note note-info">
        @Loc["Admin.Catalog.SaveBeforeEdit"]
    </div>
}