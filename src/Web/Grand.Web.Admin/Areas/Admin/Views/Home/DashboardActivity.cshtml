@model DashboardActivityModel
<table class="table table-hover">
    <tbody>
    <tr>
        <th scope="row">
            <div class="badge rounded-pill text-bg-info">
                <i class="bi bi-briefcase"></i>
            </div>
        </th>
        <td>
            @Loc["Admin.Dashboard.ActivityOverview.OrderPending"]
        </td>
        <td>
            @Model.OrdersPending
        </td>
    </tr>
    <tr>
        <th scope="row">
            <div class="badge rounded-pill text-bg-success">
                <i class="bi bi-cart"></i>
            </div>
        </th>
        <td>
            @Loc["Admin.Dashboard.ActivityOverview.AbandonedCarts"]
        </td>
        <td>
            @Model.AbandonedCarts
        </td>
    </tr>
    <tr>
        <th scope="row">
            <div class="badge rounded-pill text-bg-danger">
                <i class="bi bi-bell"></i>
            </div>
        </th>
        <td>
            @Loc["Admin.Dashboard.ActivityOverview.LowStockProducts"]
        </td>
        <td>
            @Model.LowStockProducts
        </td>
    </tr>
    <tr>
        <th scope="row">
            <div class="badge rounded-pill text-bg-warning">
                <i class="bi bi-person"></i>
            </div>
        </th>
        <td>
            @Loc["Admin.Dashboard.ActivityOverview.TodayRegisteredCustomers"]
        </td>
        <td>
            @Model.TodayRegisteredCustomers
        </td>
    </tr>
    <tr>
        <th scope="row">
            <div class="badge rounded-pill text-bg-secondary">
                <i class="bi bi-truck"></i>
            </div>
        </th>
        <td>
            @Loc["Admin.Dashboard.ActivityOverview.MerchandiseReturns"]
        </td>
        <td>
            @Model.MerchandiseReturns
        </td>
    </tr>
    </tbody>
</table>