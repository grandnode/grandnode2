@model CustomerModel
<div class="panel panel-default">
    <vc:admin-widget widget-zone="customer_details_documents_top" additional-data="Model"/>
    <div class="panel-body">
        <admin-grid id="customer-documents-grid"
                    read-url="@Url.Action("ListDocuments", "Document", new { customerId = Model.Id, StatusId = -1, area = Constants.AreaAdmin })"
                    auto-bind="false">
            <grid-column field="Number" title="@Loc["Admin.Documents.Document.Fields.Number"]">
                <cell-template>
                    <a class="k-link" href="@Url.Action("EditDocument", "Document", new { area = Constants.AreaAdmin })/{{ Id }}">{{ Number }}</a>
                </cell-template>
            </grid-column>
            <grid-column field="Name" title="@Loc["Admin.Documents.Document.Fields.Name"]">
                <cell-template>
                    <a class="k-link" href="@Url.Action("EditDocument", "Document", new { area = Constants.AreaAdmin })/{{ Id }}">{{ Name }}</a>
                </cell-template>
            </grid-column>
            <grid-column field="Published" title="@Loc["Admin.Documents.Document.Fields.Published"]" width="100" align="Center" min-screen-width="500">
                <cell-template>
                    <i data-if="Published" class="fa fa-check" aria-hidden="true" style="color:green"></i>
                    <i data-else class="fa fa-times" aria-hidden="true" style="color:red"></i>
                </cell-template>
            </grid-column>
        </admin-grid>
    </div>
    <div class="panel-footer">
        <button type="button" class="k-button" onclick="location.href='@Url.Action("CreateDocument", "Document", new { customerId = Model.Id, area = Constants.AreaAdmin })'"><i class="fa fa-plus"></i>&nbsp;@Loc["Admin.Marketing.Document.Add"]</button>
    </div>
    <vc:admin-widget widget-zone="customer_details_documents_bottom" additional-data="Model"/>
</div>

