@model CustomerModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Customers.Customers.EditCustomerDetails"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Customer" asp-action="Edit" method="post" id="customer-form">

    @* the customer's name as the title and Save as the one primary action; e-mail and
       impersonation beside it, the messages that ask first and Delete in the overflow menu *@
    <admin-page sticky
                title="@Model.LastName @Model.FirstName"
                icon="bi-person"
                meta="@Loc["Admin.Customers.Customers.EditCustomerDetails"]"
                back-url="@Url.Action("List")"
                back-text="@Loc["Admin.Customers.Customers.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" id="sendemail"><i class="bi bi-send" aria-hidden="true"></i> @Loc["Admin.Customers.Customers.SendEmail"]</button>
            <button class="btn btn-outline-secondary" type="submit" name="impersonate" asp-action="Impersonate"><i class="bi bi-cart" aria-hidden="true"></i> @Loc["Admin.Customers.Customers.Impersonate.Button"]</button>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <admin-action-menu>
                @if (Model.AllowSendingOfWelcomeMessage)
                {
                    <admin-action submit="true" name="send-welcome-message" icon="bi-arrow-clockwise"
                                  url="@Url.Action("SendWelcomeMessage", new { id = Model.Id, area = Constants.AreaAdmin })"
                                  text="@Loc["Admin.Customers.Customers.SendWelcomeMessage"]"
                                  data-grand-confirm="@Loc["Admin.Common.AreYouSure"]"
                                  data-confirm-title="@Loc["Admin.Customers.Customers.SendWelcomeMessage"]"/>
                }
                @if (Model.AllowReSendingOfActivationMessage)
                {
                    <admin-action submit="true" name="resend-activation-message" icon="bi-arrow-clockwise"
                                  url="@Url.Action("ReSendActivationMessage", new { id = Model.Id, area = Constants.AreaAdmin })"
                                  text="@Loc["Admin.Customers.Customers.ReSendActivationMessage"]"
                                  data-grand-confirm="@Loc["Admin.Common.AreYouSure"]"
                                  data-confirm-title="@Loc["Admin.Customers.Customers.ReSendActivationMessage"]"/>
                }
                <admin-action id="customer-delete" destructive="true" icon="bi-trash"
                              text="@Loc["Admin.Common.Delete"]"/>
            </admin-action-menu>
            <vc:admin-widget widget-zone="customer_details_buttons" additional-data="Model"/>
        </page-actions>

        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>
<admin-delete-confirmation button-id="customer-delete"/>

<partial name="Partials/SendEmail" model="Model.SendEmail"/>