@model ContentSettingsModel

@{
    //page title
    ViewBag.Title = Loc["Admin.Settings.Content"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Setting" asp-action="Content" method="post">

    <div asp-validation-summary="All"></div>
    @* the store scope, then one tab per settings group; Save commits every tab *@
    <admin-page sticky title="@Loc["Admin.Settings.Content"]" icon="bi-sliders">
        <page-actions>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <vc:admin-widget widget-zone="content_settings_buttons" additional-data="null"/>
        </page-actions>

        @await Component.InvokeAsync("StoreScope")

        <vc:admin-widget widget-zone="content_settings_top" additional-data="null"/>
        <admin-tabstrip name="contentsettings-edit">
            <items>
                <tabstrip-item text="@Loc["Admin.Settings.Content.BlogSettings"]" tab-index="0">
                    <content>
                        <div>
                            <partial name="Partials/Content.TabBlogSettings" model="Model"/>
                        </div>
                    </content>
                </tabstrip-item>
                <tabstrip-item text="@Loc["Admin.Settings.Content.NewsSettings"]" tab-index="1">
                    <content>
                        <div>
                            <partial name="Partials/Content.TabNewsSettings" model="Model"/>
                        </div>
                    </content>
                </tabstrip-item>
                <tabstrip-item text="@Loc["Admin.Settings.Content.KnowledgebaseSettings"]" tab-index="2">
                    <content>
                        <div>
                            <partial name="Partials/Content.TabKnowledgebaseSettings" model="Model"/>
                        </div>
                    </content>
                </tabstrip-item>
                <vc:admin-widget widget-zone="content_settings_details_tabs" additional-data="Model"/>
            </items>
        </admin-tabstrip>
        <vc:admin-widget widget-zone="content_settings_bottom" additional-data="null"/>
    </admin-page>
</form>