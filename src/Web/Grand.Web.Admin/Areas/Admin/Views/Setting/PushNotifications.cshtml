@model PushNotificationsSettingsModel
@{
    //page title
    ViewBag.Title = Loc["Admin.PushNotifications"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Setting" asp-action="PushNotifications" method="post">

    @* what push notifications are and the warning that goes with them, whether they are on, then
       the Firebase project they are sent through *@
    <admin-page title="@Loc["Admin.PushNotifications"]" icon="bi-boxes">
        <page-actions>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
        </page-actions>

        <admin-card>
            <div class="alert alert-info">
                <p>@Loc["Admin.Settings.PushNotifications.PushNotifications.Info"]</p>
            </div>
            <div class="alert alert-danger">
                <p>@Loc["Admin.Settings.PushNotifications.PushNotifications.Warning"]</p>
            </div>
            <div class="grand-fields grand-fields--2col">
                <admin-field asp-for="Enabled"/>
                <admin-field asp-for="AllowGuestNotifications"/>
            </div>
        </admin-card>
        <admin-card>
            <div class="grand-fields grand-fields--2col">
                <admin-field asp-for="PrivateApiKey"/>
                <admin-field asp-for="PushApiKey"/>
                <admin-field asp-for="AuthDomain"/>
                @*<admin-field asp-for="DatabaseUrl"/>*@
                <admin-field asp-for="ProjectId"/>
                <admin-field asp-for="StorageBucket"/>
                <admin-field asp-for="SenderId"/>
                <admin-field asp-for="AppId"/>
            </div>
        </admin-card>
    </admin-page>
</form>
