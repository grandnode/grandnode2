@inject ILanguageService languageService
@using Grand.Business.Core.Interfaces.Common.Localization
@model SystemSettingsModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Settings.System"];

    var languages = new List<SelectListItem>();
    foreach (var item in await languageService.GetAllLanguages(true))
    {
        languages.Add(new SelectListItem
        {
            Value = item.Id,
            Text = item.Name,
            Selected = item.Id == Model.DefaultAdminLanguageId
        });
    }
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Setting" asp-action="SystemSetting" method="post">

    @* orders and guests, where pictures are kept with the switch that moves them, then the admin
       panel's own grid, language and document settings *@
    <admin-page title="@Loc["Admin.Settings.System"]" icon="bi-boxes">
        <page-actions>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
        </page-actions>

        <admin-card>
            <div class="grand-fields grand-fields--2col">
                <admin-field asp-for="OrderIdent" size="sm"/>
                <admin-field asp-for="DaysToCancelUnpaidOrder" size="sm"/>
                <admin-field asp-for="DeleteGuestTaskOlderThanMinutes" size="sm"/>
                <admin-field asp-for="UseIsoDateTimeConverterInJson"/>
            </div>
        </admin-card>
        <admin-card>
            <div class="grand-facts">
                <div>
                    <admin-label asp-for="PicturesStoredIntoDatabase" asp-display-hint="false" class="grand-fact__label"/>
                    <div class="grand-fact__value">
                        @if (Model.PicturesStoredIntoDatabase)
                        {
                            @Loc["Admin.Settings.Media.PicturesStoredIntoDatabase.Database"]
                        }
                        else
                        {
                            @Loc["Admin.Settings.Media.PicturesStoredIntoDatabase.FileSystem"]
                        }
                    </div>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" name="change-picture-storage" asp-action="ChangePictureStorage" data-grand-confirm="@Loc["Admin.Common.AreYouSure"]" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-clockwise"></i> @Loc["Admin.Settings.Media.PicturesStoredIntoDatabase.Change"]
                </button>
            </div>
            <div class="note note-warning mt-3">
                <span>@Loc["Admin.Settings.Media.PicturesStoredIntoDatabase.Note"]</span>
            </div>
        </admin-card>
        <admin-card>
            <div class="grand-fields grand-fields--2col">
                <admin-field asp-for="DefaultGridPageSize" size="sm"/>
                <admin-field asp-for="GridPageSizes" size="md"/>
                <admin-field asp-for="HideStoreColumn"/>
                <admin-field asp-for="DocumentPageSizeSettings" size="md"/>
                <admin-field asp-for="DefaultAdminLanguageId" asp-items="languages" size="md"/>
                <admin-field asp-for="AutomaticallyDetectLanguage"/>
                <admin-field asp-for="IgnoreRtlPropertyForAdminArea"/>
            </div>
        </admin-card>
    </admin-page>
</form>
