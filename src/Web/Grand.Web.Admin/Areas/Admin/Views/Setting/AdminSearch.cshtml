@model AdminSearchSettingsModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Settings.AdminSearch"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Setting" asp-action="AdminSearch" method="post">

    @* what the admin search looks in, each with the place its results take in the list, then the
       limits on the term and on the results *@
    <admin-page title="@Loc["Admin.Settings.AdminSearch"]" icon="bi-boxes">
        <page-actions>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
        </page-actions>

        <admin-card>
            <div class="grand-fields grand-fields--2col">
                <admin-field asp-for="SearchInMenu"/>
                <admin-field asp-for="MenuDisplayOrder" size="sm"/>
                <admin-field asp-for="SearchInProducts"/>
                <admin-field asp-for="ProductsDisplayOrder" size="sm"/>
                <admin-field asp-for="SearchInCategories"/>
                <admin-field asp-for="CategoriesDisplayOrder" size="sm"/>
                <admin-field asp-for="SearchInCollections"/>
                <admin-field asp-for="CollectionsDisplayOrder" size="sm"/>
                <admin-field asp-for="SearchInPages"/>
                <admin-field asp-for="PagesDisplayOrder" size="sm"/>
                <admin-field asp-for="SearchInNews"/>
                <admin-field asp-for="NewsDisplayOrder" size="sm"/>
                <admin-field asp-for="SearchInBlogs"/>
                <admin-field asp-for="BlogsDisplayOrder" size="sm"/>
                <admin-field asp-for="SearchInCustomers"/>
                <admin-field asp-for="CustomersDisplayOrder" size="sm"/>
                <admin-field asp-for="SearchInOrders"/>
                <admin-field asp-for="OrdersDisplayOrder" size="sm"/>
            </div>
        </admin-card>
        <admin-card>
            <div class="grand-fields grand-fields--2col">
                <admin-field asp-for="MinSearchTermLength" size="sm"/>
                <admin-field asp-for="MaxSearchResultsCount" size="sm"/>
                <admin-field asp-for="CategorySizeLimit" size="sm"/>
                <admin-field asp-for="BrandSizeLimit" size="sm"/>
                <admin-field asp-for="CollectionSizeLimit" size="sm"/>
                <admin-field asp-for="VendorSizeLimit" size="sm"/>
                <admin-field asp-for="CustomerGroupSizeLimit" size="sm"/>
            </div>
        </admin-card>
    </admin-page>
</form>
