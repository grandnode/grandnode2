<div class="panel panel-default">
    <div class="note note-info">
        <p>
            <h4>@Loc["Admin.Settings.Order.MerchandiseReturnActions"]</h4>
        </p>
    </div>
    <div class="panel-body">
        <admin-grid id="merchandisereturnactions-grid"
                    read-url="@Url.Action("MerchandiseReturnActionList", new { area = Constants.AreaAdmin })"
                    pager="Compact">
            <grid-column field="Name" title="@Loc["Admin.Settings.Order.MerchandiseReturnActions.Name"]" width="300">
                <cell-template>
                    <a class="k-link" href="@Url.Action("MerchandiseReturnActionEdit", "Setting", new { area = Constants.AreaAdmin })/{{ Id }}">{{ Name }}</a>
                </cell-template>
            </grid-column>
            <grid-column field="DisplayOrder" title="@Loc["Admin.Settings.Order.MerchandiseReturnActions.DisplayOrder"]" width="100"/>
        </admin-grid>
    </div>
    <div class="panel-footer">
        <a href="@Url.Action("MerchandiseReturnActionCreate", new { area = Constants.AreaAdmin })" class="k-button"><i class="fa fa-plus"></i>&nbsp;@Loc["Admin.Common.AddNew"]</a>
    </div>
</div>


