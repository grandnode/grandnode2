@model MerchandiseReturnActionModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Settings.Order.MerchandiseReturnActions.AddNew"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Setting" asp-action="MerchandiseReturnActionCreate" method="post">

    <div class="row">
        <div class="col-md-12">
            <div class="x_panel light form-fit">
                <div class="x_title">
                    <div class="caption">
                        <i class="bi bi-card-list"></i>
                        @Loc["Admin.Settings.Order.MerchandiseReturnActions.AddNew"]
                        <small>
                            <i class="bi bi-arrow-left-circle"></i>@Html.ActionLink(Loc["Admin.Settings.Order.MerchandiseReturnActions.BackToList"], "MerchandiseReturnActionList")
                        </small>
                    </div>
                    <div class="actions">
                        <button class="btn btn-success" type="submit" name="save">
                            <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
                        </button>
                        <button class="btn btn-success" type="submit" name="save-continue">
                            <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
                        </button>
                    </div>
                </div>
                <div class="x_content form">
                    <partial name="Partials/CreateOrUpdate.MerchandiseReturnAction" model="Model"/>
                </div>
            </div>
        </div>
    </div>
</form>