@model MerchandiseReturnActionModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Settings.Order.MerchandiseReturnActions.AddNew"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Setting" asp-action="MerchandiseReturnActionCreate" method="post">

    @* the same shell as Edit, minus what a record that does not exist yet cannot offer *@
    <admin-page sticky
                title="@Loc["Admin.Settings.Order.MerchandiseReturnActions.AddNew"]"
                icon="bi-card-list"
                back-url="@Url.Action("MerchandiseReturnActionList", "Setting", new { area = Constants.AreaAdmin })"
                back-text="@Loc["Admin.Settings.Order.MerchandiseReturnActions.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
        </page-actions>

        <partial name="Partials/CreateOrUpdate.MerchandiseReturnAction" model="Model"/>
    </admin-page>
</form>