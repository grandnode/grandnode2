@model MerchandiseReturnReasonModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Settings.Order.MerchandiseReturnReasons.EditDetails"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Setting" asp-action="MerchandiseReturnReasonEdit" method="post">

    @* the record name as the title, Save as the one primary action, Delete in the overflow menu *@
    <admin-page sticky
                title="@Model.Name"
                icon="bi-card-list"
                meta="@Loc["Admin.Settings.Order.MerchandiseReturnReasons.EditDetails"]"
                back-url="@Url.Action("MerchandiseReturnReasonList", "Setting", new { area = Constants.AreaAdmin })"
                back-text="@Loc["Admin.Settings.Order.MerchandiseReturnReasons.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <admin-action-menu>
                <admin-action id="merchandisereturnreason-delete" destructive="true" icon="bi-trash"
                              text="@Loc["Admin.Common.Delete"]"/>
            </admin-action-menu>
        </page-actions>

        <partial name="Partials/CreateOrUpdate.MerchandiseReturnReason" model="Model"/>
    </admin-page>
</form>
<admin-delete-confirmation button-id="merchandisereturnreason-delete" action-name="MerchandiseReturnReasonDelete"/>