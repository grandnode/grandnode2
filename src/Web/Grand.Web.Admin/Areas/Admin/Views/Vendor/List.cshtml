@model VendorListModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Vendors"];
}

@* Add new as the one primary action, the name search in a filter bar whose Search steps down,
   the grid in a flush card *@
<admin-page title="@Loc["Admin.Vendors"]" icon="bi-boxes">
    <page-actions>
        <vc:admin-widget widget-zone="vendor_list_buttons" additional-data="null"/>
        <a href="@Url.Action("Create", new { area = Constants.AreaAdmin })" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> @Loc["Admin.Common.AddNew"]
        </a>
    </page-actions>

    <admin-filters id="vendor-filters" submit-id="search-vendors" secondary-submit="true">
        <filters-search>
            <admin-input asp-for="SearchName"/>
        </filters-search>
    </admin-filters>

    <admin-card flush>
        <admin-grid id="vendors-grid"
                    read-url="@Url.Action("List", "Vendor", new { area = Constants.AreaAdmin })"
                    additional-data="additionalData">
            <grid-column field="Name" title="@Loc["Admin.Vendors.Fields.Name"]" width="300">
                <cell-template>
                    <a class="text-decoration-none" href="Edit/{{ Id }}">{{ Name }}</a>
                </cell-template>
            </grid-column>
            <grid-column field="Email" title="@Loc["Admin.Vendors.Fields.Email"]" width="300">
                <cell-template>
                    <a class="text-decoration-none" href="Edit/{{ Id }}">{{ Email }}</a>
                </cell-template>
            </grid-column>
            <grid-column field="Active" title="@Loc["Admin.Vendors.Fields.Active"]" width="100" align="Center">
                <cell-template>
                    <i data-if="Active" class="bi bi-check-lg text-success" aria-hidden="true"></i>
                    <i data-else class="bi bi-x-lg text-danger" aria-hidden="true"></i>
                </cell-template>
            </grid-column>
        </admin-grid>
    </admin-card>
</admin-page>

<script>
    $(document).ready(function () {
        //search button
        $('#search-vendors').click(function () {
            //search
            var grid = GrandAdmin.grids.get('#vendors-grid');
            grid.dataSource.page(1); //new search. Set page size to 1
            //grid.dataSource.read(); we already loaded the grid above using "page" function
            return false;
        });

        $("#@Html.IdFor(model => model.SearchName)").keydown(function (event) {
            if (event.keyCode == 13) {
                $("#search-vendors").click();
                return false;
            }
        });
    });

    function additionalData() {
        var data = {
            SearchName: $('#@Html.IdFor(model => model.SearchName)').val()
        };
        addAntiForgeryToken(data);
        return data;
    }
</script>