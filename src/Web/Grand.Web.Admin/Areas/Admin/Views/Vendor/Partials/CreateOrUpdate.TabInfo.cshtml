@using Microsoft.AspNetCore.Mvc.Razor
@model VendorModel
<script>
        $(document).ready(function () {
            $("@Model.AllowCustomersToSelectPageSize").click(togglePageSize);
            togglePageSize();
        });

        function togglePageSize() {
            if ($('@Model.AllowCustomersToSelectPageSize').is(':checked')) {
                $('#pnlPageSize').hide();
                $('#pnlPageSizeOptions').show();
            } else {
                $('#pnlPageSize').show();
                $('#pnlPageSizeOptions').hide();
            }
        }
</script>
<vc:admin-widget widget-zone="vendor_details_info_top" additional-data="Model"/>

@{
    Func<int, HelperResult>
        template = @<div class="grand-fields">
                       <admin-field asp-for="@Model.Locales[item].Name"/>
                       <admin-field asp-for="@Model.Locales[item].Description">
                           <admin-textarea asp-for="@Model.Locales[item].Description"></admin-textarea>
                       </admin-field>
                       <input asp-for="@Model.Locales[item].LanguageId" type="hidden"/>
                   </div>;
}
@* The brand info tab's shape: what the vendor says, who it is, how its page is shown, then its
   address. Active is changed by the Activate/Deactivate action, so it reads as a fact here. The
   ids the script above toggles - pnlPageSize, pnlPageSizeOptions - sit on the same fields. *@
<admin-card>
    <localized-editor localized-template="@template" name="vendor-info-localized" language-ids="@Model.Locales.Select(c => c.LanguageId).ToList()">
        <div class="grand-fields">
            <admin-field asp-for="Name"/>
            <admin-field asp-for="Description">
                <admin-textarea asp-for="Description"></admin-textarea>
            </admin-field>
        </div>
    </localized-editor>
</admin-card>
@{
    ViewData["Reference"] = "Vendor";
    ViewData["ObjectId"] = Model.Id;
}
<admin-card>
    <div class="grand-facts mb-3">
        <div>
            <admin-label asp-for="Active" asp-display-hint="false" class="grand-fact__label"/>
            <div class="grand-fact__value">@Model.Active</div>
        </div>
        @if (!string.IsNullOrEmpty(Model.Id))
        {
            <div>
                <admin-label asp-for="AssociatedCustomers" asp-display-hint="false" class="grand-fact__label"/>
                <div class="grand-fact__value">
                    @if (Model.AssociatedCustomers.Count > 0)
                    {
                        for (var i = 0; i < Model.AssociatedCustomers.Count; i++)
                        {
                            if (!string.IsNullOrEmpty(Model.AssociatedCustomers[i].Email))
                            {
                                @Html.ActionLink(Model.AssociatedCustomers[i].Email, "Edit", "Customer", new { id = Model.AssociatedCustomers[i].Id }, new { })
                                if (i != Model.AssociatedCustomers.Count - 1)
                                {
                                    <text>, </text>
                                }
                            }
                        }
                    }
                    else
                    {
                        @Loc["Admin.Vendors.Fields.AssociatedCustomerEmails.None"]
                    }
                </div>
            </div>
        }
    </div>
    <div class="grand-fields grand-fields--2col">
        <admin-field asp-for="Email"/>
        <admin-field asp-for="StoreId" asp-items="Model.AvailableStores"/>
        <admin-field asp-for="Commission" size="md" suffix="%"/>
        <admin-field asp-for="AllowCustomerReviews"/>
        <admin-field asp-for="AdminComment">
            <admin-textarea asp-for="AdminComment"></admin-textarea>
        </admin-field>
        <admin-field asp-for="PictureId">
            <admin-input asp-for="PictureId"/>
        </admin-field>
    </div>
</admin-card>
<admin-card>
    <div class="grand-fields grand-fields--2col">
        <admin-field asp-for="AllowCustomersToSelectPageSize"/>
        <admin-field asp-for="PageSize" id="pnlPageSize" size="sm"/>
        <admin-field asp-for="PageSizeOptions" id="pnlPageSizeOptions"/>
        <admin-field asp-for="DisplayOrder" size="sm"/>
    </div>
</admin-card>
@if (Model.Address.FaxEnabled || Model.Address.PhoneEnabled || Model.Address.StateProvinceEnabled || Model.Address.StreetAddressEnabled || Model.Address.ZipPostalCodeEnabled ||
     Model.Address.CityEnabled || Model.Address.CompanyEnabled || Model.Address.CountryEnabled || Model.Address.StreetAddress2Enabled)
{
    <admin-card title="@Loc["Admin.Vendors.Fields.Address"]">
        <admin-input asp-for="Address" asp-template="Address"/>
    </admin-card>
}
<vc:admin-widget widget-zone="vendor_details_info_bottom" additional-data="Model"/>
