@model VendorModel

@* the merchandise return notes' shape: the notes grid in a flush card, then a card to add one *@
<admin-card flush>
    <admin-grid id="vendornotes-grid"
                read-url="@Url.Action("VendorNotesSelect", "Vendor", new { vendorId = Model.Id, area = Constants.AreaAdmin })"
                destroy-url="@Url.Action("VendorNoteDelete", "Vendor", new { vendorId = Model.Id, area = Constants.AreaAdmin })"
                pager="Compact"
                auto-bind="false">
        <grid-column field="CreatedOn" title="@Loc["Admin.Vendors.VendorNotes.Fields.CreatedOn"]" width="200" format="{0:G}"/>
        <grid-column field="Note" title="@Loc["Admin.Vendors.VendorNotes.Fields.Note"]"/>
        <grid-commands destroy="true" title="@Loc["Admin.Common.Delete"]" width="100"/>
    </admin-grid>
</admin-card>
<admin-card title="@Loc["Admin.Vendors.VendorNotes.AddTitle"]">
    <vc:admin-widget widget-zone="vendor_details_notes_top" additional-data="Model"/>
    <div class="grand-fields">
        <admin-field asp-for="AddVendorNoteMessage">
            <admin-textarea asp-for="AddVendorNoteMessage"></admin-textarea>
        </admin-field>
    </div>
    <div class="mt-3">
        <button type="button" id="addVendorNote" class="btn btn-outline-secondary btn-sm"><i class="bi bi-plus-lg"></i> @Loc["Admin.Vendors.VendorNotes.AddButton"]</button>
    </div>
    <vc:admin-widget widget-zone="vendor_details_notes_bottom" additional-data="Model"/>
</admin-card>
<script>
    $(document).ready(function () {
        $('#addVendorNote').click(function () {
            var vendorNoteMessage = $("#@Html.IdFor(model => model.AddVendorNoteMessage)").val();
            $('#addVendorNote').attr('disabled', true);

            var postData = {
                message: vendorNoteMessage,
                vendorId: '@Model.Id'
            };
            addAntiForgeryToken(postData);

            $.ajax({
                cache: false,
                type: "POST",
                url: "@(Url.Action("VendorNoteAdd", "Vendor", new { area = Constants.AreaAdmin }))",
                data: postData,
                success: function (data) {
                    var grid = $("#vendornotes-grid").data('kendoGrid');
                    grid.dataSource.read();
                    $('#addVendorNote').attr('disabled', false);
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    alert('Failed to add vendor note.');
                    $('#addVendorNote').attr('disabled', false);
                }
            });
        });
    });
</script>