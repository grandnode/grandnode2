@{
    //page title
    ViewBag.Title = Loc["Admin.Orders.OrderStatus"];
}

@* The inline grid in a flush card: grid.js moves its Add new into the card header, which makes
   it the page's only add; there is nothing else to save. *@
<admin-page title="@Loc["Admin.Orders.OrderStatus"]" icon="bi-card-list">
    <admin-card flush>
        <admin-grid id="orderstatus-grid"
                    read-url="@Url.Action("Statuses", "OrderStatus", new { area = Constants.AreaAdmin })"
                    create-url="@Url.Action("Add", "OrderStatus", new { area = Constants.AreaAdmin })"
                    update-url="@Url.Action("Update", "OrderStatus", new { area = Constants.AreaAdmin })"
                    destroy-url="@Url.Action("Delete", "OrderStatus", new { area = Constants.AreaAdmin })"
                    pager="Compact"
                    edit-mode="Inline">
            <grid-toolbar-create/>
            <grid-column field="Name" title="@Loc["Admin.Orders.OrderStatus.Fields.Name"]" width="300" editor="Text"/>
            <grid-column field="DisplayOrder" title="@Loc["Admin.Orders.OrderStatus.Fields.DisplayOrder"]" width="100" format="{0:0}" editor="Integer" default-value="0"/>
            <grid-commands edit="true" destroy="true" width="200"/>
        </admin-grid>
    </admin-card>
</admin-page>

<script type="text/javascript">
</script>