@model OrderTagModel
@{
    //page title
    ViewBag.Title = Loc["Admin.Orders.OrderTags.EditTagDetails"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="OrderTags" asp-action="Edit" method="post">

    @* the product tag screen's shell: the tag's name as the title and Save as the one primary
       action; a tag is deleted from the list, so there is no overflow menu *@
    <admin-page sticky
                title="@Model.Name"
                icon="bi-box"
                meta="@Loc["Admin.Orders.OrderTags.EditTagDetails"]"
                back-url="@Url.Action("List")"
                back-text="@Loc["Admin.Orders.OrderTags.BackToList"]">
        <page-actions>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
            <vc:admin-widget widget-zone="order_tag_details_buttons" additional-data="Model"/>
        </page-actions>

        <partial name="Partials/CreateOrUpdate" model="Model"/>
    </admin-page>
</form>