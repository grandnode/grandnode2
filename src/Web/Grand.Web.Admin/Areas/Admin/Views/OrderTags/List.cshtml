
@{
    //page title
    ViewBag.Title = Loc["Admin.Orders.OrderTags"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="OrderTags" method="post" id="order-tags-form">

    @* Tags come from orders, so there is no Add new: the page header carries only the widget
       zone, and the grid a flush card. *@
    <admin-page title="@Loc["Admin.Orders.OrderTags"]" icon="bi-boxes">
        <page-actions>
            <vc:admin-widget widget-zone="order_tag_list_buttons" additional-data="null"/>
        </page-actions>

        <admin-card flush>
        <admin-grid id="order-tags-grid"
                    read-url="@Url.Action("List", "OrderTags", new { area = Constants.AreaAdmin })"
                    destroy-url="@Url.Action("Delete", "OrderTags", new { area = Constants.AreaAdmin })"
                    confirm-destroy="true">
            <grid-column field="Name" title="@Loc["Admin.Orders.OrderTags.Fields.Name"]" width="300">
                <cell-template>
                    <a class="text-decoration-none" href="Edit/{{ Id }}">{{ Name }}</a>
                </cell-template>
            </grid-column>
            <grid-column field="OrderCount" title="@Loc["Admin.Orders.ProductTags.Fields.OrderCount"]" width="100" align="Center"/>
            <grid-commands destroy="true" title="@Loc["Admin.Common.Delete"]" width="100"/>
        </admin-grid>
        </admin-card>
    </admin-page>
</form>
