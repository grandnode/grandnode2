@model ScheduleTaskModel
@{
    ViewBag.Title = Loc["Admin.System.ScheduleTasks.Edit"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="ScheduleTask" asp-action="EditScheduler" method="post">
    <div asp-validation-summary="All"></div>

    <input asp-for="Id" type="hidden"/>
    @* the task's name as the title, Save as the one primary action; the name the list links by
       is read-only, so it is a fact rather than a field *@
    <admin-page sticky
                title="@Model.ScheduleTaskName"
                icon="bi-list-task"
                meta="@Loc["Admin.System.ScheduleTasks.Edit"]"
                back-url="@Url.Action("List", "ScheduleTask", new { area = Constants.AreaAdmin })"
                back-text="@Loc["Admin.System.ScheduleTasks.BackToList"]">
        <page-actions>
            <button class="btn btn-outline-secondary" type="submit" name="save-continue">
                <i class="bi bi-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
            </button>
            <button class="btn btn-primary" type="submit" name="save">
                <i class="bi bi-check-lg"></i> @Loc["Admin.Common.Save"]
            </button>
        </page-actions>

        <admin-card>
            <div class="grand-facts">
                <div>
                    <admin-label asp-for="ScheduleTaskName" asp-display-hint="false" class="grand-fact__label"/>
                    <div class="grand-fact__value">@Html.DisplayFor(model => model.ScheduleTaskName)</div>
                </div>
            </div>
            <div class="grand-fields grand-fields--2col mt-3">
                <admin-field asp-for="Enabled"/>
                <admin-field asp-for="StopOnError"/>
                <admin-field asp-for="TimeInterval" id="trTimeInterval" size="sm"/>
                <admin-field asp-for="LeasedByMachineName" size="md"/>
                <admin-field asp-for="StoreId" asp-items="Model.AvailableStores" size="md"/>
            </div>
        </admin-card>
    </admin-page>
</form>