{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  "Observability": {
    //true starts an OpenTelemetry Collector and Grafana (grafana/otel-lgtm) next to the apps; their traces,
    //metrics and logs then reach Grafana as well as the Aspire dashboard
    "Grafana": false
  }
}
