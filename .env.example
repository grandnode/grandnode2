ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# MongoDB (required)
MONGODB_URL=mongodb://mongodb:27017/grandnode
# DbProvider enum: MongoDB=0, CosmosDB=1, DocumentDB=2, LiteDB=3
DB_PROVIDER=0

# Redis (optional)
REDIS_PUBSUB_ENABLED=false
REDIS_PUBSUB_CONNECTION=redis:6379,allowAdmin=true
REDIS_PERSIST_KEYS=false
REDIS_PERSIST_URL=redis:6379,allowAdmin=true,defaultDatabase=1

# Installer feature flag (true for first run, set false after install completes)
INSTALLER_ENABLED=true
